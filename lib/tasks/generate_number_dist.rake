  user = User.find_by(email: '<redacted_email>');

  csv_string = CSV.generate do |csv|
    csv << ['Phone Number', 'Call Display']

    numbers.each_with_index do |number, index|
      number = "1#{number}"
      puts index
      customer = User.find_by(phone_number: number)
      if customer.present?
        uid, uid_type = customer.id, 'user'
      else
        uid, uid_type = number, 'phone_number'
      end

      from = 'N/A'
      conv = Conversation.includes(:merchant).find_by(merchant_id: user.id, uid_type: uid_type, uid: uid)
      if conv
        last_message = ConversationRef.includes(:textable).where(conversation_id: conv.id).last.try(:textable)   # maybe do a direct messages search here???????????????
        if last_message
          from = last_message.user_id == user.id ? last_message.from : last_message.to # inbound/outbound logic
          from = Number.unscoped.exists?(user_id: user.id, number: from) ? from : 'N/A' # check that merchant still owns the number else use default
        end
      end

      csv << [number, from]
    end
  end

  # FTP Here
  puts 'Creating file'.freeze
  filename = "#{user.email}.csv"
  temp_file = Tempfile.new(filename)
  temp_file.write(csv_string)
  temp_file.close

  puts 'connecting to ftp'.freeze
  Net::SFTP.start(CONTENT_SERVER_DOMAIN_NAME, CONTENT_SERVER_FTP_LOGIN, { password: CONTENT_SERVER_FTP_PASSWORD, port: PORT }) do |sftp|
