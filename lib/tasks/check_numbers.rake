      numbers.try(:each) do |n|
        next unless ary.exclude?(n['msisdn']) && numbers_ary.exclude?(n['msisdn'])

        numbers_ary.push(n['msisdn'])
        count += 1
      end
      break if numbers && numbers.size < 100
    end
    puts "#{code} #{count}"
  end
end

