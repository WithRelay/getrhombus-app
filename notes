messagingControllers.controller('messagingMainCtrl', ['$scope', '$http', 'Pubnub', 'Upload', '$timeout', '$q',
  function($scope, $http, Pubnub, Upload, $timeout, $q) {

    $scope.selected_conversation_messages = [];
    $scope.status = {
        loading: false,
        loaded: false
    };

    var counter = 0;
    $scope.loadMore = function() {
        var deferred = $q.defer();
        if (!$scope.status.loading) {
            $scope.status.loading = true;
            $scope.selected = $scope.selected_conversation_messages[0]
            // simulate an ajax request
            $timeout(function() {
                for (var i = 0; i < 15; i++) {
                    $scope.selected_conversation_messages.unshift({
                        id: counter
                    });
                    counter += 10;
                }
                $scope.status.loading = false;
                $scope.status.loaded = ($scope.selected_conversation_messages.length > 0);
                deferred.resolve();
            }, 1000);
        } else {
            deferred.reject();
        }
        return deferred.promise;
    };

    $scope.loadMore();


    // Messages  // remove
    // conversations
