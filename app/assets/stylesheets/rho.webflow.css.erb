.nav-link {
  -webkit-transition: all 500ms ease;
  transition: all 500ms ease;
  color: rgba(255, 255, 255, 0.58);
  font-size: 11px;
  line-height: 26px;
  font-weight: 500;
  letter-spacing: 3px;
  text-transform: uppercase;
}
.nav-link:hover {
