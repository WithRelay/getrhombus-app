.button {
  display: inline-block;
  padding: 11px 15px;
  border-radius: 3px;
  background-color: transparent;
  box-shadow: #357b9e 0px 0px 0px 1px;
  -webkit-transition: all 500ms ease;
  transition: all 500ms ease;
  color: #313131;
  font-size: 12px;
  font-weight: 600;
  text-align: center;
  letter-spacing: 2px;
  text-decoration: none;
  text-transform: uppercase;
}
.button:hover {
  background-color: #313131;
  color: white;
}
.button.btn-form {
  display: block;
  width: 98%;
}
.button.btn-form.contact-btn {
  color: #357b9e;
}
.button.btn-form.contact-btn:hover {
  background-color: #357b9e;
  box-shadow: #357b9e 0px 0px 0px 1px;
  color: white;
}
.button.btn-white {
  border-radius: 0px;
  background-color: #357b9e;
  box-shadow: none;
  color: white;
}
.button.btn-white:hover {
  background-color: white;
  color: #313131;
}
.button.btn-white.btn-signin {
  margin-top: 10px;
  border-style: solid;
  border-width: 1px;
  border-color: rgba(99, 99, 99, 0.58);
  background-color: transparent;
  box-shadow: none;
  color: rgba(99, 99, 99, 0.58);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 3px;
}
.button.btn-white.btn-signin:hover {
  border-color: #357b9e;
  background-color: #357b9e;
  box-shadow: none;
  color: white;
}
.button.btn-white.btn-signin.btn-signin-main {
  border-color: rgba(255, 255, 255, 0.58);
  box-shadow: none;
  color: rgba(255, 255, 255, 0.58);
}
.button.btn-white.btn-signin.btn-signin-main:hover {
  border-color: #357b9e;
  box-shadow: none;
}
.button.hm-section-4-button {
  margin-top: 23px;
  box-shadow: white 0px 0px 0px 1px;
  color: white;
}
.button.hm-section-4-button:hover {
  border: 1px solid white;
  background-color: white;
  box-shadow: none;
  color: #357b9e;
}
.button.customer-text-me {
  color: #357b9e;
}
.button.customer-text-me:hover {
  background-color: #357b9e;
  color: white;
}
.button.customer-text-me.text-me-btn {
