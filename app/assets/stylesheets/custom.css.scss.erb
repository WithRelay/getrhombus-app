
.shrink-text {
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

$error-color: red;
$success-color: green;

.intl-tel-input{
  width: 100% !important;
  margin-left: 36px !important;
}

/*page specific css for signup page*/
#sign_up-page .intl-tel-input{
  margin-bottom: 20px !important;
  margin-left: 53px !important;
}

#request-demo-page .intl-tel-input, #refer-a-business .intl-tel-input {
  margin-bottom: 20px !important;
  margin-left: 10% !important;
}

.selectize-control.single .selectize-input, .selectize-dropdown.single {
    padding: 0 !important;
    width: 100% !important;
    height: auto !important;
    border: none !important;
    -webkit-box-shadow: none !important;
    background: none !important;
    text-align: left !important;
}

.selectize-dropdown-content {
  display: block !important;
  background-color: white !important;
  width: 100% !important;
  border: 1px solid #1f8cec !important;
  margin-left: -60px !important;
  margin-top: 12px !important;
  text-align: left !important;
}

#subscription-plan-id-selectized {
  margin-top: 5px !important;
}

<% COLORS.each do |color| %>
  .radius-color-#{<%= color.first %>}{
  background-color:<%= color.last %>
  }
<%end%>

.has-error .form-control
{
  border-color: $error-color;
}

.help-block{
    color: $error-color;
}
.has-success .control-label,
.has-success .help-block {
    color: $success-color;
}
.hide {
  display: none !important;
}

/* For modals */
.modal-background {
  background: white;
}

.update-close-modals:hover {
  cursor: pointer;
}

/* End For modals */

/* For messaging page */
.message-counter {
  text-align: center;
}

/* End For messaging page */

.emojionearea-editor {
  height: 74px;
}