  padding-right: 30px;
}

.attach-image-container{
  margin-left: 160px;
  margin-top: -20px;
}
/* end for images */

#messages-box {
  padding-bottom: 200px;
}

/* For slider */
.slider-wrapper{
  width: 80% !important;
  margin: auto !important;
}

.gender-fieldset {
  overflow: hidden;
  margin-left: 39px;
}

.managed-account-gender {
  float: left;
  clear: none;
}

.gender-label {
  float: left;
