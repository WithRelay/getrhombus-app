
.shrink-text {
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

$error-color: red;
$success-color: #43e50f;

.intl-tel-input{
  width: 100% !important;
  margin-left: 52px !important;
}

/*page specific css for signup page*/
#sign_up-page .intl-tel-input{
  margin-bottom: 20px !important;
  margin-left: 53px !important;
}

#request-demo-page .intl-tel-input, #refer-a-business .intl-tel-input {
  margin-bottom: 20px !important;
  margin-left: 10% !important;
}

.selectize-control.single .selectize-input, .selectize-dropdown.single {
    padding: 0 !important;
    width: 100% !important;
    height: auto !important;
    border: none !important;
    -webkit-box-shadow: none !important;
    background: none !important;
    text-align: left !important;
}

#new-image-previews{
  width: 490px;
  margin-top: 15px;
}

.selectize-dropdown-content {
  display: block !important;
  background-color: white !important;
  width: 100% !important;
  border: 1px solid #1f8cec !important;
  margin-left: -60px !important;
  margin-top: 15px !important;
  text-align: left !important;
}

#termsAndCondition{
  margin-left: 47px;
}
.tos-checkbox{
  margin-left: -165px;
}


#subscription-plan-id-selectized, #subscription-select-coupon-selectized, #subscription-customer-id-selectized {
  margin-top: 5px !important;
}

<% COLORS.each_with_index do |color, index| %>
  .radius-color-#{<%= index %>}{
  background-color:<%= color.last %> !important;
  }
<%end%>


.has-success .form-control{
  border-color: $success-color !important;
}

.has-error .form-control
{
  border-color: $error-color !important;
}

.help-block{
    color: $error-color;
}
.has-success .control-label,
.has-success .help-block {
  color: $success-color;
}

.hide {
  display: none !important;
}

.hide-not-important {
  display: none;
}

/* For modals */
.modal-background {
  background: white;
}

.update-close-modals:hover {
  cursor: pointer;
}

/* End For modals */


/* For messaging page */
.message-counter {
  text-align: center;
}

.refund-slider {
  cursor: pointer;
}

textarea { resize: none; }

.text-area.message-text-box {
  height: auto;
  padding-bottom: 13px;
}

#messaging-page-textarea .emojionearea .emojionearea-editor {
  min-height: 0em;
  padding: 0px 10px 0px 0px;
  color: #455a64;
}

#conversations-list {
  overflow: hidden;
}

#conversation-list-wrapper {
  overflow: auto;
  height: 100%;
}

/* End For messaging page */

/* for rhombus number */

#rhombus-number {
  cursor: pointer;
}

/* End for rhombus number */

.button.remove_fb_integration {
  margin-top: 40px;
  margin-right: -4%;
}

.browser-notification-link-block, .toasters {
  position: fixed !important;
  margin: 5% auto !important;
  left: 35%;
  z-index: 10000 !important;
}

.cancel-subscription-wrapper {
  padding-bottom: 20px;
}
//https://css-tricks.com/snippets/html/responsive-meta-tag/
@-ms-viewport{
  width: device-width;
}


/* for images */
.deleteImagePreview {
  margin-left: 30px;
  cursor: pointer;
  width: 10px;
}

.editor-thumbnail {
  margin: 0px;
  width: 100%;
  height: auto;
  padding-left: 30px;
  padding-right: 30px;
}

.attach-image-container{
  margin-left: 160px;
  margin-top: -20px;
}
/* end for images */

.transaction-cell.card-name {
  float: left !important;
  width: 100% !important;
  padding-left: 0px !important;
}

#messages-box {
  padding-bottom: 200px;
}

/* For slider */
.slider-wrapper{
  width: 80% !important;
  margin: auto !important;
}

.range-bar {
    width: 70% !important;
    margin: auto !important;
    margin-top: 40px !important;
    margin-bottom: 40px !important;
}

.display-credit-card-wrapper-fix {
  padding-top: 0px;
  margin-top: 0px;
}
/* End For slider */
