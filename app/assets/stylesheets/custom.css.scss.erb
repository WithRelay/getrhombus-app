/* Header */

.header-links-fix {
  color: white;
  text-decoration: none;
}

/* Header End */
.segment-name{
  width: 59% !important;
}

.lebel_padding{
  padding-top: 11px;
}

.table-profile-picture {
  margin-left: 20px !important;
}
.text-center{
  text-align: center;
}

.link_no_underline {
  text-decoration: none;
}

.shrink-text {
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

$error-color: #e04e50;
$success-color: #43e50f;

.intl-tel-input{
  width: 100% !important;
  margin-left: 10% !important;
}

.remove_fields{
  margin-right: 472px;
  width: 100%;
}

#request-demo-page .intl-tel-input, #refer-a-business .intl-tel-input {
  margin-bottom: 20px !important;
  margin-left: 10% !important;
}

.selectize-control.single .selectize-input, .selectize-dropdown.single {
    padding: 0 !important;
    width: 100% !important;
    height: auto !important;
    border: none !important;
    -webkit-box-shadow: none !important;
    background: none !important;
    text-align: left !important;
}

.selectize-control.single .selectize-input [data-value] {
    text-shadow: 0 1px 0 rgba(0, 51, 83, 0.3);
    -webkit-border-radius: 3px;
    -moz-border-radius: 3px;
    border-radius: 3px;
    background-color: #1b9dec;
    background-image: -moz-linear-gradient(top, #1da7ee, #178ee9);
    background-image: -webkit-gradient(linear, 0 0, 0 100%, from(#1da7ee), to(#178ee9));
    background-image: -webkit-linear-gradient(top, #1da7ee, #178ee9);
    background-image: -o-linear-gradient(top, #1da7ee, #178ee9);
    background-image: linear-gradient(to bottom, #1da7ee, #178ee9);
    background-repeat: repeat-x;
    filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#ff1da7ee', endColorstr='#ff178ee9', GradientType=0);
    -webkit-box-shadow: 0 1px 0 rgba(0,0,0,0.2), inset 0 1px rgba(255,255,255,0.03);
    box-shadow: 0 1px 0 rgba(0,0,0,0.2), inset 0 1px rgba(255,255,255,0.03);
}
.selectize-control.single .selectize-input > div {
    cursor: pointer;
    margin: 0 3px 3px 0;
    padding: 2px 6px;
    background: #1da7ee;
    color: #ffffff;
    border: 1px solid #0073bb;
}

#new-image-previews{
  width: 490px;
  margin-top: 15px;
}

.selectize-dropdown-content {
  display: block !important;
  background-color: white !important;
  width: 100%;
  border: 1px solid #1f8cec !important;
  margin-left: -60px !important;
  margin-top: 15px !important;
  text-align: left !important;
}

#start-conversation-form .selectize-dropdown-content {
  margin-left: -30px !important;
  margin-top: 7px !important;
}

#termsAndCondition{
  margin-left: 47px;
}
.tos-checkbox{
  margin-left: -165px;
}


#subscription-plan-id-selectized, #subscription-select-coupon-selectized, #subscription-customer-id-selectized {
  margin-top: 5px !important;
}

<% COLORS.each do |color| %>
  .radius-color-<%= color[0] %> {
    background-color: <%= color[1] %> !important;
  }
<% end %>


.has-success .form-control{
  border-color: $success-color !important;
}

.has-error {
  border-color: $error-color !important;
  .form-control {
    border-color: $error-color !important;
    border: 1px solid #e04e50 !important;
  }
}

.help-block{
  color: $error-color;
  font-weight: 400;
  margin-right: 10%;
  margin-left: 10%;
  margin-top: -15px;
  font-family: 'Akkurat light regular', sans-serif;
  // color: #637280;
  font-size: 14px;
  float: left;
  padding-bottom:2%;
  text-transform: non
}
.has-success .control-label,
.has-success .help-block {
  color: $success-color;
}

.hide {
  display: none !important;
}

.hide-not-important {
  display: none;
}

/* For modals */
.modal-background {
  background: white;
}

.update-close-modals:hover {
  cursor: pointer;
}

/* End For modals */


/* For messaging page */
.message-counter {
  text-align: center;
}

.conversation_selected {
  border-bottom-color: #fff;
  background-color: #f0f4f7;
  box-shadow: inset 1px 1px 3px 0 rgba(141, 162, 183, .5);
  text-decoration: none;
}

.messaging-snapshot.leads.unverified {
  margin-left: 5px;
}

.disabled {
  cursor: not-allowed;
}

.refund-slider {
  cursor: pointer;
}

.z-index-1 {
  z-index: 1 !important;
}

textarea { resize: none;}

.text-area.message-text-box {
  height: auto;
  padding-bottom: 13px;
}

#messaging-page-textarea .emojionearea .emojionearea-editor {
  min-height: 0em;
  padding: 0px 10px 0px 0px;
  color: #455a64;
}

#conversations-list {
  overflow: hidden;
}

#conversation-list-wrapper {
  overflow: auto;
  height: 100%;
}

/* End For messaging page */

/* for rhombus number */

#rhombus-number {
