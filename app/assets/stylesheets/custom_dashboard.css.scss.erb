/* MERCHANT PROFILE FORM */

#merchantprofilepage {
	max-width: 750px; 
	margin: 0px auto;
	margin-bottom: 100px;
}

#merchantProfile {
	.countrygroup {
		margin-left: 0px;
		margin-right: 0px;
	}

	#address {
		max-width: 460px
	}

	#zip {
		max-width: 100px;
	}

	#taxrate {
		max-width: 60px;
	}

	#firstName, #lastName, #email, #phone, #confirmNewPassword, #newpassword, #reenterPassword {
		max-width: 220px;
	}
}

#connectStripe {
	max-width: 500px; 
	margin: 0px auto;
}

/* MERCHANT PROFILE FORM */


/* USER PROFILE FORM */
#userProfile1 {
	.login-form {
		padding-top: 40px;
		max-width: 360px !important;
	}

	.top {
		padding-bottom: 15px;
	}	

	#response {
		margin-top: -41px;
		color: rgb(233, 72, 71); 
		display: block;
		padding: 16px; 
		text-align: center;
	}

	#stripe-logo {
		margin-top: 10px;
	}

	.ccn-group {
		margin-bottom: 0px;
	}

	#cc-number {
		border-bottom-left-radius: 0; 
		border-bottom-right-radius: 0;
	}

	.exp-row {
		margin-bottom: 15px;
		margin-top: -1px;
	}

	#fa-Calendar {
		top: 13px;
		left: 27px;
	}

	#exp-div {
		padding-right: 0px;
	}

	#csc-div {
		padding-left: 0px;
	}

	#cc-csc {
		top: 14px;
		left: 9px;
	}

	#pwdnote {
		line-height: 15px; 
		margin-top: 10px;
	}

	.phonegroup {
		width: 100% !important;
	}

	#phone {
		padding-left: 43px;
	}
