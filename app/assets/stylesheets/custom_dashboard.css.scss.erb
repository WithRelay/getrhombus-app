  .col-md-6.col-sm-6.padding-fix1 {
      padding-left: 15px !important;
      padding-right: 15px !important;
  }
  .col-md-6.col-sm-6.padding-fix2 {
      padding-left: 15px !important;
  }

  #cc-exp {    
    border-radius: 1px;
  }

  #cc-csc {
    border-left: 1px solid #BDC4C9 !important;
    border-top: 1px solid #BDC4C9 !important;
    margin-top: -1px !important;
  }

  .fa.fa-lock {
    top: 11px !important;
    left: 28px !important;
  }

