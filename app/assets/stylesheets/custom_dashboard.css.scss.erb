form textarea, form input[type=text], form input[type=email], form input[type=password], form input[type=tel] {
    width: 100%;
    padding: 15px 14px 13px 14px;
    height: 52px;
    margin-bottom: 18px;
    font-size: 18px;
    font-family: 'Open Sans', sans-serif;
    color: #2f3148;
    border: 1px solid #f3f5f7;
    background-color: rgba(33, 41, 63, 0.1);
    -moz-box-shadow: inset rgba(0, 0, 0, 0.1) 0 1px 2px, inset rgba(0, 0, 0, 0.45) 0 0 1px;
    -webkit-box-shadow: inset rgba(0, 0, 0, 0.1) 0 1px 2px, inset rgba(0, 0, 0, 0.45) 0 0 1px;
    box-shadow: inset rgba(0, 0, 0, 0.1) 0 1px 2px, inset rgba(0, 0, 0, 0.45) 0 0 1px;
    -moz-border-radius: 5px;
    -webkit-border-radius: 5px;
    border-radius: 5px;
    -moz-transition-property: border-color, background-color;
    -o-transition-property: border-color, background-color;
    -webkit-transition-property: border-color, background-color;
    transition-property: border-color, background-color;
    -moz-transition-duration: 0.2s;
    -o-transition-duration: 0.2s;
    -webkit-transition-duration: 0.2s;
    transition-duration: 0.2s;
    -webkit-font-smoothing: antialiased;
    -webkit-tap-highlight-color: transparent;
    -moz-appearance: none;
    -webkit-appearance: none;
}

#merchantProfile form textarea {
    font-size: 18px;
