/* USER PROFILE FORM */

/* DASHBOARD */

#line-chart, #area-chart {
	height: 500px;
}

/* DASHBOARD */

/* TRANSACTIONS */

#transactions-column {
	#transactions-table {
		width: 100% !important;
	}

	td.details-control {
		background-image: url(/assets/Plus-25.png);	
  		background-repeat: no-repeat;
  		background-position: center;
        cursor: pointer;
    }
     
    tr.shown td.details-control {
     	background-image: url(/assets/x.png);	
  		background-repeat: no-repeat;
  		background-position: center;
        cursor: pointer;   
    }
     
    div.slider {
        display: none;
    }
     
    table.dataTable tbody td.no-padding {
        padding: 0;
    }	
}

/* TRANSACTIONS */


.intl-tel-input {
  width: inherit;
}

.pagination > .previous_page {
  background-color: transparent;
  padding: 10px;
  border: 1px solid white;
  border-radius: 25px;
  &:hover {
  	background-color: white;
  }
}

.pagination > .previous_page.disabled {
  background-color: transparent;
  padding: 10px;
  border: 1px solid white;
  border-radius: 25px;
}

.pagination > .next_page {
  background-color: transparent;
  padding: 10px;
  border: 1px solid white;
  border-radius: 25px;
  &:hover {
  	background-color: white;
  }
}

.col-md-6.col-sm-6.padding-fix2 {
    padding-left: 0px !important;
 }

#cc-csc {
  border-top-right-radius: 0; 
  border-left-color: transparent; 
  border-bottom-left-radius: 0;
}

#cc-exp {
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}

@media (max-width: 768px) {
  .col-md-6.col-sm-6.padding-fix1 {
      padding-left: 15px !important;
      padding-right: 15px !important;
  }
  .col-md-6.col-sm-6.padding-fix2 {
      padding-left: 15px !important;
  }

  #cc-exp {    
    border-radius: 1px;
  }

  #cc-csc {
    border-left: 1px solid #BDC4C9 !important;
    border-top: 1px solid #BDC4C9 !important;
    margin-top: -1px !important;
  }

  .fa.fa-lock {
    top: 11px !important;
    left: 28px !important;
  }

  #userProfile1 {
    padding: 0px;
  }

  .merchant-input {
    width: 100% !important;
  }
}

.error-pages {
   padding-bottom: 50px;
   padding-top: 50px !important;
}

.show {
  display: block;
}

.hide {
  display: none;
}

@media (min-width: 768px) {
  .form-horizontal .control-label {
    text-align: left !important;
  }
}

.dropdowm-menu, .merchant-country {
   margin-left: 15px !important;
   margin-right: 15px !important;
}

.merchant-form-line {
  border-bottom: 1px solid #ccc;
  margin-bottom: 30px;
  margin-top: 20px;
}
