var UtilFunctions = new function() {

  this.get_card_expiry_date_data = function() {
    return $('input#cc-exp').payment('cardExpiryVal');
  };

  this.get_ipinfo_url = function() {
    return "https://ipinfo.io/?token=ae79647534348f";
  };

  this.positive_integer_only = function(v) {
    if (!(/^(\d+)$/.test(v))) return '';
    else {
      if (v.match(/^[1-9]\d*$/)) return v;
      else return v.slice(0, -1);
    }
  };

  this.positive_integer_from_zero_only = function(v) {
    if (!(/^(\d+)$/.test(v))) return '';
    else {
      if (v.match(/^[0-9]\d*$/)) return v;
      else return v.slice(0, -1);
    }
  };

