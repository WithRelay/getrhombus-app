  // returns truthy or falsy value
  // takes numbers, strings, null, boolean, objects
  this.is_present = function(val) { 
    if (typeof(val) === "boolean") return val;
    if (val instanceof Object) return Object.keys(val).length;
    if ($.isNumeric(val)) val = val.toString();
    return val && val.trim().length;
  };

  this.is_blank = function(val) { 
    return !UtilFunctions.is_present(val);
  };

  this.placeCaretAtEnd = function(el) {
    el.focus();
    if (typeof window.getSelection != "undefined"
            && typeof document.createRange != "undefined") {
      var range = document.createRange();
      range.selectNodeContents(el);
      range.collapse(false);
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    } else if (typeof document.body.createTextRange != "undefined") {
      var textRange = document.body.createTextRange();
      textRange.moveToElementText(el);
      textRange.collapse(false);
      textRange.select();
    };
  };

  this.to_int_or_2dp = function(amt) {
    amt = parseFloat(amt || 0).toFixed(2);
    if (amt.indexOf('.00') != -1) amt = amt.split('.')[0];
    return amt;
  };

  this.is_conversation_page = function() {
    return window.location.pathname.indexOf('conversation') > -1;
  };

  this.is_add_subscription_page = function() {
    return window.location.pathname.indexOf('add-subscription') > -1;
  };

};


