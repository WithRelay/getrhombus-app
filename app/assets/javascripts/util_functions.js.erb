var UtilFunctions = new function() {

  this.get_card_expiry_date_data = function() {
    return $('input#cc-exp').payment('cardExpiryVal');
  }

  this.set_first_and_last_names = function() {
  	var full_name = $('#user_full_name').val().trim().replace(/\s{2,}/g,' ').split(' ');
    $('#firstName').val(full_name[0]);
    full_name.shift();
    $('#lastName').val(full_name.join(' '));
  }

  this.get_ipinfo_url = function() {
  	return "https://ipinfo.io/?token=ae79647534348f";
  }

}


$(document).ready(function () {

  var clipboard = new Clipboard('#rhombus-number');
