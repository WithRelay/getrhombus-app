    if (["/signup", "/signin", '/users', "/profile"].indexOf(url.pathname) != -1) {
        var amt = validate_captured_amt(global_page_params['amt'])
        
        if (url.pathname == "/signup") {
            document.getElementById('phone').value = global_page_params['num'];
