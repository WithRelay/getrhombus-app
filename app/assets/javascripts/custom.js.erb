  // for table slide dowm
  function format ( d, element ) {
      // `d` is the original data object for the row
      var v, w, x, y, z;
      x = '<div class="slider" style="padding: 0px 20px;">'+
              '<table cellpadding="5" cellspacing="0" border="0">'+
                  '<tr>'+
                      '<td>Email:</td>'+
                      '<td>'+ element.attr('data-email') +'</td>'+
                  '</tr>';
      if (element.attr('data-page') === 'transactions') {
          y =     '<tr>' +
                      '<td>Rhombus Txn #:</td>'+
                      '<td>'+ element.attr('data-txn-num') +'</td>'+
                  '</tr>'+
                  '<tr>'+
                      '<td>Time (ET):</td>'+
                      '<td>'+ element.attr('data-time') +'</td>'+
                  '</tr>'+
                  '<tr>'+
                      '<td>Stripe Txn #:</td>'+
                      '<td>' + element[0].id + '</td>'+
                  '</tr>'+
                  '<tr>'+
                      '<td>Taxes and Fees:</td>'+
                      '<td>' + element.attr('data-tax') + '</td>'+
                  '</tr>';
          var level = $("#transactions-column").attr('data-level');
          if (level === "0" || (level !== "0" && element.attr('data-status') === "Refunded")) {
              v ='<tr>'+
                      '<td>Status:</td>'+
                      '<td>' + element.attr('data-status') + '</td>'+
                  '</tr>';
          } else {
              v = '<tr>'+
                      '<td><a class="refund_link" data-stripe-txn-num=' + element[0].id + ' >Refund transaction</a></td>'+
                  '</tr>'
          }
      } else {
          z =     '<tr>'+
                      '<td>Phone #:</td>'+
                      '<td>' + element.attr('data-phone') + '</td>'+
                  '</tr>'
      }

      w = '</table>' + '</div>';
      return (element.attr('data-page') === "transactions") ? x + y + v + w : x + z + w;
  }

