$(document).ready(function () {  
    
    // to prefill signup form
    if (window.location.pathname == "/signup") {
        var page_params = window.location.search.substring(1);
        if (page_params != "") {
            document.getElementById('phone').value = GetURLParameter(page_params, 'num');
            document.getElementById('referrer_number').value = GetURLParameter(page_params, 'referrer_number');
        }
    }

    function GetURLParameter(page_params, sParam) {
        var sPageURL = page_params;
        var sURLVariables = sPageURL.split('&');
        for (var i = 0; i < sURLVariables.length; i++) {
            var sParameterName = sURLVariables[i].split('=');
            if (sParameterName[0] == sParam) return sParameterName[1];
        }
    }

    //


	if ($.fn.parallax){
	   $('#working-section').parallax("50%", 0.1,false);
	}


    // For phone number input field
    var input = $("#phone"),
    output = $("#output");

    input.intlTelInput({
        nationalMode: true,
        defaultCountry: "auto",
        utilsScript: "<%= asset_path 'utils.js' %>" // just for formatting/placeholders etc
    });

    // listen to "keyup", but also "change" to update when the user selects a country
    input.on("keyup change", function() {
        var intlNumber = input.intlTelInput("getNumber");
        if (intlNumber) {
            output.text("International: " + intlNumber);
        } else {
            output.text("Please enter a number below");
        }
    });
    //

    
});