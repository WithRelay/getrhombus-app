$(document).ready(function () {  

    var url = window.location;
    Stripe.setPublishableKey('<%= Rails.application.secrets.stripe["publishable_key"] %>');

    // to prefill signup form
    if (url.pathname == "/a") {
        var page_params = url.search.substring(1);
        if (page_params != "") {
            //document.getElementById('phone').value = GetURLParameter(page_params, 'num');
            //document.getElementById('referrer_number').value = GetURLParameter(page_params, 'referrer_number');
            var merchant = GetURLParameter(page_params, 'merchant');
            if (merchant) {
                var x = $("#signup_logo");
                $("<h2>" + merchant + "</h2>").insertAfter(x);
                x.remove();
            }
        }
    }


    ///// toggle card/login info for user's profile
    $('#next').click(function() {
        $('#user-form').toggleClass('show');
        $('#user-profile-form').toggleClass('show');
    });

    $('#Prev').click(function() {
        $('#user-profile-form').toggleClass('show');
        $('#user-form').toggleClass('show');
    });
    /////


    function GetURLParameter(page_params, sParam) {
        var sPageURL = page_params;
        var sURLVariables = sPageURL.split('&');
        for (var i = 0; i < sURLVariables.length; i++) {
            var sParameterName = sURLVariables[i].split('=');
            if (sParameterName[0] == sParam) return sParameterName[1];
        }
    }

    // /* Sidebar Menu*/!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!REUSE!!!!!!!!!!!reuse
    $('.nav > li > a').click(function(){
        if ($(this).attr('class') != 'active') {
            $('.nav li ul').slideUp();
            $(this).next().slideToggle();
            $('.nav li a').removeClass('active');
            $(this).addClass('active');
        }
    });

    /* Top Stats Show Hide */
    $("#topstats").click(function(){
        $(".topstats").slideToggle(100);
    });


    /* Sidebar Show-Hide On Mobile */
    $(".sidebar-open-button-mobile").click(function(){
        $(".sidebar").toggle(150);
    });


    /* Sidebar Show-Hide */
    $('.sidebar-open-button').on('click', function(){
        if($('.sidebar').hasClass('hidden')){
            $('.sidebar').removeClass('hidden');
            $('.content').css({
                'marginLeft' : 250
            });  
        }else{
            $('.sidebar').addClass('hidden');
            $('.content').css({
                'marginLeft' : 0
            });    
        }
    });
