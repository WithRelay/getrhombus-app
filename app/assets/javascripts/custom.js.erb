  $('#select-images').change(function() { read_file_picker(this); });
  function read_file_picker(input) {
    var files = input.files, new_image_previews = $('#new-image-previews').html("");

    function invalid_actions(msg) {
      input.value = "";
      new_image_previews.html("");
      alert(msg);
    }

    // http://stackoverflow.com/questions/23402187/multiple-files-upload-and-using-file-reader-to-preview
    if (files && files.length > 0) {
      if (($("#image-previews").children().length + files.length) > 2) {
        invalid_actions("you already have 2 images attached");
        return;
      }

      if (files.length > 2) {
        invalid_actions("Please reselect up to 2 files.");
        return;
      }

      for (var i = 0, l = files.length; i < l; i++) {
        var file = files[i];

        if (!file.type.match('image')) {
          invalid_actions("Please reselect only images");
          return;
        }

        // 2 MB max
        if (file.size > 2097152) {
          invalid_actions("Please reselect only images under 2MB");
          return;
        }

        var reader = new FileReader();
        reader.addEventListener("load", function (event) {
          var img = event.target;
          div = "<div class='images'><a href='#' class='deleteImagePreview' title='"+img.filename+"'>Delete Image</a><img class='thumbnail' src='" + img.result + "'" + "title='" + img.filename + "'/>" +
                "<span>" + img.filename + "</span></div>";
          new_image_previews.prepend(div);
        });

        //Read the image
        reader.filename = file.name;
        reader.readAsDataURL(file);
      }
    }
  }

