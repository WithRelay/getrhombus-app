    Line Chart with Area
    ====================================================================== */
    new Chartist.Line('#chartist-line-area', {
      labels: [1, 2, 3, 4, 5, 6, 7, 8],
      series: [
        [5, 9, 7, 8, 5, 3, 5, 4]
      ]
    }, {
      height: '420px',
      low: 0,
      showArea: true
    });

    /* ======================================================================
    Simple Line Chart
    ====================================================================== */
