                '</tr>'+
            '</table>'+
        '</div>';
    }


    var table = $('#mesa').DataTable({ 
        'dom' : 't'
    });


    // Add event listener for opening and closing details
    $('#mesa tbody').on('click', 'td > i.fa-trash', function () {
        var tr = $(this).closest('tr');
        var row = table.row( tr );
        if ( row.child.isShown() ) {
            // This row is already open - close it
            $('div.slider', row.child()).slideUp( function () {
                row.child.hide();
                tr.removeClass('shown');
            } );
        }
        else {
            // Open this row
            //row.child( format(row.data()), 'no-padding' ).show();
            row.child( format(row.data()), 'no-padding' ).show();
            tr.addClass('shown');
 
            $('div.slider', row.child()).slideDown();
        }
    } );


    // refresh page
    $('#refresh').click( function() {
        url.reload(true);
    });


    $('.selectpicker').selectpicker({
        mobile: true,
        width: "inherit"
    });
























	if ($.fn.parallax){
	   $('#working-section').parallax("50%", 0.1,false);
	}


    // For phone number input field
    var telInput = $("#phone"),
        output = $("#output");

    telInput.intlTelInput({
        nationalMode: true,
        defaultCountry: "auto",
        utilsScript: "<%= asset_path 'utils.js' %>" // just for formatting/placeholders etc
    });

    // listen to "keyup", but also "change" to update when the user selects a country
    telInput.on("keyup change", function() {
        var intlNumber = telInput.intlTelInput("getNumber");
        if (intlNumber) {
            output.text("International: " + intlNumber);
        } else {    
            output.text("Please enter a number below");
        }
    });



    $('#signinForm')
        .formValidation({
            // I am validating Bootstrap form
            framework: 'bootstrap',
            live: 'disabled',

            // Feedback icons
            /*icon: {
                valid: 'fa fa-check',
                invalid: 'fa fa-times',
                validating: 'fa fa-refresh'
            },*/

            // List of fields and their validation rules
            fields: {
                email: {
                    verbose: false,
                    row: '.group',
                    validators: {
                        notEmpty: {
                            message: 'The username is required and cannot be empty'
                        },
                        emailAddress: {
                            message: 'The input is not a valid email address'
                        },
                        remote: {
                            type: 'GET',
                            url: 'https://api.mailgun.net/v2/address/validate?callback=?',
                            crossDomain: true,
                            name: 'address',
                            data: {
                                // Registry a Mailgun account and get a free API key
                                // at https://mailgun.com/signup
                                api_key: '<redacted_api_key>'
                            },
                            dataType: 'jsonp',
                            validKey: 'is_valid',
                            message: 'The email is not valid'
                        }
                    }
                },
                password: {
                    row: '.group',
                    validators: {
                        notEmpty: {
                            message: 'The password is required and cannot be empty'
                        }
                    }
                }
            }
        })
        .on('success.validator.fv', function(e, data) {
            if (data.field === 'email' && data.validator === 'remote') {
                var response = data.result;  // response is the result returned by MailGun API
                if (response.did_you_mean) {
                    // Update the message
                    data.element                    // The field element
                        .data('fv.messages')        // The message container
                        .find('[data-fv-validator="remote"][data-fv-for="email"]')
                        .html('Did you mean ' + response.did_you_mean + '?')
                        .show();
                }
            }
        })
        .on('err.validator.fv', function(e, data) {
            if (data.field === 'email' && data.validator === 'remote') {
                // We need to reset the error message
                data.element                // The field element
                    .data('fv.messages')    // The message container
                    .find('[data-fv-validator="remote"][data-fv-for="email"]')
                    .html('The email is not valid')
                    .show();
            }
        });


