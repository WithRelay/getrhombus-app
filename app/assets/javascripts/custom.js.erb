                        '<td>' + element.attr('data-tax') + '</td>'+
                    '</tr>'+
                '</table>'+
            '</div>';
        } else {
            z = '<tr>'+
                        '<td>Phone #:</td>'+
                        '<td>' + element.attr('data-phone') + '</td>'+
                    '</tr>'+
                   '</table>'+
                '</div>';
        }

        return (element.attr('data-page') === "transactions") ? x + y : x + z;
    }

