$(document).ready(function() {

  FormValidation.Validator.password = {
    validate: function(validator, $field, options) {
      var value = $field.val();
      if (value === "") {
        return false;
      }

      if (value.length < 8) {
        return false;
      }

      return true;
    }
  };

  if ($('#account-settings-form').length) {
    $('#account-settings-form').formValidation({
      framework: 'bootstrap',
      excluded: ':disabled',
      live: 'disabled',
      err: {
        container: function($field, validator) {
          if($field.attr("id") == "newPassword" ){
            return '#password';
          }

          if($field.attr("id") == "confirmNewPassword"){
            return '#confirm-password';
          }

          if($field.attr('id') == "phone"){
              return $field.parent().parent().find('.errorPhone').show();
          }

          return $field.parent().find('.errorMessageContainer').show();
        }
      },
      fields: {
        'user[people_attributes][0][full_name]': {
          validators: {
            notEmpty: {
              message: 'Full name is required'
            },
            regexp: {
              regexp: /^(([A-Za-z]+[\-\']?)*([A-Za-z]+)?\s)+([A-Za-z]+[\-\']?)*([A-Za-z]+)?$/,
              message: 'Invalid Full Name'
            }
          }
        },
        'user[phone]': {
          validators: {
            callback: {
              callback: function(value, validator, $field) {
                if (PhoneNumberFormatter.isValid()) {
                  return {
                    valid: true, // or false
                    message: 'Valid number'
                  }
                } else {
                  return {
                    valid: false, // or false
                    message: 'Enter a valid number'
                  }
                }
              }
            }
          }
        },
        'user[email]': {
          verbose: false,
          validators: {
            notEmpty: {
              message: 'Your email is required'
            },
            emailAddress: {
              message: "The email isn't valid"
            },
            remote: {
              type: 'GET',
              url: 'https://api.mailgun.net/v2/address/validate?callback=?',
              crossDomain: true,
              name: 'address',
              data: {
                // Registry a Mailgun account and get a free API key
                // at https://mailgun.com/signup
                api_key: '<redacted_api_key>'
              },
              dataType: 'jsonp',
              validKey: 'is_valid',
              message: "The email isn't valid"
            }
          }
        },
        'user[current_password]': {
          verbose: false,
          validators: {
            notEmpty: {
              message: 'The password is required'
            },
            remote: {
              message: 'This password is not valid.',
              url: '/v1/users/check_password',
              type: 'POST'
            }
          }
        },
        'user[password]': {
          validators: {
            stringLength: {
              min: 8,
              message: 'Your password should be at least 8 characters'
            }
          }
        },
        'user[password_confirmation]': {
          validators: {
            callback: {
              message: 'Password confirmation should be same as password',
              callback: function(value, validator, $field) {
                var password_value = $("[name='user[password]']").val()
                if (password_value != ''){
                  return password_value  == $field.val();
                }
                return true
              }
            }
          }
        }
      }
    })
    .on('success.form.fv', function(e, data) {
      PhoneNumberFormatter.set_phone_number();
    });
  }

  if ($('#businessSetting').length) {
    $('#businessSetting')
    .formValidation({
      framework: 'bootstrap',
      excluded: ':disabled',
      live: 'disabled',
      err: {
        container: function($field, validator) {
          return $field.parent().find('.errorMessageContainer');
        }
      },
      fields: {
        'user[org_name]': {
          validators: {
            notEmpty: {
              message: 'Organization name is required'
            }
          }
        },
        'user[org_type]': {
          validators: {
            notEmpty: {
              message: 'Required'
            }
          }
        },
        'user[org_phone]': {
          validators: {
            notEmpty: {
              message: 'Your password is required'
            }
          }
        },
        'user[address_attributes][country]': {
            validators: {
              notEmpty: {
                message: 'Country is required'
              }
            }
          },
        'user[address_attributes][street_address]': {
          validators: {
            notEmpty: {
              message: 'street address is required'
            }
          }
        },
        'user[address_attributes][city]': {
          validators: {
            notEmpty: {
              message: 'city is required'
            }
          }
        },
        'user[address_attributes][state_province]': {
          validators: {
            notEmpty: {
              message: 'State province is required'
            }
          }
        },
        'user[address_attributes][postal_code]': {
          validators: {
            notEmpty: {
              message: 'Zip code is required'
            }
          },
        'user[url]': {
            validators: {
              uri: {
                message: 'The url is not valid'
              }
            }
          }
        },
        'user[tax_percent]': {
          selector: '#user_tax_percent',
          // Setting verbose to false ensures that the callback validator is only performed
          // Its because validation is not working in a normal flow
          verbose: false,
          validators: {
            notEmpty: {
              message: 'Tax is required'
            },
            numeric: {
              message: 'Not Valid'
            },
            callback: {
              message: 'The sum of percentages must be 100',
              callback: function(value, validator, $field) {
                if ($field.val() >= 100) {
                  validator.updateStatus('percentage[]', 'INVALID', 'callback');
                  return false;
                }
                return true;
              }
            }
          }
        }
      }
    });
  }

  $.ajaxSetup({
    cache: false
  });

  $('#deactivate-account-button').on('click', function(){
    if(!$('#confirm').val().match(/^DEACTIVATE$/)) {
      FlashHandler.setFlashMessage('Type the word "DEACTIVATE"', 'error');
      return false;
    }
  })

})
