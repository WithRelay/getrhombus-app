$(document).ready(function () {
  // validate plan form
    $('#planForm')
      .formValidation({
        framework: 'bootstrap',
        // List of fields and their validation rules
        fields: {
            'plan[name]': {
                validators: {
                  notEmpty: {
                        message: 'Name is required'
                  },
                  remote: {
                      message: 'This Plan name has already been used.',
                      url: '/v1/plans/check_plan_name',
                      type: 'POST'
                  }
                }
            },
            'plan[amount]': {
                validators: {
                    notEmpty: {
                      message: 'Amount  is required'
                    },
                    regexp: {
                      regexp: /^(?:[1-9]\d*|0)?(?:\.\d+)?$/gm,
                      message: 'Amount is not valid'
                   }
                }
              }
            }
        })
      .on('success.validator.fv', function(e, data) {
          data.element // Get the field element
          .closest('.form-group') // Get the field parent
          .removeClass('has-warning')
          .addClass('has-success')
      });

  $('.delete-plan').click(function(evt) {
    var selector = '.' + evt.target.classList[evt.target.classList.length - 1 ];
    debugger
    if (!$(selector).attr('isDestroy')) {
      flashConfirm(selector,'Delete Plan',
       'If you delete this plan, you won\'t be able to add new subscriptions. However, existing subscribers will continue to be charged on a recurring basis until their subscriptions are canceled.',
       'isDestroy'
      );
      return false;
    }
  });

})
