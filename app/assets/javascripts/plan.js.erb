$(document).ready(function() {
  // additional plan code in hashtags_plans_coupons_alerts js file

  var current_plan_name, save_icon_parent, 
      save_icon_grandparent, plan_name_input;

  // validate plan form
  if ($('#planForm').length > 0) {
    $('#planForm').formValidation({
        framework: 'bootstrap',
        live: 'disabled',
        // List of fields and their validation rules
        fields: {
          'plan[name]': {
            validators: {
              notEmpty: {
                message: 'Name is required'
              },
              remote: {
                message: 'This Plan name has already been used.',
                url: '/v1/plans/check_plan_name',
                type: 'POST'
              }
            }
          },
          'plan[amount]': {
            validators: {
              notEmpty: {
                message: 'Amount  is required'
              }
            }
          }
        }
      })
      .on('success.validator.fv', function(e, data) {
        data.element // Get the field element
          .closest('.form-group') // Get the field parent
          .removeClass('has-warning')
          .addClass('has-success')
      })
      .on('success.form.fv', function(e, data) {       
        // only applies to create modal
        if ($("#modalPlan").length > 0) {
          e.preventDefault();
          $('#create-plan').attr("disabled", true).val("Please wait...");
          addPlan(); 
        }      
      });
  }

  $('#plan_name').on("input", function() {
    $('#planForm').formValidation('revalidateField', 'plan[name]');
  });
  
  // create plan using modal through api call
  function addPlan(){
    $.ajax({
        url: "/v1/plans.json",
        beforeSend: function(xhr) {
          xhr.setRequestHeader('X-CSRF-Token', $('meta[name="csrf-token"]').attr('content'))
        },
        type: "POST",
        data: $('#planForm').serialize(),
        dataType: "json"
      })
      .done(function(data, textStatus, jqXHR) {
        FlashHandler.setFlashMessage(data.response, 'notice');
      })
      .fail(function(data, textStatus, errorThrown) {
        FlashHandler.setFlashMessage(JSON.parse(data.responseText).response, 'error');
      })
      .always(function(data, textStatus, response) {
        $('#create-plan').attr("disabled", false).val("Create Plan");
      });
  };

  /**
    We're defining the event on the `body` element, because we know the `body` is not going away.
    Second argument makes sure the callback only fires when the `click` event happens only on elements marked as `data-editable`
  */
  $('body').on('click', '.plan-name-edit-icon', function() {
    var parent = $(this).parent();
    parent.addClass('hide');
    parent = parent.parent(); 
    parent.find(".plan-name-save-span").removeClass('hide');

    var $el = parent.find('.plan-name');
    current_plan_name = $el.text();
    var $input = $('<input class="plan-name" />').val( current_plan_name );
    $el.replaceWith( $input );
    $input.focus();        
  });

  $('body').on('click', '.plan-name-save-icon', function() {
    save_icon_parent = $(this).parent();
    save_icon_grandparent = save_icon_parent.parent();
    plan_name_input = save_icon_grandparent.find('.plan-name');

    if (current_plan_name == plan_name_input.val()) {
      revert_to_text();
    } else {
      this.disabled = true;
      updatePlanName(this);
    }
  });

  function revert_to_text() {
    save_icon_parent.addClass('hide');
    save_icon_grandparent.find(".plan-name-edit-span").removeClass('hide');
    var $span = $('<span class="plan-name" />').text( plan_name_input.val() );
    plan_name_input.replaceWith( $span );
  }

  function updatePlanName(plan_save_icon) {
    $.ajax({
      url: "/v1/plans/" + save_icon_parent.data('plan-id') + ".json",
      beforeSend: function(xhr) { xhr.setRequestHeader('X-CSRF-Token', $('meta[name="csrf-token"]').attr('content')); },
      type: "PATCH",
      data: { plan: { name: plan_name_input.val() }} ,
      dataType: "json"
    })
      .done(function(data, textStatus, jqXHR) {
        FlashHandler.setFlashMessage(data.response, 'notice');
        revert_to_text();
      })
      .fail(function(data, textStatus, errorThrown) {
        FlashHandler.setFlashMessage(JSON.parse(data.responseText).response, 'error');
      })
      .always(function(data, textStatus, response) {
        plan_save_icon.disabled = false;
      });
  };


});

$(document).on('click', '.delete-plan', function(evt) {
  var selector = '.' + evt.target.classList[evt.target.classList.length - 1];
  if (!$(selector).attr('isDestroy')) {
    evt.stopImmediatePropagation();
    FlashHandler.setConfirmationDialog(selector, 'Delete Plan',
      'If you delete this plan, you won\'t be able to add new subscriptions.',
      'isDestroy'
    );
    return false;
  }
});
