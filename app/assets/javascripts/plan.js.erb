$(document).ready(function() {
  // validate plan form
  $('#planForm')
    .formValidation({
      framework: 'bootstrap',
      live: 'disabled',
      // List of fields and their validation rules
      fields: {
        'plan[name]': {
          validators: {
            notEmpty: {
              message: 'Name is required'
            },
            remote: {
              message: 'This Plan name has already been used.',
              url: '/v1/plans/check_plan_name',
              type: 'POST'
            }
          }
        },
        'plan[amount]': {
          validators: {
            notEmpty: {
              message: 'Amount  is required'
            }
          }
        },
        'plan[interval_count]': {
          validators: {
            notEmpty: {
              message: 'Interval count  is required'
            }
          }
        }
      }
    })
    .on('success.validator.fv', function(e, data) {
      data.element // Get the field element
        .closest('.form-group') // Get the field parent
        .removeClass('has-warning')
        .addClass('has-success')
    });

  $('#plan_name').keyup(function(e) {
    $('#planForm').formValidation('revalidateField', 'plan[name]');
  });

  $('#plan_interval').change(function() {
    $('#interval-count').val('');
    $('#planForm').formValidation('resetField', 'plan[interval_count]');
  });

  // dynamic  interval-count
  $('#interval-count').on('input', function() {
    debugger
    if ($('#plan_interval').val() === 'day') {
      this.value = dynamic_interval(this.value, 366);
    } else if ($('#plan_interval').val() === 'week') {
      this.value = dynamic_interval(this.value, 53);
    } else {
      this.value = dynamic_interval(this.value, 13);
    }
  });

  function dynamic_interval(v, max) {
    return (v.match(/^[1-9]\d*$/) && parseInt(v) < max) ? v : v.slice(0, -1);
  }

});

$(document).on('click', '.delete-plan', function(evt) {
  var selector = '.' + evt.target.classList[evt.target.classList.length - 1];
  if (!$(selector).attr('isDestroy')) {
    evt.stopImmediatePropagation();
    flashConfirm(selector, 'Delete Plan',
      'If you delete this plan, you won\'t be able to add new subscriptions.',
      'isDestroy'
    );
    return false;
  }
});
