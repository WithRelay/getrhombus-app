$(document).ready(function () {
  // additional coupon code in hashtags_plans_coupons_alerts js file

  RAILS_DATE_FORMAT = 'DD/MM/YYYY h:mm A'
  var date = new Date();
  var tomorrow = new Date(date.getFullYear(), date.getMonth(), date.getDate()+1);
  var maxDate = new Date(date.getFullYear() + 4, date.getMonth(), date.getDate());
  var redeem_by_input = $('input[name="coupon[redeem_by]"]');
  if (redeem_by_input.length > 0) {
    redeem_by_input.daterangepicker({
      autoUpdateInput: false,
      timePickerIncrement: 1,
      showDropdowns: true,
      singleDatePicker: true,
      minDate: tomorrow,
      maxDate: maxDate,
      todayHighlight: true,
      timePicker: true,
      locale: {
        format: RAILS_DATE_FORMAT,
        cancelLabel: 'Clear'
     },
      weekStart: 0,
      opens: "right",
      drops: 'down'
    })
    .on('apply.daterangepicker', function(ev, picker) {
      $(this).val(picker.startDate.format(RAILS_DATE_FORMAT));
    })
    .on('cancel.daterangepicker', function(ev, picker) {
      $(this).val('');
    });  
  }

  // validate coupon form
  if ($('#coupon-Form').length > 0) {
    $('#couponForm')
      .formValidation({
        framework: 'bootstrap',
        live: 'disabled',
        // List of fields and their validation rules
        fields: {
            'coupon[name]': {
                validators: {
                  notEmpty: {
                        message: 'Coupon name is required'
                  },
                  remote: {
                      message: 'This coupon name has already been used.',
                      url: '/v1/coupons/check_coupon_name',
                      type: 'POST'
                  }
                }
            },
              'coupon[amount_off]': {
                 selector: '#coupon-type-value',
                 validators: {
                      notEmpty: {
                          message: 'Amount off is required'
                      }
                  }
                },
              'coupon[duration_in_months]':{
                  validators: {
                    notEmpty: {
                      message: 'Required when creating a coupon with a repeating duration'
                    }
                  }
              }
          }
        })
      .on('success.validator.fv', function(e, data) {
          data.element // Get the field element
          .closest('.form-group') // Get the field parent
          .removeClass('has-warning')
          .addClass('has-success')
      });

  }
  
  $('#coupon-name').keyup(function(e){
    $('#couponForm').formValidation('revalidateField', 'coupon[name]');
  });

  // if coupon isnt repeating. repeating needs length in months
  $('#coupon_duration').change(function(){
    if (this.value == 'repeating') {
      $('#duration-in-months-div').slideDown(200);
    } else {
      // $('#couponForm').formValidation('resetField', 'coupon[duration_in_months]');
      $('#duration-in-months-div').slideUp(200);
      $('#duration-in-months').val('');
    }
  }).change();

  $('body').on('click', '.coupon-name-edit-icon', function() {
    var parent = $(this).parent();
    parent.addClass('hide');
    parent = parent.parent(); 
    parent.find(".coupon-name-save-span").removeClass('hide');
    var $el = parent.find('.coupon-name');
    current_coupon_name = $el.text();
    var $input = $('<input class="coupon-name editable open text-field w-input" placeholder="coupon name" />').val( current_coupon_name );
    $el.replaceWith( $input );
    $input.focus();
  });

  $('body').on('click', '.coupon-name-save-icon, .cancel-edit-coupon', function(e) {
    debugger
    e.stopImmediatePropagation();
    save_icon_parent = $(this).parent();
    save_icon_grandparent = save_icon_parent.parent();
    coupon_name_input = save_icon_grandparent.find('.coupon-name');
    cancel_edit = 'cancel-edit cancel-edit-coupon save-editable-field';

    if ((current_coupon_name == coupon_name_input.val()) || ($(this).attr('class') === cancel_edit)) {
      coupon_name = current_coupon_name;
      revert_to_text();
    } else {
      this.disabled = true;
      coupon_name = coupon_name_input.val();
      updateCouponName(this);
    }
  });

  function revert_to_text() {
    save_icon_parent.addClass('hide');
    save_icon_grandparent.find(".coupon-name-edit-span").removeClass('hide');
    var $span = $('<span class="editable-field-text settings-row-text coupon-name" />').text( coupon_name );
    coupon_name_input.replaceWith( $span );
  }

  function updateCouponName(coupon_save_icon) {
    $.ajax({
      url: "/v1/coupons/" + save_icon_parent.data('coupon-id') + ".json",
      beforeSend: function(xhr) { xhr.setRequestHeader('X-CSRF-Token', $('meta[name="csrf-token"]').attr('content')); },
      type: "PATCH",
      data: { coupon: { name: coupon_name_input.val() }} ,
      dataType: "json"
    })
      .done(function(data, textStatus, jqXHR) {
        FlashHandler.setFlashMessage(data.response, 'notice');
        revert_to_text();
      })
      .fail(function(data, textStatus, errorThrown) {
        FlashHandler.setFlashMessage(JSON.parse(data.responseText).response, 'error');
      })
      .always(function(data, textStatus, response) {
        coupon_save_icon.disabled = false;
      });
  };

});

$(document).on('click', '.delete-coupon', function(evt) {
  var selector = '.' + evt.target.classList[evt.target.classList.length - 1 ];

  if (!$(selector).attr('isDestroy')) {
    evt.stopImmediatePropagation();
    FlashHandler.setConfirmationDialog(selector,
     'Deleting this coupon will not affect discounts for customers who have already redeemed the coupon, but new redemptions of the coupon won\'t be allowed.',
     'Delete coupon', 'isDestroy'
    );
    return false;
  }
});
