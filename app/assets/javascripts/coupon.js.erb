$(document).ready(function () {
  // additional coupon code in hashtags_plans_coupons_alerts js file

  RAILS_DATE_FORMAT = 'DD/MM/YYYY h:mm A'
  var date = new Date();
  var tomorrow = new Date(date.getFullYear(), date.getMonth(), date.getDate()+1);
  var maxDate = new Date(date.getFullYear() + 4, date.getMonth(), date.getDate());
  var redeem_by_input = $('input[name="coupon[redeem_by]"]');
  if (redeem_by_input.length > 0) {
    redeem_by_input.daterangepicker({
      autoUpdateInput: false,
      timePickerIncrement: 1,
      showDropdowns: true,
      singleDatePicker: true,
      minDate: tomorrow,
      maxDate: maxDate,
      todayHighlight: true,
      timePicker: true,
      locale: {
        format: RAILS_DATE_FORMAT,
        cancelLabel: 'Clear'
     },
      weekStart: 0,
      opens: "right",
      drops: 'down'
    })
    .on('apply.daterangepicker', function(ev, picker) {
      $(this).val(picker.startDate.format(RAILS_DATE_FORMAT));
    })
    .on('cancel.daterangepicker', function(ev, picker) {
      $(this).val('');
    });  
  }

  // validate coupon form
  $('#couponForm')
    .formValidation({
      framework: 'bootstrap',
      live: 'disabled',
      // List of fields and their validation rules
      fields: {
          'coupon[name]': {
              validators: {
                notEmpty: {
                      message: 'Coupon name is required'
                },
                remote: {
                    message: 'This coupon name has already been used.',
                    url: '/v1/coupons/check_coupon_name',
                    type: 'POST'
                }
              }
          },
            'coupon[amount_off]': {
               selector: '#coupon-type-value',
               validators: {
                    notEmpty: {
                        message: 'Amount off is required'
                    }
                }
              },
            'coupon[duration_in_months]':{
                validators: {
                  notEmpty: {
                    message: 'Required when creating a coupon with a repeating duration'
                  }
                }
            }
        }
      })
    .on('success.validator.fv', function(e, data) {
        data.element // Get the field element
        .closest('.form-group') // Get the field parent
        .removeClass('has-warning')
        .addClass('has-success')
    });

  $('#coupon-name').keyup(function(e){
    $('#couponForm').formValidation('revalidateField', 'coupon[name]');
  });

  // if coupon isnt repeating. repeating needs length in months
  $('#coupon_duration').change(function(){
    if (this.value == 'repeating') {
      $('#duration-in-months-div').slideDown(200);
    } else {
      $('#couponForm').formValidation('resetField', 'coupon[duration_in_months]');
      $('#duration-in-months-div').slideUp(200);
      $('#duration-in-months').val('');
    }
  }).change();

});

$(document).on('click', '.delete-coupon', function(evt) {
  var selector = '.' + evt.target.classList[evt.target.classList.length - 1 ];

  if (!$(selector).attr('isDestroy')) {
    evt.stopImmediatePropagation();
    FlashHandler.setConfirmationDialog(selector,'Delete coupon',
     'Deleting this coupon will not affect discounts for customers who have already redeemed the coupon, but new redemptions of the coupon won\'t be allowed.',
     'isDestroy'
    );
    return false;
  }
});
