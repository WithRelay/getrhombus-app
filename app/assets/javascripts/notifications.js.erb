window.Offline.options = {
  interceptRequests: false,
  requests: false,
  checks: { xhr: { url: '/v1/offline_check' } }
};

var delay = 20000;
setTimeout(function retry() {
  //if (Offline.state == "up") Offline.check();
  setTimeout(retry, delay);
}, delay);

$(document).ready(function() {
  // subcribe to notifications channel
  function subscribe_to_notifications() {
    var merchant_data = UserDetails.object();
    // merchant and up only
    if (!jQuery.isEmptyObject( merchant_data )) {
      // Initialize PubNub with SSL
      var pubnub = new PubNub({
        publishKey: merchant_data.pubnub_publish_key,
        subscribeKey: merchant_data.pubnub_subscribe_key,
        ssl: true
      });

      pubnub.addListener({
        message: function(data) {
          process_notification(data.message);
        }
      });

      // Subscribe to merchant channel
      pubnub.subscribe({
        channels: ['notifications_<%= Rails.env %>_' + merchant_data.id.toString()]
      });
    };
  };

  subscribe_to_notifications();
    
  function process_notification(data) {
    if (data.type == 'campaign_sent') {
      FlashHandler.schedule_jobs(data.message);
    } else if (data.type == 'new_payment') {
      FlashHandler.payment_notification(data.profile_pic, data.amount, data.customer_name);
      $('#new-transaction-notification')
    } else if (data.type == 'new_message_sms') {
      FlashHandler.incoming_sms(data.profile_pic, data.customer_name, data.message);
      $('#unread-message-notification')
    } else if (data.type == 'new_message_messenger') {
      FlashHandler.incoming_facebook_message(data.profile_pic, data.customer_name, data.message);
      $('#unread-message-notification')
    };

    if (data.type != "campaign_sent") {
      $(".notification-counter").text(parseInt($(".notification-counter").text().trim()) + 1);
    };
  };

});