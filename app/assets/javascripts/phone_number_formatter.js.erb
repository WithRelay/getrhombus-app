var PhoneNumberFormatter = new function() {

  var input = "";

  this.init = function(selector) {
    input = $(selector)
    input.intlTelInput({
      nationalMode: true,
      initialCountry: 'auto',
      geoIpLookup: function(callback) {
        $.get(UtilFunctions.get_ipinfo_url(), function() {}, "jsonp").always(function(resp) {
          var countryCode = (resp && resp.country) ? resp.country : "";
          callback(countryCode);
        });
      },
      utilsScript: "<%= asset_path 'utils.js' %>" // just for formatting/placeholders etc
    });
  }

  this.isValid = function() {
    // I think it throws an error if it can't determine country code
    try { return input.intlTelInput("isValidNumber"); }
    catch(err) { return false; }
  };

  this.getNumber = function() {
    return input.intlTelInput("getNumber");
  };

  this.set_phone_number = function(with_plus) { 
    var number = PhoneNumberFormatter.getNumber();
    if (with_plus && number) number.replace("+", '');
    if (number) $('#phone_number').val(number); 
  }

}
 

$(document).ready(function () {
  // if presetting field, you must set the value to phone_number field before calling the code below
  PhoneNumberFormatter.init('#phone');
  var number = $('#phone_number').val();
  if (number) $("#phone").intlTelInput("setNumber", number);
});