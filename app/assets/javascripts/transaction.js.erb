$(document).ready(function () {

  if ($('#transaction-customer-id').length > 0) {
    $('#transaction-customer-id')
      .selectize({
        maxItems: 1,
        valueField: 'id',
        searchField: ['email', 'card_name', 'phone_number'],
        plugins: ['remove_button'],
        create: false,
        options: [],
        closeAfterSelect: true,
        render: { 
          item: function(item, escape) { 
            return '<div> <span class="">' + escape(item.email) + " - " + escape(item.card_name) + '</span></div>'; 
          },
          option: function(item, escape) { 
            return '<div> <span class="">' + escape(item.email) + " - " + escape(item.card_name) + '</span></div>'; 
          }
        },
        load: function(query, callback) {
          if (!query.length) return callback();
          $.ajax({
            url: '/v1/merchant_customers/customers',
            type: 'GET',
            dataType: 'json',
            data: {
              query: query
            },
            error: function() {
              FlashHandler.setFlashMessage('Something went wrong...Unable to find your customer', 'error');
              callback();
            },
            success: function(res) {
              callback(res['customers']);
            }
          });
        }
      })
      .on('change', function(e) {
        $('#chargeForm').formValidation('resetField', 'transaction[user_id]');
      })
  }

  if ($('#search-hashtag').length) {
    $('#search-hashtag')
      .selectize({
        maxItems: 1,
        valueField: 'id',
        labelField: 'tag',
        placeholder: 'Select an item',
        searchField: ['name', 'tag'],
        plugins: ['remove_button'],
        create: false,
        options: [],
        closeAfterSelect: true,
        render: { 
          item: function(item, escape) { 
            return '<div> <span class="">' + escape(item.name) + '</span></div>'; 
          } 
        },
        load: function(query, callback) {
          if (!query.length) return callback();
          $.ajax({
            url: '/v1/hashtags.json',
            type: 'GET',
            dataType: 'json',
            data: {
              query: query
            },
            error: function() {
              FlashHandler.setFlashMessage('Something went wrong...Unable to find your item', 'error');
              callback();
            },
            success: function(res) {
              callback(res['hashtags']);
            }
          });
        }
      })
      .on('change', function(e) {
        $('#chargeForm').formValidation('resetField', 'transaction[hashtag_id]');
      })
  }

  if ($('#chargeForm').length) {
    $('#chargeForm')
      .formValidation({
        framework: 'bootstrap',
        excluded: ':disabled',
        live: 'disabled',
        // List of fields and their validation rules
        fields: {
          'transaction[user_id]':{
            validators: {
              notEmpty: {
                message: 'Customer is required'
              },
              callback: {
                message: 'Please select a customer',
                callback: function(value, validator, $field) {
                  var user_id = validator.getFieldElements('transaction[user_id]').val();
                  return (user_id !== '');
                }
              }
            }
          },
          'transaction[amount]' :{
            validators: {
              notEmpty: {
                message: 'Amount is required'
              }
            }
          },
          'transaction[hashtag_id]':{
            validators: {
                notEmpty: {
                  message: 'Please select a item'
                },
                callback: {
                  message: 'Please select a item',
                  callback: function(value, validator, $field) {
                    var hashtag_id = validator.getFieldElements('transaction[hashtag_id]').val();
                    return (hashtag_id !== '');
                  }
                }
              }
            }
          }
      })
      .on('success.form.fv', function(e, data) {
        e.preventDefault();
        $("#charge-customer").attr("disabled", true).val("Please wait...");
        chargeCustomer();
      })
      .on('err.validator.fv', function(e) {
        $('.help-block').hide();
      });
  }

  function chargeCustomer() {
   $.ajax({
      url: "/v1/transactions",
      beforeSend: function(xhr) {
        xhr.setRequestHeader('X-CSRF-Token', $('meta[name="csrf-token"]').attr('content'))
      },
      type: "POST",
      data: $('#chargeForm').serialize(),
      dataType: "json"
    })
    .done(function(data, textStatus, jqXHR) {
      FlashHandler.setFlashMessage(data.response, 'notice');
      // dont reload...insert to top of row
      //location.reload();
    })
    .fail(function(data, textStatus, errorThrown) {
      FlashHandler.setFlashMessage(data.responseJSON.response, 'error');
    })
    .always(function(data, textStatus, response) {
      $('#charge-customer').removeAttr('disabled').val("Charge Customer");
    });
  };

})
