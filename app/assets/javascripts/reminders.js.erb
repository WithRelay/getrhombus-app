$(document).on('ready page:load', function() {

  //Started GET "/users/110/campaigns/undefined" for 127.0.0.1 at 2017-06-19 23:53:55 -0400

  // checked
  // this is for campaigns but in here because it uses APICONTROLLER 
  var url = window.location.pathname.split('/');
  var campaignId = (url[url.length-1] == 'edit') ? ('?id=' + url[url.length-2]) : '';
  $('#campaignForm').formValidation({
    framework: 'bootstrap',
    excluded: ':disabled',
    live: 'disabled',
    err: {
      container: function($field, validator) {
        return $field.parent().find('.messageContainer');
      }
    },
    fields: {
      'campaign[name]': {
        verbose: false,
        validators: {
          notEmpty: {
            message: 'Campaign name is required'
          },
          remote: {
            message: 'Campaign name is already taken.',
            url: '/v1/campaigns/check_campaign_name' + campaignId,
            type: 'POST'
          }
        }
      },
      'campaign[subject]': {
        validators: {
          callback: {
            callback: function (value, validator, $field) {
              if ($('#campaign-channel').val() == 3) {
                if ($('#campaign_subject').val().length > 0) {
                  return {
                    valid: true
                  }
                } else {
                  return {
                    valid: false
                  }
                }
              } else {
                return { valid: true }
              }
            }
          }
        }
      },
      'campaign[list_id]': {
        validators: {
          notEmpty: {
            message: 'This field is required'
          }
        }
      },
      'campaign[text]': {
        validators: {
          notEmpty: {
            message: 'This field is required'
          }
        }
      }
    }
  })
  .on('success.form.fv', function(e, data) {
    if ($( '#sendTestCampaign' ).attr('active')) {
      e.preventDefault();
      var originalURL = this.action;
      // assign url of form
      var originalMethod = $('input[name="_method"]').val();
      if ($('input[name="_method"]').val() == 'patch') {
        $('input[name="_method"]').val('post');
      };
      this.action = window.location.origin + '/v1/campaigns/send_test_email';
      var formData = new FormData(this);
      var apiController = new ApiController(this);
      apiController.sendRequest(formData);
      this.action = originalURL;
      $('input[name="_method"]').val(originalMethod);
      $('#sendTestCampaign').removeAttr('active');
    };
  });
  //

  $('.show_more').on('click', function(){
    $('.show_more').attr('select', false);
    this.setAttribute('select', true);
  });

  var reminder_channel_options;
  // eventually we should check if customer has connected facebook account before rendering this option
  function rebuild_reminder_channels(uid_type) {
    reminder_channel_options = '<option value="0">SMS</option><option value="2">Facebook Messenger</option>';
    
    if (uid_type == 'user') {
      if (UserDetails.object() && UserDetails.object().has_messenger) {
        reminder_channel_options = '<option value="0">SMS</option><option value="2">Facebook Messenger</option>';
      } else {
        reminder_channel_options = '<option value="0">SMS</option>';
      };
    } else if (uid_type == 'phone_number') {
      reminder_channel_options = '<option value="0">SMS</option>';
    } else if (uid_type == 'fb_page') {
      reminder_channel_options = '<option value="2">Facebook Messenger</option>';
    };

    $('#New-Notification-Channel').html(reminder_channel_options);
  };

  $('#edit-reminder').on('click', function() {
  	var selectedElement = CheckedItem.get();

  	if (!selectedElement) {
  		FlashHandler.setFlashMessage('Please select an item', 'error');
  		return false;
  	};

    var form = $('#editReminderForm');
  	var reminder_id = selectedElement.closest('form').find("#reminder_id").val(); 
    var edit_reminder_selectize = form.find('.search-customers-and-contacts')[0].selectize;
    
    edit_reminder_selectize.clear();
    edit_reminder_selectize.addOption(selectedElement.data('recipient'));
    edit_reminder_selectize.addItem(selectedElement.data('recipient').unique_identifier);
    edit_reminder_selectize.disable();                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          

    form.find("#reminder-date-time").val(selectedElement.data('date-time'));
    form.find("#Notification-Message").val(selectedElement.data('text'));
    
    $("#Edit-Notification-Channel option:selected").removeAttr("selected");
    $("#Edit-Notification-Channel option[value='" + selectedElement.data('channel') + "']").attr('selected', true);

		form.find(".emojionearea-editor").text(selectedElement.data('text'));
    form.attr("action", window.location.origin + '/v1/reminders/' + reminder_id);
    $('#editReminderRepeatDays').val(selectedElement.data('repeat-days'));
    $('#edit_reminder_frequency_type_' + selectedElement.data('frequency')).click();

    $("#edit-reminder-modal").lightbox_me({
      centered: true,
      overlayCSS: {
        background: '#ffffff', opacity: .8
      }
    });
  });

  $('.search-customers-and-contacts').selectize({
    maxItems: 1,
    valueField: 'unique_identifier',
    searchField: ['title', 'description'],
    placeholder: 'Find a customer or contact',
    options: [],
    create: false,
    closeAfterSelect: true,
    render: {
      item: function(item, escape) {
        return '<div> <span class="">' + escape(item.title) + " - " + escape(item.description) + '</span></div>';
      },
      option: function(item, escape) {
        return '<div> <span class="">' + escape(item.title) + " - " + escape(item.description) + '</span></div>';
      }
    },
    onItemRemove: function() { rebuild_reminder_channels(); },
    onItemAdd: function(value, $item) { rebuild_reminder_channels(this.options[value].uid_type); },
    load: function(query, callback) {
      if (!query.length) return callback();
      $.ajax({
        url: '/v1/users.json',
        type: 'GET',
        dataType: 'json',
        data: {
          query: query
        },
        error: function() {
          FlashHandler.setFlashMessage('Something went wrong...Unable to find any recipients', 'error');
          callback();
        },
        success: function(res) {
          callback(res['data']);
        }
      });
    }
  });

  $('.editReminderFrequency, .newReminderFrequency').click(function(e) {
    if (this.className.indexOf('editReminderFrequency') > -1) {
      (this.value == '0') ? $('#editReminderRepeatDays').hide() : $('#editReminderRepeatDays').show();
    } else {
      (this.value == '0') ? $('#newReminderRepeatDays').hide() : $('#newReminderRepeatDays').show();  
    };
  });

  $('#delete-reminder').click(function(e) {
    var selectedElement = CheckedItem.get();
    if (!selectedElement) {
      FlashHandler.setFlashMessage('Select a reminder to delete', 'error');
    } else {
      var id = '#reminder-delete-' + selectedElement.data('obj-id');
      FlashHandler.setConfirmationDialog(id, 'Are you sure you want to delete the Reminder?', 'Delete');
    };
    return false;
  });

  $('.notification-message').emojioneArea();

  // checked
  $(window).load(function(){
    $('#form-reminder-div .notification-message').find('.emojionearea-editor').counter({
      count: "down",
      goal: 150,
      target: '#textBoxCounter',
      msg: 'character(s)'
    });
  });

  // checked
  $(window).load(function(){
    $('#edit-reminder-div .notification-message').find('.emojionearea-editor').counter({
      count: "down",
      goal: 150,
      target: '#textBoxCounter1',
      msg: 'character(s)'
    });
  });

  $('.reminderForm').submit(function(e) {
    $(this).formValidation('revalidateField', 'reminder[text]');
    $(this).formValidation('revalidateField', 'reminder[mc_id]');
  });

  $('.reminderForm').formValidation({
    framework: 'bootstrap',
    excluded: ':disabled',
    live: 'disabled',
    err: {
      container: function($field, validator) {
        return $field.parent().find('.messageContainer');
      }
    },
    fields: {
      'reminder[text]': {
        validators: {
          notEmpty: {
            message: 'This field is required'
          }
        }
      },
      'reminder[mc_id]':{
        validators: {
          callback: {
            message: 'Please select a customer',
            callback: function(value, validator, $field) {
              return { valid: $field[0].selectize.isFull() };
            }
          }
        }
      }
    }
  }).on('success.form.fv', function(e, data) {
    e.preventDefault();
    var apiController = new ApiController(this);
    var formData = new FormData(this);
    apiController.sendRequest(formData);
  });

  // checked
  // First argument is the dom object itself and second contains the modal id
  function ApiController(element) {
    // assigning properties to RemoteCall
    this.url = element.action;
    this.method = element.method;
    this.dataType = 'json';
    this.domElementId = '#' + element.id;
    this.formData = $(element).serialize();
  };

  // checked
  ApiController.prototype.sendRequest = function(data = '') {
    // assigning modal class for closing modal after response success
    // The variable has sigil $ because local variable inside ajax call are not accessible.
    // for more details http://stackoverflow.com/questions/14496680/this-object-not-available-in-ajax-callback
    var postData = ((data != '') ? data : this.formData);
    var form_id = this.domElementId;

    if ($(this.domElementId).data('formValidation').isValid()) {
      $.ajax({ 
        method: this.method,
        url: this.url,
        contentType: false,
        processData: false,
        dataType: this.dataType,
        data: postData
      })
      .done(function(data) {
        FlashHandler.setFlashMessage(data.notice, 'notice');
        if (form_id == '#newReminderForm') {
          location.reload();
        } else if (form_id == '#editReminderForm') {
          $('.update-close-modals').click();
          $('#reminder_date_time_' + data.id).text(data.time);
          $('#reminder_frequency_' + data.id).text(data.frequency_text);
          $('#reminder_id_' + data.id).data('text', data.text).attr('data-text', data.text)
                                      .data('date-time', data.date_time).attr('data-date-time', data.date_time)
                                      .data('frequency', data.frequency).attr('data-frequency', data.frequency)
                                      .data('repeat-days', data.repeat_days).attr('data-repeat-days', data.repeat_days);
        };

      })
      .fail(function(data) { 
        FlashHandler.setFlashMessage(data.responseJSON.error, 'error'); 
      });
    };
  }
});
