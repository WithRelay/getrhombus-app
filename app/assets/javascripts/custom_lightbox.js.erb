$(document).on('ready page:load', function() {

  $('.modal-loader').click(function(e){
    var target = $(this).attr('modal-target');
    var modal = target ? $('.' + target) : $(this).parents().find('.modal-body');
    $(modal).lightbox_me({
        centered: true
      });
    e.preventDefault();
  });

  // for closing all modals
  $('.update-close-modals').click(function(e){
    if (e.target.dataset.parent == "new-customer-div") {
      $('.create-customer-form-wrapper').trigger('close');
    } else if (e.target.dataset.parent == "import-customers-div") {
      $('.import-customers-form-wrapper').trigger('close');
    } else {
      $('#' + e.target.dataset.parent).trigger('close');
    }
    e.preventDefault();
  });

});
