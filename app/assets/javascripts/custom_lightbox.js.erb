$(document).on('ready page:load', function() {

  $('.modal-loader').click(function(e){
    debugger
    var modal = $(this).parents().find('.modal-body')
    $(modal).lightbox_me({
        centered: true
        });
    e.preventDefault();
  });

  // for closing all modals
  $('.update-close-modals').click(function(e){
    $('#' + e.target.dataset.parent).trigger('close');
    e.preventDefault();
  });



});
