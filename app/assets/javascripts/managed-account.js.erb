    if ($('#managed-acct-country').val() == "CA") {
      var cur = (this.value == 'US') ? 'USD' : 'CAD';
      $('#routing-number').attr("placeholder", bank_details_formatter[cur].routing_placeholder);
      $('#routing-number-label').text(bank_details_formatter[cur].routing_label);
      cur = $("#bank-currency").val();
      (cur == "USD" && this.value == 'US') ? hide_institution_number() : show_institution_number(cur);
    } else if (['SG', 'HK'].indexOf($('#managed-acct-country').val()) > -1) {
      show_institution_number($("#bank-currency").val());
    } else {
      hide_institution_number();
    }
  });

  $('#managed-acct-country').change(function() {

    var hash = org_country_formatter[this.value];

    if (hash) {

      // Format company details
      // org tax id info
      $('#org-tax-id').attr("placeholder", hash.org_tax_id_placeholder);
      $('#org-tax-id-label').text(hash.org_tax_id_label);

      // org address
      hash = countries[this.value];
      (hash.with_state) ? show_state() : hide_state();
      (hash.without_postal) ? hide_postal() : show_postal();
      (hash.preset_city) ? $('#company-city').val(hash.preset_city).attr('disabled', true) : $('#company-city').attr('disabled', false);
      $('#company-street').attr('placeholder', hash.street_label);
      $('#company-city').attr('placeholder', hash.city_label);
      $('#company-postal-code').attr('placeholder', hash.postcode_label);

      // Format reps and/or owners
      hash = rep_formatter[this.value];
      // owners requirement
      (hash.without_owners) ? hide_owners_info() : show_owners_info();
      $('.rep-pii').attr("placeholder", hash.rep_pii_placeholder);
      $('.rep-pii-label').text(hash.rep_pii_label);
      (hash.without_pii) ? hide_pii() : show_pii();

      // End format company details

      // rep/owners address
      var address_details = ['street', 'city', 'state', 'postal', 'country'];

      // hide all address fields
      if (hash.without_address) {
        $.each(address_details, function( index, value ) {
          $('.person-' + value).val('');
          $('.person-' + value + '-div').hide();
        });
      } else {
        $.each(address_details, function( index, value ) {
          $('.person-' + value + '-div').show();
        });
      }

      // org type
      $('#user_org_type').trigger('change');

      build_currency_details(this.value);
    }
  }).change();

  function build_country_options(hash) {
    var options = '';
    $.each(hash, function(k, v) {
      options += '<option value="' + k + '">' + v.name +'</option>';
    });
    return options;
  }

  function hide_owners_info() {
    $('#add-owner-link, #owners-title').hide();
    $(".nested-fields").slice(1).remove();
  }

  function show_owners_info() {
    $('#add-owner-link, #owners-title').show();
  }

  function hide_state() {
    $('#company-state-div').hide().val('');
    $('#company-state').val('');
  }

  function show_state() {
    $('#company-state-div').show();
  }

  function hide_postal() {
    $('#company-postal-code-div').hide();
    $('#company-postal-code').val('');
  }

  function show_postal() {
    $('#company-postal-code-div').show();
  }

  function hide_pii() {
    $('.rep-pii-div').hide();
    $(".rep-pii").val('');
  }

  function show_pii() {
    $('.rep-pii-div').show();
  }

  function hide_institution_number() {
    $('#institution-number-div').hide();
    $('#institution-number').val('');
  }

  function show_institution_number(cur) {
    var hash = additional_bank_details_formatter[cur];
    $('#institution-number-div').show();
    $('#institution-number-label').text(hash.label);
    $('#institution-number').attr("placeholder", hash.placeholder);
  }

  function find_currency_in_array(val, ary) {
    if (val = '') return ary[0];
    return (ary.indexOf(val) > -1) ? val : ary[0];
  };

  function build_currency_details(country) {
    var cur = currency_supported_in_countries[country];

    // build currency options
    var options = '';
    $.each(cur, function( index, value ) {
      options += '<option value="' + value + '">' + value +'</option>';
    });
    $("#bank-currency-select").html(options);

    // set value of currency options
    if (cur.length == 1) {         // single currency countries
      $("#bank-currency-select").val(cur[0]).trigger('change').hide();
    } else {
      cur = find_currency_in_array( $("#bank-currency").val(), cur );
      $("#bank-currency-select").val(cur).trigger('change').show();
    }
  };

  function build_account_details(cur, country) {
    var hash = bank_details_formatter[cur];

    $('#account-number-label').text(hash.label);

    if (hash.routing_placeholder) {
      $('#routing-number').attr("placeholder", hash.routing_placeholder);
      $('#routing-number-label').text(hash.routing_label);
      $('#routing-number-div').show();
    } else {
      $('#routing-number').val('');
      $('#routing-number-div').hide();
    }

    (hash.with_ddr) ? $('#ddr-div').show() : $('#ddr-div').hide();

    var x = countries_supported_by_currency[country][cur];
    // build currency countries options
    var options = '';
    $.each(x, function( index, value ) {
      options += '<option value="' + value + '">' + bank_countries_list_placeholder[value][0] +'</option>';
    });
    $("#account-country-select").html(options);

    // set value of currency options
    var selected_country = $("#account-country").val();
    if (x.length == 1) $("#account-country-select").val(x[0]).trigger('change').hide();
    else {
      x = find_country_in_array(selected_country, x);
      $("#account-country-select").val(x).trigger('change').show();
    }
  };

  function find_country_in_array(val, ary) {
    if (val = '') return ary[0];
    return (ary.indexOf(val) > -1) ? val : ary[0];
  };

  $('#user-people').on('cocoon:after-insert', function(e, insertedItem) {
    var clone = $('.person-country-select:first');
    var value = clone.val();
    clone = clone.clone();
    insertedItem.find('.person-country-select').replaceWith(clone)
    clone.val(value).trigger('change');
  });

});
