  $('#user-people').on('change', '.person-country-select', function() {
    $(this).prev().val(this.value)
    var hash = countries[this.value];
    var parent = $(this).parent().parent();

    // handle state
    if (hash.with_state) {
      parent.find('.person-state-div').show();
    } else {
      parent.find('.person-state-div').hide();
      parent.find('.person-state').val('');
    }

    // handle postal
    if (hash.without_postal) {
      parent.find('.person-postal-div').hide();
      parent.find('.person-postal').val('');
    } else {
      parent.find('.person-postal-div').show();
    }

    // handle city
    (hash.preset_city) ? parent.find('.person-city').val(hash.preset_city).attr('disabled', true) : parent.find('.person-city').attr('disabled', false);

    // Add placeholders
    parent.find('.person-street').attr('placeholder', hash.street_label);
    parent.find('.person-city').attr('placeholder', hash.city_label);
    parent.find('.person-postal').attr('placeholder', hash.postcode_label);
  });

