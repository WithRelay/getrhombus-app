        options = '<option value="' + country + '">' + bank_countries_list_placeholder[country][0] +'</option>';

    if (this.value == 'Individual') {
      $('#org-tax-id-req').show()
      $('#org-name').val('');
      $('#org-name-div').hide();
      hide_owners_info();
    } else {
      $('#org-tax-id-req').hide();
      $('#org-name-div').show();
      var x = rep_formatter[country];
      if (x.use_rep_countries) options = build_country_options(rep_countries);
      if (!x.without_owners) show_owners_info();
    }

    if (!rep_formatter[country].without_address) $(".person-country-select").html(options).val(country).trigger('change');
