$(document).ready(function () {
  var subscriptionId = 0;

  $('#subscription-select-coupon').selectize({
    maxItems: 1,
    valueField: 'id',
    labelField: 'name',
    searchField: 'name',
    create: false,
    options: [],
    closeAfterSelect: true,
    load: function(query, callback) {
      if (!query.length) return callback();
      $.ajax({
        url: '/v1/coupons.json',
        type: 'GET',
        dataType: 'json',
        data: {
          name: query
        },
        error: function() {
          FlashHandler.setFlashMessage('Something went wrong...Unable to find your coupons', 'error');
          callback();
        },
        success: function(res) {
          callback(res['coupons']);
        }
      });
    }
  });

  $('#subscriptionForm')
    .formValidation({
      framework: 'bootstrap',
      excluded: ':disabled',
      live: 'disabled',
      // List of fields and their validation rules
      fields: {
        'subscription[plan_id]':{
          validators: {
            callback: {
              message: 'Please select a plan',
              callback: function(value, validator, $field) {
                var plans = validator.getFieldElements('subscription[plan_id]').val();
                return (plans !== '');
              }
            }
          }
        },
        'subscription[quantity]' :{
          validators: {
            notEmpty: {
              message: 'Quantity is required'
            },
            integer: {
              message: 'The value is not an integer'
            }
          }
        },
        'subscription[merchant_customer_id]':{
          validators: {
              notEmpty: {
                message: 'Please select a customer'
              }
            }
          }
        },
        "subscription[quantity]": {
          validators: {
            notEmpty: {
              message: 'Please enter a quantity'
            }
          }
        }
    })
    .on('success.form.fv', function(e, data) {          
      e.preventDefault();
      $("#create-subscription").attr("disabled", true).val("Please wait...");
      addSubscription(); 
    });
    
  $("#subscription-plan-id").selectize({
    maxItems: 1,
    valueField: 'id',
    labelField: 'name',
    searchField: 'name',
    create: false,
    options: [],
    closeAfterSelect: true,
    load: function(query, callback) {
      if (!query.length) return callback();
      $.ajax({
        url: '/v1/plans.json',
        type: 'GET',
        dataType: 'json',
        data: {
          name: query
        },
        error: function() {
          FlashHandler.setFlashMessage('Something went wrong...Unable to find your plans', 'error');
          callback();
        },
        success: function(res) {
          callback(res['plans']);
        }
      });
    }
  })
  .on('change', function(e) {
    $('#subscriptionForm').formValidation('resetField', 'subscription[plan_id]');
  });

  // reset form when modal close
  $('#modalSubscription').on('hidden.bs.modal', function () {
   $('#subscriptionForm').data('formValidation').resetForm();
  })

  $('#subscription-customer-id')
    .selectize({
      maxItems: 1,
      valueField: 'id',
      labelField: 'email',
      searchField: 'email',
      plugins: ['remove_button'],
      create: false,
      options: [],
      closeAfterSelect: true,
      load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
          url: '/v1/merchant/customers',
          type: 'GET',
          dataType: 'json',
          data: {
            query: query
          },
          error: function() {
            FlashHandler.setFlashMessage('Something went wrong...Unable to find your customer', 'error');
            callback();
          },
          success: function(res) {
            callback(res['customers']);
          }
        });
      }
    })
    .on('change', function(e) {
      $('#subscriptionForm').formValidation('resetField', 'subscription[merchant_customer_id]');
    })
    
  // create subscription through api with modal
  function addSubscription() {
   $.ajax({
      url: "/v1/subscriptions.json",
      beforeSend: function(xhr) {
        xhr.setRequestHeader('X-CSRF-Token', $('meta[name="csrf-token"]').attr('content'))
      },
      type: "POST",
      data: $('#subscriptionForm').serialize(),
      dataType: "json"
    })
    .done(function(data, textStatus, jqXHR) {
      FlashHandler.setFlashMessage(data.response, 'notice');
    })
    .fail(function(data, textStatus, errorThrown) {
      FlashHandler.setFlashMessage(JSON.parse(data.responseText).response, 'error');
    })
    .always(function(data, textStatus, response) {
      $('#create-subscription').removeAttr('disabled').val("Subscribe Customer");
    });
  };



  $('.auto-height').css('height', 'auto');

  $('.subscription-row').on('click', function(){
    subscriptionId = this.id.split('-')[1];
    appendSubscriptionInfo($(this).find('td'));
    $('#submit-update-plan').removeClass("hidden");
  });

  function appendSubscriptionInfo(subscriptionData){
    $('#plan-div').empty();
    $('#plan-div').append('Customer: ' + subscriptionData[0].innerHTML + '<br>');
    $('#plan-div').append('Status: ' + subscriptionData[1].innerHTML + '<br>');
    $('#plan-div').append('Plan: ' + subscriptionData[2].innerHTML + '<br>');
    $('#plan-div').append('Coupon: ' + subscriptionData[3].innerHTML + '<br>');
    $('#plan-div').append('Quantity: ' + subscriptionData[4].innerHTML + '<br>');
  }

  $('#upgrade-plan-selector').on('click', function(){
    $('#submit-update-plan').val('Upgrade Plan');
    $('#submit-update-plan').attr('class', 'btn btn-success#submit-update-plan');
    $('#update-plan-id').attr('value', '49');
  });

  $('.downgrade-plan-selector').on('click', function(){
    $('#submit-update-plan').val('Downgrade Plan');
    $('#submit-update-plan').attr('class', 'btn btn-danger#submit-update-plan');
    $('#update-plan-id').attr('value', '48');
  });


  $('#submit-update-plan').on('click',function(){
    if (subscriptionId === 0){
      errorMsg = 'Please select subscription from table before upgrade/downgrade Plan'
      FlashHandler.setFlashMessage(errorMsg, 'error');
      return false
    } else {
      action = $('#plan-update-form').attr('action') + '/' + subscriptionId;
      actionName = ($('#submit-update-plan').val() === 'Upgrade Plan') ? 'upgrade_subscription' : 'downgrade_subscription' 
      action = action + '/' + actionName;
      $('#plan-update-form').attr('action', action);
      $('#plan-update-form').attr('href', action);
    }
  });
  

});

$(document).on('click', '#cancel-subscription', function(evt) {
  var selector = '.' + evt.target.classList[evt.target.classList.length - 1];
  if (!$(selector).attr('isCancel')) {
    evt.stopImmediatePropagation();
    FlashHandler.setConfirmationDialog(selector, 'Cancel Subscription',
      'Your subscription is going to be cancelled',
      'isCancel'
    );
    return false;
  }
})
