$(document).ready(function () {

  $('#subscription-select-coupon').selectize({
      maxItems: 1,
      valueField: 'id',
      labelField: 'name',
      searchField: 'name',
      create: false,
      options: [],
      closeAfterSelect: true,
      load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
          url: '/v1/coupons/get_coupon',
          type: 'GET',
          dataType: 'json',
          data: {
            name: query
          },
          error: function() {
             FlashHandler.setFlashMessage('Something went wrong...Unable to find your coupons', 'error');
            callback();
          },
          success: function(res) {
            callback(res['coupons']);
          }
        });
      }
    }).selectize();

  $('#subscriptionForm')
    .formValidation({
      framework: 'bootstrap',
      excluded: ':disabled',
      // List of fields and their validation rules
      fields: {
        'subscription[plan_id]':{
           validators: {
              callback: {
                message: 'Please select one or more Plans',
                callback: function(value, validator, $field) {
                    var plans = validator.getFieldElements('subscription[plan_id]').val();
                    return (plans !== '');
                }
            }
           }
        },
        'subscription[merchant_customer_id]':{
           validators: {
              notEmpty: {
                message: 'Please select a Customer'
            }
           }
        }
      }
    })
    .find('[name="subscription[plan_id]"]')
      .selectize({
      maxItems: 1,
      valueField: 'id',
      labelField: 'name',
      searchField: 'name',
      create: false,
      options: [],
      closeAfterSelect: true,
      load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
          url: '/v1/plans/get_plan',
          type: 'GET',
          dataType: 'json',
          data: {
            name: query
          },
          error: function() {
             FlashHandler.setFlashMessage('Something went wrong...Unable to find your plans', 'error');
            callback();
          },
          success: function(res) {
            callback(res['plans']);
          }
        });
      }
    })
    .on('change', function(e) {
        $('#subscriptionForm').formValidation('resetField', 'subscription[plan_id]');
    })
    .on('submit', function(e) {
        $('#subscriptionForm').formValidation('revalidateField', 'subscription[plan_id]');
    })

  $('[name = "subscription[merchant_customer_id]"]')
      .selectize({
      maxItems: 1,
      valueField: 'id',
      labelField: 'email',
      searchField: 'email',
      plugins: ['remove_button'],
      create: false,
      options: [],
      closeAfterSelect: true,
      load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
          url: '/v1/merchant/customers',
          type: 'GET',
          dataType: 'json',
          data: {
            query: query
          },
          error: function() {
             FlashHandler.setFlashMessage('Something went wrong...Unable to find your customer', 'error');
            callback();
          },
          success: function(res) {
            callback(res['customers']);
          }
        });
      }
    })
    .on('change', function(e) {
        $('#subscriptionForm').formValidation('resetField', 'subscription[merchant_customer_id]');
    })
    .on('submit', function(e) {
        $('#subscriptionForm').formValidation('revalidateField', 'subscription[merchant_customer_id]');
    })

  $('.auto-height').css('height', 'auto');


//Add logic for switching plans/subscriptions
// For Upgrading
$('#upgrade-subscription').on('click', function(){
  $.ajax({
      url: "/v1/subscriptions/upgrading_subscription",
      beforeSend: function(xhr) {
        xhr.setRequestHeader('X-CSRF-Token', $('meta[name="csrf-token"]').attr('content'))
      },
      type: "POST",
      // data: $(upgrade).serialize(),
      // dummy data for testing
      data: {subscription_id: 23, plan_id: 24},
      dataType: "json"
    })
    .done(function(data, textStatus, jqXHR) {
      FlashHandler.setFlashMessage(data.response, 'notice');
    })
    .fail(function(data, textStatus, errorThrown) {
      FlashHandler.setFlashMessage(JSON.parse(data.responseText).response, 'error');
    })
    .always(function(data, textStatus, response) {
      $('#upgrade-subscription').attr("disabled", false);
    });
});

