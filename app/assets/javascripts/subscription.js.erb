$(document).ready(function () {

  $('#subscription-select-coupon').selectize({
      maxItems: 1,
      valueField: 'id',
      labelField: 'name',
      searchField: 'name',
      create: false,
      options: [],
      closeAfterSelect: true,
     load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
            url: '/v1/subscriptions/get_coupon',
            type: 'GET',
            dataType: 'json',
            data: {
                name: query,
                page_limit: 10,
            },
            error: function() {
                callback();
            },
            success: function(res) {
                callback(res['coupons']);
            }
        });
      }
    }).selectize();

  $('#subscriptionForm')
    .formValidation({
      framework: 'bootstrap',
      excluded: ':disabled',
      // List of fields and their validation rules
      fields: {
        'subscription[plan_id]':{
           validators: {
              callback: {
                message: 'Please select one or more Plans',
                callback: function(value, validator, $field) {
                    var plans = validator.getFieldElements('subscription[plan_id]').val();
                    return (plans !== '');
                }
            }
           }
        },
        'subscription[merchant_customer_id]':{
           validators: {
              notEmpty: {
                message: 'Please select one or more Customers'
            }
           }
        }
      }
    })
    .find('[name="subscription[plan_id]"]')
      .selectize({
      valueField: 'id',
      labelField: 'name',
      searchField: 'name',
      create: false,
      options: [],
      closeAfterSelect: true,
     load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
            url: '/v1/subscriptions/get_plan',
            type: 'GET',
            dataType: 'json',
            data: {
                name: query,
                page_limit: 10,
            },
            error: function() {
                callback();
            },
            success: function(res) {
                callback(res['plans']);
            }
        });
      }
    })
    .on('change', function(e) {
        $('#subscriptionForm').formValidation('resetField', 'subscription[plan_id]');
    })
    .on('submit', function(e) {
        $('#subscriptionForm').formValidation('revalidateField', 'subscription[plan_id]');
    })

  $('[name = "subscription[merchant_customer_id]"]')
      .selectize({
      valueField: 'id',
      labelField: 'email',
      searchField: 'email',
      plugins: ['remove_button'],
      create: false,
      options: [],
      closeAfterSelect: true,
     load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
            url: '/v1/merchant_customers/customer_data',
            type: 'GET',
            dataType: 'json',
            data: {
                name: query,
                page_limit: 10,
            },
            error: function() {
                callback();
            },
            success: function(res) {
                callback(res['customers']);
            }
        });
      }
    })
    .on('change', function(e) {
        $('#subscriptionForm').formValidation('resetField', 'subscription[merchant_customer_id]');
    })
    .on('submit', function(e) {
        $('#subscriptionForm').formValidation('revalidateField', 'subscription[merchant_customer_id]');
    })

  $('.auto-height').css('height', 'auto');

});

$(document).on('click', '.cancel-subscription', function(evt) {
  var selector = '.' + evt.target.classList[evt.target.classList.length - 1];
  if (!$(selector).attr('isCancel')) {
    evt.stopImmediatePropagation();
    flashConfirm(selector, 'Cancel Subscription',
      'Your subscription is going to cancelled',
      'isCancel'
    );
    return false;
  }
});
