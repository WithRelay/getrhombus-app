    action = $('#plan-update-form').attr('action');
    actionName = ($(this).val() === 'Upgrade Subscription') ? 'upgrade_subscription' : 'downgrade_subscription' 
    action +='/' + actionName;
    $('#plan-update-form').attr('action', action);
  });
*/

});
