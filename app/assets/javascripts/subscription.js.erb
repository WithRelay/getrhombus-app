$(document).ready(function () {
  var subscriptionId = 0;

  if ($('#subscription-select-coupon').length > 0) {
    $('#subscription-select-coupon').selectize({
      maxItems: 1,
      valueField: 'id',
      labelField: 'name',
      searchField: 'name',
      create: false,
      options: [],
      closeAfterSelect: true,
      load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
          url: '/v1/coupons.json',
          type: 'GET',
          dataType: 'json',
          data: {
            name: query
          },
          error: function() {
            FlashHandler.setFlashMessage('Something went wrong...Unable to find your coupons', 'error');
            callback();
          },
          success: function(res) {
            callback(res['coupons']);
          }
        });
      }
    });
  }

  if ($('#subscriptionForm').length > 0) {
    $('#subscriptionForm')
      .formValidation({
        framework: 'bootstrap',
        excluded: ':disabled',
        live: 'disabled',
        // List of fields and their validation rules
        fields: {
          'subscription[plan_id]':{
            validators: {
              notEmpty: {
                message: 'Plan is required'
              },
              callback: {
                message: 'Please select a plan',
                callback: function(value, validator, $field) {
                  var plans = validator.getFieldElements('subscription[plan_id]').val();
                  return (plans !== '');
                }
              }
            }
          },
          'subscription[quantity]' :{
            validators: {
              notEmpty: {
                message: 'Quantity is required'
              },
              integer: {
                message: 'The value is not an integer'
              }
            }
          },
          'subscription[merchant_customer_id]':{
            validators: {
                notEmpty: {
                  message: 'Please select a customer'
                },
                callback: {
                  message: 'Please select a Customer',
                  callback: function(value, validator, $field) {
                    var cus = validator.getFieldElements('subscription[merchant_customer_id]').val();
                    return (cus !== '');
                  }
                }
              }
            }
          }
      })
      .on('success.form.fv', function(e, data) {
        e.preventDefault();
        $("#create-subscription").attr("disabled", true).val("Please wait...");
        addSubscription();
      })
      .on('err.validator.fv', function(e) {
        $('.help-block').hide();
      });
  }

  if ($('#subscription-plan-id').length > 0) {
    $("#subscription-plan-id").selectize({
      maxItems: 1,
      valueField: 'id',
      labelField: 'name',
      searchField: 'name',
      create: false,
      options: [],
      closeAfterSelect: true,
      load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
          url: '/v1/plans.json',
          type: 'GET',
          dataType: 'json',
          data: {
            name: query
          },
          error: function() {
            FlashHandler.setFlashMessage('Something went wrong...Unable to find your plans', 'error');
            callback();
          },
          success: function(res) {
            callback(res['plans']);
          }
        });
      }
    })
    .on('change', function(e) {
      $('#subscriptionForm').formValidation('resetField', 'subscription[plan_id]');
    });
  }


  if ($('#subscription-customer-id').length > 0) {
    $('#subscription-customer-id')
      .selectize({
        maxItems: 1,
        valueField: 'id',
        labelField: 'email',
        searchField: 'email',
        plugins: ['remove_button'],
        create: false,
        options: [],
        closeAfterSelect: true,
        load: function(query, callback) {
          if (!query.length) return callback();
          $.ajax({
            url: '/v1/merchant/customers',
            type: 'GET',
            dataType: 'json',
            data: {
              query: query
            },
            error: function() {
              FlashHandler.setFlashMessage('Something went wrong...Unable to find your customer', 'error');
              callback();
            },
            success: function(res) {
              callback(res['customers']);
            }
          });
        }
      })
      .on('change', function(e) {
        $('#subscriptionForm').formValidation('resetField', 'subscription[merchant_customer_id]');
      })
  }
  // create subscription through api with modal
  function addSubscription() {
   $.ajax({
      url: "/v1/subscriptions.json",
      beforeSend: function(xhr) {
        xhr.setRequestHeader('X-CSRF-Token', $('meta[name="csrf-token"]').attr('content'))
      },
      type: "POST",
      data: $('#subscriptionForm').serialize(),
      dataType: "json"
    })
    .done(function(data, textStatus, jqXHR) {
      FlashHandler.setFlashMessage(data.response, 'notice');
      $('#subscriptionForm')[0].reset();
      $('#subscriptionForm').data('formValidation').resetForm();
      $('.update-close-modals').click();
    })
    .fail(function(data, textStatus, errorThrown) {
      FlashHandler.setFlashMessage(JSON.parse(data.responseText).response, 'error');
    })
    .always(function(data, textStatus, response) {
      $('#create-subscription').removeAttr('disabled').val("Subscribe Customer");
    });
  };

  // $('.auto-height').css('height', 'auto');

  $('#coupon-update-form')
    .formValidation({
      framework: 'bootstrap',
      live: 'disabled',
      // List of fields and their validation rules
      fields: {
        'subscription[coupon]':{
          validators: {
              notEmpty: {
                message: 'Coupon code required'
              }
            }
          }
        }
    })
    .on('success.form.fv', function(e, data) {
      e.preventDefault();
      subscriptionId = $("#submit-update-coupon").attr('saas_sub_id');
      $("#submit-update-coupon").attr("disabled", true).val("Please wait...");
      updateCoupon();
    })
    .on('err.validator.fv', function(e) {
      $('.help-block').hide();
    });


  function updateCoupon() {
   $.ajax({
      url: "/v1/subscriptions/"+subscriptionId,
      beforeSend: function(xhr) {
        xhr.setRequestHeader('X-CSRF-Token', $('meta[name="csrf-token"]').attr('content'))
      },
      type: "PATCH",
      data: $('#coupon-update-form').serialize(),
      dataType: "json"
    })
    .done(function(data, textStatus, jqXHR) {
      FlashHandler.setFlashMessage(data.response, 'notice');
      location.reload();
    })
    .fail(function(data, textStatus, errorThrown) {
      FlashHandler.setFlashMessage(JSON.parse(data.responseText).response, 'error');
    })
    .always(function(data, textStatus, response) {
      $('#submit-update-coupon').removeAttr('disabled').val("Apply Discount");
    });
  };

