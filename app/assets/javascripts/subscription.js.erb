$('.subscription-checkbox').click(function() {
  if ($(this).is(':checked')) {
    $("#cancel-customer-subscription").removeClass('hide')
    parent_row = $(this).closest('.transactions-table-row')
    customer_name = parent_row.find('.customer-name').text()
    plan_name = parent_row.find('.plan-name').text()
    $('#customer_name').text(customer_name)
    $('#plan_name').text(plan_name)
    subscriptionId = parent_row.attr('id')
  } else {
    $("#cancel-customer-subscription").addClass('hide')
  }
});

$('#cancel-subscription').on('click', function(e){
  e.preventDefault();
  $(this).attr("disabled", true).text("Please wait...");
  $.ajax({
     url: "/v1/subscriptions/"+subscriptionId,
     beforeSend: function(xhr) {
       xhr.setRequestHeader('X-CSRF-Token', $('meta[name="csrf-token"]').attr('content'))
     },
     type: "DELETE",
     dataType: "json"
   })
   .done(function(data, textStatus, jqXHR) {
     FlashHandler.setFlashMessage(data.response, 'notice');
     location.reload();
   })
   .fail(function(data, textStatus, errorThrown) {
     FlashHandler.setFlashMessage(JSON.parse(data.responseText).response, 'error');
   })
   .always(function(data, textStatus, response) {
     $('#cancel-subscription').removeAttr('disabled').text("Yes, unsubscribe customer");
   });
});

// transaction checkbox
$('.transaction-checkbox').click(function() {
  if ($(this).is(':checked')) {
    $("#refund-charge").removeClass('hide')
    parent_row = $(this).closest('.transactions-table-row')
    amount = parent_row.find('.tran-amount').text()
    last4 = parent_row.find('.tran-last-four').text()
    $('#tran-amount').text(amount)
    $('#last_four').text(last4)
  } else {
    $("#refund-charge").addClass('hide')
  }
});

});
