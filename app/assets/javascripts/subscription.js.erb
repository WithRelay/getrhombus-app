$(document).ready(function () {
  $('#subscription-select-coupon').selectize({
      maxItems: 1,
      valueField: 'id',
      labelField: 'name',
      searchField: 'name',
      create: false,
      options: [],
      closeAfterSelect: true,
      load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
          url: '/v1/coupons.json',
          type: 'GET',
          dataType: 'json',
          data: {
            name: query
          },
          error: function() {
             FlashHandler.setFlashMessage('Something went wrong...Unable to find your coupons', 'error');
            callback();
          },
          success: function(res) {
            callback(res['coupons']);
          }
        });
      }
    }).selectize();

  $('#subscriptionForm')
    .formValidation({
      framework: 'bootstrap',
      excluded: ':disabled',
      // List of fields and their validation rules
      fields: {
        'subscription[plan_id]':{
           validators: {
              callback: {
                message: 'Please select one or more Plans',
                callback: function(value, validator, $field) {
                    var plans = validator.getFieldElements('subscription[plan_id]').val();
                    return (plans !== '');
                }
            }
           }
        },
        'subscription[merchant_customer_id]':{
           validators: {
              notEmpty: {
                message: 'Please select a Customer'
            }
           }
        }
      }
    })
    .find('[name="subscription[plan_id]"]')
      .selectize({
      maxItems: 1,
      valueField: 'id',
      labelField: 'name',
      searchField: 'name',
      create: false,
      options: [],
      closeAfterSelect: true,
      load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
          url: '/v1/plans.json',
          type: 'GET',
          dataType: 'json',
          data: {
            name: query
          },
          error: function() {
             FlashHandler.setFlashMessage('Something went wrong...Unable to find your plans', 'error');
            callback();
          },
          success: function(res) {
            callback(res['plans']);
          }
        });
      }
    })
    .on('change', function(e) {
        $('#subscriptionForm').formValidation('resetField', 'subscription[plan_id]');
    })
    .on('submit', function(e) {
        $('#subscriptionForm').formValidation('revalidateField', 'subscription[plan_id]');
    })

  $('[name = "subscription[merchant_customer_id]"]')
      .selectize({
      maxItems: 1,
      valueField: 'id',
      labelField: 'email',
      searchField: 'email',
      plugins: ['remove_button'],
      create: false,
      options: [],
      closeAfterSelect: true,
      load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
          url: '/v1/merchant/customers',
          type: 'GET',
          dataType: 'json',
          data: {
            query: query
          },
          error: function() {
             FlashHandler.setFlashMessage('Something went wrong...Unable to find your customer', 'error');
            callback();
          },
          success: function(res) {
            callback(res['customers']);
          }
        });
      }
    })
    .on('change', function(e) {
        $('#subscriptionForm').formValidation('resetField', 'subscription[merchant_customer_id]');
    })
    .on('submit', function(e) {
        $('#subscriptionForm').formValidation('revalidateField', 'subscription[merchant_customer_id]');
    })

  $('.auto-height').css('height', 'auto');

$('.subscription-row').on('click', function(){
  $id = this.id.split('-')[1];
  appendSubscritionInfo($(this).find('td'))
});

function appendSubscritionInfo(subscriptionData){
  $('.plan-div').empty(); 
  $('.plan-div').append('Customer: ' + subscriptionData[0].innerHTML + '<br>');
  $('.plan-div').append('Status: ' + subscriptionData[1].innerHTML + '<br>');
  $('.plan-div').append('Plan: ' + subscriptionData[2].innerHTML + '<br>');
  $('.plan-div').append('Coupon: ' + subscriptionData[3].innerHTML + '<br>');
  $('.plan-div').append('Quantity: ' + subscriptionData[4].innerHTML + '<br>');
}

$('.upgrade-plan-selector').on('click', function(){
  $('.submit-update-plan').val('Upgrade Plan');
  $('.submit-update-plan').attr('class', 'btn btn-success submit-update-plan');
  $('#subscription_plan_id').attr('value', '30');
});

$('.downgrade-plan-selector').on('click', function(){
  $('.submit-update-plan').val('Downgrade Plan');
  $('.submit-update-plan').attr('class', 'btn btn-danger submit-update-plan');
  $('#subscription_plan_id').attr('value', '31');
});

$('.submit-update-plan').on('click',function(){
  action = $('#plan-update-form').attr('action') + '/' + $id;
  actionName = ($('.submit-update-plan').val() === 'Upgrade Plan') ? 'upgrading_subscription' : 'downgrading_subscription' 
  action = action + '/' + actionName;
  $('#plan-update-form').attr('action', action);
  $('#plan-update-form').attr('href', action)
});

});

$(document).on('click', '.cancel-subscription', function(evt) {
  var selector = '.' + evt.target.classList[evt.target.classList.length - 1];
  if (!$(selector).attr('isCancel')) {
    evt.stopImmediatePropagation();
    FlashHandler.setConfirmationDialog(selector, 'Cancel Subscription',
      'Your subscription is going to cancelled',
      'isCancel'
    );
    return false;
  }
});
