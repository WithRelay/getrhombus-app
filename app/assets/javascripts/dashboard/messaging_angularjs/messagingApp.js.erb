'use strict';

/* App Module */

var messagingApp = angular.module('PubNubAngularMessagingApp', [
  'ngRoute',
  'templates',
  'messagingControllers',
  'messagingFilters',
  "angucomplete-alt",
  "ngFileUpload",
  'smoothScroll',
  'angular-inview',
  'luegg.directives' // Auto scroll module
]);

messagingApp.directive('whenScrolledUp', ['$timeout', 'smoothScroll', function($timeout, smoothScroll) {
  return function(scope, elm, attr) {
    var raw = elm[0];    
    elm.bind('scroll', _.throttle(function() {
      if (raw.scrollTop <= 0) {
        var sh = raw.scrollHeight;
        var first_item = raw.children.item(0).children.item(0);
        scope.$apply(attr.whenScrolledUp).then(function() {
          $timeout(function() {
            var options = {
              duration: 800,
              offset: (raw.scrollHeight - sh),
              containerId: 'messages-box'
            }
            smoothScroll(first_item, options);
          })
        });
      }
    }, 350));
  };
}])

messagingApp.directive('whenScrolledDown', function() {
  return function(scope, elm, attr) {
    var raw = elm[0];        
    elm.bind('scroll', _.throttle(function() {
      if (raw.scrollTop + raw.offsetHeight >= raw.scrollHeight) {
        scope.$apply(attr.whenScrolledDown);
      }
    }, 350));
  };
});

messagingApp.directive("mySrc", function() {
  return {
    link: function(scope, element, attrs) {
      var img, loadImage;
      img = null;

      loadImage = function() {

        element[0].src = "<%= asset_path 'Relay-Image-Placeholder.png' %>";

        img = new Image();
        img.src = attrs.mySrc;

        img.onload = function() {
          element.hide();
          element[0].src = attrs.mySrc;
          element.fadeIn('slow')
        };
      };

      loadImage();
    }
  };
});

