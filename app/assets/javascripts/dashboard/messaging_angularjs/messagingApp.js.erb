'use strict';

/* App Module */

var messagingApp = angular.module('PubNubAngularMessagingApp', [
  'ngRoute',
  'templates',
  'messagingControllers',
  'messagingFilters',
  "ngFileUpload",
  'angular-inview',
  'selectize',
  'luegg.directives' // Auto scroll module
]);

messagingApp.directive('whenScrolledUp', ['$timeout', function($timeout) {
  return function(scope, elm, attr) {
    var raw = elm[0];    
    var debounced = _.debounce(function() {
      console.log('debounced')
      if (raw.scrollTop <= 0) {
        var sh = raw.scrollHeight;
        scope.$apply(attr.whenScrolledUp).then(function() {
          $timeout(function() {
            raw.scrollTop = raw.scrollHeight - sh;
            console.log('fired')
          });
        });
      }
    }, 350);

   elm.bind('scroll', debounced);  
  };
}]);

messagingApp.directive('whenScrolledDown', function() {
  return function(scope, elm, attr) {
    var raw = elm[0];        
    elm.bind('scroll', _.throttle(function() {
      if (hasScrollReachedBottom(raw))
        scope.$apply(attr.whenScrolledDown);
    }, 350));
  };
});

messagingApp.directive("mySrc", function() {
  return {
    link: function(scope, element, attrs) {
      var img, loadImage;
      img = null;

      loadImage = function() {

        element[0].src = "<%= asset_path 'Relay-Image-Placeholder.png' %>";

        img = new Image();
        img.src = attrs.mySrc;

        img.onload = function() {
          element.hide();
          element[0].src = attrs.mySrc;
          element.fadeIn('slow')
        };
      };

      loadImage();
    }
  };
});

var hasScrollReachedBottom = function(element) {
  return element.scrollTop + $(element).innerHeight() >= element.scrollHeight;
};

messagingApp.directive('onFinishRender', function ($timeout) {
  return {
    restrict: 'A',
    link: function (scope, element, attr) {
      var raw = element[0];
      if (scope.$last === true) {
        if (hasScrollReachedBottom(raw.parentElement)) {
          $timeout(function() {
            raw.parentElement.scrollTop = raw.parentElement.scrollHeight;
          });
        }
      }
    }
  }
});

messagingApp.config(['$routeProvider',
  function($routeProvider) {
    $routeProvider.when('/', {
      templateUrl : 'dashboard/messaging_angularjs/templates/index.html',
      controller : 'messagingMainCtrl'
    }).otherwise({
      redirectTo : '/'
    });
  }
]);

messagingApp.factory('conversationService', function($http, $q, Upload){
  var service = {};
  var base_url = window.location.origin + '/v1/conversations';
  var token = { 'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content') };

  service.getConversations = function(page, conversation) {
    var deferred = $q.defer();
    $http.get(base_url + ".json", { params: { select_conversation: conversation, page: page } })
    .success(function(data) {
      console.log('console success in service get conversations'); 
      deferred.resolve(data);
    })
    .error(function(data, status, headers, config) { 
      console.log('console fail in service get conversations'); 
      deferred.reject("there was an error");
    });
    return deferred.promise;
  }

  service.findConversation = function(data){
    var deferred = $q.defer();
    $http.get(base_url + '/find.json', { params: data })
    .success(function(data) {
      console.log('console success in service get conversation'); 
      deferred.resolve(data);
    })
    .error(function(data, status, headers, config) { 
      console.log('console fail in service get conversation'); 
      deferred.reject("there was an error");
    });
    return deferred.promise;
  }

  service.getConversationMessages = function(conversation_id, page){
    var deferred = $q.defer();
    $http.get(base_url + "/" + conversation_id + '.json?page=' + page)
    .success(function(data) { 
      console.log('console success in service get conversation messages');
      deferred.resolve(data);
    })
    .error(function() { 
      console.log('console fail in service get conversation messages');
      deferred.reject("there was an error");
    });
    return deferred.promise;
  };

  service.markMessageAsRead = function(conversation_id, unread_ids) {
    var deferred = $q.defer();
    $http({
      method: 'POST',
      url: base_url + "/" + conversation_id + '/mark_messages_as_read.json?ids=' + unread_ids,
      headers: token,
    })
    .success(function(data) { 
      deferred.resolve(true);
    })
    .error(function() { 
      deferred.reject(false);
    });
    return deferred.promise;
  };

  service.sendConversationMessage = function(conversation_id, text, channel) {
    var deferred = $q.defer();
    $http({
      method: 'POST',
      url: base_url + "/" + conversation_id + '/messages.json',
      headers: token,
      data: { msg: text, channel: channel },
    })
    .success(function(data) { 
      deferred.resolve(data);
    })
    .error(function(data) { 
      deferred.reject(data);
    });
    return deferred.promise;
  };

  service.sendConversationMMS = function(conversation_id, file, text, channel) {
    file.upload = Upload.upload({
      url: base_url + "/" + conversation_id + "/mms.json",
      data: { avatar: file, msg: text, channel: channel },
      headers: token
    });
    return file.upload;
  };

  service.closeConversation = function(conversation_id, data){
    var deferred = $q.defer();
    $http({
      method: 'POST',
      url: base_url + "/" + conversation_id + '/close.json',
      headers: token,
      data: data
    })
    .success(function(data) { 
      deferred.resolve(true);
    })
    .error(function() { 
      deferred.reject(false);
    });
    return deferred.promise;
  }

  return service;
});


