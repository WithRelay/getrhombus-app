      if (file) {
        if (file.type.match('image')) {
          $scope.selected_file = file;
          // show preview
          $('#mms-img-preview').lightbox_me({ centered: true })
        } else 
          console.log('unsupported type');
      } else if (errFiles.length > 0) {
        if(errFiles[0].$errorMessages.maxSize) console.log('file size is too large');
      }
    };
   
