'use strict';

/* Controllers */

var messagingControllers = angular.module('messagingControllers', [
  'pubnub.angular.service'
]);

messagingControllers.controller('messagingMainCtrl', ['$scope', '$http', 'PubNub', 'Upload',
  function($scope, $http, PubNub, Upload) {

    // Messages
    $scope.num_message_history = 200;
    $scope.char_limit = 150;
    $scope.active_user_number = 0;
    $scope.active_user_count = 0;
    $scope.global_unread_count = 0;
    $scope.current_chat_user = false;
    $scope.send_msg_btn = "SEND";

    // Transactions
    $scope.charge_btn = "CHARGE";
    $scope.charge_data = {};
    $scope.charge_data.hashtag_id = null;
    $scope.is_true = true;
    $scope.is_sending = false;
    
    // Get logged in merchant id
    $http.get(window.location.origin + '/json_get_current_user')    
    .success(function(data) {
      var merchant_id = data.id;
      $scope.merchant_short_url = data.short_url;
      
      // Initialize PubNub with SSL
      PubNub.init({
        publish_key: data.pubnub_publish_key,
        subscribe_key: data.pubnub_subscribe_key,
        ssl: true
      });
      
      // Subscribe to merchant channel
      PubNub.ngSubscribe({
        channel: 'messaging_<%= Rails.env %>_' + merchant_id,
        message: function(m){
          var json_response = JSON.parse(m[0]);
          
          $scope.$apply(function() {
            if (json_response.user_number == $scope.active_user_number) {
              $scope.selected_user_messages.push({user_number: json_response.user_number, user_level: json_response.user_level, profile_image: json_response.profile_image, text: json_response.message, ts_day_of_the_week: json_response.ts_day_of_the_week, ts_time: json_response.ts_time, unread: false});
              if (json_response.user_level == 0) {
                $scope.users[json_response.user_number].last_message = json_response.message;
                $scope.users[json_response.user_number].last_message_ts = parseInt(json_response.ts_int);
              }
              $http.get(window.location.origin + '/users/' + merchant_id + '/mark_user_messages_for_merchant_as_read/' + $scope.active_user_number);
            } else {
              if (!$scope.users[json_response.user_number]) {
                $scope.users[json_response.user_number] = {user_number: json_response.user_number, first_name: json_response.first_name, last_name: json_response.last_name, email: json_response.email, profile_image: json_response.profile_image, last_message: json_response.message, last_message_ts: json_response.ts_int, unread_count: 0};
                $scope.active_user_count += 1;
              }
              if (json_response.user_level == 0) {
                $scope.global_unread_count += 1;
                $scope.users[json_response.user_number].unread_count += 1;
                $scope.users[json_response.user_number].last_message = json_response.message;
                $scope.users[json_response.user_number].last_message_ts = parseInt(json_response.ts_int);
              }
            }
          });
        }
      });
      
      // Get latest messages for this merchant
      $http.get(window.location.origin + '/users/' + merchant_id + '/json_get_latest_active_messaging')      
      .success(function(data) {        
        var user_list = {};
        // Build user list and count initial global unread
        angular.forEach(data.users, function(value, key) {
          user_list[value.user_number] = value;
          $scope.active_user_count += 1;
          $scope.global_unread_count += value.unread_count;
        });
        
        $scope.users = user_list;
        
        $scope.getUserMessages = function(user) {
          $http.get(window.location.origin + '/users/' + merchant_id + '/json_get_user_messages_by_merchant/' + user.user_number + '?limit=' + (user.unread_count + $scope.num_message_history))
          .success(function(data) {
            $scope.active_user_number = user.user_number;
            $scope.selected_user = user;
            $scope.selected_user_messages = data.messages;
            $scope.current_chat_user = user;
                       
            // Mark messages as read
            console.log(user.user_number);
            $scope.global_unread_count = (($scope.global_unread_count - $scope.users[user.user_number].unread_count) > 0) ? $scope.global_unread_count - $scope.users[user.user_number].unread_count : 0;
            $scope.users[user.user_number].unread_count = 0;
            $http.get(window.location.origin + '/users/' + merchant_id + '/mark_user_messages_for_merchant_as_read/' + user.user_number);
          });
        };
        
        $scope.sendMessage = function(new_message) {
          $scope.is_sending = true;
          $scope.send_msg_btn = "Sending...";
          // twilio allow 1600 characters
          if ((new_message == undefined) || (new_message.text.trim() == '') || (new_message.text.trim().length > $scope.char_limit)) {
            alert('Maximum ' + $scope.char_limit + ' characters.');            
          } else {
            /*$http.get(window.location.origin + '/users/' + merchant_id + '/send_message_from_merchant/' + $scope.selected_user.user_number + '?message=' + encodeURI(new_message.text.trim()))
            .success(function(data) {
              if (data.success) {
                $scope.selected_user_messages.push({user_number: merchant_id, user_level: data.user_level, 
                                                    profile_image: data.profile_image, text: new_message.text.trim(), 
                                                    ts_day_of_the_week: data.ts_day_of_the_week, ts_time: data.ts_time, 
                                                    unread: false});
                new_message.text = '';
              } else {
                alert('The message could not be sent, please try again.');
              }
            }).
            error(function(data, status, headers, config) {
              alert('The message could not be sent, please try again.');
            });*/
          }
          $scope.is_sending = false;
          $scope.send_msg_btn = "SEND";
        };
     
        // Twilio supports only gif, png and jpeg
        $scope.uploadFiles = function(file, errFiles) {
            $scope.f = file;
            $scope.errFile = errFiles && errFiles[0];
            
            if (file) {
                file.upload = Upload.upload({
                    url: '/send_mms_from_dashboard',
                    data: { file: file },
                    headers: {
                      'Content-Type': file.type,
                      'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                    },
                });

                file.upload.then(function (response) {
                   /*
                    $timeout(function () {
                        file.result = response.data;
                    });
                    */
                    // seeing some errors with timeout???
                    //$scope.users["<redacted_phone_number>"]
                    console.log($scope.users)
                    console.log(response)
                    $scope.selected_user_messages.push({user_number: merchant_id, user_level: data.user_level, 
                                                    profile_image: data.profile_image, text: '', 
                                                    ts_day_of_the_week: data.ts_day_of_the_week, ts_time: data.ts_time, 
                                                    unread: false, image_url: file.$ngfBlobUrl });
                
                }, function (response) {
                    if (response.status > 0)
                        $scope.errorMsg = response.status + ': ' + response.data;
                }, function (evt) {
                    file.progress = Math.min(100, parseInt(100.0 * 
                                             evt.loaded / evt.total));
                });
            }   
        };
      })  
      .error(function(data, status, headers, config) {
        alert('Error while trying to connect to the messaging system.');
      });

    })
    .error(function(data, status, headers, config) {
      alert('Error while trying to connect to the messaging system.');
    });

    
    $scope.displayChargeForm = function() {
      $('#chargeFormBox').lightbox_me({
        centered: true, 
        onLoad: function() { $('#chargeForm').find('input:first').focus(); }
      });
    };

    $scope.customerSelected = function(selected) {
      $scope.customerToCharge = (selected) ? selected.originalObject.phone_number : null;
    };

    $scope.hashtagSelected = function(selected) {
      $scope.charge_data.hashtag_id = (selected) ? selected.originalObject.id : null;
    }; 

     $scope.apiErrorHandler = function(selected) {
      alert('error');
    }; 

    // function to submit the form after all validation has occurred            
    $scope.submitChargeForm = function(isValid) {
      if (isValid) {
        $scope.is_sending = true;
        $scope.charge_btn = "Please wait...";
        $scope.charge_data.phone_number = $scope.customerToCharge;
        $scope.charge_data.tag = document.getElementById('find-hashtag_value').value;
        $scope.charge_data.amount = $scope.amount;
        $scope.charge_data.notes = $scope.notes;
        $scope.charge_data.authorize = $scope.authorize;
        console.log($scope.charge_data);
        
        /*$http.post("/echo/json/", data)
        .success(function(data) {
          if (data.success) {
            charge.amount = '';
          } else {
            alert('The message could not be sent, please try again.');
          }
        })
        .error(function(data, status, headers, config) {
          alert('The message could not be sent, please try again.');
        });*/
      }
      $scope.is_sending = false;
      $scope.charge_btn = "CHARGE";
    };


  }

]);

