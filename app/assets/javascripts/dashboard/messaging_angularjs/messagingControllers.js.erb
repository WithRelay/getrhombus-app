'use strict';

/* Controllers */

var messagingControllers = angular.module('messagingControllers', [
  'pubnub.angular.service',
  'selectize',
]);


messagingControllers.controller('messagingMainCtrl', ['$scope', '$rootScope', '$http', 'Pubnub', 'Upload', '$timeout', '$q',
                                                        'savedReplyService',  'conversationService', 'transactionService', 'userService', 'listService', 'userListService', 'reminderService',
  function($scope, $rootScope, $http, Pubnub, Upload, $timeout, $q, savedReplyService, conversationService, transactionService, userService, listService, userListService, reminderService) {

    // Conversations
    $scope.conversations = {};
    $scope.start_conversation = {};
    $scope.selected_conversation = {};
    $scope.open_conversations_count = 0;
    $scope.selected_conversation_messages = [];
    $scope.status = { loading: false, /* loaded: false */ };

    // Message
    var text_to_send = '';
    $scope.mms = { text: '' };
    $scope.send_mms_btn = "Send";
    $scope.new_message = { channel: false };
    $scope.is_sending = false;
    $scope.mms_btn_disabled = false;
    $scope.retrieving_messages_for_scroll = false;

    $scope.disable_secondary_btns = false;

    // Marked As Done
    $scope.close_conversation_btn = "Mark conversation as done";
    $scope.marked_as_done = { reason: 'account_reactivation', notes: '' };

    // Transactions
    $scope.charge_data = {};
    $scope.charge = { amount: '' };
    $scope.customer_transactions = [];
    $scope.charge_btn = "Charge Customer";

    // Lists
    $scope.merchant_lists = [];
    $scope.add_member_to_list_btn = 'Add member to list';
    $scope.no_list_message = 'See the lists each customer is subscribed to right here. Use lists to send group messages.';
    $scope.lists_dropdown = { list: null };
    $scope.customer_lists = [];

    // Scheduled Messages
    $scope.schedule_notification_btn = "Schedule notification";
    $scope.customer_channel_list = [ { id: "0", title: 'SMS' } <%#, { id: '2', title: 'Facebook Messenger'} %>];
    $scope.scheduled_message = { frequency_type: "1", text: '', repeat_days: '3', channel: $scope.customer_channel_list[0] };

    // Saved Replies
    $scope.saved_replies_list = [];
    $scope.saved_replies = { reply: null };

    // selectize
    var start_conversation_selectize;
    $scope.start_conversation_options = [];
    $scope.hashtag_config_options = [];

    $scope.online = function() {
      // this might need to be throttling since it runs quite a number of times
      Offline.check();
      return Offline.state == "up";
    };

    // need to keep track of when at the end of conversations
    var conversation_page = 1;
    $scope.loadConversations = function(first_call) {
      var deferred = $q.defer();
      
      if ($scope.online()) {
        var select_conversation;
        
        if (first_call) {
          var params = PageParameter.get_params();
          if (params['type'] == 'start_conversation') select_conversation = { uid: params['uid'], uid_type: params['uid_type'] };
        };

        conversationService.getConversations(conversation_page, select_conversation)
        .then(function(data) {
          if (data.count) {
            angular.forEach(data.conversations, function(value, key) {
              $scope.conversations[value.id] = value;
            });

            conversation_page += 1;
            console.log(data.conversations);
            console.log('loaded conversations');
            deferred.resolve();
          } else {
            console.log('you have no conversations');
            deferred.reject();
          }

          $scope.open_conversations_count = data.count;
          if (first_call) {
            $scope.setup_pubnub();          
            $scope.selectConversation(data);
          };
        }, function(data) {
          console.log('unable to retrieve your conversations');
          deferred.reject();
        });
      } else {
        deferred.reject();
      }

      return deferred.promise;
    };

    $scope.focusOnStartConversationField = function() {
      start_conversation_selectize.focus();
    };

    $scope.getSavedReplies = function() {
      if ($scope.online()) {
        savedReplyService.getSavedReplies()
        .then(function(data) {
          $scope.saved_replies_list = data;
          $scope.saved_replies.reply = data[0];
          console.log('saved replies retrieved');
        }, function(data) {
          FlashHandler.setFlashMessage('Unable to get saved replies', 'error');
        });
      }
    };
    $scope.getSavedReplies();

    $scope.getSnapshot = function() {
      if ($scope.online()) {
        userService.getSnapshot({ uid: $scope.selected_conversation.uid, uid_type: $scope.selected_conversation.uid_type })
        .then(function(data) {
          console.log(data)
          $scope.no_social_data = false;
          $scope.snapshot = data;
        }, function(data) {
          console.log(data)
          $scope.no_social_data = true;
        });
      }
    };

    $scope.$watch(function () {
      $scope.filteredConversations = $scope.$eval("conversations | filterConversationList:query | orderObjectBy:'last_message_ts'");
    });

    $scope.selectConversation = function(data) {
      if (data.select_conversation !== undefined) {
        if ($scope.filteredConversations.length) data.select_conversation.last_message_ts = $scope.filteredConversations[0].last_message_ts + 1;
        $scope.conversations[data.select_conversation.id] = data.select_conversation;
        $timeout(function() { $scope.clickFirstConversation(); });
      };
    };

    $scope.startConversation = function(data) {
      if ($scope.online()) {
        if ($scope.findConversationInView(data)) return;

        conversationService.findConversation(data)
        .then(function(conv) {
          // check one more time
          if ($scope.findConversationInView(data)) return; 
          
          // are there conversations already loaded
          if ($scope.filteredConversations.length) conv.last_message_ts = $scope.filteredConversations[0].last_message_ts + 1;
          $scope.conversations[conv.id] = conv;
          console.log('started conversation');
          $timeout(function() { $scope.clickFirstConversation(); });
        }, function() {
          console.log('unable to start conversations');
        });
      }
    };

    $scope.findConversationInView = function(data) {
      // is conversation already in view?
      for (var i = 0, len = $scope.filteredConversations.length; i < len; i++) {
        if (data.uid == $scope.filteredConversations[i].uid && data.uid_type == $scope.filteredConversations[i].uid_type) {
          $scope.conversations[$scope.filteredConversations[i].id].last_message_ts = $scope.filteredConversations[0].last_message_ts + 1;
          console.log('found conversation in view');
          $timeout(function() { $scope.clickFirstConversation(); });
          return true;
        }
      };
    };

    $scope.clickFirstConversation = function() {
      $timeout(function() {
        angular.element('#conversation-list-wrapper').children(':first').triggerHandler('click');
        if (start_conversation_selectize) start_conversation_selectize.clear(true);
      });
    };

    $scope.closeConversation = function(data) {
      if ($scope.is_conversation_selected() && $scope.online()) {
        $scope.disable_secondary_btns = true;
        $scope.close_conversation_btn = "Closing...";
        var hash = { conversation_resolution: { notes: $scope.marked_as_done.notes, resolution: $scope.marked_as_done.reason } };
        conversationService.closeConversation($scope.selected_conversation.id, hash)
        .then(function(data) {
          $scope.selected_conversation_messages = [];
          delete $scope.conversations[$scope.selected_conversation.id];
          $scope.selected_conversation = {};
          $scope.conversation_selected = false;
          $scope.open_conversations_count -= 1;
          $('.update-close-modals').click();
        }, function(data) {
          FlashHandler.setFlashMessage('Unable to close conversation :(','error');
        })
        .finally(function() { 
          $scope.close_conversation_btn = "Mark conversation as done";
          $scope.disable_secondary_btns = false;
        });
      };
    };

    $scope.messageTrackingFunction = function(message) {
      //console.log(message.text);
      //console.log(message.channel + "-" + message.id.toString());
      return message.channel + "-" + message.id.toString();
    };
    $scope.imageTrackingFunction = function(image) { return 'Image-' + image.id.toString(); };

    $scope.messageInView = function(index, in_view) {
      if (in_view && $scope.selected_conversation_messages[index].unread && $scope.online()) {
        // doing this here simply because I don't want to make excessive server calls even if there is a failure
        $scope.selected_conversation_messages[index].unread = false;   
        var conversation_id = $scope.selected_conversation.id;

        conversationService.markMessageAsRead(conversation_id, $scope.selected_conversation_messages[index].conv_ref_id)
        .then(function(re) {
          $scope.conversations[conversation_id].unread_count -= 1;
          console.log('marked as read');
        }, function(re) {
          console.log('marked as read failed');
        });
      };
    };

    $scope.canSendFbMessage = function(from_conversations_list, conversation) {
      BindConversationPlugins.get_emoji_box()[0].emojioneArea.enable();
      $scope.mms_btn_disabled = false;
      $scope.new_message.channel = false;
      if (from_conversations_list && conversation.uid_type == "fb_page") {
        if (!$scope.merchant.has_messenger) {
          FlashHandler.setFlashMessage("You don't have a facebook page connected :(", 'error');
          $scope.mms_btn_disabled = true;
          BindConversationPlugins.get_emoji_box()[0].emojioneArea.disable();
        } else if (!conversation.has_messenger) {
          FlashHandler.setFlashMessage("Contact messaged you from a different facebook page :(", 'error');
          BindConversationPlugins.get_emoji_box()[0].emojioneArea.disable();
          $scope.mms_btn_disabled = true;
        };
      };
    };

    $scope.getConversationMessages = function(conversation, from_conversations_list) {
      $scope.canSendFbMessage();

      var deferred = $q.defer();
      $scope.conversation_selected = true;

      // track if messages are being retrieved because of scrolling
      if (from_conversations_list) $scope.retrieving_messages_for_scroll = false;

      // don't get messages if user clicks again on current conversation
      if (!(from_conversations_list && conversation.id == $scope.selected_conversation.id) && $scope.online()) {

        // a new conversation is selected, reset
        if ($scope.selected_conversation.id != conversation.id) $scope.selected_conversation_messages = [];

        // Pull messages if you click on another conversation, even if the current one is loading
        // Pull messages for the current conversation if it isnt loading
        if (!$scope.status.loading || conversation.id != $scope.selected_conversation.id) {
          $scope.selected_conversation = conversation;
          $scope.status.loading = true;

          var oldest_thread_msg = $scope.selected_conversation_messages[0] ? $scope.selected_conversation_messages[0].conv_ref_id : '';
          conversationService.getConversationMessages(conversation.id, oldest_thread_msg)
          .then(function(data) {
            if (conversation.id == $scope.selected_conversation.id) {
              if (data.messages.length > 0) {
                for (var i = 0, len = data.messages.length; i < len; i++) {
                  $scope.selected_conversation_messages.unshift(data.messages[i]);
                };
                //$scope.status.loaded = ($scope.selected_conversation_messages.length > 0);  // might not need this line
                $scope.status.loading = false;
                if (from_conversations_list && conversation.uid_type == 'user' && conversation.has_messenger) {
                  var message = _.last($scope.selected_conversation_messages);
                  $scope.new_message.channel = (!message || message.channel == 'Message') ? false : true;
                };                
                deferred.resolve();
              } else {
                $scope.rejectPromise(false, 'no messages', deferred);
              }
            } else {
              $scope.rejectPromise(false, 'viewing another conversation', deferred);
            }
          }, function(data) {
            $scope.rejectPromise(false, 'get more messages failed', deferred);
          });
        } else {
          deferred.reject();
        }

        if (from_conversations_list) $scope.performUserActions();
      } else {
        deferred.reject();
      };

      return deferred.promise;
    };

    // get transactions, snapshot and lists
    $scope.performUserActions = function() {
      $scope.getSnapshot();
      $scope.getCustomerLists();
      $scope.getCustomerTransactions();
    };

    $scope.rejectPromise = function(status, msg, obj) {
      $scope.status.loading = status;
      console.log(msg);
      obj.reject();
    };

    $scope.bindEnterToMessagingArea = function() {
      BindConversationPlugins.get_emoji_box()[0].emojioneArea
      .on("keydown", function(btn, e) { if (e.keyCode == 13) e.preventDefault(); })
      .on("keyup", function(btn, e) { if (e.keyCode == 13) { $scope.sendConversationMessage(); } });
    };

    $scope.getSendChannel = function() {
      var channel;
      if ($scope.selected_conversation.uid_type == 'user') {
        channel = $scope.new_message.channel ? 'FbMessage' : 'Message';
      } else {
        channel = $scope.selected_conversation.uid_type == 'fb_page' ? 'FbMessage' : 'Message';
      };
      return channel;
    };

    $scope.sendConversationMessage = function() {
      if ($scope.is_conversation_selected() && !$scope.is_sending && $scope.online()) {
        $scope.is_sending = true;
        text_to_send = BindConversationPlugins.get_emoji_box()[0].emojioneArea.getText().trim();

        if ((text_to_send == '') || (text_to_send.length > $scope.merchant.num_of_chars)) {
          FlashHandler.setFlashMessage('Enter up to ' + $scope.merchant.num_of_chars + ' characters.', 'error');
        } else {
          var conversation_id = $scope.selected_conversation.id;
          conversationService.sendConversationMessage(conversation_id, text_to_send, $scope.getSendChannel())
          .then(function(data) {
            // ensure we still have the right conversation
            if ($scope.selected_conversation.id == conversation_id) {
              $scope.selected_conversation_messages.push(data);
              $scope.conversations[conversation_id].last_message = data.text;
              $scope.conversations[conversation_id].last_message_ts = data.ts;
              $scope.conversations[conversation_id].last_message_type = data.channel;
              $scope.conversations[conversation_id].ago = data.ago;
              BindConversationPlugins.get_emoji_box()[0].emojioneArea.setText('');
            }
            console.log(data)
          }, function(data) {
            console.log('unable to send message');
            console.log(data)
          })
          .finally(function() {
            $scope.is_sending = false;
          });
        };
      };
    };

    $scope.is_conversation_selected = function(msg, show_alert) {
      var state = $scope.conversation_selected;
      if (!state && !show_alert) FlashHandler.setFlashMessage(msg || 'Select a conversation', 'error');
      return state;
    };

    // MMS
    // Twilio supports only gif, png and jpeg
    $scope.handleFile = function(file, errFiles) {
      if (file) {
        if (file.type.match('image')) {
          $('#mms-file-preview-div').lightbox_me({ 
            centered: true,
            overlayCSS: {
              background: 'rgba(99,114,130,0.5)', opacity: .8
            }, 
          });
          return;
        } else {
          FlashHandler.setFlashMessage('Sorry, only image files are supported :(', 'error');
        }
      } else if (errFiles.length) {
        if (errFiles[0].$errorMessages.maxSize) {
          FlashHandler.setFlashMessage('Please select a file under 1MB', 'error');
        }
      };
      $scope.mms.file = '';
    };


    $scope.sendMMS = function() {
      if ($scope.is_conversation_selected() && $scope.online()) {
        $scope.disable_secondary_btns = true;
        $scope['send_mms_btn'] = "Sending...";
        var conversation_id = $scope.selected_conversation.id;

        conversationService.sendConversationMMS(conversation_id, $scope.mms.file, $scope.mms.text, $scope.getSendChannel())
        .then(function (data) {
          if ($scope.selected_conversation.id == conversation_id) {
            $scope.selected_conversation_messages.push(data.data);
            $scope.mms.text = '';
          }
          $('.update-close-modals').click();
        }, function (response) {
          FlashHandler.setFlashMessage('Sorry, unable to send mms :(', 'error');
        })
        .finally(function() {
          $scope.mms.file = '';
          $scope['send_mms_btn'] = "Send";
          $scope.disable_secondary_btns = false;
        });
      }
    };
    // End MMS


    // Modals
    $scope.displayChargeForm = function() {
      $('#charge-a-customer-div').lightbox_me({
        centered: true,
        overlayCSS: {
          background: 'rgba(99,114,130,0.5)', opacity: .8
        },
        onLoad: function() {
          $('#conversation-chargeForm').find('input:first').focus();
          $scope.is_conversation_selected('Please select a conversation with a customer to continue');
        }
      });
    };

    $scope.openSavedRepliesDiv = function() {
      $('#saved-reply-selection-div').lightbox_me({
        centered: true,
        overlayCSS: {
          background: 'rgba(99,114,130,0.5)', opacity: .8
        }
      });
    };

    $scope.markAsDoneDiv = function() {
      $('#mark-as-done-div').lightbox_me({
        centered: true,
        overlayCSS: {
          background: 'rgba(99,114,130,0.5)', opacity: .8
        }
      });
    };

    $scope.addToListDiv = function() {
      $('#add-to-list-div').lightbox_me({
        centered: true,
        overlayCSS: {
          background: 'rgba(99,114,130,0.5)', opacity: .8
        }
      });
    };

    $scope.clickFilePicker = function() { $('#file-picker').click(); };

    $scope.newReminderDiv = function() {
      $('#new-reminder-div').lightbox_me({
        centered: true,
        overlayCSS: {
          background: 'rgba(99,114,130,0.5)', opacity: .8
        }
      });
    };

    $scope.insertTextIntoMessageBox = function(text_to_insert) {
      if (text_to_insert && text_to_insert.trim().length) {
        var text = BindConversationPlugins.get_emoji_box()[0].emojioneArea.getText().trim() + " " + text_to_insert.trim();
        BindConversationPlugins.get_emoji_box()[0].emojioneArea.setText(text);
        $('.update-close-modals').click();
        UtilFunctions.placeCaretAtEnd($('.emojionearea-editor').get(0));
      };
    };    

    // End Modals

    $scope.hashtag_config = {
      valueField: 'id',
      labelField: 'tag',
      searchField: ['name', 'tag'],
      placeholder: 'Select an item...',
      options: [],
      preload: 'focus',
      maxItems: 1,
      render: { item: function(item, escape) { return '<div> <span class="">' + escape(item.name) + '</span></div>'; } },
      onInitialize: function(selectize) {
        //$('#conversation-chargeForm .form-group').addClass('has-error');
      },
      load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
          url: '/v1/hashtags?query=',
          type: 'GET',
          dataType: 'json',
          data: { query: query },
          error: function() {
            FlashHandler.setFlashMessage('Something went wrong...Unable to find your tags', 'error');
            callback();
          },
          success: function(res) {
            callback(res['hashtags']);
          }
        });
      },
      onChange: function(value) {
        var x = this;
        if (x) {
          x = x.options[value];
          if (x) $scope.$apply(function () { $scope.charge.amount = parseFloat(x.amount); });          
          //$('#conversation-chargeForm .form-group').removeClass('has-error');
        } else {
          //$('#conversation-chargeForm .form-group').addClass('has-error');
        }
      }
    };

    $scope.start_conversation_config = {
      valueField: 'unique_identifier',
      searchField: ['title', 'description'],
      placeholder: 'Start conversation...',
      options: [],
      maxItems: 1,
      onInitialize: function (selectize) {
        start_conversation_selectize = selectize;
      },
      render: {
        item: function(item, escape) {
          return '<div> <span class="">' + escape(item.title) + " - " + escape(item.description) + '</span></div>';
        },
        option: function(item, escape) {
          return '<div> <span class="">' + escape(item.title) + " - " + escape(item.description) + '</span></div>';
        }
      },
      load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
          url: '/v1/users',
          type: 'GET',
          dataType: 'json',
          data: { query: query },
          error: function() {
            FlashHandler.setFlashMessage('Something went wrong...Unable to find any recipients', 'error');
            callback();
          },
          success: function(res) {
            callback(res['data']);
          }
        });
      },
      onChange: function(value) {
        // Start new conversation
        if (value) {
          var obj = start_conversation_selectize.options[value];
          $scope.startConversation({ uid: obj.uid, uid_type: obj.uid_type });
        }
      }
    };

    // Transactions
    $scope.disableChargeButton = function(chargeForm) {
      return !$scope.is_conversation_selected('', true) || $scope.selected_conversation.uid_type != 'user' || chargeForm.$invalid || $scope.disable_secondary_btns;
    };

    // function to submit the form after all validation has occurred
    $scope.submitChargeForm = function(isValid) {
      if (isValid && $scope.online()) {
        $scope.disable_secondary_btns = true;
        $scope.charge_btn = "Please wait...";
        $scope.charge_data.customer_id = $scope.selected_conversation.uid;
        $scope.charge_data.hashtag_id = $scope.charge.hashtag_id;
        //*
        $scope.charge_data.amount = $scope.charge.amount;
        $scope.charge_data.notes = ($scope.charge.notes) ? $scope.charge.notes : '';
        $scope.charge_data.capture = !$scope.charge.authorize;

        transactionService.createCharge($scope.charge_data)
        .then(function (data) {
          $('.update-close-modals').click();
          FlashHandler.setFlashMessage(data.response, 'notice');
          $scope.customer_transactions.unshift(data.transaction);
        }, function (data) {
          console.log(data);
          FlashHandler.setFlashMessage(data.response, 'error');
        })
        .finally(function() {
          $scope.disable_secondary_btns = false;
          $scope.charge_btn = "Charge Customer";
        });
        //*/
      }
    };

    $scope.getCustomerTransactions = function() {
      if ($scope.selected_conversation.uid_type == 'user' && $scope.online()) {
        transactionService.getTransactions($scope.selected_conversation.uid)
        .then(function (data) {
          console.log('transactions retrieved');
          console.log(data)
          $scope.customer_transactions = data;
        }, function (response) {
          console.log('unable to retrieve transactions');
          $scope.customer_transactions = [];
          console.log(response);
        });
      } else {
        $scope.customer_transactions = [];
      }
      console.log($scope.selected_conversation)
    };
    // End Transactions


    // Lists
    $scope.getMerchantLists = function() {
      if ($scope.online()) {
        listService.getLists({ query: '', list_mode: 'list' })
        .then(function (data) {
          console.log('merchant lists retrieved');
          console.log(data);
          $scope.merchant_lists = data['lists'];
          if (!data['lists'].length) $scope.no_list_message = 'See the lists each customer is subscribed to right here. Use lists to send group messages.';
        }, function (response) {
          $scope.no_list_message = 'Unable to retrieve your lists :(';
          $scope.merchant_lists = [];
        });
      }
    };

    $scope.AddUserToList = function() {
      if ($scope.is_conversation_selected() && $scope.online()) {
        if (!$scope.lists_dropdown.list) {
          FlashHandler.setFlashMessage('Select a list', 'error');
        } else {
          $scope.disable_secondary_btns = true;
          $scope.add_member_to_list_btn = 'Adding...';
          var list = $scope.lists_dropdown.list;
          var hash = { user_list: { list_id: list.id, customer_contact_id: $scope.selected_conversation.mc_id, customer_contact_type: $scope.selected_conversation.mc_type } };

          userListService.addUserToList(hash)
          .then(function(data) {
            $scope.customer_lists.push({ id: list.id, name: list.name, user_added: data.user_added });
            FlashHandler.setFlashMessage(data.message, 'notice');
            $('.update-close-modals').click();
          }, function(data) {
            FlashHandler.setFlashMessage(data.message, 'error');
          })
          .finally(function() { 
            $scope.add_member_to_list_btn = 'Add member to list';
            $scope.disable_secondary_btns = false;
          });
        };
      };
    };

    $scope.getCustomerLists = function() {
      if ($scope.is_conversation_selected() && $scope.online()) {
        var hash = { customer_contact_id: $scope.selected_conversation.mc_id, customer_contact_type: $scope.selected_conversation.mc_type };
        userListService.getCustomerLists(hash)
        .then(function(data) {
          console.log(data);
          console.log('got customer lists');
          $scope.customer_lists = data;
        }, function(data) {
          $scope.customer_lists = [];
          FlashHandler.setFlashMessage('Unable to retrieve lists for conversation', 'error');
        });
      };
    };

    $scope.filterMerchantLists = function(list) {
      // user should not already be in the list
      if (_.find($scope.customer_lists, { id: list.id })) return false;
      
      if (list.list_type == 'customer' && $scope.selected_conversation.uid_type == 'user') {
        return true;
      } else if (list.list_type == 'contact') {
        if ($scope.selected_conversation.uid_type == 'phone_number' && list.channel == 'sms') {
          return true;  
        } else if ($scope.selected_conversation.uid_type == 'fb_page' && list.list_type == 'messenger') {
          return true;
        }
      };
      return false;
    };
    // End lists


    // reminders
    $scope.createReminder = function() {
      if ($scope.is_conversation_selected() && $scope.online()) {
        if ($scope.scheduled_message.text == "") {
          FlashHandler.setFlashMessage('Please enter a message', 'error');
        } else {
          $scope.disable_secondary_btns = true;
          $scope.schedule_notification_btn = "Scheduling...";
          var hash = angular.copy($scope.scheduled_message);
          hash.channel = hash.channel.id;
          hash.mc_id = $scope.selected_conversation.mc_id + "-" + $scope.selected_conversation.mc_type;
          console.log(hash)
          //*
          reminderService.createReminder({ reminder: hash })
          .then(function(data) {
            console.log(data)
            FlashHandler.setFlashMessage('Reminder created', 'notice');
            $('.update-close-modals').click();
          }, function(data) {
            console.log(data)
            FlashHandler.setFlashMessage(data.error, 'error');
          })
          .finally(function() { 
            $scope.schedule_notification_btn = "Schedule notification";
            $scope.disable_secondary_btns = false;
          });
          //*/
        };
      }
    };

    $scope.filterReminderChannelDropdown = function(channel) {
      if (channel.id == '0' && ($scope.selected_conversation.uid_type == 'user' || $scope.selected_conversation.uid_type == 'phone_number')) {
        return true;
      } else if (channel.id == '2' && $scope.selected_conversation.has_messenger 
                                   && ($scope.selected_conversation.uid_type == 'fb_page' || $scope.selected_conversation.uid_type == 'user')) {
        return true;
      };
      return false;
    };
    // End reminders

    $scope.getProfileLink = function() {
      var type = ($scope.selected_conversation.uid_type == 'user') ? '/customers/' : '/contacts/';
      return '/users/' + $scope.merchant.id + type + ($scope.selected_conversation.mc_id || '');
    };

    $scope.subscribe_merchant = function() {
      Pubnub.subscribe({
        channels: [$scope.merchant.message_channel],
        triggerEvents: ['message'],
      });
    };

    $scope.setup_pubnub = function() {
      $rootScope.$on(Pubnub.getMessageEventNameFor($scope.merchant.message_channel), function (ngEvent, envelope) {
        $scope.$apply(function () {
          //console.log(envelope)
          var re = envelope.message;
          if (re.type == 'new-message') {
            $scope.conversations[re.conversation.id] = re.conversation;
            if (!$scope.conversations[re.conversation.id]) $scope.open_conversations_count += 1;            
            if (re.conversation.id == $scope.selected_conversation.id) $scope.selected_conversation_messages.push(re.message);
          } else if (re.type == 'update-conv-properties') {
            if ($scope.conversations[re.id]) {
              $scope.conversations[re.id].full_name = re.full_name;
              $scope.conversations[re.id].profile_image = re.profile_image;
              $scope.conversations[re.id].uid = re.selectize.uid;
              $scope.conversations[re.id].uid_type = re.selectize.uid_type;

              // update customer/contact option in selectize list
              start_conversation_selectize.updateOption(re.old_selectize_val, re.selectize);
              if (re.id == selected_conversation.id) $scope.performUserActions();
            };
          };
        });
      });
      $scope.subscribe_merchant();
    };

    // Get logged in merchant id
    $scope.merchant = $('#user-details').data('user-info');
    if (Object.keys($scope.merchant).length) {
      // Initialize PubNub with SSL
      Pubnub.init({
        publishKey: $scope.merchant.pubnub_publish_key,
        subscribeKey: $scope.merchant.pubnub_subscribe_key,
        ssl: true
      });

      // get initial conversations
      $scope.loadConversations(true);
      $scope.getMerchantLists();
    };

  }

]);
