    $scope.AddUserToList = function() {
      if ($scope.is_conversation_selected() && $scope.online()) {
        if (!$scope.lists_dropdown.list) {
          alert('select a list');
        } else {    
          /*
          var hash = { list_id: $scope.lists_dropdown.list.id, 
                        uid_type: $scope.selected_conversation.uid_type,
                        uid: $scope.selected_conversation.uid
                      };
          listService.addUserToList(hash)
