        centered: true,
      });
    };

    $scope.markAsDoneDiv = function() {
      $('#mark-as-done-div').lightbox_me({
        centered: true,
      });
    };

    $scope.addToListDiv = function() {
      $('#add-to-list-div').lightbox_me({
        centered: true
      });
    };

    $scope.clickFilePicker = function() { $('#file-picker').click(); };
    
    $scope.newReminderDiv = function() {
      $('#new-reminder-div').lightbox_me({
        centered: true,
      });
    };

    $scope.insertTextIntoMessageBox = function(text_to_insert) {
      if (text_to_insert && text_to_insert.trim().length) {
        var box = BindConversationPlugins.get_emoji_box()[0], text = box.emojioneArea.getText();
        text += " " + text_to_insert.trim();
        box.emojioneArea.setText(text);
        $scope.new_message.text = text;
      }
    };

    // End Modals
    
    $scope.disableChargeButton = function(chargeForm) {
      //return !$scope.is_conversation_selected('', true) ||
      return  chargeForm.$invalid || $scope.is_sending;
    };

    $scope.hashtag_config = {
      valueField: 'id',
      labelField: 'tag',
      searchField: ['name', 'tag'],
      placeholder: 'Select an item',
      options: [],
      preload: 'focus',
      required: true,
      maxItems: 1,
      render: { item: function(item, escape) { return '<div> <span class="">' + escape(item.name) + '</span></div>'; } },
      onInitialize: function(selectize){
        $('#conversation-chargeForm .form-group').addClass('has-error');
      },
      load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
          url: '/v1/hashtags?query=',
          type: 'GET',
          dataType: 'json',
          data: { query: query },
          error: function() {
            FlashHandler.setFlashMessage('Something went wrong...Unable to find your tags', 'error');
            callback();
          },
          success: function(res) {
            callback(res['hashtags']);
          }
        });
      },
      onChange: function(value) {
        if (value)
          $('#conversation-chargeForm .form-group').removeClass('has-error');
        else
          $('#conversation-chargeForm .form-group').addClass('has-error');
      }
    };

    $scope.start_conversation_config = {
      valueField: 'unique_identifier',
      searchField: ['title', 'description'],
      placeholder: 'Start conversation',
      options: [],
      maxItems: 1,
      onInitialize: function (selectize) {
        start_conversation_selectize = selectize;
      },
      render: { 
        item: function(item, escape) { 
          return '<div> <span class="">' + escape(item.title) + " - " + escape(item.description) + '</span></div>'; 
        },
        option: function(item, escape) { 
          return '<div> <span class="">' + escape(item.title) + " - " + escape(item.description) + '</span></div>'; 
        } 
      },
      load: function(query, callback) {
        if (!query.length) return callback();
        $.ajax({
          url: '/v1/users?query=',
          type: 'GET',
          dataType: 'json',
          data: { query: query },
          error: function() {
            FlashHandler.setFlashMessage('Something went wrong...Unable to find any recipients', 'error');
            callback();
          },
          success: function(res) {
            callback(res['data']);
          }
        });
      },
      onChange: function(value) {
        // Start new conversation
        if (value) {
          value = value.split('-');
          $scope.startConversation({ uid: value[0], uid_type: value[1] });
        }
      }
    };

    // function to submit the form after all validation has occurred
    $scope.submitChargeForm = function(isValid) {
      if (isValid && $scope.online()) {
        //$scope.is_sending = true;
        $scope.charge_btn = "Please wait...";
        $scope.charge_data.user_id = $scope.selected_conversation.uid;
        $scope.charge_data.hashtag_id = $scope.charge.hashtag_id;
        /*$scope.charge_data.amount = $scope.charge.amount;
        $scope.charge_data.notes = ($scope.charge.notes) ? $scope.charge.notes : '';
        $scope.charge_data.capture = ($scope.charge.authorize) ? $scope.charge.authorize : false;

        transactionService.createCharge($scope.charge_data)
        .then(function (data) {
          console.log('charge complete');
          console.log(data)
        }, function (response) {
          console.log(response);
          FlashHandler.setFlashMessage(response.error, 'error');
        })
        .finally(function() {
          $scope.is_sending = false;
          $scope.charge_btn = "Charge Customer";
        });*/
      }
    };

    $scope.getCustomerTransactions = function() {
      if ($scope.selected_conversation.uid_type == 'user' && $scope.online()) {
        transactionService.getTransactions($scope.selected_conversation.uid)
        .then(function (data) {
          console.log('transactions retrieved');
          console.log(data)
          $scope.customer_transactions = data;
        }, function (response) {
          console.log('unable to retrieve transactions');
          $scope.customer_transactions = [];
          console.log(response);
        });
      } else {
        $scope.customer_transactions = [];
      }
      console.log($scope.selected_conversation)
    };    
