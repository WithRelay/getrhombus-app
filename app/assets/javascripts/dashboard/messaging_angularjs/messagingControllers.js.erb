'use strict';

/* Controllers */

var messagingControllers = angular.module('messagingControllers', [
  'pubnub.angular.service',
  'selectize',
]);


messagingControllers.controller('messagingMainCtrl', ['$scope', '$http', 'Pubnub', 'Upload', '$timeout', '$q',
                                                        'savedReplyService',  'conversationService', 'transactionService', 'userService', 'listService', 'reminderService',
  function($scope, $http, Pubnub, Upload, $timeout, $q, savedReplyService, conversationService, transactionService, userService, listService, reminderService) {

    // Conversations
    $scope.conversations = {};
    $scope.start_conversation = {};
    $scope.selected_conversation = {};
    $scope.open_conversations_count = 0;
    $scope.selected_conversation_messages = [];
    var messages_page = 1;
    $scope.status = { loading: false, /* loaded: false */ };

    // Message
    $scope.new_message = {}; 
    $scope.new_message.text = "";

    // Marked As Done
    $scope.marked_as_done = { reason: 'account_reactivation', notes: '' }; 

    // ajax
    $scope.is_sending = false;

    // buttons
    $scope.send_msg_btn = "Reply";
    $scope.send_msg_fb_btn = "Send via Facebook";
    $scope.send_mms_btn = "Send";
    $scope.send_mms_fb_btn = "Send via Facebook";
    $scope.charge_btn = "Charge Customer";

    // Transactions
    $scope.charge_data = {};
    $scope.customer_transactions = [];

    // Lists
    $scope.merchant_lists = [];
    $scope.no_list_message = 'See the lists each customer is subscribed to right here. Use lists to send group messages.';
    $scope.lists_dropdown = { list: null }; 
    $scope.lists_for_customer = [];

    // Scheduled Messages    
    $scope.customer_channel_list = [ { title: 'SMS', id:"0" } ];
    $scope.scheduled_message = { frequency_type: "0", text: '', repeat_days: '3', 
                                 channel: $scope.customer_channel_list[0] };    
    
    // Saved Replies
    $scope.saved_replies_list = [];
    $scope.saved_replies = { reply: null };

    // selectize
    var start_conversation_selectize;
    $scope.start_conversation_options = [];
    $scope.hashtag_config_options = [];

    $scope.online = function() {
      //Offline.check();
      //Offline.state == "up"
      return true;
    };

    // Get logged in merchant id
    $http.get(window.location.origin + '/get_current_user').success(function(data) {

      console.log(data)
      $scope.merchant = data;

      // Initialize PubNub with SSL
      Pubnub.init({
        publish_key: data.pubnub_publish_key,
        subscribe_key: data.pubnub_subscribe_key,
        ssl: true/*,
        error: function (error) {
          console.log('Error:', error);
        }*/
      });

      // Subscribe to merchant channel
      Pubnub.subscribe({
        channel: 'messaging_<%= Rails.env %>_' + $scope.merchant.id,
        message: function(m) {
          var re = JSON.parse(m);
          $scope.$apply(function() {
            if (re.type == 'new-message') {
              if (!$scope.conversations[re.conversation.id]) {
                // add conversation object and update count
                $scope.conversations[re.conversation.id] = re.conversation;
                $scope.open_conversations_count += 1;
                //$scope.global_unread_count += re.conversation.unread_count;
              } else {
                $scope.conversations[re.conversation.id].last_message = re.conversation.last_message
                $scope.conversations[re.conversation.id].last_message_ts = re.conversation.last_message_ts
                $scope.conversations[re.conversation.id].ago = re.conversation.ago

                console.log($scope.conversations[re.conversation.id].last_message)
                console.log(re.conversation.last_message)

                if (re.message.source == 'customer') {
                  //$scope.global_unread_count += 1;
                  $scope.conversations[re.conversation.id].unread_count += 1;
                }
              };

              if (re.conversation.id == $scope.selected_conversation.id) {
                $scope.selected_conversation_messages.push(re.message);
                //$scope.markMessagesAsRead(conversation.id, re.message.id);
              };
            } else if (re.type == 'update-conv-properties') {
              if ($scope.conversations[re.id]) {
                $scope.conversations[re.id].full_name = re.full_name;
                $scope.conversations[re.id].profile_image = re.profile_image;
                $scope.conversations[re.id].uid = re.selectize.uid;
                $scope.conversations[re.id].uid_type = re.selectize.uid_type;

                // update customer/contact option in selectize list
                start_conversation_selectize.updateOption(re.old_selectize_val, re.selectize);
                if (re.id == selected_conversation.id) $scope.performUserActions();
              };
            };
          });
        }
      });

      // need to keep track of when at the end of conversations
      var conversation_page = 1;
      $scope.loadConversations = function() {
        if ($scope.online()) {
          var params = PageParameter.get_params(), select_conversation = {};
          if (params['type'] == 'start_conversation')
            select_conversation = { uid: params['uid'], uid_type: params['uid_type'] };

          conversationService.getConversations(conversation_page, select_conversation)
          .then(function(data) {
            if (data.count) {
              // Build conversation list and count initial global unread
              angular.forEach(data.conversations, function(value, key) {
                $scope.conversations[value.id] = value;
                //$scope.global_unread_count += value.unread_count;
              });

              conversation_page += 1;
              console.log('loaded conversations')
            } else {
              console.log('you have no conversations');
            }

            $scope.open_conversations_count = data.count;
            $scope.selectConversation(data);
          }, function(data) {
            console.log('unable to retrieve your conversations')
          });
        }
      };

      // get initial conversations
      $scope.loadConversations();
      $scope.getMerchantLists();
    })
    .error(function(data, status, headers, config) { 
      alert('Error while trying to connect to the messaging system.'); 
    });

    $scope.focusOnStartConversationField = function() {
      start_conversation_selectize.focus();
    };

    $scope.getSavedReplies = function() {
      if ($scope.online()) {
        savedReplyService.getSavedReplies()
        .then(function(data) {
          $scope.saved_replies_list = data;
          $scope.saved_replies.reply = data[0];
          console.log('saved replies retrieved');
        }, function(data) {
          alert('unable to get saved replies');
        });      
      }
    };
    $scope.getSavedReplies();

    $scope.getSnapshot = function() {
      if ($scope.online()) {
        userService.getSnapshot({ uid: $scope.selected_conversation.uid, uid_type: $scope.selected_conversation.uid_type })
        .then(function(data) {
          $scope.no_social_data = false;
          $scope.snapshot = data;
        }, function(data) {
          $scope.no_social_data = true;
        });
      }
    };

    $scope.selectConversation = function(data) {
      if (data.select_conversation !== undefined) {
        $timeout(function() {
          var select_conversation;
          // check if conversation to select is already in the conversations list that was just loaded
          for (var i = 0, len = data.conversations.length; i < len; i++) {
            if (data.select_conversation.uid == data.conversations[i].uid && data.select_conversation.uid_type == data.conversations[i].uid_type) {
              select_conversation = data.conversations[i];
              break;
            }
          }

          // if not displayed push into conversations. Move to top.
          var convs_keys = Object.keys($scope.conversations);          
          if (select_conversation === undefined) {
            // are there conversations in view?
            if (convs_keys.length) data.select_conversation.last_message_ts = $scope.conversations[convs_keys[0]].last_message_ts + 1; 
            $scope.conversations[data.select_conversation.id] = data.select_conversation;
          } else
            select_conversation.last_message_ts = $scope.conversations[convs_keys[0]].last_message_ts + 1; 

          $scope.clickFirstConversation();
        });
      }
    };

    $scope.startConversation = function(data) {
      if ($scope.online()) {
        var convs_keys = Object.keys($scope.conversations);

        // is conversation already in view?
        for (var i = 0, len = convs_keys.length; i < len; i++) {
          if (data.uid == $scope.conversations[convs_keys[i]].uid && data.uid_type == $scope.conversations[convs_keys[i]].uid_type) {
            $scope.conversations[convs_keys[i]].last_message_ts = $scope.conversations[convs_keys[0]].last_message_ts + 1;
            $scope.clickFirstConversation();
            console.log('found conversation in view');
            return;
          }
        };

        conversationService.findConversation(data)
        .then(function(conv) {
          convs_keys = Object.keys($scope.conversations);       // get updated keys
          
          // one more check like above...this conversation could have been opened before this ajax came back.
          for (var i = 0, len = convs_keys.length; i < len; i++) {
            if (data.uid == $scope.conversations[convs_keys[i]].uid && data.uid_type == $scope.conversations[convs_keys[i]].uid_type) {
              $scope.conversations[convs_keys[i]].last_message_ts = $scope.conversations[convs_keys[0]].last_message_ts + 1;;
              $scope.clickFirstConversation();
              console.log('found conversation in view');
              return;
            }
          };

          // are there messages already loaded
          if (convs_keys.length) conv.last_message_ts = $scope.conversations[convs_keys[0]].last_message_ts + 1;        
          $scope.conversations[conv.id] = conv;
          $scope.clickFirstConversation();
          console.log('started conversation');
        }, function() {
          console.log('unable to start conversations');
        });
      }
    };

    $scope.clickFirstConversation = function() {
      $timeout(function() { 
        angular.element('#conversation-list-wrapper').children(':first').triggerHandler('click'); 
        if (start_conversation_selectize) start_conversation_selectize.clear(true);
      });
    };

    $scope.closeConversation = function(data) {
      if ($scope.is_conversation_selected() && $scope.online()) {
        var hash = { conversation_resolution: { notes: $scope.marked_as_done.notes, resolution: $scope.marked_as_done.reason } };
        conversationService.closeConversation($scope.selected_conversation.id, hash)
        .then(function(data) {
          $scope.selected_conversation_messages = [];
          $scope.selected_conversation = {};
          $scope.conversation_selected = false;
          delete $scope.conversations[$scope.selected_conversation.id];
        }, function(data) {
          alert('unable to close conversation');
        })
        .finally(function() { $('#mark-as-done-div').trigger('close'); });      
      };
    };

    $scope.messageTrackingFunction = function(message) { return message.channel + "-" + message.id.toString(); };
    $scope.imageTrackingFunction = function(image) { return 'Image-' + image.ref.toString(); };

    $scope.messageInView = function(index) {
      var message = $scope.selected_conversation_messages[index];
      if (message.unread) {
        message.unread = false;   // doing this here simply because i don't want to make excessive server calls even if there is a failure
        $scope.markMessagesAsRead($scope.selected_conversation.id, message.id);
      }
    };

    $scope.getConversationMessages = function(conversation, from_conversations_list) {
      var deferred = $q.defer();

      $scope.conversation_selected = true;

      // don't get messages if user clicks again on current conversation
      if (!(from_conversations_list && conversation.id == $scope.selected_conversation.id) && $scope.online()) {
      
        // a new conversation is selected, reset
        if ($scope.selected_conversation.id != conversation.id) {
          messages_page = 1;
          $scope.selected_conversation_messages = [];
        }

        // Pull messages if you click on another conversation, even if the current one is loading
        // Pull messages for the current conversation if it isnt loading
        if (!$scope.status.loading || conversation.id != $scope.selected_conversation.id) {
          $scope.selected_conversation = conversation;
          $scope.status.loading = true;

          conversationService.getConversationMessages(conversation.id, messages_page)
          .then(function(data) {
            // update only if the conversation that requested the message is still selected
            if (conversation.id == $scope.selected_conversation.id) {
              if (data.messages.length > 0) {
                messages_page += 1;
                for (var i = 0, len = data.messages.length; i < len; i++) { 
                  data.messages[i].unread = false;
                  $scope.selected_conversation_messages.unshift(data.messages[i]); 
                }
                //$scope.status.loaded = ($scope.selected_conversation_messages.length > 0);  // might not need this line
                //$scope.markMessagesAsRead(conversation.id, data.unread_ids);
                $scope.status.loading = false;
                console.log(data.messages)
                deferred.resolve();
              } else
                $scope.rejectPromise(false, 'no messages', deferred);
            } else
              $scope.rejectPromise(false, 'viewing anothe conversation', deferred)
          }, function(data) {
            $scope.rejectPromise(false, 'get more messages failed', deferred)
          });
        } else {
          deferred.reject();
        }

        if (from_conversations_list) $scope.performUserActions();
      } else {
        deferred.reject();
      }

      return deferred.promise;
    };

    // get transactions, snapshot and lists, build channel dropdown
    $scope.performUserActions = function() {
      $scope.getCustomerTransactions();
      $scope.getSnapshot();
      $scope.getCustomerLists();
      $scope.buildChannelDropdown();
    };

    $scope.rejectPromise = function(status, msg, obj) {
      $scope.status.loading = status;
      console.log(msg);
      obj.reject();
    }

    $scope.markMessagesAsRead = function(conversation_id, unread_ids) {
      if ($scope.online()) {
        conversationService.markMessageAsRead(conversation_id, unread_ids)
        .then(function(re) {
          //var unread_ids = unread_ids.split(",");
          //var unread_diff = $scope.global_unread_count - unread_ids.length;
          //$scope.global_unread_count = (unread_diff > 0) ? unread_diff : 0;
          $scope.conversations[conversation_id].unread_count -= unread_ids.split(",").length;
          console.log('marked as read');
        }, function(re) {
          console.log('markes as read Failed');
        });
      }
    };

    $scope.bindEnterToMessagingArea = function() {
      BindConversationPlugins.get_emoji_box()[0].emojioneArea.on("keyup", function(btn, e) {
        BindConversationPlugins.update_textarea();
        if (e.keyCode == 13) $scope.sendConversationMessage('Message');   
      });
    };

    $scope.sendConversationMessage = function(channel) {
      if ($scope.is_conversation_selected() && !$scope.is_sending && $scope.online()) {
        $scope.is_sending = true;
        var btn = (channel == 'Message') ? 'send_msg_btn' : 'send_msg_fb_btn';
        $scope[btn] = "Sending...";
        console.log($scope.new_message);

        if (($scope.new_message.text == '') || ($scope.new_message.text.length > $scope.merchant.num_of_chars)) {
          alert('enter up to ' + $scope.merchant.num_of_chars + ' characters.');
          $scope.enable_msg_btn(btn, channel);
        } else {
          var conversation_id = $scope.selected_conversation.id;
          conversationService.sendConversationMessage(conversation_id, $scope.new_message.text, channel)
          .then(function(data) {
            // ensure we still have the right conversation
            if ($scope.selected_conversation.id == conversation_id) {
              $scope.selected_conversation_messages.push(data);
              /*
              $scope.conversations[conversation_id].last_message = data;
              $scope.conversations[conversation_id].last_message_ts = data.ts;
              $scope.conversations[conversation_id].ago = data.ago;
              */
            }
            $scope.new_message.text = '';
            BindConversationPlugins.get_emoji_box()[0].emojioneArea.setText('');
            console.log('sent message');
            console.log(data)
          }, function(data) {
            console.log('unable to send message');
            console.log(data)
          })
          .finally(function() { 
            $scope.enable_msg_btn(btn, channel); 
          });
        };
      };
    };

    $scope.is_conversation_selected = function(msg, show_alert) {
      var state = $scope.conversation_selected;
      if (!state && !show_alert) FlashHandler.setFlashMessage(msg || 'select a conversation', 'error');
      return state;
    }

    $scope.enable_msg_btn = function(btn, channel) {
      $scope[btn] = (channel == 'Message') ? 'Send' : 'Send via Facebook';
      $scope.is_sending = false;
    };

    // MMS
    // Twilio supports only gif, png and jpeg
    $scope.handleFile = function(file, errFiles) {
      $scope.errFile = errFiles && errFiles[0];
      console.log(errFiles)
      if (file) {
        if (file.type.match('image')) {
          $scope.selected_file = file;
          // show preview
          $('#mms-file-preview-div').lightbox_me({ centered: true })
        } else
          console.log('unsupported type');
      } else if (errFiles.length > 0) {
        if(errFiles[0].$errorMessages.maxSize) console.log('file size is too large');
      }
    };


    $scope.sendMMS = function(channel) {
      if ($scope.is_conversation_selected() && !$scope.is_sending && $scope.online()) {
        $scope.is_sending = true;
        var btn = (channel == 'Message') ? 'send_mms_btn' : 'send_mms_fb_btn';
        $scope[btn] = "Sending...";
        var file = $scope.selected_file;
        var conversation_id = $scope.selected_conversation.id;
        conversationService.sendConversationMMS(conversation_id, file, $scope.mms_text, channel)
        .then(function (data) {
          if ($scope.selected_conversation.id == conversation_id) $scope.selected_conversation_messages.push(data.data);
          // wipe file picker?
          console.log('mms sent');
          console.log(data)
          $('#mms-file-preview-div').trigger('close');
        }, function (response) {
          console.log('unable to send mms');
        })
        .finally(function() {
          $scope.enable_msg_btn(btn, channel); 
          $('#mms-img-preview-div').trigger('close');
        });
      }
    };
    // End MMS


    // Modals
    // Transactions
    $scope.displayChargeForm = function() {
      $('#charge-a-customer-div').lightbox_me({
        centered: true,
        onLoad: function() { 
          $('#conversation-chargeForm').find('input:first').focus(); 
          //$scope.is_conversation_selected('Please select a conversation with a customer to continue'); 
        }
      });
    };

    $scope.openSavedRepliesDiv = function() {
      $('#saved-reply-selection-div').lightbox_me({
        centered: true,
      });
    };

    $scope.markAsDoneDiv = function() {
      $('#mark-as-done-div').lightbox_me({
        centered: true,
      });
    };

    $scope.addToListDiv = function() {
      $('#add-to-list-div').lightbox_me({
        centered: true
      });
    };

    $scope.clickFilePicker = function() { $('#file-picker').click(); };
    
    $scope.newReminderDiv = function() {
      $('#new-reminder-div').lightbox_me({
        centered: true,
      });
    };

    $scope.insertTextIntoMessageBox = function(text_to_insert) {
      if (text_to_insert && text_to_insert.trim().length) {
        var box = BindConversationPlugins.get_emoji_box()[0], text = box.emojioneArea.getText();
