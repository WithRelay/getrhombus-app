(function() {
  angular.module('messageFetcher', ['upwards-scroll']);
  angular.module('messageFetcher').controller('endlessMessage', function($scope, $http) {
  
    var messages = this;
    messages.Items = [];

    messages.LoadMore = function() {
      var url = window.location.origin + '/v1/conversations/' + $scope.active_conversation_id + '.json?page=' + page;
      $http.get(url).success(function(data) {
        if (data.messages.length < 1){
          $('.messageStatus').html('Message Completed')
        }
        var msg = data.messages;
        for (var i = 0; i < msg.length; i++) {
            messages.Items.unshift(msg[i]);
        }
        $scope.update_unread_messages(data.unread_ids);
        page += 1;
      })
      .error(function(data, status, headers, config) {
        alert('Error while trying to connect to the messaging system.');
      });
    };
    
    var counter = 0, page = 1;
    messages.LoadMore();
  });
})();


