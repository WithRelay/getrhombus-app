              <label class="w-form-label" for="Notification Frequency-2">Repeat</label>
            </div>
            <select class="dropdown frequency-dropdown w-select" id="field-5" name="field-5">
              <option value="">Repeat every</option>
              <option value="">3 days</option>
              <option value="">7 days</option>
              <option value="">14 days</option>
              <option value="">30 days</option>
              <option value="">60 days </option>
              <option value="">90 days</option>
            </select><a class="button schedule-notification w-button">Schedule notification for [Customer name]</a>
            <%# added data and update-close-modals %>
            <a class="button cancel-notification w-button update-close-modals" data-parent='new-reminder-div'>Cancel</a>
          </form>
        </div>
      </div>

    </div>

