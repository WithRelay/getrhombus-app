  <%# added id %>
  <div class="dashboard-body messaging w-clearfix" id='messages-box' when-scrolled-up="getConversationMessages(selected_conversation, false)" scroll-bottom-on="status.loaded" in-view-container>

    <%# <div ng-show="status.loading" class="me"><span>loading...</span></div> %>
    
    <%# added this wrapping div %>
    <!-- message ng-repeat -->
    <div ng-repeat="message in selected_conversation_messages track by messageTrackingFunction(message)"> <%# track by $index">  %>

      <div class="conversation-date-wrapper" ng-if="($index != 0) && !selected_conversation_messages[$index - 1].unread && selected_conversation_messages[$index].unread">
        <div class="conversation-date">New Messages</div>
      </div>

      <div class="conversation-date-wrapper" ng-if="($index == 0) || (selected_conversation_messages[$index - 1].ts_day_of_the_week != selected_conversation_messages[$index].ts_day_of_the_week)">
        <div class="conversation-date">{{message.ts_day_of_the_week}}</div>
      </div>

      <!-- user -->
      <div class="customer-messaging-bubble w-clearfix" ng-if="(message.source == 'customer')">
        <div class="w-row">
          <div class="customer-messaging-bubble-picture-wrapper w-clearfix w-col w-col-2">
            <%# added height %>
            <img ng-if="message.profile_image.type == 'image'" class="messaging-bubble right-nav-profile-picture" src="{{message.profile_image.value}}" width="35" height='35'>
            
            <div class="chat-wwindow no-image-found-placeholder" ng-if="message.profile_image.type == 'color'">
              <div class="customer-initial">{{ selected_conversation.uid_type == 'user' ? selected_conversation.full_name.charAt(0) : '#' }}</div>
            </div>
          </div>

          <div class="w-col w-col-10">

            <!-- image -->
            <div class="chat-bubble-image-wrapper customer" ng-if='message.images.length'>
              <img ng-repeat="image in message.images track by imageTrackingFunction(image)" class="chat-bubble-image" src="{{ message.images[$index].url }}">
            </div>
            <!-- text -->
            <div ng-class="{ 'customer-message' : true, 'fb-messenger': message.msg_type == 'FbMessage', 'message-bubble' : true }">
              <div ng-class="{ 'chat-text' : true, 'fb-messenger': message.msg_type == 'FbMessage' }">{{message.text}}</div>
            </div>

          </div>
        </div>
        <div class="message-date-time">Received via <strong class="channel-and-time">{{ message.msg_type == 'Message' ? 'SMS' : 'Facebook Messenger'}} {{message.ts_time}}</strong></div>
      </div>
      <!-- end user -->

      <!-- merchant -->
      <div class="agent-messaging-bubble w-clearfix" ng-if="(message.source == 'merchant')">
        <div class="w-row">
          <div class="w-col w-col-10">

            <!-- images -->
            <div class="chat-bubble-image-wrapper" ng-if='message.images.length'>
              <img ng-repeat="image in message.images track by imageTrackingFunction(image)" class="chat-bubble-image" src="{{ message.images[$index].url }}">
            </div>
            <!-- text -->
            <div class="agent-messaging message-bubble" ng-if='message.text'>
              <div class="agent chat-text">{{message.text}}</div>
            </div>

          </div>
          <div class="w-clearfix w-col w-col-2">
            <%# added height %>
            <img ng-if="message.profile_image.type == 'image'" class="agent-picture messaging-bubble right-nav-profile-picture" src="{{message.profile_image.value}}" width="35" height='35'>
            <div class="agent chat-wwindow no-image-found-placeholder" ng-if="message.profile_image.type == 'color'">
              <div class="customer-initial">{{ merchant.full_name.charAt(0) }}</div>
            </div>
          </div>
        </div>
        <div class="agent message-date-time">&nbsp;&nbsp;Sent <em class="time-text">{{message.ts_time}}</em></div>
      </div>
      <!-- end merchant -->

    </div>
    <!-- end message ng-repeat -->
  </div>
  
