    <%= render partial: 'shared/modals/mms_file_preview', locals: { reminder: @reminder , reminder_url: v1_reminders_path, method: 'post' } %>
  </div>

  <div class="messaging sub-nav-bar">
    <div class="w-row">
      <div class="w-col w-col-4"></div>
      <div class="w-col w-col-4">
        <div class="customer-name-text subheader" ng-show="current_chat_conversation != false">Conversation with {{current_chat_conversation.full_name}}</div>
      </div>
      <div class="w-col w-col-4"></div>
    </div>
  </div>

  <div class="messaging side-bar" when-scrolled-down="loadConversations()" id='conversations-list'>
    <div class="w-tabs" data-duration-in="300" data-duration-out="100">

      <div class="messaging-tab-menu w-tab-menu">
        <a class="messages-tab-link w--current w-inline-block w-tab-link" data-w-tab="Tab 1">
          <div class="messages-tab-link-text">New (<span>29)</span>
          </div>
        </a>
        <a class="messages-tab-link right w-inline-block w-tab-link" data-w-tab="Tab 2">
          <div class="messages-tab-link-text">Open (<span>9)</span>
          </div>
        </a>
      </div>

      <form novalidate>

        <label>
          <angucomplete-alt id="find-recipient"
          placeholder="name or phone number"
          pause="300"
          minlength="1"
          selected-object="recipientSelected"
          remote-url="<%= (Rails.env == 'development' ? "http://localhost:3000" : "#{Rails.application.secrets.url["info"]}") + "/v1/hashtags?query=" %>"
          remote-url-data-field="data"
          title-field="tag"
          text-no-results='false'
          match-class='highlight'
          input-name='recipient'
          description-field='description'
          text-searching="Finding your customer/contact..."
          <%#= add html notification during ui integration %>
          <%#= scroll bar added but test option during UI integration and testing %>
          remote-url-error-callback='searchRecipientsApiErrorHandler'
          />
        </label>
      </form>


      <div id="rhombus-number" data-clipboard-text="RHOMBUS NUMBER ALSO GOES HERE!">RHOMBUS NUMBER HERE</div>


      <div class="message-tab-content w-tab-content">

        <div class="w--tab-active w-tab-pane" data-w-tab="Tab 1">
          <a class="message-tab w-inline-block" ng-repeat="(identifier, conversation) in conversations | filterConversationList:query | orderObjectBy:'last_message_ts':true" ng-click="getConversationMessages(conversation, true)">
            <div class="message-tab-content-wrapper w-row">
              <div class="message-tab-picture-column w-col w-col-2">
                <div class="w-clearfix">

                  <div ng-class="conversation.last_message_type === 'Message' ? 'channel-indicator-2' : 'channel-indicator'" ng-if="conversation.last_message"></div>
                  <%# combined color and image div into the same a tag %>
                  <div ng-class="{ 'no-image-found-placeholder' : true, 'radius-color-{{conversation.profile_image.value}}' : true }" ng-if="conversation.profile_image.type == 'color'"></div>
                  <%# added height %>
                  <img ng-if="conversation.profile_image.type == 'image'" class="customer-profile-picture" src="{{conversation.profile_image.value}}" width="30" height='30'>

                </div>
              </div>
              <div class="name-and-preview-column w-clearfix w-col w-col-9">
                <div class="customer-name-text shrink-text">{{conversation.full_name}}</div>
                <div class="message">{{conversation.last_message}}</div>
              </div>
              <div class="time-and-counter-column w-clearfix w-col w-col-1">
                <div class="messaging-dash-variable-text">{{conversation.ago}}</div>
                <div class="message-counter" ng-show="conversation.unread_count > 0">{{conversation.unread_count}}</div>
              </div>
            </div>
          </a>
        </div>

        <div class="w-tab-pane" data-w-tab="Tab 2">
          <a class="message-tab older-message w-inline-block" href="#">
            <div class="message-tab-content-wrapper w-row">
