<div class="content">
  <!-- Start Page Header -->
  <div class="page-header">
    <!--<h1 class="title">Messaging</h1>-->
    <ol class="breadcrumb">
      <li ng-if="users.length > 0" class="active">
        You have <span class="label label-danger">{{global_unread_count}}</span> unread messages
      </li>
      <li ng-if="users.length == 0" class="active">
        No messages in the last <%= CONFIG[:dashboard]['messaging']['num_days_history'] %> days.
      </li>
    </ol>
  </div>
  <!-- End Page Header -->
  <!-- //////////////////////////////////////////////////////////////////////////// -->
  <!-- START CONTAINER -->
  <div ng-if="users.length > 0" class="container-mail">
    <!-- Start Mailbox -->
    <div class="mailbox clearfix">
      <!-- Start Mailbox Menu -->
      <div class="mailbox-menu"></div>
      <!-- End Mailbox Menu -->
      <!-- Start Mailbox Container -->
      <div class="container-mailbox">
        <!-- Start Mailbox Inbox -->
        <div class="col-lg-3 col-md-4 padding-0">
          <ul class="mailbox-inbox">
            <li class="search">
              <form>
                <input type="text" class="mailbox-search" id="mailboxsearch" placeholder="Search" ng-model="query">
                <span class="searchbutton"><i class="fa fa-search"></i></span>
              </form>
            </li>
            <li ng-repeat="user in users | filter:query">
              <a class="item clearfix" ng-click="getUserMessages(user)"> 
                <img ng-src="{{user.image_url}}" alt="img" class="img" /> 
                <span class="from">{{user.first_name}} {{user.last_name}}</span> 
                {{user.last_message}}
                <span class="date">{{user.unread_count}}</span> 
              </a>
            </li>
          </ul>
        </div>
        <!-- End Mailbox Inbox -->
        <!-- Start Chat -->
        <div ng-if="selected_user_messages.length > 0" class="chat col-lg-9 col-md-8 padding-0">
          <!-- Start Title -->
          <div class="title">
            <h1>{{selected_user.first_name}} {{selected_user.last_name}}</h1>
            <p>
              {{selected_user.email}}
            </p>
          </div>
          <!-- End Title -->
          <!-- Start Conv -->
          <ul class="conv">
            <li ng-repeat="message in selected_user_messages track by $index">
              <img ng-if="($index == 0) || (selected_user_messages[$index - 1].user_level != message.user_level)" ng-src="{{message.image_url}}" alt="img" class="img">
              <p ng-class="{'ballon color1': message.user_level == 0 , 'ballon color2': message.user_level != 0}">
                {{message.text}}
              </p>
            <li>
          </ul>
          <!-- End Conv -->
          <div class="write">
            <form class="margin-b-20">
              <p>
                <textarea class="textarea form-control" placeholder="Enter text ..."  style="height:60px; width:100%;"></textarea>
              </p>
              <button class="btn btn-default">
                Send
              </button>
              <button type="reset" class="btn margin-l-5">
                Clear
              </button>
            </form>
          </div>
        </div>
        <!-- End Chat -->
      </div>
      <!-- End Mailbox Container -->
    </div>
    <!-- End Mailbox -->
  </div>
  <!-- END CONTAINER -->
</div>