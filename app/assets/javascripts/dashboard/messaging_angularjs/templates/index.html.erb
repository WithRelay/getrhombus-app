          <div class="form-check-box w-checkbox">
            <input type="checkbox" class="w-checkbox-input" name="authorize" ng-model='charge.authorize' value="authorize">
            <label class="w-form-label" for="checkbox-4">Authorize only</label>
          </div>

          <button class="button charge-modal-button w-button" id="chargeButton" ng-disabled="disableChargeButton(chargeForm)" type="submit">{{charge_btn}}</button>
