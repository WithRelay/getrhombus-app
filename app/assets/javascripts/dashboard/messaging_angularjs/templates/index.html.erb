<div class="modal-body w-hidden">
  <%= render partial: 'shared/modals/save_reply', locals: { reminder: @reminder , reminder_url: v1_reminders_path, method: 'post' } %>
</div>
  <div class="modal-body w-hidden">
    <%= render partial: 'shared/modals/charge_customer', locals: { reminder: @reminder , reminder_url: v1_reminders_path, method: 'post' } %>
  </div>
  <div class="modal-body w-hidden">
    <%= render partial: 'shared/modals/add_to_list', locals: { reminder: @reminder , reminder_url: v1_reminders_path, method: 'post' } %>
  </div>
  <div class="modal-body w-hidden">
    <%= render partial: 'shared/modals/mark_as_done', locals: { reminder: @reminder , reminder_url: v1_reminders_path, method: 'post' } %>
  </div>
  <div class="modal-body w-hidden">
    <%= render partial: 'shared/modals/new_reminder', locals: { reminder: @reminder , reminder_url: v1_reminders_path, method: 'post' } %>
  </div>
