<div class="content">
  <!-- Start Page Header -->
  <div class="page-header">
    <div style="float:left;">
      <h1 class="title">Messaging</h1>
      <!--<ol class="breadcrumb">
        <li ng-if="active_user_count > 0" class="active">
          You have <span ng-class="{'label label-danger': global_unread_count > 0 , '': global_unread_count == 0}" class="">{{global_unread_count}}</span> unread messages
        </li>
        <li ng-if="active_user_count == 0" class="active">
          No messages in the last <%= CONFIG[:dashboard]['messaging']['num_days_history'] %> days.
        </li>
      </ol>-->
    </div>

    <div style="float:right;">
      <button ng-click="displayChargeForm()">Charge a customer</button>    
    </div>
    <div class="clearfix"></div>
  </div>
  <!-- End Page Header -->
  <!-- //////////////////////////////////////////////////////////////////////////// -->
  <!-- START CONTAINER -->
  <div ng-if="active_user_count > 0" class="container-mail">
    <!-- Start Mailbox -->
    <div class="mailbox clearfix">
      <!-- Start Mailbox Menu -->
      <div class="mailbox-menu"></div>
      <!-- End Mailbox Menu -->
      <!-- Start Mailbox Container -->
      <div class="container-mailbox">
        <!-- Start Mailbox Inbox -->
        <div class="col-lg-3 col-md-4 padding-0">
          <ul class="mailbox-inbox">
            <li class="search">
              <form>
                <input type="text" class="mailbox-search" id="mailboxsearch" placeholder="Search" ng-model="query">
                <span class="searchbutton"><i class="fa fa-search"></i></span>
              </form>
            </li>
            <div class="user-list">
              <li ng-repeat="(user_number, user) in users | filterUserList:query | orderObjectBy:'last_message_ts':true">
                
                <a ng-class="{ chat_highlight : current_chat_user === user, item : true, clearfix : true }" ng-click="getUserMessages(user)"> 
                  <img ng-src="{{user.profile_image}}" alt="img" class="img" /> 
                  <span class="from">{{user.first_name}} {{user.last_name}}</span> 
                  <div class="last-message">{{user.last_message}}</div>
                  <span ng-if="user.unread_count > 0" class="unread">{{user.unread_count}}</span> 
                </a>
              </li>
            </div>
          </ul>
        </div>
        <!-- End Mailbox Inbox -->
        <!-- Start Chat -->
        <div ng-if="selected_user_messages.length > 0" class="chat col-lg-9 col-md-8 padding-0">
          <!-- Start Title -->
          <div class="title">
            <h1>{{selected_user.first_name}} {{selected_user.last_name}}</h1>
            <p>
              {{selected_user.email}}
            </p>
          </div>
          <!-- End Title -->
          <!-- Start Conv -->
          <ul class="conv" scroll-glue>
            <div ng-repeat="message in selected_user_messages track by $index">
              <li ng-if="($index != 0) && !selected_user_messages[$index - 1].unread && selected_user_messages[$index].unread" class="date">New Messages</li>
              <li ng-if="($index == 0) || (selected_user_messages[$index - 1].ts_day_of_the_week != selected_user_messages[$index].ts_day_of_the_week)" class="date">{{message.ts_day_of_the_week}}</li>
              <li>
                <img ng-if="(message.user_level == 0) && (($index == 0) || (selected_user_messages[$index - 1].user_level != message.user_level))" ng-src="{{message.profile_image}}" alt="img" class="img">
                <p ng-class="{'ballon color1': message.user_level == 0 , 'ballon color2': message.user_level != 0}">
                  
                  

                  <!--{{message.text}}-->
                  <span ng-if="message.text">{{message.text}}</span>
                  <span ng-if="message.image_url"><img src="{{message.image_url}}"/></span>
                </p>
                <p class="ts">
                  {{message.ts_time}}
                </p>
                <div class="separator">&nbsp;</div>
              <li>
            </div>
          </ul>
          <!-- End Conv -->
          <div class="write">
            <form>
              <p>
                <span class="char-counter">{{char_limit - new_message.text.length}} characters left</span>
                <textarea class="textarea form-control" placeholder="Type a message here..." style="height:60px; width:100%;" ng-model="new_message.text" ng-trim="true" ng-enter="sendMessage(new_message)"></textarea>
              </p>
              <button class="btn btn-default btn-rhombus" id="send_msg_btn" ng-click="sendMessage(new_message)" style="height: 32px;" ng-disabled='is_sending'>
                {{send_msg_btn}}
              </button>
              
              <input type="file" id="file-picker" ngf-select="handleFile($file, $invalidFiles)" ng-model="pic_file" ngf-accept="'image/*'" ngf-max-size="1MB">              
    
                <%#<button type="reset" class="btn margin-l-5">
                  Clear
                </button>%>
                <span class="char-counter">{{char_limit - new_message.text.length}} characters left</span>
                      
            </form>


            <!-- Image Preview -->
            <div style="display: none; width: 400px; height: 400px; background: white;" id="mms-img-preview">
              <div style="font:smaller">{{f.name}}</div>    
              <textarea class="textarea form-control" placeholder="Add a message to this MMS..." style="height:100px; width:70%;" ng-model="mms_text" ng-trim="true"></textarea>
              <br><br>
              <style type="text/css"> .thumb { width: 100px; height: 100px; float: none; position: relative; top: 7px; }</style>
              <img ngf-thumbnail="pic_file" class="thumb">
              <br><br>
              <button class="btn btn-default btn-rhombus" id="send_mms_btn" ng-click="sendMMS()" style="height: 32px;" ng-disabled='is_sending_mms'>
                {{send_mms_btn}}
              </button>
              <br>
              <button class="btn btn-default btn-rhombus" id="cancel_mms_btn" ng-click="cancelMMS()" style="height: 32px;" ng-disabled='is_sending_mms'>
                Cancel
              </button>
            </div>
            <!-- Image Preview -->

          </div>
        </div>
        <!-- End Chat -->
      </div>
      <!-- End Mailbox Container -->
    </div>
    <!-- End Mailbox -->
  </div>
  <!-- END CONTAINER -->
</div>


<!-- Charge Box -->
<div style="display: none;" id="chargeFormBox" class="newForms">
  <div id="chargeFormDiv" class="parent_div">
    <div class="center_div">      
      <div id="chargeCustomer">Charge Customer</div>
      <p id="chargeCustomerLine">____</p>      
      <form id="chargeForm" name="chargeForm" ng-submit="submitChargeForm(chargeForm.$valid)" novalidate>
         
        <label>
          <angucomplete-alt id="find-hashtag"
            placeholder="Hashtag or item name"
            pause="400"
            minlength="1" 
            selected-object="hashtagSelected"
            remote-url="<%= (Rails.env == 'development' ? "http://localhost:3000" : "https://www.getrhombus.com")  +  "/v1/hashtags/find?query=" %>"
            remote-url-data-field="hashtags"
            title-field="tag"
            text-no-results='false'
            match-class='highlight'
            input-name='hashtag'
            description-field='description'             
            text-searching="Finding your tag/item..." 
            <%#= add html notification during ui integration %>
            <%#= scroll bar added but test option during UI integration and testing %>
            remote-url-error-callback='apiErrorHandler' 
            />
        </label>

         <label>
          <angucomplete-alt id="find-customer"
            placeholder="Customer name or number"
            pause="400"
            minlength="3" 
            selected-object="customerSelected"
            remote-url="<%= (Rails.env == 'development' ? "http://localhost:3000" : "https://www.getrhombus.com")  +  "/v1/users/find?query=" %>"
            remote-url-data-field="users"
            title-field="card_name"
            text-no-results="We couldn't find any customer"
            match-class='highlight'
            input-name='customer_number'
            description-field='phone_number'
            text-searching="Finding your customer..." 
            field-required="is_true"
            remote-url-error-callback='apiErrorHandler' 
             />
        </label>

        <style type="text/css"> .has-error { border-color: red; }</style>       

        <label class="left">
          <%# http://gsferreira.com/archive/2015/02/angularjs-input-number-with-two-decimal-places %>
          <input type="number" min="1" max='15000' required ng-model='amount' name="amount" placeholder="Amount" style="width: 150px" step='0.01' ng-pattern="/^\d+(.\d{1,2})?$/" ng-class="{'has-error': chargeForm.amount.$invalid && !chargeForm.amount.$pristine }">
          <p ng-show="chargeForm.amount.$invalid && !chargeForm.amount.$pristine">Amount is required.</p>
        </label>
      
        <label>
          <textarea type="text" ng-model='notes' name="notes" placeholder="Description" style="height: 100px;" class="rhombusFocus"></textarea>
        </label>

        <label>
          <input type="checkbox" name="authorize" ng-model='authorize' value="authorize">Authorize only
        </label>

        <footer>
          <button class="btn btn-default btn-block btn-rhombus" id="chargeButton" ng-disabled="chargeForm.$invalid || is_sending" type="submit">{{charge_btn}}</button>
        </footer>
      </form>
    </div>
  </div>
</div>
<!-- Charge Box -->
