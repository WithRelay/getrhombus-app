            <div class="file-sender split-button-wrapper">
              
              <a class="message-window-tabs send-button split-button w-button" ng-click="sendMMS('Message')" ng-disabled='is_sending || selected_conversation.id === undefined'>{{send_mms_btn}}</a>
              
              <div class="w-dropdown">
