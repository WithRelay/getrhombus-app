  <div class="modal-body w-hidden" id='new-reminder-div'>
    <%# removed all webflow data attributes %>

    <div class="schedule-notification-form-wrapper" id="schedule-message-div">
      <div class="content-sub-wrapper modal w-clearfix">
        <h4 class="modal-header welcome-dash-content-container-header">Schedule Message</h4>
        <a class="close-modal update-close-modals" data-parent='schedule-message-div'></a>
      </div>
      <p class="modal-content-description">Set a reminder or notification that will go out to this customer at a future date. You can use this to automate appointment reminders, or bill payment reminders.</p>
      <div class="segment-modal underline-div"></div>
      <div class="scheduled-notification-form w-form">
        <form class="w-clearfix" id="email-form-7" name="email-form-7">

          <select class="dropdown frequency-dropdown w-select" ng-model='scheduled_message.channel' ng-options='option.title for option in customer_channel_list track by option.id'></select>
          
          <textarea class="notification-message text-area w-input" id="Notification-Message-2" placeholder="Enter notification message" ng-model='scheduled_message.text'></textarea>
          <div class="char-count notications">150 characters</div>
          
          <input class="daterange delivery-date-time-picker text-field w-input" placeholder="Notification Delivery Date &amp; Time" type="text" ng-model='scheduled_message.date_time'>
          
          <%# removed data attrs, changed name attr and id %>
          <div class="notification-frequency radio-button w-radio">
            <input class="w-radio-input" id="oneTimeFrequency" type="radio" value="0" name="reminder[frequency_type]" checked='checked' ng-model="scheduled_message.frequency_type">
            <label class="w-form-label" for="Notification Frequency">Send once</label>
          </div>
          
          <div class="notification-frequency radio-button repeat w-radio">
            <input class="w-radio-input" type="radio" value="1" id="recurringFrequency" name="reminder[frequency_type]" ng-model='scheduled_message.frequency_type'>
            <label class="w-form-label" for="Notification Frequency-2">Repeat</label>
          </div>
          
          <%# changed  id %>
          <select class="dropdown frequency-dropdown w-select" id='campaign_repeat_days' ng-model='scheduled_message.repeat_days'>
            <option value="3">3 days</option>
            <option value="7">7 days</option>
            <option value="14">14 days</option>
            <option value="30">30 days</option>
            <option value="60">60 days </option>
            <option value="90">90 days</option>
          </select>

          <a class="button schedule-notification w-button" ng-click='createReminder()'>Schedule notification</a><a class="button cancel-notification w-button">Cancel</a>
        </form>
      </div>
    </div>
  </div>





