        <form id="conversation-chargeForm" name="chargeForm" ng-submit="submitChargeForm(chargeForm.$valid)" novalidate>

          <div class="form-group col-xs-6">
            <selectize class="form-control dropdown w-select" config='hashtag_config' ng-model="charge.hashtag_id" options='hashtag_config_options'></selectize>
          </div>

          <input class="amount-field text-field w-input" type="number" min="1" max='15000' ng-model='charge.amount' name="amount" placeholder="$10.20" step='0.01' ng-pattern="/^\d+(.\d{1,2})?$/" ng-class="{'has-error': chargeForm.amount.$invalid && !chargeForm.amount.$pristine }">
          <%#<span ng-show="chargeForm.amount.$invalid && !chargeForm.amount.$pristine">A valid amount is required</span>%>

