<link rel="stylesheet" type="text/css" href="//cdn.jsdelivr.net/bootstrap.daterangepicker/2/daterangepicker.css" />

<%= form_for([current_user, @coupon]) do |f| %>
  <% if @coupon.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@coupon.errors.count, "error") %> prohibited this coupon from being saved:</h2>

      <ul>
      <% @coupon.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %><br>
    <%= f.text_field :name, id: 'coupon-name' %>
  </div>

  <div class="field">
    <%= f.label :coupon_type %><br>
    <%= f.select :coupon_type, options_for_select({ "Amount Off" => "amount_off", "Percent Off" => 'percent_off' }, selected: get_selected_coupon_type(@coupon)), {}, id: 'coupon-type' %>
  </div>

  <div class="field">
    <% if f.object.new_record? || (f.object.persisted? && f.object.amount_off.present?)%>
      <%= f.label :amount_off, id: 'coupon-type-value-label' %><br>
      <%= f.text_field :amount_off, id: "coupon-type-value" %>
    <% else %>
      <%= f.label :percent_off, id: 'coupon-type-value-label' %><br>
      <%= f.text_field :percent_off, id: "coupon-type-value" %>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :duration %><br>
    <%= f.select :duration, options_for_select({ "Once" => "once", "repeating" => 'repeating', "forever" => "forever" }, selected: @coupon.duration) %>
  </div>

  <!-- only if repeating -->
  <div class="field" id='duration-in-months-div'>
    <%= f.label :duration_in_months %><br>
    <%= f.text_field :duration_in_months, id: "duration-in-months" %>
  </div>

  <div class="field">
    <%= f.label :max_redemptions %><br>
    <%= f.text_field :max_redemptions, id: 'max-redemptions' %>
  </div>

   <div class="field">
    <%= f.label :redeem_by %><br>
    <i id='calIcon' class="fa fa-calendar" aria-hidden="true"></i>
    <%= f.text_field :redeem_by, id: 'redeemField' %>
  </div>

  
  <div class="actions">
    <%= f.submit 'Create Coupon', data: { disable_with: "Please wait..." } %>
  </div>
<% end %>
