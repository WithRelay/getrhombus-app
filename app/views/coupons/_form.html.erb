<% @coupon = Coupon.new %>
<%= form_for([current_user, @coupon], :html=> { id: 'couponForm' }) do |f| %>
  <div class="form-group col-xs-6">
    <%= f.text_field :name, id: 'coupon-name', class: 'form-control coupon-name text-field w-input', placeholder: 'Coupon name (no spaces)' %>
    </div>

  <div class="form-group col-xs-6">
    <%= f.select :coupon_type, options_for_select({ "Amount Off" => "amount_off", "Percent Off" => 'percent_off' }, selected: present(@coupon).get_selected_coupon_type), {}, id: "coupon-type", class: "form-control coupon-type dropdown w-select", prompt: 'Select coupon type' %>
  </div>


  <div class="form-group col-xs-6">
    <%= f.text_field :amount_off, id: "coupon-type-value", class: "form-control text-field w-input", placeholder: 'Amount'%>
  </div>

  <div class="form-group col-xs-6">
    <%= f.select :duration, options_for_select({ "Once" => "once", "repeating" => 'repeating' }, selected: @coupon.duration), {}, class: "form-control coupon-duration dropdown w-select" %>
  </div>
  <div class="form-group col-xs-6">
    <%= f.text_field :duration_in_months, id: "duration-in-months-div", class: "form-control text-field w-input", placeholder: 'Duration in months' %>
  </div>

  <div class="form-group col-xs-6">
    <%= f.text_field :max_redemptions, id: 'max-redemptions',  class: "form-control coupon-redemptions text-field w-input", placeholder: "Maximum number of redemptions" %>
  </div>
  <%= f.label :redeem_by_date, class: 'form-label', id: 'redeemLabel' %>
  <div class="form-group col-xs-6">
    <%= f.text_field :redeem_by, id: 'redeemField', class: "form-control redemption-date text-field w-input", value: present(@coupon).zone_timestamp %>
  </div>

  <%= f.submit 'Create Coupon', id: 'commit',class: 'button subscription w-button' %>

<% end %>
