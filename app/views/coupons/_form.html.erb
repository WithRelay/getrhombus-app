<!-- Date picker stuff -->
<!-- Include Required Prerequisites -->
<script type="text/javascript" src="//cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
<!-- Include Date Range Picker -->
<script type="text/javascript" src="//cdn.jsdelivr.net/bootstrap.daterangepicker/2/daterangepicker.js"></script>
<link rel="stylesheet" type="text/css" href="//cdn.jsdelivr.net/bootstrap.daterangepicker/2/daterangepicker.css" />

<%= form_for([current_user, @coupon], :html=> { id: 'couponForm', class: 'form-horizontal' }) do |f| %>
  
  <div class="form-group">
      <%= f.label :name, class: 'col-xs-3 control-label' %>
      <div class="col-xs-5">
        <%= f.text_field :name, id: 'coupon-name', class: 'form-control' %>
      </div>
  </div>

  <div class="form-group">
    <%= f.label :coupon_type, class: 'col-xs-3 control-label' %>
    <div class="col-xs-2">
      <%= f.select :coupon_type, options_for_select({ "Amount Off" => "amount_off", "Percent Off" => 'percent_off' }, selected: get_selected_coupon_type(@coupon)), {}, id: 'coupon-type', class: 'form-control' %>
    </div>
  </div>

  <div class="form-group">
    <% if f.object.new_record? || (f.object.persisted? && f.object.amount_off.present?)%>
      <%= f.label :amount_off, class: 'col-xs-3 control-label', id: 'coupon-type-value-label' %>
      <div class="col-xs-5">
        <%= f.text_field :amount_off, id: "coupon-type-value", class: 'form-control' %>
      </div>
    <% else %>
      <%= f.label :percent_off, class: 'col-xs-3 control-label', id: 'coupon-type-value-label' %>
      <div class="col-xs-5">
        <%= f.text_field :percent_off, id: "coupon-type-value", class: 'form-control' %>
      </div>
    <% end %>
  </div>

  <div class="form-group">
    <%= f.label :duration, class: 'col-xs-3 control-label' %>
    <div class="col-xs-2">
      <%= f.select :duration, options_for_select({ "Once" => "once", "repeating" => 'repeating', "forever" => "forever" }, selected: @coupon.duration), {}, class: 'form-control' %>
      </div>
  </div>

  <!-- only if repeating -->
  <div class="form-group" id='duration-in-months-div'>
    <%= f.label :duration_in_months, class: 'col-xs-3 control-label' %>
    <div class="col-xs-5">
      <%= f.text_field :duration_in_months, id: "duration-in-months", class: 'form-control' %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :max_redemptions, class: 'col-xs-3 control-label' %>
    <div class="col-xs-5">
      <%= f.text_field :max_redemptions, id: 'max-redemptions', class: 'form-control' %>
    </div>
  </div>

   <div class="form-group">
    <%= f.label :redeem_by, class: 'col-xs-3 control-label', id: 'redeemLabel' %>
    <div class="col-xs-5">
       <i id='calIcon' class="fa fa-calendar" aria-hidden="true"></i>
      <%= f.text_field :redeem_by, id: 'redeemField', class: 'form-control', value: present(@coupon).format_time %>
    </div>
  </div>

  <div class="actions field form-group">
    <div class="col-xs-9 col-xs-offset-3">
      <%= f.submit 'Create Coupon', id: 'commit',class: 'btn btn-primary' %>
    </div>
  </div>

<% end %>
