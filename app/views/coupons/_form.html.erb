<%= form_for([current_user, @coupon]) do |f| %>
  <% if @coupon.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@coupon.errors.count, "error") %> prohibited this coupon from being saved:</h2>

      <ul>
      <% @coupon.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %><br>
    <%= f.text_field :name, id: 'coupon-name' %>
  </div>

   <div class="field">
    <%= f.label :amount_off %><br>
    <%= f.text_field :amount_off, id: "amount-off" %>
  </div>

  <div class="field">
    <%= f.label :duration %><br>
    <%= f.select :duration, options_for_select({ "Once" => "once", "repeating" => 'repeating', "forever" => "forever" }, selected: @coupon.duration), id: 'coupon-duration' %>
  </div>

  <!-- only if repeating -->
  <div class="field" id='duration-in-months-div'>
    <%= f.label :duration_in_months %><br>
    <%= f.text_field :duration_in_months, id: "duration-in-months" %>
  </div>

  <div class="field">
    <%= f.label :max_redemptions %><br>
    <%= f.text_field :max_redemptions, id: 'max-redemptions' %>
  </div>


  <div class="field">
    <%= f.label :percent_off %><br>
    <%= f.text_field :percent_off, id: 'percent-off' %>
  </div>

   <div class="field">
    <%= f.label :redeem_by %><br>
    <%= f.text_field :redeem_by %>
  </div>

  
  <div class="actions">
    <%= f.submit 'Create Coupon', data: { disable_with: "Please wait..." } %>
  </div>
<% end %>
