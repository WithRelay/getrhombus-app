<div class="settings sub-nav-bar w-clearfix">
  <a class="dashboard-return sub-nav-button w-button" href="#"> &nbsp;<strong>Return to dashboard</strong></a>
</div>
<div class="dashboard-body settings">
  <div class="dash-content-container manage-plans settings">
    <h4 class="form-header">Manage Coupons</h4>
    <div class="flex-underline form-header-underline"></div>
    <div class="manage-segments-row w-row">
      <div class="w-col w-col-4">
        <div class="editable-row-header header settings-row-text">Coupon name</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Type</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Max Redemptions</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Date created</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Actions</div>
      </div>
    </div>
    <% @coupons.each do |coupon| %>
      <div class="manage-segments-row w-row">
        <div class="w-clearfix w-col w-col-4">
          <span class='editable-field-text settings-row-text coupon-name'><%= coupon.name %></span>
          <span class="coupon-name-edit-span">
            <a class="coupon-name-edit-icon edit-field save-editable-field" href="#"></a>
          </span>
          <span class='hide coupon-name-save-span' data-coupon-id='<%= coupon.id %>'>
            <a class="cancel-edit save-editable-field" href="#"><strong></strong></a>
            <a class="save-editable-field coupon-name-save-icon" href="#"></a>
          </span>

        </div>
        <div class="w-col w-col-2">
          <div class="settings-row-text"><%= present(coupon).coupon_type_on_manage %></div>
        </div>
        <div class="w-col w-col-2">
          <div class="settings-row-text"><%= coupon.max_redemptions %></div>
        </div>
        <div class="w-col w-col-2">
          <div class="settings-row-text"><%= present(coupon).date_created %></div>
        </div>
         <% if coupon.subscription_id.blank? %>
          <div class="w-col w-col-2">
            <%= link_to 'Delete Coupon', user_coupon_path(current_user, coupon), method: :delete, class: "button settings-table-row w-button delete-coupon coupon#{coupon.id}"%>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
