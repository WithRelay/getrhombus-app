<div class="container">
  <h1>Listing Coupons</h1>

  <table class= 'table'>
    <thead>
      <tr>
        <th>Coupon name</th>
        <th>Amount off</th>
        <th>Currency</th>
        <th>duration</th>
        <th>Duration in months</th>
        <th>Max Redemption</th>
        <th>Percent off</th>
        <th>Redeem by</th>
      </tr>
    </thead>

    <tbody>
      <% @coupons.each do |coupon| %>
        <tr>
          <td><%= coupon.name %></td>
          <td><%= present(coupon).format_amount %></td>
          <td><%= coupon.currency %></td>
          <td><%= coupon.duration %></td>
          <td><%= coupon.duration_in_months %></td>
          <td><%= coupon.max_redemptions %></td>
          <td><%= coupon.percent_off %></td>
          <td><%= present(coupon).zone_timestamp %></td>
          <td>
            <% if coupon.subscription_id.blank? %>
              <%= link_to 'Delete Coupon', user_coupon_path(current_user, coupon), method: :delete, class: "btn btn-danger delete-coupon coupon#{coupon.id}", data: { disable_with: "<i class='fa fa-spinner fa-spin'></i>Please wait...".html_safe } %></td>
            <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>

  <br>

  <%= link_to 'New Coupon', new_user_coupon_path %>
   <%#= render :partial => '/referrers/form' %>

</div>