<div class="sub-nav-bar table-header">
  <div class="table-header">
    <div class="table-header">
      <div class="header new-table-row w-row">
        <div class="cn w-clearfix w-col w-col-3">
          <div class="header name w-clearfix">
            <div class="headings name"> &nbsp; Coupon name</div>
          </div>
          <div class="cb check-box-column header"></div>
        </div>
        <div class="fv w-clearfix w-col w-col-2">
          <div class="cn column column-2 header">
            <div class="first-visit headings">&nbsp; &nbsp;&nbsp;Type</div>
          </div>
        </div>
        <div class="lv w-clearfix w-col w-col-2">
          <div class="colum-3 column header lv">
            <div class="headings last-visit"> &nbsp; Value</div>
          </div>
        </div>
        <div class="avs w-clearfix w-col w-col-1">
          <div class="avs column column-4 header">
            <div class="avs headings last-visit"> &nbsp;&nbsp;&nbsp;Duration</div>
          </div>
        </div>
        <div class="ts w-clearfix w-col w-col-1">
          <div class="column column-5 header ts"></div>
        </div>
        <div class="table-actions w-clearfix w-col w-col-3">
          <div class="column column-6 header new-row">
            <div class="headings recipient">&nbsp;  &nbsp; Redemptions</div>
          </div>
          <div class="column column-6 header new-row w-clearfix">
            <div class="headings location name">&nbsp; &nbsp;&nbsp;&nbsp;Redeem by</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="customer-dash sub-nav-bar">
  <div class="sub-nav-options-wrapper w-clearfix">
    <a class="w-button sub-nav-button w-button modal-loader", id: 'new-coupon-modal', href="#"> &nbsp;<strong>New coupon</strong></a>    
    <%= link_to user_manage_coupons_path(current_user), class: 'import sub-nav-button w-button' do %>
      &nbsp; <strong>Edit coupons</strong>
    <% end %>
  </div>

  <div class='modal-background w-hidden modal-body'>
    <%= render partial: 'shared/modals/new_coupon'  %> 
  </div>
</div>

<div class="dashboard-body">
  <% @coupons.each do |coupon| %>
  <div class="row-wrapper">
    <div class="alt-table-row w-row">
      <div class="alt-column w-clearfix w-col w-col-3">
        <div class="title-column-div w-clearfix">
          <div class="shrink-text table-text"><%= coupon.name %></div>
        </div>
        <div class="alt-table cb check-box-column">
        </div>
      </div>
      <div class="alt-column w-col w-col-2">
        <div class="alt-table-column-div w-clearfix">
          <%= present(coupon).coupon_type %>
        </div>
      </div>
      <div class="alt-column w-col w-col-2">
        <div class="alt-table-column-div w-clearfix">
          <div class="table-text">
            <%= present(coupon).format_amount %>
          </div>
        </div>
      </div>
      <div class="alt-column w-col w-col-2">
        <div class="alt-table-column-div w-clearfix">
          <div class="shrink-text table-text"><%= coupon.duration.capitalize %></div>
        </div>
      </div>
      <div class="alt-column w-col w-col-2">
        <div class="alt-table-column-div w-clearfix">
          <div class="shrink-text table-text"><%= present(coupon).zone_timestamp %></div>
        </div>
      </div>
      <div class="alt-column w-col w-col-1">
        <div class="alt-table-column-div w-clearfix">
          <div class="table-text"> <%= coupon.max_redemptions %></div>
        </div>
      </div>
    </div>
  </div>
  <% end %>
</div>
