<%= form_for [current_user, @hashtag], :html => { :multipart => true } do |f| %>
 
  <% if @hashtag.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@hashtag.errors.count, "error") %> prohibited this hashtag from being saved:</h2>

      <ul>
      <% @hashtag.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :tag %><br>
    <%= f.text_field :tag %>
  </div>

  <div class="field">
    <%= f.label :description %><br>
    <%= f.text_area :description %>
  </div>

  <% f.fields_for :images do |i| %>
    <%= i.label "Image" %>
    <%= i.file_field :avatar %>
  <% end %>sd
  
  
  <div class="field">
    <%= f.select :type, "<option value=1>Non-payment Hashtag</option><option value=2>One-time payment Hashtag</option><option value=3>Recurring payment Hashtag</option>".html_safe %>
  </div>

  <div class="field">
    <%= f.label :response %><br>
    <%= f.text_area :response %>
  </div>

  <br>

  <div class="field">
    <%= f.check_box :enable_tweet %> <%= f.label :enable_tweet %>

  </div>

  <br>

  <div id="hashtag-payment-settings" style="display:none;">
    <div class="field">
      <%= f.label :amount %>
      <%= f.text_field :amount %>
    </div> <br>
    <div class="field">
      <%#= f.label :is_precedent %>
      <%= f.select :charge_amount, "<option value=0>Allow customers to ovveride amount</option><option value=1>Always charge amount</option>".html_safe %>
    </div>
  </div>

  <br>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>

    