<div class="editor side-bar">
  <div class="dashboard-nav-links">All Customers</div>
  <h5 class="left-nav signup-box-subheading">CREATE HASHTAG</h5>
  <div class="campaign-editor-options w-form">
    <%= form_for [current_user, @hashtag], html: { multipart: true, data: { name: "Email Form" }, id: 'email-form' } do |f| %>
      <label class="editor-options form-label" for="Tag-name"> &nbsp; Tag name</label>
      <%= f.text_field :tag, class: "editor text-field w-input", data: { name: "Tag name" }, id: 'Tag-name', placeholder: "E.g. #CheeseBurger" %>
      <label class="editor-options form-label" for="Tag-Description">&nbsp; &nbsp;Description</label>
      <%= f.text_area :description, class: "editor text-field w-input", data: { name: "Tag Description" }, placeholder: "E.g. Wednesday chesseburger special", id: "Tag-Description" %>
      <label class="editor-options form-label" for="Channel"> &nbsp; Type</label>
      <%= f.select :tag_type, options_for_select({ "Non-payment Hashtag" => "0", "One-time payment Hashtag" => '1', "Recurring payment Hashtag" => "2" }, selected: @hashtag.tag_type), {}, class: 'dropdown editor-dropdown w-select', data: { name: 'Channel' },  id: "Channel" %>
      <div class="editor-options form-label"> &nbsp; Payment Settings</div>
      <div class="editor underline-div"></div>
      <div class="fixed-amount radio-button w-clearfix w-radio">
        <%= f.radio_button :charge_amount, 1, class: "w-radio-input", data: { name: "Radio" }, id:"radio"%>
        <label class="check-radio-text w-form-label" for="radio">Set a fixed amount</label>
      </div>
      <div class="fixed-amount radio-button w-clearfix w-radio">
        <%= f.radio_button :charge_amount, 0 , class: "w-radio-input", data: { name: "Radio" }, id:"radio" %>
          <label class="check-radio-text w-form-label" for="radio">Allow customers to send any amount&nbsp;</label>
        </div>
      <%= file_field_tag "hashtag[images_attributes][][avatar]", type: :file, id: "Amount select-images", accept: "image/*", class: "editor text-field w-input", data: { name: "Amount" } %>
      <%= f.text_field :amount, class: "editor text-field w-input", data: { name: "Tag name" }, id: 'Tag-name', placeholder: "Enter amount (USD)" %>
      <%= f.select :interval, options_for_select({ "Day" => "day", "Week" => 'week', "Month" => "month" }, selected: @hashtag.interval), {},  data: { name: "Interval" },  class: "dropdown editor-dropdown w-select" , id: "Interval plan_interval" %>
      <%= f.text_field :interval_count, class: "editor text-field w-input", data: { name: "Tag name" }, id: 'Tag-name interval-count' %>
      <div class="check-box editor w-checkbox w-clearfix">
        <%= f.check_box :enable_tweet, class: "w-checkbox-input", data: { name: "Deliver Now 2"},  id: "checkbox"   %>
      <label class="check-radio-text w-form-label" for="Deliver-now-2">Enable Tweet</label>
    </div>
      <p class="editor-paragraph tips"> &nbsp;TIP: Fixed amounts for payment Hashtags are suitable for products or services with a set price.</p>
    <div class="w-form-done">
      <div>Thank you! Your submission has been received!</div>
    </div>
    <div class="w-form-fail">
      <div>Oops! Something went wrong while submitting the form</div>
    </div>
  </div>
</div>
<div class="dashboard-body editor">
    <div class="dash-content-container message-editor">
      <div class="w-form">
          <%= f.text_area :response, class: 'message-editor text-area w-input', data: { name: 'Editor Text Area 2' }, id: "Hashtag-Auto-response", placeholder: 'Type message'  %>

        <div class="w-form-done">
          <div>Thank you! Your submission has been received!</div>
        </div>
        <div class="w-form-fail">
          <div>Oops! Something went wrong while submitting the form</div>
        </div>
      </div>
      <div class="editor-button-container">
        <div class="w-row">
          <div class="w-col w-col-6">
            <div class="char-count">0 characters</div><a class="attach-text" href="#"></a>
          </div>
          <div class="w-clearfix w-col w-col-6">
            <%= f.submit 'Create Hashtag', id: 'create-hashtag-btn', class: 'button editor-buttons w-button' %>
        </div>
        </div><img class="editor-thumbnail" src="http://uploads.webflow.com/img/image-placeholder.svg" width="100">
      </div>
    </div>
    <div class="editor-date">December 28, 2016</div>
  </div>
  <div class="alt hashtags sub-nav-bar"></div>
<% end %>
