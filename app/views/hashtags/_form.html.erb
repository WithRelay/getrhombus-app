<%= form_for [current_user, @hashtag], :html => { :multipart => true } do |f| %>

  <div class="editor side-bar" id="create-hashtag-sidebar">

    <div class="dashboard-logo-wrapper">
      <%= link_to user_path(current_user) do %>
        <%= image_tag 'Relay-Transparent-500x300.png', class: "dashboard-logo", width: "50" %>
      <% end %>
    </div>

    <div class="dashboard-nav-links">All Customers</div>
    <h5 class="left-nav signup-box-subheading shrink-text">CREATE HASHTAG</h5>
    <div class="campaign-editor-options">

      <%= f.label :name, class: 'editor-options form-label' do %>
         &nbsp; Name
      <% end %>
      <div class='form-group col-xs-6'>
        <%= f.text_field :name, class: 'form-control editor item-name-field text-field w-input', placeholder: 'E.g. Cheese Burger', autocomplete: 'off' %>
      </div>


      <%= f.label :hashtag, class: 'editor-options form-label lebel_padding' do %>
         &nbsp; Hashtag
      <% end %>
      <div class='form-group col-xs-6'>
        <%= f.text_field :tag, class: 'form-control editor text-field w-input', placeholder: 'E.g. #CheeseBurger' %>
      </div>

      <%= f.label :description, class: "editor-options form-label lebel_padding" do %>
         &nbsp; Description
      <% end %>
      <%= f.text_area :description, class: 'hashtag-description-area text-area w-input', placeholder: 'E.g. Burger with bacon & extra bun' %>

      <label class="editor-options form-label lebel_padding" > &nbsp; Type</label>
      <%= f.select :tag_type, options_for_select(present(@hashtag).get_tag_type_options, selected: present(@hashtag).get_tag_type_value), {}, { class: "dropdown editor-dropdown w-select" } %>

      <div class="hashtag-payment-settings">

        <div class="editor-options form-label"> &nbsp; Payment Settings</div>
        <div class="editor underline-div"></div>
        <div class="fixed-amount radio-button w-clearfix w-radio">
          <%= f.radio_button :charge_amount, 1, class: "w-radio-input", checked: @hashtag.always_charge_amount? %>
          <label class="check-radio-text w-form-label" for="radio">Set a fixed amount</label>
        </div>
        <div class="fixed-amount radio-button w-clearfix w-radio">
          <%= f.radio_button :charge_amount, 0, class: "w-radio-input", checked: @hashtag.new_record? || @hashtag.allow_customers_to_override_amount? %>
          <label class="check-radio-text w-form-label" for="radio">Allow customers to send any amount&nbsp;</label>
        </div>

        <div class='form-group col-xs-6'>
          <%= f.text_field :amount, class: "form-control editor text-field w-input", placeholder: "Enter amount (USD)" %>
        </div>

        <div id='interval-settings'>
          <%= f.select :interval, options_for_select(present(@hashtag).get_tag_interval_options, selected: present(@hashtag).get_interval_string), {}, { id: "plan_interval", class: "dropdown editor-dropdown w-select" } %>
        </div>
      </div>

      <div class="check-box editor w-checkbox w-clearfix lebel_padding padding_tweet_enable">
        <%= f.check_box :enable_tweet, class: "w-checkbox-input" %><label class="check-radio-text w-form-label" for="Deliver-now-2">Enable Tweet</label>
      </div>

      <div class="hashtag-payment-settings">
        <p class="editor-paragraph tips"> &nbsp;TIP: Fixed amounts for payment Hashtags are suitable for products or services with a set price.</p>
      </div>

    </div>
  </div>
  <div class="dashboard-body editor">
    <div class="dash-content-container message-editor">
      <div>
        <div class='form-group col-xs-6'>
          <%= f.text_area :response, class: "form-control message-editor text-area w-input", placeholder: "Type message", id: "hashtag-response-textarea", maxlength: 10 %>
        </div>

      </div>
      <div class="editor-button-container">
        <div class="w-row">
          <div class="w-col w-col-6">
            <%# added id %>
            <div class="char-count" id='char-count'></div>
            <a class="attach-text" href="#" id='select-images-button'></a>
            <%= file_field_tag "hashtag[images_attributes][][avatar]", type: :file, id: "select-images", class: 'hide', accept: "image/*" %>
          </div>
          <div class="w-clearfix w-col w-col-6">
            <%= f.submit present(@hashtag).get_submit_text, id: 'create-hashtag-btn', class: "button editor-buttons w-button" %>
          </div>
        </div>

        <!-- for new images -->
        <div id='new-image-previews'>
        </div>

        <!-- for already attached images -->
        <div id='image-previews' data-model-id='hashtags_<%= @hashtag.id %>'>
          <%= div_for @hashtag.images do |image| %>
            <%= present(image).image_delete_url %>
            <%= present(image).image_url %>
            <%= present(image).image_name %>
          <% end %>
        </div>

      </div>
    </div>

    <% end %>

    <div class="editor-date"><%= todays_date %></div>
  </div>
  <div class="alt hashtags sub-nav-bar"></div>


  <!-- [if lte IE 9]><script src="https://cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif] -->
