<%= form_for([current_user, @hashtag]) do |f| %>
  <% if @hashtag.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@hashtag.errors.count, "error") %> prohibited this hashtag from being saved:</h2>

      <ul>
      <% @hashtag.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </div>
  <div class="field">
    <%= f.label :not_payment_tag %><br>
    <%= f.check_box :not_payment_tag %>
  </div>
  <div class="field" id="hashtag_amount_field">
    <%= f.label :amount %><br>
    <%= f.text_field :amount %>
  </div>
  <div class="field">
    <%= f.label :response %><br>
    <%= f.text_area :response %>
  </div>
  <div class="field">
    <%= f.label :tag %><br>
    <%= f.text_field :tag %>
  </div>

  <div class="field">
    <%= f.label :enable_tweet %><br>
    <%= f.check_box :enable_tweet %>
  </div>

  <div class="field" id="hashtag_precedence_field">
    <%= f.label :is_precedent %><br>
    <%= f.check_box :is_precedent %>
  </div>
  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>

    