
  <div class="customer-dashboard-header list-member sub-nav-bar table-header">
    <div class="table-header">
      <div class="table-header">
        <div class="header new-table-row w-row">
          <div class="cn w-clearfix w-col w-col-3">
            <div class="header name w-clearfix">
              <div class="headings name"> &nbsp; Name</div>
            </div>
            <div class="cb check-box-column header"></div>
          </div>
          <div class="fv w-clearfix w-col w-col-2">
            <div class="cn column column-2 header">
              <div class="first-visit headings"> &nbsp; First visit</div>
            </div>
          </div>
          <div class="lv w-clearfix w-col w-col-2">
            <div class="colum-3 column header lv">
              <div class="headings last-visit">@ &nbsp;Mention date</div>
            </div>
          </div>
          <div class="avs w-clearfix w-col w-col-1">
            <div class="avs column column-4 header">
              <div class="avs headings last-visit"> &nbsp;Amount</div>
            </div>
          </div>
          <div class="ts w-clearfix w-col w-col-1">
            <div class="column column-5 header ts">
              <div class="headings total-spend-header"> &nbsp; Total Spend</div>
            </div>
          </div>
          <div class="table-actions w-clearfix w-col w-col-3">
            <div class="column column-6 header new-row w-clearfix">
              <div class="headings message-customer name">&nbsp; &nbsp;Actions</div>
            </div>
            <div class="column column-6 header new-row w-clearfix">
              <div class="headings location name">&nbsp; &nbsp;Location</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="customer-dash sub-nav-bar">
    <div class="list-members mentions sub-nav-options-wrapper w-clearfix">
      <div class="customer-count">56</div>
      <div class="default-sub_header-field-form-div list-members mentions">
        <form class="add-to-list-form mentions w-clearfix" data-name="Email Form 6" id="email-form-6" name="email-form-6">
          <a class="sub-nav-button w-button" href="#">New hashtag</a><a class="sub-nav-button w-button" href="#"> &nbsp; Create list</a>
        </form>
      </div>
      <div class="customer-count hashtag-index sub-text">in #BlackFriday</div>
    </div>
  </div>
  <div class="dashboard-body">
    <div class="customer-dashboard-table-wrapper list-members row-wrapper">
      <div>
        <div class="new-table-row w-row">
          <div class="cn w-clearfix w-col w-col-3">
            <div class="name w-clearfix">
              <%= image_tag('Green.png', class: 'table-profile-picture', width: 24) %>
              <div class="table-text">Sandra Fried</div>
            </div>
            <div class="cb check-box-column">
              <div>
                <form data-name="Email Form 2" id="email-form-2" name="email-form-2">
                  <div class="select-all-check-box w-checkbox w-clearfix">
                    <input class="cb table-checkbox w-checkbox-input" id="node" type="checkbox">
                    <label class="checkbox-field-lable w-form-label" for="node">-</label>
                  </div>
                </form>
              </div>
            </div>
          </div>
          <div class="fv w-clearfix w-col w-col-2">
            <div class="cn column column-2 w-clearfix">
              <div class="table-text">6 months ago</div>
            </div>
          </div>
          <div class="lv w-clearfix w-col w-col-2">
            <div class="colum-3 column lv">
              <div class="table-text">1 week ago</div>
            </div>
          </div>
          <div class="avs w-clearfix w-col w-col-1">
            <div class="avs column column-4 w-clearfix">
              <div class="table-text">$23,04</div>
            </div>
          </div>
          <div class="ts w-clearfix w-col w-col-1">
            <div class="column column-5 ts w-clearfix">
              <div class="table-text total-spend-text">$400</div>
            </div>
          </div>
          <div class="table-actions w-clearfix w-col w-col-3">
            <div class="column column-6 left new-row">
              <div class="frequency table-text">Washington</div>
            </div>
            <div class="column column-6 new-row"><a class="actions-button notification" href="#">Message</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
