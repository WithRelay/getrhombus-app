<%= provide(:title, "Rhombus - Hashtags") %>
<div class="sub-nav-bar table-header">
  <div class="table-header">
    <div class="table-header">
      <div class="header new-table-row w-row">
        <div class="cn w-clearfix w-col w-col-3">
          <div class="header name w-clearfix">
            <div class="headings name"> &nbsp; Tag name</div>
          </div>
          <div class="cb check-box-column header"></div>
        </div>
        <div class="fv w-clearfix w-col w-col-2">
          <div class="cn column column-2 header">
            <div class="first-visit headings">&nbsp; &nbsp;&nbsp;Created by</div>
          </div>
        </div>
        <div class="lv w-clearfix w-col w-col-2">
          <div class="colum-3 column header lv">
            <div class="headings last-visit"> &nbsp;&nbsp;&nbsp;Date created</div>
          </div>
        </div>
        <div class="avs w-clearfix w-col w-col-1">
          <div class="avs column column-4 header">
            <div class="avs headings last-visit"> &nbsp;&nbsp;&nbsp;Type</div>
          </div>
        </div>
        <div class="ts w-clearfix w-col w-col-1">
          <div class="column column-5 header ts"></div>
        </div>
        <div class="table-actions w-clearfix w-col w-col-3">
          <div class="column column-6 header new-row">
            <div class="headings recipient">@ &nbsp; Mentions</div>
          </div>
          <div class="column column-6 header new-row w-clearfix">
            <div class="headings location name">&nbsp; &nbsp;&nbsp;&nbsp;Total amount</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="customer-dash sub-nav-bar">
  <div class="sub-nav-options-wrapper w-clearfix">
    <a class="add sub-nav-button w-button" data-ix="create-customer" href="#"> &nbsp;<strong>New hashtag</strong></a>
    <a class="import sub-nav-button w-button" data-ix="import-customers" href="#">&nbsp; <strong>Deactivate</strong></a>


    <a class="sub-nav-button w-button" data-ix="create-list" id= "delete-hashtag" href="#"> &nbsp;<strong>Delete</strong></a>

  </div>
</div>
<div class="dashboard-body">
  <% @hashtags.each do |h| %>
  <div class="row-wrapper">
    <div class="alt-table-row w-row">
      <div class="alt-column w-clearfix w-col w-col-3">
        <div class="title-column-div w-clearfix">
          <div class="shrink-text table-text"><%= h.name %></div>
        </div>
        <div class="alt-table cb check-box-column">
          <div class="w-form">
            <%= form_for h, url: user_hashtag_path(current_user, h) do |f| %>
              <div class="select-all-check-box w-checkbox w-clearfix">
                <%= f.hidden_field :id %>
                <input class="cb table-checkbox w-checkbox-input hashtag-check-box" id="node" type="checkbox">
                <label class="checkbox-field-lable w-form-label" for="node">-</label>
              </div>
            <% end %>
            <div class="w-form-done">
              <div>Thank you! Your submission has been received!</div>
            </div>
            <div class="w-form-fail">
              <div>Oops! Something went wrong while submitting the form</div>
            </div>
          </div>
        </div>
      </div>
      <div class="alt-column w-col w-col-2">
        <div class="alt-table-column-div w-clearfix">
            <%= present(h).profile_image %>
          <div class="shrink-text table-text"><%="#{current_user.first_name} #{current_user.last_name}" %></div>
        </div>
      </div>
      <div class="alt-column w-col w-col-2">
        <div class="alt-table-column-div w-clearfix">
          <div class="table-text"><%= present(h).date_in_word %></div>
        </div>
      </div>
      <div class="alt-column w-col w-col-2">
        <div class="alt-table-column-div w-clearfix">
          <div class="table-text">Non-payment</div>
        </div>
      </div>
      <div class="alt-column w-col w-col-2">
        <div class="alt-table-column-div w-clearfix">
          <div class="table-text">---</div>
        </div>
      </div>
      <div class="alt-column w-col w-col-1">
        <div class="alt-table-column-div w-clearfix">
          <div class="table-text"> &nbsp; 279</div>
        </div>
      </div>
    </div>
  </div>
  <% end %>
</div>
