<%= provide(:title, "Relay - Hashtags")  %>
<div class="sub-nav-bar table-header">
  <div class="table-header">
    <div class="table-header">
      <div class="header new-table-row w-row">
        <div class="cn w-clearfix w-col w-col-3">
          <div class="header name w-clearfix">
            <div class="headings name"> &nbsp; Tag name</div>
          </div>
          <div class="cb check-box-column header"></div>
        </div>
        <div class="fv w-clearfix w-col w-col-2">
          <div class="cn column column-2 header">
            <div class="first-visit headings">&nbsp; &nbsp;&nbsp;Created by</div>
          </div>
        </div>
        <div class="lv w-clearfix w-col w-col-2">
          <div class="colum-3 column header lv">
            <div class="headings last-visit"> &nbsp;&nbsp;&nbsp;Date created</div>
          </div>
        </div>
        <div class="avs w-clearfix w-col w-col-1">
          <div class="avs column column-4 header">
            <div class="avs headings last-visit"> &nbsp;&nbsp;&nbsp;Type</div>
          </div>
        </div>
        <div class="ts w-clearfix w-col w-col-1">
          <div class="column column-5 header ts"></div>
        </div>
        <div class="table-actions w-clearfix w-col w-col-3">
          <div class="column column-6 header new-row">
            <div class="headings recipient">@ &nbsp; Mentions</div>
          </div>
          <div class="column column-6 header new-row w-clearfix">
            <div class="headings location name">&nbsp; &nbsp;&nbsp;&nbsp;Total amount</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%= render 'sub_nav' %>
<div class="dashboard-body">
  <div id='objlists'>
    <%= render @hashtags %>
  </div>
  <%= (will_paginate(@hashtags)).html_safe if @hashtags.count > PAGINATION_PER_PAGE %>
</div>
