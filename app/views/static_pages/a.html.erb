  

    <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Sign Up') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>
  
  <style type="text/css">
    body{background: #F5F5F5;}
  </style>
  
  <body>

  <div class="login-form">
      <form action="index.html" id="signupForm" >
        <div class="top">
          <img src="<%= asset_path 'logo_grey.jpg' %>" alt="icon" id="signup_logo" class="icon">
          <h4>Create an account.</h4>
        </div>
        <div class="form-area">
          <div class="group">
            <input type="email" name="email" class="form-control rhombusFocus" placeholder="E-mail">
            <i class="fa fa-envelope-o"></i>
          </div>
          <div class="group phonegroup">
            <input type="tel" id="phone" name="phone" class="form-control rhombusFocus">
          </div>
          <div class="group">
            <input type="password" class="form-control rhombusFocus" name="password" placeholder="Password">
            <i class="fa fa-key"></i>
          </div>
          <div class="group">
            <input type="password" class="form-control rhombusFocus" name="confirmPassword" placeholder="Password again">
            <i class="fa fa-key"></i>
          </div>
          <div class="form-group accountTypegroup">         
              <select class="selectpicker rhombusFocus" name="accountType" title="">
                <option value='' disabled selected class='hide'>Please select account type</option>
                <option value="0">I'm a customer</option>
                <option value="1">I'm a merchant</option>
                <option value="1">I'm a non-profit</option>
              </select>                  
          </div>          
          <button type="submit" class="btn btn-default btn-block btn-rhombus">SIGN UP</button>
          <p id="termsNote">By signing up, I agree to Rhombus <a href="/terms">terms and conditions.</a></p>
        </div>
      </form>
      <div class="footer-links row">
        <div class="col-xs-6"><a href="/signin"><i class="fa fa-sign-in"></i> Login</a></div>
        <div class="col-xs-6 text-right"><a href="/users/password/new"><i class="fa fa-lock"></i> Forgot password</a></div>
        <div class="col-md-12 hide" id="rhombusPower"><img src="<%= asset_path 'poweredbyR.jpg' %>"></div>
      </div>
    </div>

    <input type="hidden" id="referrer_number" value=''>
    <input type="hidden" id="subscription_type" value=''>

</body>
</html>