  

    <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Sign Up') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>
  
  <style type="text/css">
    body{background: #F5F5F5;}
  </style>
  
  <body>

  <div style="margin: 20px;">
<p id="output">Please enter a number below</p>
<input id="referrer_number" type="text" <%#= hidden %> >
</div>

    <div class="login-form">
      <form action="index.html" id="signupForm" >
        <div class="top">
          <img src="<%= asset_path 'logo.jpg' %>" alt="icon" id="signup_logo" class="icon">
          <h4>Create an account.</h4>
        </div>
        <div class="form-area">
          <div class="group">
            <input type="email" name="email" class="form-control" placeholder="E-mail">
            <i class="fa fa-envelope-o"></i>
          </div>
          <div class="group phoneNumber" style="width: 100% !important;">
            <input type="tel" id="phone" name="phone" class="form-control" style="padding-left: 43px;">
          </div>
          <div class="group">
            <input type="password" class="form-control" name="password" placeholder="Password">
            <i class="fa fa-key"></i>
          </div>
          <div class="group">
            <input type="password" class="form-control" name="confirmPassword" placeholder="Password again">
            <i class="fa fa-key"></i>
          </div>
          <div class="group">         
              <select class="selectpicker" name="accountType" >
                <option value=''></option>
                <option value="a">I'm a customer</option>
                <option value="b">I'm a merchant</option>
              </select>                  
          </div>          
          <button type="submit" class="btn btn-default btn-block">REGISTER NOW</button>
          <p>By signing up I agree to Rhombus terms and conditions.</p>
        </div>
      </form>
      <div class="footer-links row">
        <div class="col-xs-6"><a href="/z"><i class="fa fa-sign-in"></i> Login</a></div>
        <div class="col-xs-6 text-right"><a href="#"><i class="fa fa-lock"></i> Forgot password</a></div>
      </div>
    </div>

<%#= javascript_include_tag "bootstrap-select" %>

</body>
</html>