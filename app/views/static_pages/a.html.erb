  

    <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Sign Up') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>

  <%= content_for :head_script do %>
  <%= javascript_include_tag "bootstrap-select.js" %>
    <%= javascript_include_tag "custom.js" %>
  <% end %>

  <style type="text/css">
    body{background: #F5F5F5;}
  </style>
  
  <body>

  <div style="margin: 20px;">
<p id="output">Please enter a number below</p>
<input id="referrer_number" type="text" <%#= hidden %> >
</div>

    <div class="login-form">
      <form action="index.html">
        <div class="top">
          <img src="<%= asset_path 'logo.jpg' %>" alt="icon" id="signup_logo" class="icon">
          <h4>Create an account.</h4>
        </div>
        <div class="form-area">
          <div class="group">
            <input type="text" class="form-control" placeholder="E-mail">
            <i class="fa fa-envelope-o"></i>
          </div>
          <div class="group">
            <%#<input type="tel" id="phone" class="form-control">%>
          </div>
          <div class="group">
            <input type="password" class="form-control" placeholder="Password">
            <i class="fa fa-key"></i>
          </div>
          <div class="group">
            <input type="password" class="form-control" placeholder="Password again">
            <i class="fa fa-key"></i>
          </div>
          <div class="group">
            <select class="selectpicker">
                <%#<option value="" disabled selected style='display:none;'>Select your option</option>%>
                <option>Graphicriver</option>
                <option>Activeden</option>
            </select>                    
          </div>
          
          
                                
                  
          <button type="submit" class="btn btn-default btn-block">REGISTER NOW</button>
          <p>By signing up I agree to Rhombus terms and conditions.</p>
        </div>
      </form>
      <div class="footer-links row">
        <div class="col-xs-6"><a href="/z"><i class="fa fa-sign-in"></i> Login</a></div>
        <div class="col-xs-6 text-right"><a href="#"><i class="fa fa-lock"></i> Forgot password</a></div>
      </div>
    </div>

  

</body>
</html>