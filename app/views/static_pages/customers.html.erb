  <% provide(:title, 'Rhombus - Customers') %>

  <%= content_for :head do %>
  <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.4/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "normalize" %>
    <%= stylesheet_link_tag "webflow" %>
    <%= stylesheet_link_tag "rho.webflow" %>
  <% end %>

   <style type="text/css">
    @media screen and (min-width: 1200px) {
        .w-container {
          max-width: 1170px;
        }
      }
      .w-slider-nav-invert>div {
    background-color: #e5e5e5; !important
}
  </style>

  <%= render 'shared/static_pages_header' %>
  

  <%#= render 'shared/full_messages' %>


  <div class="w-section banner inner _2" id="top" data-ix="show-social-and-nav">
    <div class="w-container">
      <div class="div-center" data-ix="show-navigation">
        <h2 class="h-inner" data-ix="h-inner"><span class="customer-hero-text">All your favorite businesses – at your fingertips.</span></h2>
      </div>
    </div>
  </div>
  <div class="w-section section gray customers-form-section">
    <div class="w-container">
      <div class="<%#w-form%>">

        <form class="customers-form" id="tell-me-form">
          <div class="form-group"><input class="w-input customers-phone" id="phone" type="tel" placeholder="Enter your phone number" name="phone">
          <input class="w-input customers-zip" id="zip" type="text" placeholder="Zip code" name="zip">
          <button class="w-button button customer-text-me text-me-btn" id="text-me-btn" type="submit" value="TEXT ME A LIST OF BUSINESSES">
            TEXT ME A LIST OF BUSINESSES</button> </div>
        </form>

      </div>
    </div>
  </div>
  <div class="w-section section hm-section-7">
    <div class="w-container">
      <div class="w-row row-business-icons">
        <div class="w-col w-col-2"><img src="<%= asset_path'Taxi-50.png' %>">
          <div class="business-icons-text">TAXI</div>
        </div>
        <div class="w-col w-col-2"><img src="<%= asset_path'Restaurant-50.png' %>">
          <div class="business-icons-text">RESTAURANT</div>
        </div>
        <div class="w-col w-col-2"><img src="<%= asset_path'Coffee To Go-50.png' %>">
          <div class="business-icons-text">COFFEE SHOP</div>
        </div>
        <div class="w-col w-col-2"><img src="<%= asset_path'Hair Dryer-50.png' %>">
          <div class="business-icons-text">BEAUTY PROFESSIONALS</div>
        </div>
        <div class="w-col w-col-2"><img src="<%= asset_path'Roller Brush-50.png' %>">
          <div class="business-icons-text">HOME &amp; REPAIR SERVICES</div>
        </div>
        <div class="w-col w-col-2"><img src="<%= asset_path'Money Transfer-50.png' %>">
          <div class="business-icons-text">ORGS &amp; NONPROFITS</div>
        </div>
      </div>
      <div class="business-icons-spacing"></div>
      <div class="w-row row-business-icons">
        <div class="w-col w-col-2"><img src="<%= asset_path'Delivery-50.png' %>">
          <div class="business-icons-text">ON-DEMAND DELIVERY</div>
        </div>
        <div class="w-col w-col-2"><img src="<%= asset_path'Price Tag-50.png' %>">
          <div class="business-icons-text">RETAIL</div>
        </div>
        <div class="w-col w-col-2"><img src="<%= asset_path'Broom-50.png' %>">
          <div class="business-icons-text">CLEANING SERVICES</div>
        </div>
        <div class="w-col w-col-2"><img src="<%= asset_path'Briefcase-50.png' %>">
          <div class="business-icons-text">PROFESSIONAL SERVICES</div>
        </div>
        <div class="w-col w-col-2"><img src="<%= asset_path'Dumbbell-50.png' %>">
          <div class="business-icons-text">HEALTH &amp; FITNESS</div>
        </div>
        <div class="w-col w-col-2"><img src="<%= asset_path'Purchase Order-50.png' %>">
          <div class="business-icons-text">OTHERS</div>
        </div>
      </div>
    </div>
  </div>
  <div class="w-section section gray">
    <div class="w-container">
      <div class="w-row">
        <div class="w-col w-col-4" data-ix="show-social-team">
          <div class="div-spc center">
            <h4 class="h-team">simple</h4>
            <p>No app downloads required. You can use simple text messages on any mobile device to chat with a local business or pay for things.</p>
          </div>
        </div>
        <div class="w-col w-col-4 col-spcae" data-ix="show-social-team">
          <div class="div-spc center">
            <h4 class="h-team">safe</h4>
            <p>Paying with rhombus is safer than debit cards or checks. We encrypt and tokenize your payment information so no one can have access to it. You will never have to give out sensitive information to businesses.</p>
          </div>
        </div>
        <div class="w-col w-col-4 col-spcae" data-ix="show-social-team">
          <div class="div-spc center">
            <h4 class="h-team">CONVENIENT</h4>
            <p>Spend less time paying for items or donating to a cause. No more debit or credit card forms. No more checks. No more calling out sensitive payment information over the phone.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="w-section section customer-section-4">
    <div class="w-container">
      <div class="w-row">
        <div class="w-col w-col-7 w-col-stack">
          <div data-ix="img-from-left"><img src="<%= asset_path'Rhombus Iphone 1.png' %>">
          </div>
        </div>
        <div class="w-col w-col-5 w-col-stack col-spcae">
          <div class="div-spc section-3-spacing"></div>
          <div class="div-spc section-3-spacing"></div>
          <h1 class="customer-section-4-title">Everything on demand –<br>zero hassle.</h1>
          <p class="customer-section-4-text">Get what you want, when you want it from any local business. Order take-out or delivery, make dinner reservations, book hair appointments, schedule laundry pick-up, check in-store availability, and more, all without ever placing a phone call. Best of all, you can also text in your payments to complete an order.</p><a class="button hm-section-4-button" href="/signup">get started</a>
        </div>
      </div>
    </div>
  </div>
  <div class="w-section section paralax">
    <div class="w-container">
      <div class="customers-section-6-title">
        <div>How it Works</div>
      </div>
      <div class="w-row">
        <div class="w-col w-col-4">
          <div class="div-img" data-ix="move-img">
            <img src="<%= asset_path 'Rhombus Step 1.png' %>">
              
            
          </div>
        </div>
        <div class="w-col w-col-4">
          <div class="div-img" data-ix="move-img-2">
            <img src="<%= asset_path 'Rhombus Step 2.png' %>">
              
            
          </div>
        </div>
        <div class="w-col w-col-4"><img src="<%= asset_path 'Rhombus Step 3.png' %>">
        </div>
      </div>
    </div>
  </div>
