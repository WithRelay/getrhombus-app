<% provide(:title, 'Pay with Rhombus') %>

<%= content_for :head do %>
  <%#= stylesheet_link_tag "style_home.css", "data-turbolinks-track" => true %>
  <%#= stylesheet_link_tag "responsive_home.css", "data-turbolinks-track" => true %>
  <%#= stylesheet_link_tag "custom_home.css", "data-turbolinks-track" => true %>
  <%= stylesheet_link_tag "mainly_static_pages", "data-turbolinks-track" => true %>
<% end %>

<body>

	<div class="main-wrapper">
		<%= render 'shared/header' %>
		
			<div class="section grey">
			<div class="container">
				<div class="p-t-60 p-b-60">
					<div class="row">
						<div class="col-md-8 col-md-offset-2">
							<h2 class="text-center m-b-30 sell_margin">Pay with Rhombus Whenever, Wherever.<p class="sell_caption sell_margin">
								Send payments seamlessly to your favorite take-out restaurants, dry-cleaner, non-profits, etc. using simple text messages on any device. No app downloads required.</p>
								<a class="btn btn-danger btn-cons call_to_action_btn call_to_action_btn btn_one sell_margin" href="/signup">Sign up</a>
								<a class="btn btn-primary btn-cons call_to_action_btn sell_margin sell_button_two" href="/faqs">Learn More</a>
							</h2>

						</div>					
					</div>
				</div>
			</div>
		</div>

	

<div class="section white ha-waypoint" >
		<div class="container">
		<div class="p-t-60">
		<div class="row">
		<div class="col-md-12 feature-list ">
			<div class="col-md-4">
			<h4 class="title">SIMPLE</h4>
			<p>
			No app downloads required. You can use simple text messages on any mobile device to pay for things or donate to a good cause.
			</p>
			</div>
			<div class="col-md-4">
			<h4 class="title">SAFE</h4>
			<p>
		Paying with rhombus is safer than debit cards or checks.  We encrypt and tokenize your payment information so no one can have access to it. You will never have to give out sensitive information to businesses.
			</p>
			</div>
			<div class="col-md-4">
			<h4 class="title">CONVENIENT</h4>
			<p>
		Spend less time paying for items or donating to a cause. No more debit or credit card forms. No more checks. No more calling out sensitive payment information over the phone. Simply text the amount and description. Done! 
			</p>
			</div><div class="clearfix"></div>
		</div>

			<div class="col-md-12 feature-list ">
			<div class="col-md-4">
			<h4 class="title">TEXT "SIGNUP" TO GET STARTED</h4>
			<p>
			To start paying with Rhombus, simply text “signup” to the rhombus number of your favorite local business or non-profit.
			</p>
			</div>
			<div class="col-md-4">
			<h4 class="title">COMPLETE YOUR ACCOUNT</h4>
			<p>
Follow the signup link on your phone to complete your account.
			</p>
			</div>
			<div class="col-md-4">
			<h4 class="title">START PAYING</h4>
			<p>
To send your first payment simply text the amount you’re sending, followed by a description. Done! You will receive a payment confirmation via SMS, and an email receipt for your purchase or donation. 
			</p>
			</div><div class="clearfix"></div>
		</div>
				<div class="col-md-12 feature-list pricing">
		Sending payments to a Rhombus number is completely free as long as you register with a supported debit card, credit card or bank account.
		<div class="clearfix"></div>
		</div>

		</div>
		<br>
		</div>
	  </div>
	</div>




<div class="section grey">
	<div class="container">
	  <div class="p-t-40 p-b-50 ">

		<div class="row feature-list value_prop">	
 	     	<div>
		Rhombus takes the hassle out of collecting payments or donations from your customers, members or group of friends on any mobile device, using the most ubiquitous messaging system – SMS. The friction-free process lets users make a purchase or donation instantly by texting an amount and description to your Rhombus number!
			</div>

		</div>
	</div>
</div>	

<div class="section table-layout">	
			<div id="working-section" class="table-cell v-middle">	
				<div >
				<h3 class="text-white text-center custom-font no-margin">JOIN A GROWING LIST OF PEOPLE PAYING WITH RHOMBUS</h3>
				</div>
			</div>
</div>

<div class="section grey">
		<div class="container">
			<div class="p-t-60 p-b-60">
				<div class="row">
					<div class="col-md-8 col-md-offset-2">
						<h2 class="text-center m-b-30">Sign up to start making payments<a class="btn btn-primary btn-cons call_to_action_btn" href="/signup">Sign up</a></h2>				
					</div>					
				</div>
				
			</div>
		</div>
</div>

<%= render "shared/footer" %>


</body>