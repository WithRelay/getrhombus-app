<div class="alt hero-content w-container">
  <h1 class="hero-h1 home-header">Schedule a demo below. We'll walk you through the features specific to your use case &amp; answer all your questions.</h1>
</div>
</div> <!-- This div refers to closing div for opening div in header due to sticky header -->
<div class="default-content-section">
  <h1 class="first-content-section-sub-header footer-cta-header">Schedule a Demo</h1>
  <h5 class="footer-cta-subheading signup-box-subheading">get a 30-minute overview of relay</h5>
  <div class="demo-request footer-cta-forms w-form">
    <form data-name="Email Form" id="email-form" name="email-form">
      <input class="text-field w-input" data-name="Name" id="Name" maxlength="256" name="Name" placeholder="Full name" required="required" type="text">
      <input class="company text-field w-input" data-name="Company" id="Company" maxlength="256" name="Company" placeholder="Company" required="required" type="text">
      <input class="footer-cta-field text-field w-input" data-name="Work Email" id="Work-Email" maxlength="256" name="Work-Email" placeholder="Work email" required="required" type="email">
      <input class="text-field w-input" data-name="Phone Number 2" id="Phone-Number-2" maxlength="256" name="Phone-Number-2" placeholder="Phone number" required="required" type="text">
      <select class="dropdown w-select" id="field" name="field" required="required">
        <option value="">Number of employees</option>
        <option value="Another Choice">1-9</option>
        <option value="Another Choice">10-24</option>
        <option value="Another Choice">25-49</option>
        <option value="Another Choice">50-99</option>
        <option value="Another Choice">100-249</option>
        <option value="Another Choice">250-499</option>
        <option value="Another Choice">500-999</option>
        <option value="Another Choice">1000-4999</option>
        <option value="Another Choice">5000+</option>
      </select><a class="alt-hero-cta-button footer-cta-button home w-button" href="#">Schedule Demo</a>
    </form>
    <div class="w-form-done">
      <div>Thank you! Your submission has been received!</div>
    </div>
    <div class="w-form-fail">
      <div>Oops! Something went wrong while submitting the form</div>
    </div>
  </div>
</div>
