<!-- Calendly Assets -->
<link href="https://calendly.com/assets/external/widget.css" rel="stylesheet" >
<style type="text/css"> 
  .calendly-badge-content { display: none !important; }
</style>
<script src="https://calendly.com/assets/external/widget.js" type="text/javascript"></script>
<!-- End Calendly Assets -->
<div class="alt hero-content w-container">
  <h1 class="hero-h1 home-header">Schedule a demo below. We'll walk you through the features specific to your use case &amp; answer all your questions.</h1>
</div>
</div> <!-- This div refers to closing div for opening div in header due to sticky header -->
<div class="default-content-section" id="request-demo-page">
  <h1 class="first-content-section-sub-header footer-cta-header">Schedule a Demo</h1>
  <h5 class="footer-cta-subheading signup-box-subheading">get a 30-minute overview of relay</h5>
  <div class="demo-request footer-cta-forms w-form">
    <%= form_for 'demo', url: '#',html: { id: 'demoForm'} do |f| %>
      <div class="form-group col-xs-6">
        <%= f.text_field :full_name, class: 'form-control text-field w-input', placeholder: "Full name"  %>
        </div>

      <div class="form-group col-xs-6">
        <%= f.text_field :company, class: 'form-control company text-field w-input', placeholder: "Company"  %>
        </div>

      <div class="form-group col-xs-6">
        <%= f.text_field :email, class: 'form-control footer-cta-field text-field w-input', placeholder: "Work email"  %>
        </div>

      <div class="form-group col-xs-6">
        <%= f.phone_field :phone, placeholder: 'Phone Number', class: 'form-control text-field w-input', id: 'phone', placeholder: "Phone Number" %>
        <%= f.hidden_field :phone_number, :id => "phone_number" %>
      </div>

      <div class="form-group col-xs-6">
        <%= f.select :employee_count, options_for_select({'1-9' => '1-9','10-24'=>'10-24','25-49' => '25-49','50-99' => '50-99',  '100-249'=>'100-249', '250-499'=>'250-499','500-999' => '500-999', '1000-4999' => '1000-4999', '5000+' => '5000+'  }), {include_blank: "Number of employees"}, class: 'form-control dropdown w-select' %>
        </div>

      <%= f.submit 'Schedule Demo', id: 'commit_demo',class: 'alt-hero-cta-button footer-cta-button home w-button' %>
      <% end %>
  </div>
</div>
