<% provide(:title, 'Rhombus - Pricing') %>

<div class="hero-content pricing w-container">
  <h1 class="hero-h1 home-header pricing-hero">Simple Pricing</h1>
  <h5 class="hero-section-sub signup-box-subheading">TRY IT FREE FOR 14 DAYS ON PAID PLANS</h5>
</div>
<div class="def-content-row w-row">
  <div class="pricing-row-column-1 w-clearfix w-col w-col-6">
    <div class="def-row-content-wrapper plan-2">
      <h5 class="premium-table signup-box-subheading">ALL FEATURES INCLUDED IN EVERY PLAN</h5>
      <div class="premium-features pricing-table-feature-list">Unlimited Inbound &amp; Outbound Messages</div>
      <div class="premium-features pricing-table-feature-list">Customer Segmentation</div>
      <div class="premium-features pricing-table-feature-list">Drip Campaigns</div>
      <div class="premium-features pricing-table-feature-list">Hashtags &amp; Keywords</div>
      <div class="premium-features pricing-table-feature-list">Automated Responses</div>
      <div class="premium-features pricing-table-feature-list">Customer Import</div>
      <div class="premium-features pricing-table-feature-list">Stripe Integration for Charges &amp; Subscriptions</div>
      <div class="premium-features pricing-table-feature-list">In-Chat Payments</div>
      <div class="premium-features pricing-table-feature-list">Messaging &amp; Transaction Analytics</div>
      <div class="premium-features pricing-table-feature-list">Full Contact Data</div>
      <div class="premium-features pricing-table-feature-list">OpenCNAM Data</div>
      <div class="premium-features pricing-table-feature-list">Data Export</div>
      <div class="premium-features pricing-table-feature-list">Free SMS Number | Cost Per SMS: $0.025</div>
    </div>
  </div>
  <div class="pricing-row-column-2 w-clearfix w-col w-col-6">
    <div class="def-row-content-wrapper">
      <%= image_tag('003_043.png', class: 'pricing-table-icon') %>
      <h1 class="first-content-section-sub-header pricing-header">Unlimited usage for your team</h1>
      <p class="def-content-section-paragraph pricing-paragraph">Pricing is based on how many active customers or leads you communicate with inside Relay. No per seat pricing.
        <br>
        <br>How many customers do you have?</p>
      <div class="slider-wrapper">
        <%= image_tag('Slider-Placeholder-2.png', class: 'slider-placeholder') %>
      </div>
      <h1 class="plan-amount">$0</h1>
      <h5 class="signup-box-subheading starter-table">BILLED MONTHLY</h5><a class="button pricing-table-button w-button" href="#">Get Started</a>
    </div>
  </div>
</div>
</div>
<div class="default-content-section-2 signup-box">
<div class="pricing-div"></div>
<div class="payment-pricing">
  <div class="transaction-fee-section">
    <div class="content-wrapper transaction-fee-wrapper w-container">
      <h1 class="first-content-section-sub-header transaction-fee-table-subheader">Transaction Fee</h1>
      <h5 class="signup-box-subheading">2-DAY PAYOUTS . PCI COMPLIANT . INTEGRATED FRAUD TOOLS</h5>
      <div class="transaction-fee-table w-row">
        <div class="transaction-fee-table-column-1 w-col w-col-7">
          <h1 class="first-content-section-sub-header transaction-table-subheader">Debit &amp; Credit Cards</h1>
          <p class="transaction-fee-table-description">We charge a percentage-based fee each time you accept a credit or debit card payment. The price is the same for all major cards, including American Express. There’s no additional fee for international cards, failed charges, or refunds.</p>
          <%= image_tag('payment-card-types.svg', class: 'payment-card-types') %>
        </div>
        <div class="transaction-fee-table-column-2 w-col w-col-5">
          <h1 class="first-content-section-sub-header transaction-fee-amount">2.9% + $0.30</h1>
          <h5 class="signup-box-subheading">PER SUCCESSFUL TRANSACTION</h5>
        </div>
      </div>
    </div>
  </div>
</div>
</div>
<div class="default-content-section pricing">
