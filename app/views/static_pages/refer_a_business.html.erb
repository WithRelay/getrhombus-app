<div class="business-referral-image-wrapper">
  <h1 class="alt hero-h1 home-header use-case-header">
    Give your favorite local businesses free software, <br>and earn up to $300 when they sign up
  </h1>
</div>
<div class="home sub-hero-div use-case">
  <h1 class="sub-hero-header">We've made it extremely easy for businesses to make customers happy <br>using personalized mobile messaging, help us spread the word.</h1>
  <div class="customer-interactions-table w-row">
    <div class="w-col w-col-4">
      <div class="customer-interaction-content-wrapper first">
        <div class="featues-div-header-wrapper"><img class="features-div-icon" src="../assets/008_053.png">
        </div>
        <div class="features-div-paragraph-wrapper">
          <h3 class="features-div-header-text">Tell us about the business</h3>
          <p class="feature-div-paragraph">Respond to customer inquiries via SMS or Facebook Messenger, so you can provide better support, quicker.</p>
        </div>
      </div>
    </div>
    <div class="w-col w-col-4">
      <div class="customer-interaction-content-wrapper">
        <div class="featues-div-header-wrapper"><img class="features-div-icon" src="../assets/011_146.png">
        </div>
        <div class="features-div-paragraph-wrapper">
          <h3 class="features-div-header-text">Notify the owner</h3>
          <p class="feature-div-paragraph">Automate important notifications like bill payment due date, appointment reminders, etc. via mobile messaging.</p>
        </div>
      </div>
    </div>
    <div class="w-col w-col-4">
      <div class="customer-interaction-content-wrapper">
        <div class="featues-div-header-wrapper"><img class="features-div-icon" src="../assets/014_124.png">
        </div>
        <div class="features-div-paragraph-wrapper">
          <h3 class="features-div-header-text">earn commissions</h3>
          <p class="feature-div-paragraph">Segment your customers &nbsp;and send them targeted mobile messages to drive more sales.</p>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="default-content-section features-page">
  <div class="def-content-section-wrapper w-container"><img class="section-icon" src="../assets/015_037.png">
    <h1 class="sub-hero-header">Business Referral</h1>
  </div>
  <div class="business-referral-table w-row">
    <div class="business-referral-table-column-1 w-col w-col-6">
      <h3 class="section-3-header">Facebook Messenger Integration</h3>
      <p class="def-content-section-paragraph section-4">Untether support from your website "live chat" by allowing your customers message you anywhere anytime via SMS or Facebook Messenger.&nbsp;</p>
      <h3 class="section-3-header">Facebook Messenger Integration</h3>
      <p class="def-content-section-paragraph section-4">Untether support from your website "live chat" by allowing your customers message you anywhere anytime via SMS or Facebook Messenger.&nbsp;</p>
      <h3 class="section-3-header">Facebook Messenger Integration</h3>
      <p class="def-content-section-paragraph section-4">Untether support from your website "live chat" by allowing your customers message you anywhere anytime via SMS or Facebook Messenger.&nbsp;</p>
    </div>
    <div class="w-col w-col-6">
      <div class="account-settings-form-wrapper business-referral">
        <div id= 'refer-a-business'>
          <%= form_for('referrer', :html => { :class => "w-clearfix", :id => "referrerForm" } ) do |f| %>

            <label class="field-headers form-label settings" for="name">referrer details</label>
            <div class="form-group col-xs-6">
              <%= f.text_field 'referrer_name', placeholder: 'Your full name', class: 'form-control full-name settings text-field w-input' %>
            </div>

            <div class="form-group col-xs-6">
              <%= f.text_field 'referrer_email', placeholder: 'Your email address', class: 'form-control settings text-field w-input' %>
            </div>
            <div class="flex-underline form-section-divider"></div>

            <label class="field-headers form-label settings" for="Referee-Business-Name">i'm referring</label>

            <div class="form-group col-xs-6">
              <%= f.text_field 'org_name', placeholder: 'Name of the business you\'re referring', class: 'form-control full-name settings text-field w-input'%>
            </div>

            <div class="form-group col-xs-6">
              <%= f.text_field 'referee_email', placeholder: 'Contact person\'s email address', class: 'form-control settings text-field w-input' %>
            </div>

            <div class="form-group col-xs-6">
              <%= f.phone_field 'phone', placeholder: 'Phone Number (optional)', class: 'form-control settings text-field w-input', id: 'phone' %>
              <%= f.hidden_field :phone_number, :id => "phone_number" %>
            </div>

            <div class="form-group col-xs-6">
              <%= f.select :country, country_list, { prompt: 'Select your country' }, { class: 'form-control country_dropdown w-select', id:'user-country' } %>
            </div>

            <%= f.button "Invite business", id: 'referrer-submit', class: "button save-changes w-button" %>

          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>
