<div class="use-case-image-wrapper-sales">
<h1 class="alt hero-h1 home-header use-case-header">Increase your sales conversion by 30%, and <br>retain existing customers using text messages</h1>
      <h5 class="footer-cta-subheading signup-box-subheading use-case">agencies, sales staff, in-house marketing teams</h5><a class="button use-case-button w-button" href="#">Get started for free</a><a class="button demo-request use-case-button w-button" href="#">Schedule Demo</a>  </div>
<div class="home sub-hero-div use-case">
  <h1 class="sub-hero-header">Communicate with prospects and customers effectively. <br>Guaranteed 98% open rates for mobile messages.</h1>
  <div class="customer-interactions-table w-row">
    <div class="w-col w-col-4">
      <div class="customer-interaction-content-wrapper first">
        <div class="featues-div-header-wrapper">
          <%= image_tag('003_012.png', class: 'features-div-icon')%>
        </div>
        <div class="features-div-paragraph-wrapper">
          <h3 class="features-div-header-text">Outbound Sales Outreach</h3>
          <p class="feature-div-paragraph">Jump-start your outbound sales outreach using simple text messages as part of your entire workflow</p>
        </div>
      </div>
    </div>
    <div class="w-col w-col-4">
      <div class="customer-interaction-content-wrapper">
        <div class="featues-div-header-wrapper">
          <%= image_tag('011_164.png', class: 'features-div-icon')%>
        </div>
        <div class="features-div-paragraph-wrapper">
          <h3 class="features-div-header-text">Marketing Automation</h3>
          <p class="feature-div-paragraph">Segment and target prospects or existing customers to drive more sales and reduce customer churn</p>
        </div>
      </div>
    </div>
    <div class="w-col w-col-4">
      <div class="customer-interaction-content-wrapper">
        <div class="featues-div-header-wrapper">
          <%= image_tag('Wallet.png', class: 'features-div-icon', width: 60) %>
        </div>
        <div class="features-div-paragraph-wrapper">
          <h3 class="features-div-header-text">Payments &amp; Transactions</h3>
          <p class="feature-div-paragraph">Go from first outreach to closed sale without leaving the conversation, make it easy for prospects and customers to pay you using short text commands</p>
        </div>
      </div>
    </div>
  </div>
</div>
