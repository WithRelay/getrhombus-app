  

    <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Sign Up') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>
  

  <body>
  <!-- Start Page Loading -->
  <div class="loading"><img src="<%= asset_path 'loading.gif' %>" alt="loading-img"></div>
  <!-- End Page Loading -->

 <%= render 'shared/header_new' %>
  <%= render 'shared/sidebar' %>

  <div class="content">
    <!-- Start Page Header -->
    <div class="page-header">
      <h1 class="title">Payment Info</h1>
      <!-- Start Page Header Right Div -->
      <div class="right">
        <div class="btn-group" role="group" aria-label="...">
          <a href="index.html" class="btn btn-light">Dashboard</a>
          <a href="#" class="btn btn-light"><i class="fa fa-refresh"></i></a>
        </div>
      </div>
      <!-- End Page Header Right Div -->
    </div>
    <!-- End Page Header -->

    <div class="login-form">
      <form action="index.html" id="signupForm" >
        <div class="top">
          <img src="<%= asset_path 'logo.jpg' %>" alt="icon" id="signup_logo" class="icon">
          <h4>Create an account.</h4>
        </div>
        <div class="form-area">
          <div class="group">
            <input type="email" name="email" class="form-control" placeholder="E-mail">
            <i class="fa fa-envelope-o"></i>
          </div>
          <div class="group" style="width: 100% !important;">
            <input type="tel" id="phone" name="phone" class="form-control" style="padding-left: 43px;">
          </div>
          <div class="group">
            <input type="password" class="form-control" name="password" placeholder="Password">
            <i class="fa fa-key"></i>
          </div>
          <div class="group">
            <input type="password" class="form-control" name="confirmPassword" placeholder="Password again">
            <i class="fa fa-key"></i>
          </div>
          <div class="group" style="width: 100%;">         
              <select class="selectpicker" name="accountType" title="">
                <option value='' disabled selected style='display:none;'>Please select account type</option>
                <option value="0">I'm a customer</option>
                <option value="1">I'm a merchant</option>
                <option value="1">I'm a non-profit</option>
              </select>                  
          </div>          
          <button type="submit" class="btn btn-default btn-block">REGISTER NOW</button>
          <p>By signing up I agree to Rhombus terms and conditions.</p>
        </div>
      </form>
      <div class="footer-links row">
        <div class="col-xs-6"><a href="/z"><i class="fa fa-sign-in"></i> Login</a></div>
        <div class="col-xs-6 text-right"><a href="#"><i class="fa fa-lock"></i> Forgot password</a></div>
      </div>
    </div>

<%#= javascript_include_tag "bootstrap-select" %>


 </div>

</body>
</html>