  

    <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Sign Up') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>
  

  <body>
  <!-- Start Page Loading -->
  <div class="loading"><img src="<%= asset_path 'loading.gif' %>" alt="loading-img"></div>
  <!-- End Page Loading -->

 <%= render 'shared/header_new' %>
  <%= render 'shared/sidebar' %>





  <div class="content" id="userProfile1">


    <!-- Start Page Header -->
    <div class="page-header">
      <h1 class="title">Dashboard</h1>

      <!-- Start Page Header Right Div -->
      <div class="right">
        <div class="btn-group" role="group" aria-label="...">
          <a href="index.html" class="btn btn-light">Dashboard</a>
          <a href="#" id="refresh" class="btn btn-light"><i class="fa fa-refresh"></i></a>
          <a href="#" class="btn btn-light" id="topstats"><i class="fa fa-line-chart"></i></a>
        </div>
      </div>
    </div>
      <!-- End Page Header Right Div -->


   <div class="login-form" style="padding-top: 40px;max-width: 360px !important;">
      <form action="index.html" id="user-form" >
        <div class="top" style="padding-bottom: 15px;">
          <h4>Enter Payment Info.</h4>
          <img src="<%= asset_path 'stripe.png' %>" alt="icon" style="margin-top: 10px;">
        </div>
        
        <div class="form-area">
          
          
          <div class="group">
            <input type="text" class="form-control" placeholder="Card name" x-autocompletetype="off" autocompletetype="off" autocorrect="off" spellcheck="off" autocapitalize="off" autocomplete="off" id="cc-name">
            <i class="fa fa-user"></i>
          </div>          

          
          <div class="group" style="margin-bottom: 0px;">
            <input type="tel" id="cc-number" class="form-control" placeholder="Card number" style="border-bottom-left-radius: 0; border-bottom-right-radius: 0;" x-autocompletetype="cc-number" autocompletetype="cc-number" autocorrect="off" spellcheck="off" autocapitalize="off">
            <i class="fa fa-credit-card"></i>
          </div>

          
          <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10" style="margin-bottom: 15px;margin-top: -1px;">
            
            <div class="col-md-6 col-sm-6 padding-fix1" id="exp-div" style="padding-right: 0px;">
              <input id="cc-exp" type="text" class="form-control" placeholder="MM / YY" value="">
                  <i class="fa fa-calendar" style="top: 13px;left: 27px;" x-autocompletetype="off" autocompletetype="off" autocorrect="off" spellcheck="off" autocapitalize="off"></i>
            </div>

            <div class="col-md-6 col-sm-6 padding-fix2" style="padding-left: 0px;" id="csc-div">
              <input id="cc-csc" type="tel" class="form-control" placeholder="CVC" value="" 
                  autocorrect="off" spellcheck="off" autocapitalize="off" autocomplete="off" maxlength="4"> <i class="fa fa-lock" style="top: 14px;left: 9px;"></i>
            </div>

          </div>

          
          
          <div class="group">
            <input type="password" class="form-control" name="password" placeholder="Re-enter current password">
            <i class="fa fa-key"></i>
            <div style="line-height: 15px; margin-top: 10px;">For account protection, enter your password to save info.</div>
          </div>

          <button type="submit" class="btn btn-default btn-block">Save</button>
        </div>
      </form>
      <div class="footer-links row">
        <div class="col-xs-6"><a href="#"></a></div>
        <div class="col-xs-6 text-right"><a href="#"></a></div>
      </div>
    </div>

<%= javascript_include_tag "tokenize.js" %>


 </div>

</body>
</html>