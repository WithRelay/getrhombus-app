  

    <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Merchant Profile') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>
  

  <body>
  <!-- Start Page Loading -->
  <div class="loading"><img src="<%= asset_path 'loading.gif' %>" alt="loading-img"></div>
  <!-- End Page Loading -->

 <%= render 'shared/header_new' %>
  <%= render 'shared/sidebar' %>

  <div class="content">
    <!-- Start Page Header -->
    <div class="page-header">
      <h1 class="title">Account Settings</h1>

      <!-- Start Page Header Right Div -->
      <div class="right">
        <div class="btn-group" role="group" aria-label="...">
          <a href="index.html" class="btn btn-success">Update Stripe Connect</a>
          <a href="" class="btn btn-light"><i class="fa fa-refresh" id="refresh"></i></a>
        </div>
      </div>
      <!-- End Page Header Right Div -->

    </div>
    <!-- End Page Header -->

    <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTAINER -->
<div class="container-padding" id="merchantProfile">


  
  <!-- Start Row -->
  <div class="row">
    
    <div class="">
      <div class="panel panel-default" id="merchantprofilepage">

        <div class="panel-title">
          Horizontal Form
        </div>

            <div class="panel-body">
              <form class="form-horizontal" id="merchantProfile">

                 <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Email</label>
                  <div class="col-sm-10">
                    <input type="email" class="form-control" id="email" name="email" placeholder="Email">
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">New Password</label>
                  <div class="col-sm-10">
                    <input type="password" class="form-control" id="newpassword" name="password" Placeholder="Enter new password">
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Confirm Password</label>
                  <div class="col-sm-10">
                    <input type="password" class="form-control" id="confirmNewPassword" name="confirmPassword" Placeholder="Confirm">
                  </div>
                </div>

              <div class="merchant-form-line">Where are you based?</div>

                <div class="form-group" >
                  <label class="col-sm-2 control-label form-label">Country</label>
                  <div class="col-sm-10 countrygroup">   
                        <select class="selectpicker" name="country" id="country">
                          <option value='' disabled selected class="hide">Select country</option>
                           <option value="AU">Australia</option>    
                            <option value="AT">Austria</option>   
                            <option value="BE">Belgium</option>   
                            <option value="CA">Canada</option>    
                            <option value="DK">Denmark</option>   
                            <option value="FI">Finland</option>   
                            <option value="FR">France</option>    
                            <option value="DE">Germany</option>   
                            <option value="IE">Ireland</option>   
                            <option value="IT">Italy</option>   
                            <option value="LU">Luxembourg</option>    
                            <option value="NL">Netherlands</option>   
                            <option value="NO">Norway</option>    
                            <option value="ES">Spain</option>   
                            <option value="SE">Sweden</option>    
                            <option value="GB">United Kingdom</option>    
                            <option value="US">United States</option> 
                        </select>    
                    </div>
                </div>

                <div class="merchant-form-line">Tell us about your business</div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Name</label>
                  <div class="col-sm-10">
                    <input type="text" name="businessName" class="form-control" placeholder="Business Name">
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Type</label>
                  <div class="col-sm-10">
                     <select class="selectpicker" name="businessType">
                          <option value='' disabled selected class='hide'>Select business type</option>
                            <option value="Beauty Professional">Beauty Professional</option> 
                            <option value="Cleaning Services">Cleaning Services</option>     
                            <option value="Coffee Shop">Coffee Shop</option>    
                            <option value="Concierge Services">Concierge Services</option>
                            <option value="Home and Repair Services">Home and Repair Services</option>   
                            <option value="Health and Fitness">Health and Fitness</option>    
                            <option value="Individual">Individual</option>    
                            <option value="On-Demand Delivery">On-Demand Delivery</option>    
                            <option value="Orgs and Non-Profits">Orgs and Non-Profits</option>    
                            <option value="Professional Services">Professional Services</option>   
                            <option value="Restaurant">Restaurant</option>   
                            <option value="Retail">Retail</option>   
                            <option value="Taxi">Taxi</option>                
                            <option value="Others">Others</option>   
                        </select>   
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Phone</label>
                  <div class="col-sm-10">
                    <input type="tel" class="form-control" id="phone" name="phone">
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Address</label>
                  <div class="col-sm-10">
                    <input type="text" class="form-control" id="address" name="address" Placeholder="123 Main St, Ste 3">
                  </div>
                </div>

                 <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Postal Code</label>
                  <div class="col-sm-10">
                    <input type="text" class="form-control" id="zip" name="zip" Placeholder="Zip">
                  </div>
                </div>

                <input type="hidden" class="form-control" id="city" name="city" >
                <input type="hidden" class="form-control" id="state" name="state">

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Website</label>
                  <div class="col-sm-10">
                    <input type="text" class="form-control" id="" name="website" Placeholder="Your website or social profile link">
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Tax rate</label>
                  <div class="col-sm-10">
                      <input type="text" class="form-control" id="taxrate" name="taxRate" Placeholder="5">
                      <span>Default is 0. To be applied to transactions</span>
                  </div>
                </div>


                <div class="merchant-form-line">Tell us about you</div>


                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Name</label>
                  <div class="col-sm-10">
                    <input type="text" class="form-control" id="firstName" name="firstName" Placeholder="First">
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label"></label>
                  <div class="col-sm-10">
                    <input type="text" class="form-control" id="lastName" name="lastName" Placeholder="Last">
                  </div>
                </div>

                <div class="merchant-form-line">Optional welcome SMS message for customers that sign up with your number</div>


                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Welcome Message</label>
                  <div class="col-sm-10"> 
                      <textarea id="count_me" class="form-control" rows="4"></textarea>
                  </div>
                </div>



                <div class="merchant-form-line">You're almost set</div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Password</label>
                  <div class="col-sm-10">
                    <input type="password" class="form-control" id="reenterPassword" placeholder="Enter your password to save info." name="reenterPassword">
                  </div>
                </div>
                
                <div class="form-group">
                  <div class="col-sm-offset-2 col-sm-10">
                    <button type="submit" class="btn btn-default">Submit</button>
                  </div>
                </div>

              </form>

            </div>

      </div>
    </div>

  </div>
  <!-- End Row -->


</div>
<!-- END CONTAINER -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 





 </div>

<%#= javascript_include_tag "bootstrap-select" %>

</body>
</html>