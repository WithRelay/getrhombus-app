<%= provide(:title, "Rhombus - Dashboard") %>

<!-- ========== Css Files ========== -->
  
<%= content_for :head do %>
	<%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
<% end %>

<body>
<!-- Start Page Loading -->
  <div class="loading"><img src="<%= asset_path 'loading.gif' %>" alt="loading-img"></div>
  <!-- End Page Loading -->
  
<%= render 'shared/header_new' %>
<%= render 'shared/sidebar' %>

 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTENT -->
<div class="content">

  <!-- Start Page Header -->
  <div class="page-header">
    <h1 class="title">Dashboard</h1>

    <!-- Start Page Header Right Div -->
    <div class="right">
      <div class="btn-group" role="group" aria-label="...">
        <a href="index.html" class="btn btn-light">Dashboard</a>
        <a href="#" id="refresh" class="btn btn-light"><i class="fa fa-refresh"></i></a>
        <a href="#" class="btn btn-light" id="topstats"><i class="fa fa-line-chart"></i></a>
      </div>
    </div>
    <!-- End Page Header Right Div -->

  </div>
  <!-- End Page Header -->


 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTAINER -->
<div class="container-widget">

  <!-- Start Top Stats -->
  <div class="col-md-12">
  <ul class="topstats clearfix">
    <li class="arrow"></li>
    <li class="col-xs-6 col-lg-2">
      <span class="title">Rhombus Number</span>
      <h3>1 202 403 9524</h3>
    </li>
    <li class="col-xs-6 col-lg-2">
      <span class="title">Today's Sales</span>
      <h3>$96.25</h3>
    </li>
    <li class="col-xs-6 col-lg-2">
      <span class="title">Today's Transactions</span>
      <h3 class="color-up">696</h3>
    </li>
    <li class="col-xs-6 col-lg-2">
      <span class="title">Sales to Date</span>
      <h3>$9060</h3>
    </li>
    <li class="col-xs-6 col-lg-2">
      <span class="title">Your Customers</span>
