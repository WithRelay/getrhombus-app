<% provide(:title, 'Rhombus - Conversational Commerce Platform') %>

<div class="alternate-hero-table w-row">
  <div class="w-col w-col-6">
    <div class="alt-hero-content">
      <h1 class="alt-hero-heading v2">Communicate with customers inside the messaging apps they use everyday.</h1>
      <p class="def-content-section-paragraph">Untether support from your website "live chat" by allowing your customers message you anywhere anytime via SMS or Facebook Messenger.&nbsp;</p>
      <div>
        <%= image_tag('fb-messenger.png', class: 'alt messaging-app-icons', width: 30) %>
        <%= image_tag('slack.png', class: 'alt messaging-app-icons', width: 30) %>
        <%= image_tag('twilio-logo.png', class: 'alt messaging-app-icons', width: 30) %>
        <%= image_tag('twitter.png', class: 'alt messaging-app-icons', width: 30) %>
        <%= image_tag('whatsapp.png', class: 'alt messaging-app-icons', width: 30) %>
      </div>
    </div>
    <div class="hero-button-wrapper w-clearfix">
      <%= link_to 'Get started for free', new_user_registration_url, class: 'alt-hero-cta-button features hero-button w-button' %>
      <a class="button div-cta hero-alt-button w-button" href="#">Learn more</a>
    </div>
  </div>
  <div class="w-col w-col-6">
    <%= image_tag('Rhombus-iphone-frame-crop-top.png', class: 'alt features-hero-image', width: 371) %>
  </div>
</div>
<div class="alt home sub-hero-div">
      <h1 class="sub-hero-header">A single interface to manage all your customer interactions including direct messaging, <br>marketing campaigns &amp; transactions</h1>
      <div class="customer-interactions-table w-row">
        <div class="w-col w-col-3">
          <div class="customer-interaction-content-wrapper first">
            <div class="featues-div-header-wrapper">
              <%= image_tag('User-ID.png', class: 'features-div-icon') %>
            </div>
            <div class="features-div-paragraph-wrapper">
              <h3 class="features-div-header-text">Customer support</h3>
              <p class="feature-div-paragraph">Respond to customer inquiries via SMS or Facebook Messenger, so you can provide better support, quicker.</p>
            </div>
          </div>
        </div>
        <div class="w-col w-col-3">
          <div class="customer-interaction-content-wrapper">
            <div class="featues-div-header-wrapper">
              <%= image_tag('Messaging-1.png', class: 'features-div-icon') %>
            </div>
            <div class="features-div-paragraph-wrapper">
              <h3 class="features-div-header-text">notifications</h3>
              <p class="feature-div-paragraph">Automate important notifications like bill payment due date, appointment reminders, etc. via mobile messaging.</p>
            </div>
          </div>
        </div>
        <div class="w-col w-col-3">
          <div class="customer-interaction-content-wrapper">
            <div class="featues-div-header-wrapper">
              <%= image_tag('Node.png', class: 'features-div-icon') %>
            </div>
            <div class="features-div-paragraph-wrapper">
              <h3 class="features-div-header-text">targeted campaigns</h3>
              <p class="feature-div-paragraph">Segment your customers &nbsp;and send them targeted mobile messages to drive more sales.</p>
            </div>
          </div>
        </div>
        <div class="w-col w-col-3">
          <div class="customer-interaction-content-wrapper">
            <div class="featues-div-header-wrapper">
              <%= image_tag('Wallet.png', class: 'features-div-icon') %>
            </div>
            <div class="features-div-paragraph-wrapper">
              <h3 class="features-div-header-text">Transactions &amp; Refunds</h3>
              <p class="feature-div-paragraph">Charge customers, or create subscriptions within a conversation. No need to switch between apps</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="default-content-section home">
  <div class="content-wrapper icon-table w-container">
    <%= image_tag('Node-3.png', class: 'section-icon') %>
    <h1 class="sub-hero-header">Delight your customers by making every&nbsp;<br>interaction more human.</h1>
    <div>
      <div class="browser-header-full w-clearfix">
        <div class="browser-options"></div>
        <div class="browser-options new-option"></div>
        <div class="browser-options new-option"></div>
      </div>
      <%= image_tag('Messaging-Dashboard.png', class: 'messaging-dashboard', width: 929) %>
    </div>
  </div>
  <div class="customer-interactions-table no-icon-row w-row">
    <div class="w-col w-col-4">
      <div class="customer-interaction-content-wrapper first">
        <div class="features-div-paragraph-wrapper">
          <h3 class="features-div-header-text">Transcend email</h3>
          <p class="feature-div-paragraph">90% of text messages are read within 3 minutes. interact with customers, employees and contractors in real-time using mobile messages.</p>
        </div>
      </div>
    </div>
    <div class="w-col w-col-4">
      <div class="customer-interaction-content-wrapper no-icon-row">
        <div class="features-div-paragraph-wrapper">
          <h3 class="features-div-header-text">Go Where Your Customers are</h3>
          <p class="feature-div-paragraph">Untether customer support from your website's "live chat" by giving customers the flexibility to message you anytime, even on the go.</p>
        </div>
      </div>
    </div>
    <div class="w-col w-col-4">
      <div class="customer-interaction-content-wrapper no-icon-row">
        <div class="features-div-paragraph-wrapper">
          <h3 class="features-div-header-text">prevent Customers from slipping away</h3>
          <p class="feature-div-paragraph">Create rule based drip campaigns to nurture first-time and VIP customers so you can grow your business.</p>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="default-content-section-2 table-section">
    <div class="def-content-section-wrapper w-container">
      <%= image_tag('011_095.png', class: 'section-icon') %>
      <h1 class="sub-hero-header">Turn first-time contacts<br>to loyal customers</h1>
      <div class="default-content-section-table w-row">
        <div class="def-content-section-column-1 w-col w-col-6">
          <h3 class="section-3-header">Engage customers everywhere</h3>
          <p class="def-content-section-paragraph section-4">Untether support from your website "live chat" by allowing your customers message you anywhere anytime via SMS or Facebook Messenger.&nbsp;</p>
          <h3 class="section-3-header">Get a complete picture of each customer</h3>
          <p class="def-content-section-paragraph section-4">No more switching between support tools and your transaction data to look up customer information.
            <br>
            <br>Relay connects with your back-office&nbsp;to show your customers' purchase history alongside their interactions with your business, giving your team a complete picture.</p><a class="button def-content-section-button w-button" href="#">See all features</a>
          <div class="user-review-div">
            <div class="user-review-table w-row">
              <div class="w-col w-col-3">
                <%= image_tag('J-Libov.jpg', class: 'user-review-image', width: 50) %>
              </div>
              <div class="w-col w-col-9">
                <p class="user-revew-paragraph"><span class="quotes">&nbsp; </span>Text-based interaction is fast..flexible, descriptive and even consistent in ways that voice and user interface often are not</p>
                <div class="user-reviewer-name">Jonathan Libov (USV Analyst)</div>
              </div>
            </div>
          </div>
        </div>
        <div class="w-col w-col-6">
          <%= image_tag('Iphone-frame-Rhombus.png', class: 'phone', width: 366) %>
        </div>
      </div>
    </div>
  </div>
