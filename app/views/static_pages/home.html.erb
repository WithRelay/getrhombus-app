<% provide(:title, 'Rhombus - Conversational Commerce Platform') %>
  <div class="alternate-hero-table w-row">

    <div class="w-col w-col-6 integrate-icon">
      <div class="alt-hero-content">
        <!-- <h1 class="alt-hero-heading v2">
          Relay makes landline &amp; toll-free numbers smart
        </h1> -->
        <h1 class="alt-hero-heading v2">
          Communicate with <p id="type-it"></p>
          <p>inside the messaging apps they use everyday.</p>
        </h1>

        <p class="def-content-section-paragraph">
          Send &amp; receive text messages, set auto-responders, schedule notifications &amp; accept payments using your existing business phone number
        </p>
        <div class = "def-content-section-button">
          <%= image_tag('fb-messenger.png', class: 'alt messaging-app-icons', width: 30) %>
          <%= image_tag('twilio-logo.png', class: 'alt messaging-app-icons', width: 30) %>
          <%= image_tag('slack.png', class: 'alt messaging-app-icons', width: 30) %>
          <%= image_tag('twitter.png', class: 'alt messaging-app-icons', width: 30) %>
        </div>
      </div>
      <div class="hero-button-wrapper w-clearfix def-content-section-button">
        <%= link_to 'Get started for free', new_user_registration_path, class: 'alt-hero-cta-button features hero-button w-button' %>
        <%= link_to 'Learn more', features_path, class: 'button div-cta hero-alt-button w-button' %>
      </div>
    </div>

    <div class="w-col w-col-6">
      <div class="phone-wrapper w-hidden-tiny">
        <div class="speaker"></div>
        <div class="camera"></div>
        <div class="phone-screenshot-wrapper">
          <div class="phone-header">
            <div class="phone-name placeholder-content-text">Happy Fun Store</div>
          </div>
          <div class="agent conversation-bubble-place-holder-div">
            <p class="conversation-bubble-placeholder-text">Hi Jen, thanks for visiting our store today! We'd like to offer you a discount on your next purchase</p>
          </div>
          <div class="conversation-bubble-place-holder-div">
            <p class="conversation-bubble-placeholder-text">Really? that's fantastic!</p>
          </div>
          <div class="agent conversation-bubble-place-holder-div">
            <p class="conversation-bubble-placeholder-text">Sure thing!</p>
          </div>
          <div class="agent conversation-bubble-place-holder-div">
            <p class="conversation-bubble-placeholder-text">Use this code: Y7G8S next time your in the store to get 20% off your entire purchase.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="alt home sub-hero-div">
  <h1 class="sub-hero-header">Free up the phone lines, and manage customer&nbsp;<br>interactions via smart texting</h1>

  <div class="customer-interactions-table w-row">
    <div class="w-col w-col-3">
      <div class="customer-interaction-content-wrapper first">
        <div class="featues-div-header-wrapper">
          <%= image_tag('011_145.png', class: 'features-div-icon') %>
        </div>
        <div class="features-div-paragraph-wrapper">
          <h3 class="features-div-header-text">
            Customer support
          </h3>
          <p class="feature-div-paragraph">
            Respond to customer inquiries via SMS or Facebook Messenger, so you can provide better support, quicker.
          </p>
        </div>
      </div>
    </div>
    <div class="w-col w-col-3">
      <div class="customer-interaction-content-wrapper">
        <div class="featues-div-header-wrapper">
          <%= image_tag('Messaging-1.png', class: 'features-div-icon') %>
        </div>
        <div class="features-div-paragraph-wrapper">
          <h3 class="features-div-header-text">notifications</h3>
          <p class="feature-div-paragraph">
            Automate important notifications like bill payment due dates, appointment reminders, etc. via text messaging.
          </p>
        </div>
      </div>
    </div>
    <div class="w-col w-col-3">
      <div class="customer-interaction-content-wrapper">
        <div class="featues-div-header-wrapper">
          <%= image_tag('011_162.png', class: 'features-div-icon') %>
        </div>
        <div class="features-div-paragraph-wrapper">
          <h3 class="features-div-header-text">targeted campaigns</h3>
          <p class="feature-div-paragraph">
            Segment your customers &nbsp;and send them targeted text messages to drive more sales.
          </p>
        </div>
      </div>
    </div>
    <div class="w-col w-col-3">
      <div class="customer-interaction-content-wrapper">
        <div class="featues-div-header-wrapper">
          <%= image_tag('Wallet.png', class: 'features-div-icon') %>
        </div>
        <div class="features-div-paragraph-wrapper">
          <h3 class="features-div-header-text">
            Transactions &amp; Refunds
          </h3>
          <p class="feature-div-paragraph">
            Charge customers, or create subscriptions within a text conversation. No need to switch between apps
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="default-content-section home">

  <div class="content-wrapper icon-table w-container">
    <%= image_tag('017_228.png', class: 'section-icon') %>
    <h1 class="sub-hero-header">Reach customers &amp; prospects 7x faster<br>with powerful messaging tools</h1>
    <div>
      <div class="browser-header-full w-clearfix">
        <div class="browser-options"></div>
        <div class="browser-options new-option"></div>
        <div class="browser-options new-option"></div>
      </div>
      <%= image_tag('Messaging-Dashboard-Updated.png', class: 'messaging-dashboard', width: 929) %>
    </div>
  </div>

  <div class="customer-interactions-table no-icon-row w-row">
    <div class="w-col w-col-4">
      <div class="customer-interaction-content-wrapper first">
        <div class="features-div-paragraph-wrapper">
          <h3 class="alt features-div-header-text">Transcend email</h3>
          <p class="alt feature-div-paragraph">90% of text messages are read within 3 minutes. interact with customers, employees and contractors in real-time using mobile messages.</p>
        </div>
      </div>
    </div>
    <div class="w-col w-col-4">
      <div class="customer-interaction-content-wrapper no-icon-row">
        <div class="features-div-paragraph-wrapper">
          <h3 class="alt features-div-header-text">Go Where Your Customers are</h3>
          <p class="alt feature-div-paragraph">Untether customer support from your website's "live chat" by giving customers the flexibility to message you anytime, even on the go.</p>
        </div>
      </div>
    </div>
    <div class="w-col w-col-4">
      <div class="customer-interaction-content-wrapper no-icon-row">
        <div class="features-div-paragraph-wrapper">
          <h3 class="alt features-div-header-text">
            Retention Messages
          </h3>
          <p class="alt feature-div-paragraph">
            Create rule based drip campaigns to nurture first-time and VIP customers so you can grow your business.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="default-content-section-2 table-section">
