  

    <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Sign Up') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>
  

  <body>
  <!-- Start Page Loading -->
  <div class="loading"><img src="<%= asset_path 'loading.gif' %>" alt="loading-img"></div>
  <!-- End Page Loading -->

 <%= render 'shared/header_new' %>
  <%= render 'shared/sidebar' %>

  <div class="content">
    <!-- Start Page Header -->
    <div class="page-header">
      <h1 class="title">Account Settings</h1>

      <!-- Start Page Header Right Div -->
      <div class="right">
        <div class="btn-group" role="group" aria-label="...">
          <a href="index.html" class="btn btn-light">Dashboard</a>
          <a href="#" class="btn btn-light"><i class="fa fa-refresh"></i></a>
        </div>
      </div>
      <!-- End Page Header Right Div -->

    </div>
    <!-- End Page Header -->

    <div class="container-padding">
        <div class="row">
          <div class="panel panel-default" style="margin: 0 auto;max-width: 750px;margin-top: 60px;">

            <div class="panel-title">
              Inline Form without Label
            </div>

                <div class="panel-body">
                  <form id="merchantProfile">
                    


                     <div class="form-inline">
                      <div class="form-group fix-margin">
                        <input type="email" name="email" class="form-control" placeholder="Email">
                      </div>
                      <div class="form-group fix-margin" style="width: inherit !important;">
                        <input type="tel" class="form-control" id="phone" placeholder="Business Phone" name="phone">
                      </div>
                    </div>

                     <div class="form-inline ">
                      <div class="form-group fix-margin">
                        <input type="password" class="form-control" name="password" placeholder="New Password">
                      </div>
                      <div class="form-group fix-margin">
                        <input type="password" class="form-control" name="confirmPassword" placeholder="Confirm New Password">
                      </div>
                    </div>


                    <div style="padding: 30px;">Business Information</div>


                    <div class="form-inline">
                      <div class="form-group fix-margin">
                        <input type="text" class="form-control" placeholder="First Name" name="firstName">
                      </div>
                      <div class="form-group fix-margin">
                        <input type="text" class="form-control" name="lastName" placeholder="Last Name">
                      </div>
                    </div>

                     <div class="form-inline">
                      <div class="form-group fix-margin">
                        <input type="text" class="form-control" name="businessName" placeholder="Business Name">
                      </div>
                      <div class="form-group fix-margin">
                        <input type="text" class="form-control" name="websiteLink" placeholder="Website or social profile link">
                      </div>
                    </div>

                    <div class="form-inline">
                      <div class="form-group fix-margin">
                        <select class="selectpicker" name="businessType">
                          <option value='' disabled selected style='display:none;'>Select business type</option>
                            <option value="Beauty Professional">Beauty Professional</option> 
                            <option value="Cleaning Services">Cleaning Services</option>     
                            <option value="Coffee Shop">Coffee Shop</option>    
                            <option value="Concierge Services">Concierge Services</option>
                            <option value="Home and Repair Services">Home and Repair Services</option>   
                            <option value="Health and Fitness">Health and Fitness</option>    
                            <option value="On-Demand Delivery">On-Demand Delivery</option>    
                            <option value="Orgs and Non-Profits">Orgs and Non-Profits</option>    
                            <option value="Professional Services">Professional Services</option>   
                            <option value="Restaurant">Restaurant</option>   
                            <option value="Retail">Retail</option>   
                            <option value="Taxi">Taxi</option>                
                            <option value="Others">Others</option>   
                        </select>   
                      </div>
                      <div class="form-group fix-margin">
                        <input type="text" class="form-control" name="address" placeholder="Street Address, Suite or Apartment #">
                      </div>
                    </div>

                 

                     <div class="form-inline">
                        <div class="form-group fix-margin">
                        <select class="selectpicker" name="country">
                          <option value='' disabled selected style='display:none;'>Select country</option>
                           <option value="AU">Australia</option>    
                            <option value="AT">Austria</option>   
                            <option value="BE">Belgium</option>   
                            <option value="CA">Canada</option>    
                            <option value="DK">Denmark</option>   
                            <option value="FI">Finland</option>   
                            <option value="FR">France</option>    
                            <option value="DE">Germany</option>   
                            <option value="IE">Ireland</option>   
                            <option value="IT">Italy</option>   
                            <option value="LU">Luxembourg</option>    
                            <option value="NL">Netherlands</option>   
                            <option value="NO">Norway</option>    
                            <option value="ES">Spain</option>   
                            <option value="SE">Sweden</option>    
                            <option value="GB">United Kingdom</option>    
                            <option value="US">United States</option> 
                        </select>         
                      </div>
                      <div class="form-group fix-margin">
                        <input type="text" class="form-control" name="zipCode" placeholder="Zip/Postal Code">
                      </div>
                    </div>

                    <div class="form-inline">
                      <div class="form-group fix-margin">
                      Tax rate to be applied to customer debits
                        <input type="tel" class="form-control" name="taxRate" placeholder="Without %. Default is 0">
                      </div>

                    </div>



                    <div class="form-inline">
                      <div class="form-group fix-margin">
                        For account protection, please re-enter your password to save changes.
                        <input type="password" class="form-control" name="reenterPassword" placeholder="Re-enter password">
                      </div>
                      <div class="form-group fix-margin">
                      <span style="visibility: hidden;">For account protection, please re-enter your password to save changes.</span>
                        <button type="submit" class="btn btn-default btn-block">Save</button>
                      </div>
                    </div>
                    

                    <div class="form-inline">
                      <div class="form-group fix-margin">
                          <button type="submit" class="btn btn-default btn-block">Update Stripe Connect</button>
                      </div>
                    </div>




                  </form>







              </div>
          </div>
        </div>
    </div>



 </div>

