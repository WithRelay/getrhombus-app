            <h3 class="features-div-header-text use-case">Drip campaigns</h3>
            <p class="feature-div-paragraph use-case">Send automated drip campaigns to help educate donors and volunteers about your cause.</p>
          </div>
        </div>
      </div>
      <div class="w-col w-col-4">
        <div class="customer-interaction-content-wrapper no-icon-row use-case">
          <div class="features-div-paragraph-wrapper use-case">
