<div class="use-case-image-wrapper-non-profit">
  <h1 class="alt hero-h1 home-header use-case-header">Grow donor acquisition 3x &amp; improve <br>engagement using mobile messages</h1>
  <h5 class="footer-cta-subheading signup-box-subheading use-case">campaigns . charities . churches . community organizations</h5><a class="button use-case-button w-button" href="#">Get started for free</a>
  <a class="button demo-request use-case-button w-button" href="#">Schedule Demo</a>
</div>
<div class="home sub-hero-div use-case">
    <h1 class="sub-hero-header">Connect with volunteers &amp; donors on the <br>messaging apps they use everyday</h1>
    <div class="customer-interactions-table w-row">
      <div class="w-col w-col-4">
        <div class="customer-interaction-content-wrapper first">
          <div class="featues-div-header-wrapper">
            <%= image_tag('Messaging-1.png', class: 'features-div-icon')%>
          </div>
          <div class="features-div-paragraph-wrapper">
            <h3 class="features-div-header-text">donor &amp; Volunteer outreach</h3>
            <p class="feature-div-paragraph">Accelerate your outreach campaign using simple text messages for guaranteed 98% open rates, and 3x better response rates</p>
          </div>
        </div>
      </div>
      <div class="w-col w-col-4">
        <div class="customer-interaction-content-wrapper">
          <div class="featues-div-header-wrapper">
            <%= image_tag('011_162.png', class: 'features-div-icon')%>
          </div>
          <div class="features-div-paragraph-wrapper">
            <h3 class="features-div-header-text">Segmentation &amp; Targeting</h3>
            <p class="feature-div-paragraph">Segment donors and volunteers based on geography, average donation size, etc, and send them targeted messages to keep them fully engaged.</p>
          </div>
        </div>
      </div>
      <div class="w-col w-col-4">
        <div class="customer-interaction-content-wrapper">
          <div class="featues-div-header-wrapper">
            <%= image_tag('014_133.png', class: 'features-div-icon')%>
          </div>
          <div class="features-div-paragraph-wrapper">
            <h3 class="features-div-header-text">One-time &amp; recurring In-chat donations</h3>
            <p class="feature-div-paragraph">Increase repeat donations by accepting payments directly inside SMS and Facebook Messenger conversations</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="customer default-content-section home">
    <div class="content-wrapper icon-table w-container">
      <%= image_tag('021_114.png', class: 'section-icon')%>
      <h1 class="sub-hero-header">Use Cases</h1>
    </div>
    <div class="customer-interactions-table no-icon-row w-row">
      <div class="w-col w-col-4">
        <div class="customer-interaction-content-wrapper first use-case">
          <div class="features-div-paragraph-wrapper use-case">
            <h3 class="features-div-header-text use-case">Donor outreach &amp; management</h3>
            <p class="feature-div-paragraph use-case">Two-way messaging and enriched social media profiles of all your donors and volunteers</p>
          </div>
        </div>
      </div>
      <div class="w-col w-col-4">
        <div class="customer-interaction-content-wrapper no-icon-row use-case">
