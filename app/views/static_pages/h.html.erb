
  <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Sign in') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>
  
  <style type="text/css">
    body{background: #F5F5F5;}
  </style>


  <body>

    <div class="login-form">
      <form action="index.html" id="changePasswordForm">
        <div class="top">
          <img src="<%= asset_path 'logo_grey.jpg' %>" alt="icon" id="signup_logo" class="icon">
          <h4>Change your password.</h4>
        </div>
        <div class="form-area">
          <div class="group">
            <input type="password" class="form-control rhombusFocus" name="password" placeholder="Password">
            <i class="fa fa-key"></i>
          </div>
          <div class="group">
            <input type="password" class="form-control rhombusFocus" name="confirmPassword" placeholder="Confirm password">
            <i class="fa fa-key"></i>
          </div>
          <button type="submit" class="btn btn-default btn-block btn-rhombus">Reset</button>
        </div>
      </form>
      <div class="footer-links row">
        <div class="col-xs-6"><a href="/a"><i class="fa fa-external-link"></i>Back to Login</a></div>
        <div class="col-xs-6 text-right"><a href="#"></a></div>
      </div>
    </div>

</body>
</html>