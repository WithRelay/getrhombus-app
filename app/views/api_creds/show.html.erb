
<div class="dashboard-body settings">
  <div class="settings-info-div tokens" id='api-tokens'>
    <h5 class='account-status-text'>API KEY: <span class="api-key"><%= @api_cred.key.present? ? @api_cred.key : '-' %></span></h5>
    <h5 class='account-status-text'>API SECRET: <span class="api-secret"><%= @api_cred.secret.present? ? @api_cred.secret : '-' %></span></h5>
  </div>

  <div class="w-col w-col-6">
    <button class='btn-rhombus button w-button' id='generate-key-secret'>Generate New Api Key/Secret</button>
  </div>

  <div class="w-col w-col-8" style="float: left;">
    <%= form_for @api_cred, url: user_api_creds_path(current_user), method: :put, html: { class: "w-clearfix", id: 'webhook-url-form' } do |f| %>
      <div class="form-label" id='webhook-url-div'>
        <%= f.text_field :webhook_url, class: 'form-control text-field w-input', placeholder: 'Webhook URL' %>
        <%= f.submit 'Save', class: 'button btn-rhombus w-button' %>
      </div>
    <% end %>
  </div>
</div>
