<%= form_for([current_user, @subscription], :html=> { id: 'subscriptionForm', class: 'form-horizontal' }) do |f| %>

   <div class="form-group">
    <%= f.label :plan, class: 'col-xs-3 control-label' %>
    <div class="col-xs-5">
      <%= f.text_field :plan_id, class: 'form-control auto-height', placeholder: "Select 1 or more plans" %>
    </div>
  </div>

  <% if current_user.is_platform? %>
    <div class="form-group">
      <%= f.label :coupon, class: 'col-xs-3 control-label' %>
      <div class="col-xs-5">
        <%= f.text_field :coupon_id, class: 'form-control auto-height', id: 'subscription-select-coupon', placeholder: "Select a coupon" %>
      </div>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :customer, class: 'col-xs-3 control-label' %>
    <div class="col-xs-5">
      <%= f.text_field :merchant_customer_id, class: 'form-control auto-height', placeholder: "Select a customer" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :quantity, class: 'col-xs-3 control-label' %>
    <div class="col-xs-5">
      <%= f.text_field :quantity, class: 'form-control' %>
    </div>
  </div>

  <div class="actions field form-group">
    <div class="col-xs-9 col-xs-offset-3">
      <%= f.submit 'Create Subscription', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
