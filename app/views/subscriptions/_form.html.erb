<%= form_for('subscription', html: { id: 'subscriptionForm', class: 'w-clearfix' }) do |f| %>

  <div class="form-group col-xs-6">
     <%= subscription_customer_field(f) %>
  </div>

  <div class="form-group col-xs-6">
    <%= f.text_field :plan_id, class: 'form-control dropdown w-select', placeholder: "Select a plan", id: "subscription-plan-id" %>
  </div>

  <div class="form-group col-xs-6">
    <%= f.text_field :coupon_id, class: 'form-control subscriber-name text-field w-input', id: 'subscription-select-coupon', placeholder: "Select a coupon" %>
  </div>

  <%= create_plan_field %>

  <label class="form-label" for="Number-of-subscriptions">
    Number of subscriptions
  </label>

  <div class="form-group col-xs-6">
    <%= f.text_field :quantity, class: 'form-control number-of-subscriptions text-field w-input', id: "Number-of-subscriptions", value: 1 %>
  </div>
  <%= f.submit 'Subscribe Customer', class: 'button subscription w-button', id: 'create-subscription' %>
<% end %>
