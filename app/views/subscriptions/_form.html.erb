<%= form_for([current_user, @subscription], :html=> { id: 'subscriptionForm', class: 'form-horizontal' }) do |f| %>
  <% if @subscription.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@subscription.errors.count, "error") %> prohibited this subscription from being saved:</h2>

      <ul>
      <% @subscription.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

   <div class="form-group">
    <%= f.label :plan, class: 'col-xs-3 control-label' %>
    <div class="col-xs-5">
      <%= f.text_field :plan_id, class: 'form-control' %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :customer, class: 'col-xs-3 control-label' %>
    <div class="col-xs-5">
      <%= f.text_field :user_id, class: 'form-control' %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :quantity, class: 'col-xs-3 control-label' %>
    <div class="col-xs-5">
      <%= f.text_field :quantity, class: 'form-control' %>
    </div>
  </div>

  <div class="actions field form-group">
    <div class="col-xs-9 col-xs-offset-3">
      <%= f.submit 'Create Subscription', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
