<%= form_for('subscription', method: 'PUT', :html=> { id: 'coupon-update-form', class: 'form-horizontal' }) do |f| %>
    <label class="field-headers form-label settings" for="Business-Name">COUPON & DISCOUNTS</label>
    <hr>
    <div class="form-group">
      <%= f.text_field :coupon, id: 'update-plan-id', class: 'form-control', placeholder: 'Enter Discount Code' %>
    </div>
  <br>
  <%= f.submit 'Apply Discount', class: 'button pricing-button customer-text-me', id: 'submit-update-coupon', saas_sub_id: get_saas_sub_id %>
<% end %>
