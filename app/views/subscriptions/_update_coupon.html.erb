<%= form_for('subscription', method: 'PUT', :html=> { id: 'coupon-update-form', class: 'form-horizontal' }) do |f| %>
    <label class="field-headers form-label settings" for="Business-Name">COUPON & DISCOUNTS</label>

  <%= f.text_field :coupon, id: 'update-plan-id', placeholder: 'Enter Discount Code' %>
  <br>
  <%= f.submit 'Apply Discount', class: 'button pricing-button customer-text-me', id: 'submit-update-coupon', saas_sub_id: get_saas_sub_id, data: {disable_with: 'Please wait ...'} %>
<% end %>
