<%= render 'subscription_nav' %>
<div class="dashboard-body">
<div class="blank-page-container w-container">
  <%= image_tag('017_215.png', class: 'blank-page-icon')%>
  <% if current_user.is_merchant? %>
    <% if current_user.can_accept_payments? %>
      <h1 class="empty-state-dash hero-h1 home-header">Your bank account is connected. <br> Create a plan & add subscribers</h1>
      <a class="button error-page-button w-button modal-loader" href="#" modal-target="new-plan-modal"> <strong>Create plan</strong></a>
    <% else %>
      <h1 class="empty-state-dash hero-h1 home-header">You have no bank account. <br> Connect your bank account to get started</h1>
      <%= link_to 'Connect bank account', user_managed_accounts_path(current_user), class: 'button error-page-button w-button' %>
    <% end %> 
  <% else %>  
    <h1 class="empty-state-dash hero-h1 home-header">You have no subscriptions</h1>
  <% end %>  
</div>
</div>
