<div class="container">
  <h1>Listing Subscriptions</h1>

  <table class="table">
    <thead>
      <tr>
        <th>Customer</th>
        <th>Status</th>
        <th>Plan</th>
        <th>Quantity</th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <% @subscriptions.each do |subscription| %>
        <tr>
          <td>Customer info here</td>
          <td><span class="btn btn-success"><%= subscription.status %></span></td>
          <td>Plan Info here</td>
          <td><%= subscription.quantity %></td>
          <!-- <td><%#= link_to 'Show', subscription %></td> -->
          <!-- <td><%#= link_to 'Edit', edit_subscription_path(subscription) %></td> -->
          <td><%= link_to 'Cancel Subscription', user_subscription_path(current_user, subscription), method: :delete, class: "btn btn-danger cancel-subscription subscription#{subscription.id}", data: { disable_with: "<i class='fa fa-spinner fa-spin'></i>Please wait...".html_safe } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <br>

  <%#= link_to 'New Subscription', new_subscription_path %>
  <%= link_to 'Create Subscription', new_user_subscription_path, id: 'create-subscription' %>


</div>