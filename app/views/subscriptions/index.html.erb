<div class="container">
  <!-- Button trigger modal -->
  <%= button_tag 'Create Plan', class: 'btn btn-default plan-modal', data: { toggle: :modal, target: '#modalPlan' } %>
  <%= button_tag 'Create Subscription', class: 'btn btn-default', data: { toggle: :modal, target: '#modalSubscription' } %>
  <%= button_tag 'Setting', class: 'btn btn-default', data: { toggle: :modal, target: '#setSubscription' } %>
  <!-- Modal -->
  <div class="modal fade" id="modalPlan" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">&times;</span>
          <span class="sr-only">Close</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">Create Plan</h4>
          <hr>
          Plans let you charge customers a recurring amount over a specified time interval.
        </div>
        <!-- Modal Body -->
        <div class="create-plan-form w-form">
          <%= render 'plans/form' %>
        </div>
      </div>
    </div>
  </div>
  <div class="modal fade" id="modalSubscription" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">&times;</span>
          <span class="sr-only">Close</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">Create Subscription</h4>
          <hr>
          Subscribe customers to an existing plan to charge them on a recurring basis.
        </div>
        <!-- Modal Body -->
        <div class="create-subscription-form w-form">
          <%= render 'subscriptions/form' %>
        </div>
      </div>
    </div>
  </div>
  <div class="modal fade" id="setSubscription" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">&times;</span>
          <span class="sr-only">Close</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">SAAS Subscription Setting</h4>
          <hr>
          Upgrade or modify your subscription plan by making a sliding price range below:
        </div>
        <!-- Modal Body -->
        <div class="create-subscription-form w-form">
          <%= render 'shared/subscription_setting' %>
        </div>
      </div>
    </div>
  </div>

  <h1>Listing Subscriptions</h1>
  <table class="table table-condensed table-hover">
    <thead>
      <tr>
        <th>Customer</th>
        <th>Status</th>
        <th>Plan</th>
        <th>Discount</th>
        <th>Quantity</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @subscriptions.each do |subscription| %>
        <tr id="subscription-<%= subscription.id %>" class="subscription-row">
          <td><%= present(subscription).get_customer_info %></td>
          <td><%= present(subscription).status %></td>
          <td><%= present(subscription).get_plan_info %></td>
          <td><%= present(subscription).get_coupon_info %></td>
          <td><%= subscription.quantity %></td>
          <td>
            <% if subscription.cancel_at_period_end %>
              <span class="label label-info">Cancel at period end</span>
            <% elsif subscription.status != 'canceled' %>
              <%= link_to 'Cancel Subscription', user_subscription_path(current_user, subscription), method: :delete, class: "btn btn-danger subscription#{subscription.id}", id: 'cancel-subscription', data: { disable_with: "<i class='fa fa-spinner fa-spin'></i>Please wait...".html_safe } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= render 'subscriptions/update_coupon' %>
  <br><br><br><br><br>
</div>
