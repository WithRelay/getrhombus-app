<%= render partial: 'subscription_nav', locals: { subscriptions: @subscriptions} %>
<form id="subs_txn_history_form" method="get" action="subscriptions/download.csv">
  <input type="hidden" id="subs_txn_start_date" name="subs_txn_start_date" />
  <input type="hidden" id="subs_txn_end_date" name="subs_txn_end_date" />
</form>
<div class="dashboard-body">
  <div class="table-wrapper">
    <div class="transaction-summary-wrapper">
      <div class="transaction-summary-row w-row">
        <div class="w-col w-col-4">
          <div class="subscriptions transaction-summary-cell">
            <h1 class="total-customer-count"><%= saas_invoices[0].count %></h1>
            <h4 class="count-description"> &nbsp; Transactions Today</h4>
            <h4 class="count-description transaction-count"><%= subscriptions_change %></h4>
          </div>
        </div>
        <div class="w-col w-col-4">
          <div class="transaction-summary-cell">
            <h1 class="total-customer-count"><%= "#{Toolbox::Decimal.to_2dp(subscriptions_total_amount)}"  %></h1>
            <h4 class="count-description"> &nbsp; Total Collected</h4>
            <h4 class="count-description transaction-count"> <%= subscriptions_total_amount_change %></h4>
          </div>
        </div>
        <div class="w-col w-col-4">
          <div class="transaction-summary-cell">
            <h1 class="total-customer-count"><%= "#{Toolbox::Decimal.to_2dp(subscriptions_net_sales)}"  %></h1>
            <h4 class="count-description"> &nbsp; Net Sales</h4>
            <h4 class="count-description transaction-count"> <%= subscription_net_sales_change %></h4>
          </div>
        </div>
      </div>
    </div>
    <div class="row-wrapper transactions">
      <div class="header transactions-table-row w-row">
        <div class="transaction-column w-clearfix w-col w-col-3">
          <div class="card-name table-heading transaction-cell w-clearfix">
            <div class="table-heading-text transaction-header-text">Card name</div>
          </div>
          <div class="cb check-box-column table-heading"></div>
        </div>
        <div class="transaction-column w-col w-col-2">
          <div class="table-heading transaction-cell w-clearfix">
            <div class="table-heading-text table-text">Plan name</div>
          </div>
        </div>
        <div class="transaction-column w-col w-col-2">
          <div class="table-heading transaction-cell w-clearfix">
            <div class="table-heading-text table-text">Date</div>
          </div>
        </div>
        <div class="transaction-column w-col w-col-2">
          <div class="table-heading transaction-cell w-clearfix">
            <div class="table-heading-text table-text tran-amount">Amount</div>
          </div>
        </div>
        <div class="transaction-column w-col w-col-2">
          <div class="table-heading transaction-cell w-clearfix">
            <div class="table-heading-text table-text tran-email">Email</div>
          </div>
        </div>
        <div class="transaction-column w-col w-col-1">
          <div class="table-heading transaction-cell w-clearfix">
            <div class="table-heading-text table-text tran-last-four">Last four</div>
          </div>
        </div>
      </div>
    </div>
    <% @subscriptions.each do |subscription| %>
      <% if subscription.merchant_customer && subscription.merchant_customer.customer %>
        <% customer = subscription.merchant_customer.customer %>
        <div class="row-wrapper transactions">
          <div class="transactions-table-row w-row" id="<%= subscription.id %>">
            <div class="transaction-column w-clearfix w-col w-col-3">
              <div class="card-name transaction-cell subs-card-name">
                <%= present(subscription.merchant_customer).profile_image %>
                <div class="table-text customer-name"><%= customer.card_name %></div>
              </div>
              <div class="cb check-box-column">
                <div class="w-form">
                  <form data-name="Email Form 2" id="email-form-2" name="email-form-2">
                    <div class="select-all-check-box w-checkbox w-clearfix">
                      <input class="cb table-checkbox checkboxes w-checkbox-input subscription-checkbox" id="node" type="checkbox">
                      <label class="checkbox-field-lable w-form-label" for="node">-</label>
                    </div>
                  </form>
                </div>
              </div>
            </div>
            <div class="transaction-column w-col w-col-2">
              <div class="transaction-cell">
                <div class="table-text plan-name shrink-text"><%= subscription.plan.name %></div>
              </div>
            </div>
            <div class="transaction-column w-col w-col-2">
              <div class="transaction-cell">
                <div class="table-text"><%= subscription.created_at.strftime('%d/%m/%Y') %></div>
              </div>
            </div>
            <div class="transaction-column w-col w-col-2">
              <div class="transaction-cell w-clearfix">
                <div class="table-text tran-amount"><%= present(subscription).get_amount %></div>
              </div>
            </div>
            <div class="transaction-column w-col w-col-2">
              <div class="transaction-cell w-clearfix">
                <div class="table-text tran-email"><%= customer.email %></div>
              </div>
            </div>
            <div class="transaction-column w-col w-col-1">
              <div class="transaction-cell w-clearfix">
                <div class="table-text tran-last-four"><%= customer.last4 %></div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
