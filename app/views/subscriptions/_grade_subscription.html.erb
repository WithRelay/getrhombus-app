<%= form_for('subscription', :html=> { id: 'plan-update-form', class: 'form-horizontal' }) do |f| %>
    <label class="field-headers form-label settings" for="Business-Name">PLAN INFORMATION</label>
    <label class="form-label paragraph" for="Tax-Rate">Upgrade or modify your subscription plan by making a selection below:</label>
    <a class="downgrade-plan-selector w-inline-block" href="javascript:;">
        <img class="plan-icon" height="80" src="http://uploads.webflow.com/5767087cbd63608e7eb4abdc/57cb21e46ca51954384be53f_Shop-100.png">
        <div class="plan-name">Starter Plan</div>
    </a>
    <a class="w-inline-block" id="upgrade-plan-selector" href="javascript:;">
        <img class="plan-icon" height="80" src="http://uploads.webflow.com/5767087cbd63608e7eb4abdc/57cb21acbf740f9d07997dde_Business-100.png">
        <div class="plan-name">Business Plan</div>
    </a>
    <div class="settings-info-div">
        <h1 class="business-plan plan-name plans-text">Current Subscription Details:</h1>
        <div class="flex-underline" id="plan-div">
            <b>
                <p>You don't have selected any subscription</p>
                <p>Please select subscription by clicking on table row before upgrade/downgrade Plan</p>
            </b>
        </div>
    </div>

  <%= f.text_field :plan_id, class: 'hidden', id: 'update-plan-id', value: '49' %>
  <br>
  <%= f.submit 'Upgrade Plan', class: 'btn btn-success hidden', id: 'submit-update-plan', data: {disable_with: 'Please wait ...'} %>
<% end %>
