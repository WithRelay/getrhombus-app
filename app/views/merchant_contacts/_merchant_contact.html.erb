  <div>
  <div class="new-table-row w-row">
    <div class="cn w-clearfix w-col w-col-3">
      <div class="name w-clearfix">
        <% contact_details = present(merchant_contact).contact_details %>
        <%= profile_image(contact_details[:profile_image]) %>
        <div class="shrink-text table-text">
          <%=link_to contact_details[:full_name], merchant_contact_path(merchant_contact) %>
        </div>
      </div>
      <div class="cb check-box-column">
        <div>
          <form data-name="Email Form 2" id="email-form-2" name="email-form-2">
            <div class="select-all-check-box w-checkbox w-clearfix">
              <input class="cb table-checkbox w-checkbox-input merchant_customers" id="node" type="checkbox" data-users="<%= merchant_contact.id %>">
              <label class="checkbox-field-lable w-form-label" for="node">-</label>
            </div>
          </form>
        </div>
      </div>
    </div>
    <div class="fv w-clearfix w-col w-col-2">
      <div class="cn column column-2 w-clearfix">
        <div class="shrink-text table-text"><%= contact_details[:phone_number] %></div>
      </div>
    </div>
    <div class="lv w-clearfix w-col w-col-2">
      <div class="colum-3 column lv w-clearfix">
        <div class="shrink-text table-text"><%= contact_details[:since][:date] %></div>
      </div>
    </div>
    <div class="avs w-clearfix w-col w-col-1">
      <div class="avs column column-4 w-clearfix">
        <div class="table-text"><%= present(merchant_contact).channel %></div>
      </div>
    </div>
    <div class="ts w-clearfix w-col w-col-1">
      <div class="column column-5 ts">
        <div class="dashboard-right-nav id signup-box-subheading">
          <span class="relay-id leads unverified"><%= contact_details[:verified] %></span>
        </div>
      </div>
    </div>
    <div class="table-actions w-clearfix w-col w-col-3">
      <div class="column column-6 left new-row w-clearfix">
        <div class="frequency shrink-text table-text"><%= contact_details[:location] %></div>
      </div>
      <div class="column column-6 new-row"><a class="actions-button notification" href="#">Message &nbsp; </a>
      </div>
    </div>
  </div>
</div>
