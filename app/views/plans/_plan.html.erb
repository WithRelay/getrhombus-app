<div class="manage-plans-row w-row">
  <div class="w-clearfix w-col w-col-4">
    <span class='editable-field-text settings-row-text plan-name'><%= present(plan).format_plan_name %></span>
    <% if plan.hashtag_id.blank? && plan.customer_id.blank? %>
      <span class="plan-name-edit-span">
        <a class="plan-name-edit-icon edit-field save-editable-field" href="#"></a>
      </span>
      <span class='plan-name-save-span' data-plan-id='<%= plan.id %>' >
        <a class="cancel-edit cancel-edit-plan save-editable-field" href="#"><strong></strong></a>
        <a class="save-editable-field plan-name-save-icon" href="#"></a>
      </span>
    <% end %>
  </div>
  <div class="w-col w-col-2">
    <div class="settings-row-text"><%= present(plan).format_amount %></div>
  </div>
  <div class="w-col w-col-2">
    <div class="settings-row-text"><%= plan.interval %></div>
  </div>
  <div class="w-col w-col-2">
    <% subscriber_count = plan.subscriptions.length %>
    <div class="settings-row-text"><%= subscriber_count %></div>
  </div>
  <div class="w-col w-col-2">
    <% if subscriber_count == 0 %>
      <%= link_to 'Delete Plan', user_plan_path(current_user, plan), method: :delete, class: "button settings-table-row w-button delete-plan plan#{plan.id}" %>
    <% end %>
  </div>
</div>
