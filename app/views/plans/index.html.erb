<%=render 'shared/return_to_dashboard'%>
<div class="dashboard-body settings">
  <div class="dash-content-container manage-plans settings">
    <h4 class="form-header">Manage Plans</h4>
    <div class="flex-underline form-header-underline"></div>
    <div class="header manage-plans-row w-row">
      <div class="w-col w-col-4">
        <div class="editable-row-header header settings-row-text">Plan name</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Amount</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Plan interval</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Subscriber count</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Actions</div>
      </div>
    </div>
    <div id='objlists' data-object-type='plan'>
      <%= render partial: @plans %>
    </div>
    <div id="with-button" class="hide">
      <%= will_paginate %>
    </div>

    <% if @plans.next_page %>
      <div id="load_more_plans" class="show_more load-more-wrapper" data-loading-text="Loding more Plans" >
        <a class="load-more-rows-button w-button" href="#">&nbsp;&nbsp;&nbsp;Load more</a>
      </div>
    <% end %>
  </div>
</div>
