<div , class="container">
  <div id="ordered-plans", class="container">
    <p id="notice"><%= notice %></p>

    <h1>Listing Plans</h1>


    <div class="table-responsive" >
      <table class="table table-hover table-bordered">
        <thead>
          <tr>
            <th colspan="3">Amount</th>
            <th colspan="3">Currency</th>
            <th colspan="3">Interval</th>
            <th colspan="3">Interval Count</th>
          </tr>
        </thead>
        <tbody id='my-plans'>
          <%= render partial: 'plans' %>
        </tbody>
      </table>
    </div>
  </div>

  <br>
  <div id="with-button">
      <%= will_paginate %>
  </div>

  <% if @plans.next_page %>
      <div id="load_more_plans" class="show_more btn btn-primary " data-loading-text="<i class='fa fa-spinner fa-spin '></i> Loding more Plans">Show More </div>
  <% end %>
  <%= link_to 'New Plan', new_user_plan_path, class: 'btn btn-default' %>

</div>
