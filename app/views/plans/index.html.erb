<p id="notice"><%= notice %></p>

<h1>Listing Plans</h1>

<table>
  <thead>
    <tr>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @plans.each do |plan| %>
      <tr>
        <td><%= plan.name %></td>
        <td><%= plan.amount %></td>
        <td><%= plan.interval %></td>
        <td><%= plan.interval_count %></td>
        <td><%= plan.currency %></td>
        <td><%#= link_to 'Show', user_plan_path(current_user, plan) %></td>
        <td><%#= link_to 'Edit', edit_user_plan_path(current_user, plan) %></td>
        <td><%#= link_to 'Destroy', plan, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Plan', new_user_plan_path %>
