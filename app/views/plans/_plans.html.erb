<!-- partials for plans index for show more feature support -->

<% if @plans %>
<div class="dashboard-body settings">
    <div class="dash-content-container manage-plans settings">
      <h4 class="form-header">Manage Plans</h4>
      <div class="flex-underline form-header-underline"></div>
      <% @plans.each do |plan| %>

      <div class="header manage-plans-row w-row">
        <div class="w-col w-col-4">
          <div class="header settings-row-text">Plan name</div>
        </div>
        <div class="w-col w-col-2">
          <div class="header settings-row-text">Amount</div>
        </div>
        <div class="w-col w-col-2">
          <div class="header settings-row-text">Plan interval</div>
        </div>
        <div class="w-col w-col-2">
          <div class="header settings-row-text">Subscriber count</div>
        </div>
        <div class="w-col w-col-2">
          <div class="header settings-row-text">Actions</div>
        </div>
      </div>

<div class="manage-plans-row w-row">
  <div class="w-col w-col-4">
    <div class="w-form">
      <form data-name="Email Form" id="email-form" name="email-form">
        <span class="plan-name manage-plans plan-name text-field w-input" data-name="Plan Name 2" id="Plan-name-2"><%= plan.name %></span>
      </form>
      <div class="w-form-done">
        <div>Thank you! Your submission has been received!</div>
      </div>
      <div class="w-form-fail">
        <div>Oops! Something went wrong while submitting the form</div>
      </div>
    </div>
  </div>
  <div class="w-col w-col-2">
    <div class="w-form">
      <form data-name="Email Form" id="email-form" name="email-form">
        <span class="text-field w-input" data-name="Plan Amount 2" id="Plan-amount-2"><%= present(plan).format_amount %></span>
      </form>
      <div class="w-form-done">
        <div>Thank you! Your submission has been received!</div>
      </div>
      <div class="w-form-fail">
        <div>Oops! Something went wrong while submitting the form</div>
      </div>
    </div>
  </div>
  <div class="w-col w-col-2">
    <div class="w-form">
      <form class="plan-interval-column" data-name="Email Form" id="email-form" name="email-form">
        <span class="dropdown subscription-interval w-select" data-name="Subscription Interval 2" id="Subscription-Interval-2" ><%= plan.interval %> </span>
      </form>
      <div class="w-form-done">
        <div>Thank you! Your submission has been received!</div>
      </div>
      <div class="w-form-fail">
        <div>Oops! Something went wrong while submitting the form</div>
      </div>
    </div>
  </div>
  <div class="w-col w-col-2">
    <div class="settings-row-text">500</div>
  </div>
  <div class="w-col w-col-2">
    <% if plan.subscription_id.blank? %>
      <%= link_to 'Delete Plan', user_plan_path(current_user, plan), method: :delete, class: "button settings-table-row w-button delete-plan plan#{plan.id}", data: { disable_with: "<i class='fa fa-spinner fa-spin'></i>Please wait...".html_safe } %>
    <% end %>
  </div>
</div>
<% end %>
</div>
</div>
<a class="button save-changes settings-table w-button" href="#">Save changes</a>
<% end %>

