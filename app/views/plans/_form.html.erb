<%= form_for([current_user, @plan], :html=> { id: 'planForm', class: 'form-horizontal' }) do |f| %>

  <div class="form-group">
    <%= f.label :name, class: 'col-xs-3 control-label' %>
    <div class="col-xs-5">
      <%= f.text_field :name, class: 'form-control' %>
    </div>
  </div>

  <% if action_name == 'new' || action_name == 'create' %>
    
    <div class="form-group">
      <%= f.label :amount, class: 'col-xs-3 control-label' %>
      <div class="col-xs-5">
        <%= f.text_field :amount, class: 'form-control' %>
      </div>
    </div>

    <div id='interval-settings'>
      <div class="form-group">
        <%= f.label :interval, class: 'col-xs-3 control-label' %>
        <div class="col-xs-2">
          <%= f.select :interval, options_for_select({ "Day" => "day", "Week" => 'week', "Month" => "month" }, selected: @plan.interval),{}, class: 'form-control' %>
        </div>
      </div>
    </div>

      <div class="form-group">
        <%= f.label :interval_count, class: 'col-xs-3 control-label' %>
        <div class="col-xs-5 dynamic-count">
          <%= f.text_field :interval_count, id: 'interval-count', class: 'form-control' %>
        </div>
      </div>
    </div>

    <div class="actions field form-group">
      <div class="col-xs-9 col-xs-offset-3">
        <%= f.submit 'Create Plan', class: 'btn btn-primary' %>
      </div>
    </div>

  <% elsif action_name == 'edit' %>

    <div class="actions field form-group">
      <div class="col-xs-9 col-xs-offset-3">
        <%= f.submit 'Update Plan', class: 'btn btn-primary' %>
      </div>
    </div>

  <% end %>

<% end %>
