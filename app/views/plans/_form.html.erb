<div class="w-container">
  <%= form_for([current_user, @plan], :html=> { id: 'planForm' }) do |f| %>
    <label class="form-label" for="Plan-name">Plan name</label>
    <div class="form-group col-xs-6">
      <%= f.text_field :name, id: 'Plan-name', class: 'plan-name text-field w-input', data: { name: "Plan name" }, placeholder: 'Ex. Monthly fruit basket' %>
      </div>

    <div class="form-group col-xs-6">
      <%= f.text_field :amount, id: 'Plan-Amount', data: { name: "Plan Amount" }, class: 'plan-amount text-field w-input', placeholder: 'Plan Amount' %>
      </div>
    <label class="form-label" for="Plan-Interval">Subscription Interval</label>
    <div class="form-group col-xs-6">
      <%= f.select :interval, options_for_select(present(@plan).get_plan_intervals), {}, { id: "plan_interval", class: "dropdown w-select" } %>
      </div>    
    <div class="form-group col-xs-6">
      <% unless !current_user.is_platform? %>
        <%= f.label :trial_period_days, class: 'form-label' %>
        <%= f.text_field :trial_period_days, id: 'trial-days', class: 'plan-amount text-field w-input' %>
      <% end %>
      </div>
    <%= f.submit 'Create Plan', class: 'button create-plan w-button', id: 'create-plan' %>
  <% end %>
</div>
