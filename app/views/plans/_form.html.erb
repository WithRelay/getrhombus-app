<%= form_for([current_user,  Plan.new], :html=> { id: 'plan Formemail-form-8', class: 'form-horizontal', data: { name: 'Email Form 8' } }) do |f| %>
  <label class="form-label" for="Plan-name">Plan name</label>
  <%= f.text_field :name, id: 'Plan-name', class: 'plan-name text-field w-input', data: { name: "Plan name" } %>
  <%= f.text_field :amount, id: 'Plan-Amount', data: { name: "Plan Amount" }, class: 'plan-amount text-field w-input' %>
  <label class="form-label" for="Plan-Interval">Subscription Interval</label>
  <select class="dropdown w-select" data-name="Plan Interval" id="Plan-Interval" name="plan[interval]">
    <option value="week_1">Weekly</option>
    <option value="week_2">Bi-weekly</option>
    <option value="month_1">Monthly</option>
    <option value="month_3">Every 3 months</option>
    <option value="month_6">Every 6 months</option>
    <option value="year_1">Yearly</option>
  </select>
  <% unless !current_user.is_platform? %>
      <%= f.label :trial_period_days, class: 'col-xs-3 control-label' %>
      <%= f.text_field :trial_period_days, id: 'trial-days', class: 'form-control' %>
  <% end %>
  <%= f.submit 'Create Plan', class: 'button create-plan w-button', id: 'create-plan' %>
  <p class="charge-tips modal-paragraph tips"> &nbsp;TIP: You can also use Hashtags to create a subscription plan in Rhombus. Recurring payment Hashtags allow your customers subscribe themselves to a plan by simply texting the Hashtag to your Rhombus number.</p>
  <a class="button manage-plans w-button" href="#">Manage plans</a>
<% end %>
