<%= render 'campaign_header' %>
<%= render 'shared/flash_messages' %>
<%= link_to 'New Campaign', new_user_campaign_path(current_user), method: :get %>
<%= button_to 'Resend' %>
<table>
  <thead>
    <tr>
     <th>Title</th>
     <th>From</th>
     <th>Created</th>
     <th>Channel</th>
     <th>Recipients</th>
     <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% @campaigns.each do |campaign| %>
      <tr>
        <td>
          <%= link_to edit_user_campaign_path(current_user, campaign) do %>
            <%= campaign.name %>
          <% end %>
        </td>
        <td>
          <%= campaign.from_user %>
        </td>
        <td>
          <%= present(campaign).format_created_at %>
        </td>
        <td>
          <%= "#{campaign.channel} (#{present(campaign).format_frequency_type}) " %>
        </td>
        <td>
          <%= present(campaign).count_recipient %>
        </td>
        <td>
          <%= present(campaign).campaign_change_status_link %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
