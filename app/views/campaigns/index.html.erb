    <a class="import sub-nav-button w-button delete-resource" data-ix="cancel-subscription" href="#"> &nbsp;Delete</a>
  </div>
</div>
<script><%= render partial: 'shared/index.js.erb', locals: { obj: @campaigns } %></script>
