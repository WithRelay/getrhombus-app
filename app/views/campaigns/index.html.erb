<table>
  <thead>
    <tr>
     <th>Channel Name</th>
     <th>Status</th>
     <th>Delivery Type</th>
     <th>Date</th>
    </tr>
  </thead>
  <tbody>
    <% @campaigns.each do |campaign| %>
      <tr>
        <td>
          <%= campaign.channel %>
        </td>
        <td>
          <%= campaign.status %>
        </td>
        <td>
          <%= campaign.delivery_type %>
        </td>
        <td>
          <%= campaign.date_time %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
