<%= render 'shared/flash_messages' %>
<table>
  <thead>
    <tr>
     <th>Name</th>
     <th>Channel</th>
     <th>Status</th>
     <th>Frequency Type</th>
     <th>Date</th>
     <th>Edit</th>
     <th>Delete</th>
     <th>Pause</th>
    </tr>
  </thead>
  <tbody>
    <% @campaigns.each do |campaign| %>
      <tr>
        <td>
          <%= campaign.name %>
        </td>
        <td>
          <%= campaign.channel %>
        </td>
        <td>
          <%= campaign.status %>
        </td>
        <td>
          <%= present(campaign).format_frequency_type  %>
        </td>
        <td>
          <%= present(campaign).format_date_time %>
        </td>
        
        <td>
          <%= link_to 'Edit', edit_user_campaign_path(current_user, campaign) %>
        </td>
        <td>
          <%= link_to 'Delete', user_campaign_path(current_user, campaign), method: :delete %>
        </td>
        <td>
          <%= present(campaign).generate_status_link %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
