<%#= link_to 'Active', filter_campaign_user_campaigns_path(current_user, status: 'active') %>
<%#= link_to 'Inactive', filter_campaign_user_campaigns_path(current_user, status: 'inactive') %>
<%#= link_to 'Sent', filter_campaign_user_campaigns_path(current_user, status: 'sent') %>
<%#= link_to 'Paused', filter_campaign_user_campaigns_path(current_user, status: 'paused') %>
<div class="dashboard-nav w-clearfix">
  <div class="dashboard-logo-wrapper">
    <%= link_to root_url do %>
      <%= image_tag('relay-6.png', class: 'dashboard-logo', width: 50) %>
    <% end %>
  </div>
  <div class="dashboard-nav-links-wrapper">
    <a class="w-clearfix w-inline-block" href="#">
      <div class="dash-header-links"> &nbsp; <strong>Active</strong>
      </div>
      <div class="dash-header-links new-link"> &nbsp;&nbsp;<strong>Inactive</strong>
      </div>
      <div class="dash-header-links new-link">&nbsp; &nbsp;<strong>Sent</strong>
      </div>
      <%= render "shared/rhombus_number" %>
    </a>
  </div>
  <div class="dashboard-nav-links-wrapper new-tab right-nav settings-dropdown">
    <div class="dropdown-wrapper w-dropdown" data-delay="0">
      <div class="w-dropdown-toggle">
        <div class="dropdown-wrapper-text"><strong class="settings-header-tab-text">Settings &nbsp;&nbsp;</strong>
        </div>
      </div>
      <nav class="dropdown-content-wrapper w-dropdown-list"><a class="dropdown-link header w-dropdown-link" href="#"><%= current_user.full_name %></a>
        <a class="content-link dropdown-link w-dropdown-link" href="#">
          <span class="business-name-settings-dropdown"><%= current_user.org_name %></span>
          <br>
          <span class="account-owner-email-settings-dropdown"><%= current_user.email %></span></a>
          <a class="dropdown-link w-dropdown-link" href="#">Settings</a>
          <a class="dropdown-link w-dropdown-link" href="#">Billing Information</a>
        <%= link_to('Sign out', destroy_user_session_path, class: 'dropdown-link sign-out w-dropdown-link', method: :delete) %>
      </nav>
    </div>
  </div>
  <%= render 'shared/notifications' %>
</div>
