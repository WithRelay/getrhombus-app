<%#= link_to 'Active', filter_campaign_user_campaigns_path(current_user, status: 'active') %>
<%#= link_to 'Inactive', filter_campaign_user_campaigns_path(current_user, status: 'inactive') %>
<%#= link_to 'Sent', filter_campaign_user_campaigns_path(current_user, status: 'sent') %>
<%#= link_to 'Paused', filter_campaign_user_campaigns_path(current_user, status: 'paused') %>
<div class="dashboard-nav w-clearfix">
  <div class="dashboard-logo-wrapper">
    <%= link_to root_url do %>
      <%= image_tag('relay_6.png', class: 'dashboard-logo', width: 50) %>
    <% end %>
  </div>
  <div class="dashboard-nav-links-wrapper">
    <%= link_to filter_campaign_user_campaigns_path(status: 'active'), class: 'w-clearfix w-inline-block' do %>
      <div class="dash-header-links"> &nbsp; Active</div>
    <% end %>
    <%= link_to filter_campaign_user_campaigns_path(status: 'inactive'), class: 'w-clearfix w-inline-block' do %>
      <div class="dash-header-links new-link"> &nbsp; Inactive</div>
    <% end %>
    <%= link_to filter_campaign_user_campaigns_path(status: 'sent'), class: 'w-clearfix w-inline-block' do %>
      <div class="dash-header-links new-link"> &nbsp; Sent</div>
    <% end %>
  </div>
  <div class="dashboard-nav-links-wrapper new-tab right-nav settings-dropdown">
    <div class="dropdown-wrapper w-dropdown" data-delay="0">
      <div class="w-dropdown-toggle">
        <div class="dropdown-wrapper-text">Settings</div>
        <div class="dropdown-wrapper-icon w-icon-dropdown-toggle"></div>
      </div>
      <nav class="dropdown-content-wrapper w-dropdown-list"><a class="dropdown-link w-dropdown-link" href="#">&nbsp;&nbsp;&nbsp;&nbsp;Your profile</a><a class="dropdown-link w-dropdown-link" href="#">&nbsp;&nbsp;&nbsp;&nbsp;Settings</a><a class="dropdown-link w-dropdown-link" href="#">&nbsp;&nbsp;&nbsp;&nbsp;Billing Information</a><a class="dropdown-link w-dropdown-link" href="#">&nbsp;&nbsp;&nbsp;&nbsp;Log out</a>
      </nav>
    </div>
  </div>
  <div class="dashboard-nav-links-wrapper notifications right-nav">
    <div class="dropdown-wrapper w-dropdown" data-delay="0">
      <div class="w-dropdown-toggle">
        <div class="dropdown-wrapper-text"></div>
      </div>
      <nav class="dropdown-content-wrapper w-dropdown-list">
        <a class="dropdown-link w-dropdown-link" href="#">&nbsp;&nbsp;&nbsp;&nbsp;Unread messages</a>
        <a class="dropdown-link w-dropdown-link" href="#">&nbsp;&nbsp;&nbsp;&nbsp;New customer</a>
        <a class="dropdown-link w-dropdown-link" href="#">&nbsp;&nbsp;&nbsp;&nbsp;Payment received</a>
      </nav>
    </div>
  </div>
</div>
