<div class="row-wrapper">
  <div class="alt-table-row w-row">
    <div class="alt-column w-clearfix w-col w-col-3">
      <div class="title-column-div w-clearfix">
        <%= link_to edit_user_campaign_path(current_user, campaign), class: 'shrink-text table-text' do %>
          <%= present(campaign).campaign_name %>
          <% end %>
      </div>
      <div class="alt-table cb check-box-column">
        <div class="w-form">
          <form data-name="Email Form 2" id="email-form-2" name="email-form-2">
            <div class="select-all-check-box w-checkbox w-clearfix">
              <input class="cb table-checkbox checkboxes w-checkbox-input" id="node" type="checkbox">
              <div class ='resource-id w-hidden'><%= campaign.id %></div>
              <div class ='resource-status w-hidden'><%= campaign.status %></div>
              <label class="checkbox-field-lable w-form-label" for="node">-</label>
            </div>
          </form>
        </div>
      </div>
    </div>
    <div class="alt-column w-col w-col-2">
      <div class="alt-table-column-div w-clearfix">
        <%= present(campaign).profile_image %>
        <div class="shrink-text table-text"><%= campaign.from_user %></div>
      </div>
    </div>
    <div class="alt-column w-col w-col-2">
      <div class="alt-table-column-div w-clearfix">
        <div class="table-text shrink-text"><%= present(campaign).format_created_at %></div>
      </div>
    </div>
    <div class="alt-column w-col w-col-2">
      <div class="alt-table-column-div w-clearfix">
        <div class="table-text">1 week ago</div>
      </div>
    </div>
    <div class="alt-column w-col w-col-2">
      <div class="alt-table-column-div w-clearfix">
        <div class="shrink-text table-text"><%= campaign.channel.capitalize %></div>
      </div>
    </div>
    <div class="alt-column w-col w-col-1">
      <div class="alt-table-column-div w-clearfix">
        <div class="table-text"> &nbsp;  <%= present(campaign).count_recipient %></div>
      </div>
    </div>
  </div>
</div>
