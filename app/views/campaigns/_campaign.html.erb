<style>
.selectize-dropdown-content {
  display: block !important;
  background-color: white !important;
  width: 113% !important;
  border: 1px solid #1f8cec !important;
  margin-left: -33px !important;
  margin-top: 12px !important;
  text-align: left !important;
}
.name{
  border-bottom: none;
  height: 20px;
}
</style>
<div class="campaign-editor-options w-form">
  <%= form_for [current_user, @campaign], html: { multipart: true, id: 'campaignForm', class: 'w-clearfix', data: { name: 'Email Form' } } do |f| %>

    <div class='form-group col-xs-6'>
      <%= f.text_field :name, class: 'form-control editor text-field w-input', id: 'Campaign-name', data: { name: 'Campaign name' }, placeholder: 'Campaign name'  %>
      <div class="messageContainer"></div>
    </div>

    <div class='form-group col-xs-6'>
      <label class="editor-options form-label" for="List"> &nbsp; List</label>
      <%= f.text_field :list_name, id: 'List', 'data-lists_data' => "#{@lists.to_json}", placeholder: "Choose a list", class: 'form-control editor text-field w-input', data: { name: 'List' } %>
      <div class="messageContainer"></div>
    </div>

    <label class="channel editor-options form-label" for="Channel"> &nbsp; Message channel</label>

    <%= f.select :channel, channel_list(@campaign, @lists), {}, selected: get_channel_enum_value(@campaign.channel), class: 'dropdown editor-dropdown w-select', id: 'Channel', data: { name: 'Channel' } %>

    <div class="frequency radio-button w-clearfix w-radio">
      <%= f.radio_button :frequency_type, 0, id: 'oneTimeFrequency', checked: is_one_time_checked?(@campaign), class: 'w-radio-input', data: { name: 'Radio 2' } %>
      <label class="check-radio-text w-form-label" for="radio">Send once</label>
    </div>

    <div class="frequency radio-button w-clearfix w-radio">
      <%= f.radio_button :frequency_type, 1, id: 'recurringFrequency',  checked: is_recurring_checked?(@campaign), class: 'w-radio-input' %>
      <label class="check-radio-text w-form-label" for="radio">Repeat message</label>
    </div>

    <div class="editor underline-div"></div>

    <div class="check-box editor w-checkbox w-clearfix">
      <%= f.check_box :deliver_now, id: 'Deliver-now', class: 'w-checkbox-input', data: { name: 'Deliver now' } %>
      <label class="check-radio-text w-form-label" for="Deliver-now">Deliver Immediately</label>
    </div>

    <div class='scheduleOption'>
      <%= f.text_field :date_time, class: 'daterange editor text-field w-input', id: 'Date-Picker', value: present(@campaign).to_user_date_time, data: { name: "Date Picker" } %>
      <%= f.select :repeat_days, repeat_days_options, {}, selected: @campaign.repeat_days, id: 'campaign_repeat_days', class: 'dropdown editor-dropdown w-select', data: { name: 'Interval' } %>
    </div>

    <p class="editor-paragraph tips"> &nbsp;TIP: Set your messages to deliver at the most appropriate time for your customers</p>

    <div class="dashboard-body editor">
    <div class="dash-content-container message-editor">
      <div class="w-form">
        <div class='newMessage'>
          <div class="w-form">
            <div class='form-group col-xs-6'>
              <%= f.text_area :text, id: 'trumbowyg', class: 'form-control message-editor text-area w-input', data: { name: 'Editor Text Area' } %>
              <div class="messageContainer"></div>
            </div>
          </div>
        </div>

      </div>
      <div class="editor-button-container">
        <div class="w-row">
          <div class="w-col w-col-6">
            <div id="textBoxCounter" class='char-count'> </div>
            <div class="upload_image">
              <div class='attach-image-container'>
                <a class="attach-text" href="#" id='select-images-button'></a>
              </div>
              <!-- for new images -->
              <%= f.file_field :avatar, id: 'select-images', class: 'w-hidden' %>
              <div id='new-image-previews'>
              </div>
              <!-- for already attached images -->
              <div id='image-previews' data-model-id='campaigns_<%= @campaign.id %>'>
                <%= div_for @campaign.images do |image| %>
                  <%= present(image).image_delete_url %>
                  <%= present(image).image_url %>
                  <%= present(image).image_name %>
                <% end %>
              </div>
            </div>
          </div>
          <div class="w-clearfix w-col w-col-6">
            <%= f.submit 'Send me a test', id: 'sendTestCampaign', class: 'alt button editor-buttons w-button' %>
            <%= f.submit 'Send', class: 'button editor-buttons w-button' %>
          </div>
        </div>
      </div>
    </div>
    <div class="editor-date">December 28, 2016</div>
    <div class="alt campaign-editor sub-nav-bar w-clearfix">
      <div class="w-form">
        <div class='form-group col-xs-6'>
          <%= f.text_field :subject, class: "form-control emailSubject email-subject text-field w-input", data: { name: "Email Subject" }, id: "campaign_subject", placeholder: 'Email subject'  %>
          <div class="messageContainer"></div>
        </div>
        <div class="w-form-done">
          <div>Thank you! Your submission has been received!</div>
        </div>
        <div class="w-form-fail">
          <div>Oops! Something went wrong while submitting the form</div>
        </div>
      </div>
      <h4 class="sender welcome-dash-content-container-header w-hidden"><%= @user_title %></h4>
    </div>
  </div>
  <% end %>
</div>
