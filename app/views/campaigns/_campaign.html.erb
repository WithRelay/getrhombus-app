<%= form_for [current_user, @campaign], html: { multipart: true } do |f| %>

<div class="row">
  <div class="col-xs-5">
    <%= f.label :Name %>
  </div>

    <div class="col-xs-6">

      <%= f.text_field :name %>
    </div>

  <br><br>
    <%= f.label :Choose_a_list, class: 'col-xs-3 control-label' %>
    <div class="col-xs-6">
      <%= f.text_field :list_name, id: 'campaign-select-lists', 'data-lists_data' => "#{@lists.to_json}", placeholder: "Select 1 or more lists" %>
    </div>
  <br>
  <br><br><br>
  <br><br><br>
  <%= f.label :Channel %>
  <%= f.select :channel, channel_list(@campaign, @lists), selected: get_channel_enum_value(@campaign) %>

  <br><br>

  <%= f.label :Delivery_Settings %>

  <br><br>

  <%= f.label :One_Time %>
  <%= f.radio_button :frequency_type, 0, id: 'oneTimeFrequency', checked: is_one_time_checked?(@campaign)   %>

  <%= f.label :Recurring %>
  <%= f.radio_button :frequency_type, 1, id: 'recurringFrequency',  checked: is_recurring_checked?(@campaign)  %>

  <br><br>

  <%= f.label :send_campaign_now, class: 'deliverNow' %>
  <%= f.check_box :deliver_now, id: 'deliverNow' %>

  <div class='scheduleOption'>
    <%= f.select :repeat_days, repeat_days_options, selected: @campaign.repeat_days %>
    <%= f.text_field :date_time, class: 'daterange', value: present(@campaign).to_user_date_time %>
  </div>

  <br><br>
    <div class='newMessage'>
      <div class='emailSubject'>
        <div class="col-xs-5">
          <%= f.label :subject %>
          <%= f.text_field :subject %>
        </div>
      </div>
      <br>
      <br><br>
      <div class="col-xs-6">
        <%= f.text_area :text, id: 'trumbowyg' %>
      </div>
      </div>
      <div id="textBoxCounter"> </div>
  </div>

  <br><br>

  <div class="upload_image">
    <%= f.file_field :avatar, id: 'select-images' %>
  </div>

  <!-- for new images -->
  <div id='new-image-previews'></div>
  <!-- for already attached images -->
  <div id='image-previews' data-model-id='campaigns_<%= @campaign.id %>'>
    <%= div_for @campaign.images do |image| %>
      <%= present(image).image_url %>
      <%= present(image).image_delete_url %>
    <% end %>
  </div>
  <div class="col-xs-6">
    <%= f.submit 'Save Campaign' %>
  </div>
  <div class="col-xs-6">
    <%= f.submit 'Send Test Email For Me', id: 'sendTestCampaign'%>
  </div>
<% end %>
