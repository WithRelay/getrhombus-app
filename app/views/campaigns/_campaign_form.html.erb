<style>
  /*dashboard-nav is from the parent page*/
  .dashboard-nav{
    left: 20%;
    width: 80%;
    min-width: 80%;
  }
</style>
<div class="campaign-editor-options">
  <%= form_for [current_user, @campaign], html: { multipart: true, id: 'campaignForm', class: 'w-clearfix', data: { persisted: @campaign.persisted?, channel: @campaign.channel } } do |f| %>

    <div class='form-group col-xs-6'>
      <%= f.text_field :name, class: 'form-control editor text-field w-input', id: 'Campaign-name', placeholder: 'Campaign name'  %>
      <div class="errorMessageContainer"></div>
    </div>

    <div class='form-group col-xs-6'>
      <label class="editor-options form-label" for="List"> &nbsp; List</label>
    <div id = 'choose-a-list'>
      <%= f.text_field :list_id, id: 'campaign-list', 'data-list-data' => "#{@lists.to_json}", placeholder: "Choose a list", class: 'form-control editor text-field w-input' %>
    </div>
      <div class="errorMessageContainer"></div>
    </div>

    <label class="channel editor-options form-label" for="Channel"> &nbsp; Message channel</label>

    <%= f.select :channel, channel_list(@campaign, @lists), { selected: get_channel_enum_value(@campaign.channel) }, class: 'dropdown editor-dropdown w-select', id: 'campaign-channel' %>

    <div class="frequency radio-button w-clearfix w-radio">
      <%= f.radio_button :frequency_type, 0, checked: is_one_time_checked?(@campaign), class: 'w-radio-input', id: 'campaignOneTimeFrequency' %>
      <label class="check-radio-text w-form-label" for="radio">Send once</label>
    </div>

    <div class="frequency radio-button w-clearfix w-radio">
      <%= f.radio_button :frequency_type, 1, checked: is_recurring_checked?(@campaign), class: 'w-radio-input', id: 'campaignRecurringFrequency' %>
      <label class="check-radio-text w-form-label" for="radio">Repeat message</label>
    </div>

    <div class="editor underline-div"></div>

    <div class="check-box editor w-checkbox w-clearfix">
      <%= f.check_box :deliver_now, id: 'Deliver-now', class: 'w-checkbox-input' %>
      <label class="check-radio-text w-form-label" for="Deliver-now">Deliver Immediately</label>
    </div>

    <div class='scheduleOption'>
      <%= f.text_field :date_time, class: 'daterange editor text-field w-input', id: 'Date-Picker', value: present(@campaign).to_user_date_time %>
      <%= f.select :repeat_days, repeat_days_options, { selected: @campaign.repeat_days }, class: 'dropdown editor-dropdown w-select', id: 'campaign_repeat_days' %>
    </div>

    <p class="editor-paragraph tips"> &nbsp;TIP: Set your messages to deliver at the most appropriate time for your customers</p>

    <div class="dashboard-body editor">
    <div class="dash-content-container message-editor">
      <div class='form-group col-xs-6'>
        <div class='newMessage'>
          <div>
            <%= f.text_area :text, id: 'trumbowyg', class: 'form-control message-editor text-area w-input' %>
            <div class="errorMessageContainer"></div>
          </div>
        </div>
      </div>
      <div class="editor-button-container">
        <div class="w-row">
          <div class="w-col w-col-4">
            <div id="textBoxCounter" class='char-count w-col-8'> </div>
            <div class="upload_image">
              <div class='attach-image-container w-col-2'>
                <a class="attach-text" href="#" id='select-images-button'></a>
              </div>
            </div>
            </div>
              <!-- for new images -->
              <div class = "w-col-12" id = "image-wrapper">
              <%= f.file_field :avatar, id: 'select-images', class: 'w-hidden' %>
              <div id='new-image-previews'>
              </div>
              <!-- for already attached images -->
              <div id='image-previews' data-model-id='campaigns_<%= @campaign.id %>'>
                <%= div_for @campaign.images do |image| %>
                  <%= present(image).image_delete_url %>
                  <%= present(image).image_url %>
                  <%= present(image).image_name %>
                <% end %>
              </div>
            </div>

          <div class="w-clearfix w-col w-col-8 campaign-buttons-list">
            <%= f.submit 'Save campaign', class: 'button editor-buttons w-button campaign-button', id: 'send-campaign-users' %>
            <%= f.submit 'Send me a test', id: 'sendTestCampaign', class: 'alt button editor-buttons w-button campaign-button' %>
            <div data-delay="0" class="dropdown merge-fields w-dropdown merge-fields-dd">
              <div class="w-dropdown-toggle merge-fields-text">
                <div class="merge-field-icon w-icon-dropdown-toggle"></div>
                <div class="merge-field-dropdown-text">Insert Merge Fields</div>
              </div>
              <nav class="dropdown-list merge-fields w-dropdown-list">
                <a href="#" class="dropdown-link merge-field-links w-dropdown-link handlebar-content" data-value='{{first_name}}'>First name</a>
                <a href="#" class="dropdown-link merge-field-links w-dropdown-link handlebar-content" data-value='{{full_name}}'>Full name</a>
                <a href="#" class="dropdown-link merge-field-links w-dropdown-link handlebar-content" data-value='{{phone_number}}'>Phone number</a>
                <a href="#" class="dropdown-link merge-field-links w-dropdown-link handlebar-content" data-value='{{merchant_org_number}}'>Your phone number</a>
                <a href="#" class="dropdown-link merge-field-links w-dropdown-link handlebar-content" data-value='{{business_name}}'>Business name</a>
                <a href="#" class="dropdown-link merge-field-links w-dropdown-link handlebar-content" data-value='{{merchant_address}}'>Your address</a>
              </nav>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="editor-date"><%= todays_date %></div>
    <div class="alt campaign-editor sub-nav-bar w-clearfix emailSubject">
      <div>
        <div class='form-group col-xs-6'>
          <%= f.text_field :subject, class: "form-control email-subject text-field w-input", id: "campaign_subject", placeholder: 'Email subject'  %>
          <div class="errorMessageContainer"></div>
        </div>
      </div>
      <h4 class="sender welcome-dash-content-container-header w-hidden"><%= current_user.user_title %></h4>
    </div>
  </div>
  <% end %>
</div>
