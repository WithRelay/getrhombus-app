<div class='newMessage'>
  <%= f.fields_for :messages do |ff| %>

    <%= ff.text_area :text, cols: 100, rows: 15, id: 'jodit' %>

    <%= ff.fields_for :images do |fff| %>

      <%= fff.file_field :avatar_file_name, id: 'campaignMessageAttachment',  multiple: true, accept: "image/jpeg, image/jpg, image/gif, image/png" %>

    <% end %>
  <% end %>
</div>
<%= image_tag 's', id: 'imagePreview'%>
