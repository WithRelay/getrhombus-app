<% if params[:controller] == 'merchant_customers' %>
  <div class="customer-profile-trasaction-table w-row">
    <div class="w-col w-col-5">
      <div class="description w-clearfix">
        <div class="shrink-text table-text unread-table"><%= transaction.description %></div>
      </div>
    </div>
    <div class="w-col w-col-2">
      <div class="amount w-clearfix">
        <div class="shrink-text table-text unread-table tran-amount">$<%= transaction.amount || 0 %></div>
      </div>
    </div>
    <div class="w-col w-col-2">
      <div class="date w-clearfix">
        <div class="table-text unread-table shrink-text"><%= time_in_relative_form(transaction.created_at, 'short_ago_format') %></div>
      </div>
    </div>
    <div class="w-col w-col-3">
      <div class="action w-clearfix">
        <% if transaction.subscription_id.blank? %>
          <a class="actions status modal-loader customer-profile-refund-btn" modal-target= 'refund_customer_modal' data-txn-number="<%= transaction.txn_number %>" data-txn-last4="<%= transaction.last4 %>">Refund</a>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <div class="row-wrapper transactions">
    <div class="transactions-table-row w-row">
      <div class="transaction-column w-clearfix w-col w-col-3">
        <div class="card-name transaction-cell w-clearfix">
          <%= present(transaction).profile_image %>
          <div class="shrink-text table-text transaction-table">
            <%= link_to "#{present(transaction).transaction_user_name}", "customers/#{get_merchant_customer_id transaction}", class: 'non-underline-link', action: "show" %>
          </div>
        </div>
        <div class="cb check-box-column">
          <div>
            <%= form_for(transaction, url: capture_user_transaction_path(current_user, transaction)) do |f| %>
              <div class="select-all-check-box w-checkbox w-clearfix">
                <input class="cb table-checkbox checkboxes w-checkbox-input <%= @authorized_txns ? 'capture-txn-checkbox' : 'transaction-checkbox' %>" type="checkbox" data-txn-number="<%= transaction.txn_number %>">
                <label class="checkbox-field-lable w-form-label" for="node">-</label>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <div class="transaction-column w-col w-col-2">
        <div class="transaction-cell w-clearfix">
          <div class="shrink-text table-text"><%= transaction.item_name || "-" %></div>
        </div>
      </div>
      <div class="transaction-column w-col w-col-2">
        <div class="transaction-cell">
          <div class="table-text"><%= transaction.created_at.strftime("%d/%m/%Y") %></div>
        </div>
      </div>
      <div class="transaction-column w-col w-col-2">
        <div class="transaction-cell w-clearfix">
          <div class="table-text tran-amount">$<%= number_with_delimiter("#{Toolbox::Decimal.to_int_or_2dp(transaction.amount)}", delimiter: ',') %></div>
        </div>
      </div>
      <div class="transaction-column w-col w-col-2">
        <div class="transaction-cell w-clearfix">
          <div class="shrink-text table-text tran-email"><%= transaction.user.email %></div>
        </div>
      </div>
      <div class="transaction-column w-col w-col-1">
        <div class="transaction-cell w-clearfix">
          <div class="table-text tran-last-four"><%= transaction.last4 %></div>
        </div>
      </div>
    </div>
  </div>
<% end %>
