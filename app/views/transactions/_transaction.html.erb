<div class="row-wrapper transactions">
  <div class="transactions-table-row w-row">
    <div class="transaction-column w-clearfix w-col w-col-3">
      <div class="card-name transaction-cell w-clearfix">
        <%= present(transaction).profile_image %>
        <div class="shrink-text table-text transaction-table">
          <%= link_to "#{present(transaction).transaction_user_name}", "customers/#{get_merchant_customer_id transaction}", class: 'non-underline-link', action: "show" %>
        </div>
      </div>
      <div class="cb check-box-column">
        <div>
          <form id="email-form-2" name="email-form-2">
            <div class="select-all-check-box w-checkbox w-clearfix">
              <input class="cb table-checkbox checkboxes w-checkbox-input transaction-checkbox" id="node" type="checkbox" data-txn-number="<%= transaction.txn_number %>">
              <label class="checkbox-field-lable w-form-label" for="node">-</label>
            </div>
          </form>
        </div>
      </div>
    </div>
    <div class="transaction-column w-col w-col-2">
      <div class="transaction-cell w-clearfix">
        <div class="shrink-text table-text">Cheese Burger</div>
      </div>
    </div>
    <div class="transaction-column w-col w-col-2">
      <div class="transaction-cell">
        <div class="table-text"><%= transaction.created_at.strftime("%d/%m/%Y") %></div>
      </div>
    </div>
    <div class="transaction-column w-col w-col-2">
      <div class="transaction-cell w-clearfix">
        <div class="table-text tran-amount"><%= "#{Toolbox::Decimal.to_int_or_2dp(transaction.amount)}" %></div>
      </div>
    </div>
    <div class="transaction-column w-col w-col-2">
      <div class="transaction-cell w-clearfix">
        <div class="shrink-text table-text tran-email"><%= transaction.user.email %></div>
      </div>
    </div>
    <div class="transaction-column w-col w-col-1">
      <div class="transaction-cell w-clearfix">
        <div class="table-text tran-last-four"><%= transaction.last4 %></div>
      </div>
    </div>
  </div>
</div>
