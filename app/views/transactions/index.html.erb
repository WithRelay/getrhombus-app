<%= render 'transaction_nav' %>
<form id="txn_history_form" method="get" action="transactions/download.csv">
  <input type="hidden" id="txn_start_date" name="txn_start_date" />
  <input type="hidden" id="txn_end_date" name="txn_end_date" />
</form>
<div class="dashboard-body">
  <div class="table-wrapper">
    <div class="transaction-summary-wrapper">
      <div class="transaction-summary-row w-row">
        <div class="w-col w-col-4">
          <div class="transaction-summary-cell transcation-count">
            <h1 class="total-customer-count"><%= transactions[0].count %></h1>
            <h4 class="count-description"> &nbsp; Transactions Today</h4>
            <h4 class="count-description transaction-count"> <%= transactions_change %></h4>
          </div>
        </div>
        <div class="w-col w-col-4">
          <div class="transaction-summary-cell">
            <h1 class="total-customer-count"><%= "$#{Toolbox::Decimal.to_int_or_2dp(transactions_total_amount)}"  %></h1>
            <h4 class="count-description"> &nbsp; Total Collected</h4>
            <h4 class="count-description transaction-count"> <%= transactions_total_amount_change %></h4>
          </div>
        </div>
        <div class="w-col w-col-4">
          <div class="transaction-summary-cell">
            <h1 class="total-customer-count"><%= "$#{Toolbox::Decimal.to_int_or_2dp(transactions_net_sales)}"  %></h1>
            <h4 class="count-description"> &nbsp; Net Sales</h4>
            <h4 class="count-description transaction-count"><%= transactions_net_sales_change %></h4>
          </div>
        </div>
      </div>
    </div>
    <div class="row-wrapper transactions">
      <div class="header transactions-table-row w-row">
        <div class="transaction-column w-clearfix w-col w-col-3">
          <div class="card-name table-heading transaction-cell w-clearfix">
            <div class="table-heading-text transaction-header-text">Card name</div>
          </div>
          <div class="cb check-box-column table-heading"></div>
        </div>
        <div class="transaction-column w-col w-col-2">
          <div class="table-heading transaction-cell w-clearfix">
            <div class="table-heading-text table-text">Item name</div>
          </div>
        </div>
        <div class="transaction-column w-col w-col-2">
          <div class="table-heading transaction-cell w-clearfix">
            <div class="table-heading-text table-text">Date</div>
          </div>
        </div>
        <div class="transaction-column w-col w-col-2">
          <div class="table-heading transaction-cell w-clearfix">
            <div class="table-heading-text table-text tran-amount">Amount</div>
          </div>
        </div>
        <div class="transaction-column w-col w-col-2">
          <div class="table-heading transaction-cell w-clearfix">
            <div class="table-heading-text table-text tran-email">Email</div>
          </div>
        </div>
        <div class="transaction-column w-col w-col-1">
          <div class="table-heading transaction-cell w-clearfix">
            <div class="table-heading-text table-text tran-last-four">Last four</div>
          </div>
        </div>
      </div>
    </div>
    <div id='objlists'>
      <%= render @transactions %>
    </div>
    <div id="with-button" class="hide">
      <%= will_paginate %>
    </div>

    <% if @transactions.next_page %>
      <div id="load_more_transactions" class="show_more button w-button" data-loading-text="Loding more transactions" title="Click here to load more transactions">Show More</div>
    <% end %>
  </div>
</div>