<%= provide(:title, "Rhombus - Transactions") %>
<!-- ========== Css Files ========== -->
<!-- Start Page Loading -->
<div class="loading"><img src="<%= asset_path 'loading.gif' %>" alt="loading-img"></div>
<!-- End Page Loading -->
<%= render 'shared/header_new' %>
<%= render 'shared/sidebar' %>
<!-- //////////////////////////////////////////////////////////////////////////// -->
<!-- START CONTENT -->
<div class="content">
  <!-- Button trigger modal -->
  <%= button_tag 'Create Plan', class: 'btn btn-default', data: { toggle: :modal, target: '#modalPlan' } %>
  <%= button_tag 'Create Subscription', class: 'btn btn-default', data: { toggle: :modal, target: '#modalSubscription' } %>
  <%= button_tag 'Cancel Subscription', class: 'btn btn-default', data: { toggle: :modal, target: '#modalCancelSubscription' } %>
  <!-- Modal -->
  <div class="modal fade" id="modalPlan" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">&times;</span>
          <span class="sr-only">Close</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">Create Plan</h4>
          <hr>
          Plans let you charge customers a recurring amount over a specified time interval.
        </div>
        <!-- Modal Body -->
        <div class="create-plan-form w-form">
          <form data-name="Email Form 8" id="modal-create-plan" name="email-form-8">
            <label class="form-label" for="Plan-name">Plan name</label>
            <input class="plan-name text-field w-input" data-name="Plan name" id="Plan-name" maxlength="256" name="Plan-name" placeholder="Ex. Monthly fruit basket" type="text">
            <input class="plan-amount text-field w-input" data-name="Plan Amount" id="Plan-Amount" maxlength="256" name="Plan-Amount" placeholder="Amount" required="required" type="email">
            <label class="form-label" for="Plan-Interval">Subscription Interval</label>
            <select class="dropdown w-select" data-name="Plan Interval" id="Plan-Interval" name="Plan-Interval">
              <option value="">Weekly</option>
              <option value="14">Bi-weekly</option>
              <option value="30">Monthly</option>
              <option value="90">Every 3 months</option>
              <option value="180">Every 6 months</option>
              <option value="365">Yearly</option>
            </select>
            <a class="button create-plan w-button" href="#">Create plan</a>
            <p class="charge-tips modal-paragraph tips"> &nbsp;TIP: You can also use Hashtags to create a subscription plan in Rhombus. Recurring payment Hashtags allow your customers subscribe themselves to a plan by simply texting the Hashtag to your Rhombus number.</p>
            <a class="button manage-plans w-button" href="#">Manage plans</a>
          </form>
          <div class="w-form-done">
            <div>Thank you! Your submission has been received!</div>
          </div>
          <div class="w-form-fail">
            <div>Oops! Something went wrong while submitting the form</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="modal fade" id="modalSubscription" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">&times;</span>
          <span class="sr-only">Close</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">Create Subscription</h4>
          <hr>
          Subscribe customers to an existing plan to charge them on a recurring basis.
        </div>
        <!-- Modal Body -->
        <div class="create-subscription-form w-form">
          <form class="w-clearfix" data-name="Email Form 9" id="modal-subscription-form" name="email-form-9">
            <input class="subscriber-name text-field w-input" data-name="Subscriber Name" id="Subscriber-Name" maxlength="256" name="Subscriber-Name" placeholder="Enter customer's name or phone number" required="required" type="text">
            <select class="dropdown w-select" id="field-5" name="field-5">
              <option value="">Select a plan</option>
              <option value="">Weekly Veggie Bowl</option>
              <option value="">Monthly fruit basket</option>
            </select>
            <label class="form-label" for="Number-of-subscriptions">Number of subscriptions</label>
            <input class="number-of-subscriptions text-field w-input" data-name="Number of subscriptions" id="Number-of-subscriptions" maxlength="256" name="Number-of-subscriptions" placeholder="1" required="required" type="email">
            <a class="button subscription w-button" id="modal-subscription" href="#">Subscribe customer</a>
          </form>
          <div class="w-form-done">
            <div>Thank you! Your submission has been received!</div>
          </div>
          <div class="w-form-fail">
            <div>Oops! Something went wrong while submitting the form</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="modal fade" id="modalCancelSubscription" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">&times;</span>
          <span class="sr-only">Close</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">Cancel Subscription</h4>
          <hr>
          Are you sure you'd like to unsubscriber [customer name] from [plan name] plan?
        </div>
        <!-- Modal Body -->
        <a class="button cancel-no w-button" data-ix="close-cancel-subscription" href="#" data-dismiss="modal">Cancel</a>
        <a class="button cancel-yes w-button" href="#">Yes, unsubscribe customer</a>
      </div>
    </div>
  </div>
  <!-- Start Page Header -->
  <div class="page-header" style="background: transparent; margin-bottom: 0px;">
    <div class="title" style="font-weight: normal;">Transactions</div>
    <!-- CSV upload -->
    <form id="csv-upload-form" action="/v1/users/add_customers.csv" method="POST">
      <input type="file" id="csv-file-select" name="csv" accept=".csv"/>
      <button type="submit" id="csv-upload-button">Upload</button>
    </form>
    <%= render 'shared/dashboard_shortcut' %>
  </div>
  <!-- End Page Header -->
  <!-- //////////////////////////////////////////////////////////////////////////// -->
  <!-- START CONTAINER -->
  <div class="" id="transactions-column" data-level="<%= current_user.user_level %>">
    <!-- Start Row -->
    <div class="row">
      <!-- Start Panel -->
      <div class="col-md-12">
        <% unless @transactions.blank? %>
        <div class="panel panel-default">
          <div class="panel-title">
            <ul class="panel-tools">
              <li><a class="icon expand-tool"><i class="fa fa-expand"></i></a></li>
            </ul>
          </div>
          <div class="panel-body table-responsive">
            <table id="transactions-table" class="table table-striped dataTable">
              <thead>
                <tr role="row">
                  <td class="text-center"><i class="fa fa-trash" style="visibility: hidden;"></i></td>
                  <th>Date (ET)</th>
                  <th><%= current_user.is_customer? ? "Business" : "Card Name" %></th>
                  <th>Message</th>
                  <th>Phone #</th>
                  <th><%= current_user.is_customer? ? "Rhombus #" : "Amt Paid" %></th>
                  <th>Last Four</th>
                </tr>
              </thead>
              <tbody>
                <% @transactions.each do |t| %>
                <tr role="row">
                  <td class="details-control" data-txn-num="<%= t.txn_number %>"
                    data-time="<%= t.created_at.strftime("%I:%M %p") %>"
                    id="<%= t.txn_number %>"
                    data-email="<%= t.email %>"
                    data-tax="<%= t.tax_percent %>"
                    data-status="<%#= (t.refund_id) ? "Refunded" : "Charged" %>"
                    data-page="transactions"
                    ></td>
                  <td><%= t.created_at.strftime("%m/%d/%Y") %></td>
                  <td><%= current_user.is_customer? ? t.org_name : t.card_name %></td>
                  <td><%= t.notes %></td>
                  <td><%= current_user.is_customer? ? t.org_phone : t.phone_number %></td>
                  <td><%= current_user.is_customer? ? t.rhombus_number : t.amount_less_fees %></td>
                  <td><%= t.last4 %></td>
                </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <% else %>
        <div class="center">
          <img src="<%= asset_path 'no-transactions.png' %>" alt="no transaction">
          <div class="no-user"><%= current_user.is_customer? ? "You have no payments :(" : "You have no transactions :(" %></div>
        </div>
        <% end %>
      </div>
      <!-- End Panel -->
      <div style="text-align: center; margin-bottom: 40px;"><%= will_paginate @transactions, :page_links => false %></div>
    </div>
    <!-- End Row -->
  </div>
  <!-- END CONTAINER -->
  <!-- //////////////////////////////////////////////////////////////////////////// -->
  <br><br><br><br><br><br><br><br><br><br><br><br>
  <br><br><br><br><br><br>
  <%= render 'shared/dashboard_footer' %>
</div>
<!-- End Content -->
<!-- //////////////////////////////////////////////////////////////////////////// -->
<%= render 'refund_box' %>
<!-- should move out of here -->
<form id="txn_history_form" method="get" action="transactions/download.csv">
  <input type="hidden" id="txn_start_date" name="txn_start_date" />
  <input type="hidden" id="txn_end_date" name="txn_end_date" />
</form>
<!-- Date picker stuff -->
<!-- Include Required Prerequisites -->
<script type="text/javascript" src="//cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
<!-- Include Date Range Picker -->
<script type="text/javascript" src="//cdn.jsdelivr.net/bootstrap.daterangepicker/2/daterangepicker.js"></script>
<link rel="stylesheet" type="text/css" href="//cdn.jsdelivr.net/bootstrap.daterangepicker/2/daterangepicker.css" />
<script type="text/javascript">
  $(function() {
      $('.title').daterangepicker({
        cancelClass: 'hide',
        linkedCalendars: true,
        /*timePicker: true,
        timePickerIncrement: 30,
        singleDatePicker: true,
        locale: {
            format: 'MM/DD/YYYY h:mm A'
        },*/
       ranges: {
           'Today': [moment(), moment()],
           'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
           'Last 7 Days': [moment().subtract(6, 'days'), moment()],
           'Last 30 Days': [moment().subtract(29, 'days'), moment()],
           'This Month': [moment().startOf('month'), moment().endOf('month')],
           'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
        },
        alwaysShowCalendars: false,
        //maxDate: new Date
      })
        .on('apply.daterangepicker', function(ev, picker) {
          document.getElementById('txn_start_date').value = picker.startDate.format('YYYY-MM-DD');
          document.getElementById('txn_end_date').value = picker.endDate.format('YYYY-MM-DD');
          $('#txn_history_form').submit();
        });
  });
</script>
