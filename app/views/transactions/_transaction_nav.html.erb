<div class="customer-dash sub-nav-bar w-clearfix">
  <div class="sub-nav-options-wrapper transactions w-clearfix">
    <a class="add sub-nav-button w-button modal-loader" href="#" modal-target= "charge-customer-modal">&nbsp; <strong>Charge&nbsp;customer</strong></a>
    <div class='modal-background w-hidden modal-body charge-customer-modal'>
      <%= render 'shared/modals/charge_customer' %>
    </div>
    <a class="import sub-nav-button w-button modal-loader hide"  href="#" modal-target= 'refund_customer_modal' id="refund-charge">&nbsp; <strong>Refund</strong></a>
    <div class='modal-background w-hidden modal-body refund_customer_modal'>
      <%= render 'shared/modals/refund_customer' %>
    </div>
    <% if transactions.present? %>
      <div class="date-range-wrapper w-clearfix">
        <form class="date-picker-form w-clearfix" id="email-form-3" name="email-form-3">
          <input class="date-picker-field w-input" id="Transaction-Date-Range-Picker" maxlength="256" placeholder="Date Picker " type="text">
        </form>
      </div>
    <% end %>
  </div>
</div>
