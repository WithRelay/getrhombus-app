<%= render partial: 'transaction_nav', locals: { transactions: @transactions } %>

<% if current_user.is_merchant? %>

  <div class="dashboard-body">
    <div class="blank-page-container w-container">
      <%= image_tag 'Wallet.png', class: 'blank-page-icon' %>
      <h1 class="empty-state-dash hero-h1 home-header">
        <%= empty_transaction_text %>
      </h1>

      <% if current_user.can_accept_payments? %>
        <a class="button error-page-button w-button modal-loader" href="#" modal-target= "charge-customer-modal"><strong>Charge customer</strong></a>    
      <% else %>
        <%= link_to 'Connect bank account', user_managed_accounts_path(current_user), class: 'button error-page-button w-button' %>
      <% end %>    
    </div>
  </div>

<% else %>

  <div class="dashboard-body">
    <div class="blank-page-container w-container">
      <%= image_tag 'Wallet.png', class: 'blank-page-icon' %>
      <h1 class="empty-state-dash hero-h1 home-header">
        You have no <%= @authorized_txns ? 'pre-authorized' : '' %> transactions.
      </h1>
    </div>
  </div>

<% end %>
