
<h1>Saved Replies</h1>

<table>
  <tr>
    <th>Id</th>
    <th>Title</th>
    <th>Body</th>
    <th></th>    
  </tr>
<% @save_replies.each do |reply| %>
  <% if reply.id.present? %>
    <tr>
      <td><%= reply.id %></td>
      <td><%= reply.title %></td>
      <td><%= reply.body %></td>
      <td><%= link_to 'Destroy',[reply.user, reply], confirm: 'Are you sure?', method: :delete %></td>
    </tr>
  <% end %>
<% end %>
</table>

<%= render partial: 'form', locals: { save_reply: @save_reply } %>
