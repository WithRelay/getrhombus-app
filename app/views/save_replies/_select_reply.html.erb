<% @replies = saved_replies_list.to_json %> 
<div id="page-wrapper" > 
  <h1>Select Saved Reply</h1>
  <hr>
  <p>Saved replies help your team speed up response time to frequently asked questions. Select your saved replies from the drop-down, then personalize and hit send.</p>  
  <hr>
  <% @options = saved_replies_list.keys %>
  <%= bootstrap_form_tag do |f|%>
    <%= f.select  :title, options_for_select(@options), class: "title_select", prompt: "Select saved reply" %>
    <br>
    <%= f.text_area :body, id: 'trumbowyg', class: 'select_body', placeholder: 'View saved reply', param: @replies %>
    <br>
    <%= f.button "Cancel", type: :reset %>
    <%= f.submit 'Send Reply', class: 'reply_submit' %>
  <% end %>

</div>

<script type = "text/javascript">

  $('#_title').click(function() {
    var title = $(this).val();
    var replies = JSON.parse($('.select_body').attr('param'));
    var body = replies[title];
    $('.select_body').val(body);
  });

  $(document).on('click', '.reply_submit', function() { 
    evt.preventDefault();
    var reply = $( '.select_body' ).val();
    debugger
    // append body to fb_message textarea
    return false;
  });
</script>