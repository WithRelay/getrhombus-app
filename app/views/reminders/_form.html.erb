      <!-- Modal Body -->
        <%= form_for reminder, url: v1_create_reminder_path do |f| %>
        <div class="modal-body">

          <div class="col-xs-5">
            <%= f.label :Channel %>
            <%= f.select :channel, channel_list(reminder), selected: get_channel_enum_value(reminder) %>
          </div>

          <div class="col-xs-5">
            <%= f.label :text %>
            <%= f.text_area :text %>
          </div>

          <div class="col-xs-5">
            <%= f.text_field :date_time, class: 'daterange', value: present(reminder).to_user_date_time %>
          </div>

          <%= f.label :One_Time %>
          <%= f.radio_button :frequency_type, 0, id: 'oneTimeFrequency', checked: is_one_time_checked?(reminder) %>

          <%= f.label :Recurring %>
          <%= f.radio_button :frequency_type, 1, id: 'recurringFrequency',  checked: is_recurring_checked?(reminder) %>

          <%= f.select :repeat_days, repeat_days_options, {}, { selected: reminder.repeat_days, id: 'campaign_repeat_days' } %>
          <!-- Modal Footer -->
            <div class="modal-footer">
              <%= button_tag 'Cancel', class: 'btn btn-default', data: { dismiss: :modal } %>
              <%= f.submit 'Schedule Notification' %>
            </div>
        </div>
      <% end %>
