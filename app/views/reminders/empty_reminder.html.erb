<div class="dashboard-body">
<div class="blank-page-container w-container">
  <%= image_tag('020_200.png', class: 'blank-page-icon') %>
  <h1 class="empty-state-dash hero-h1 home-header">You have no scheduled customer<br>reminders</h1>
  <div class='modal-background w-hidden modal-body'>
    <%= render partial: 'shared/modals/new_reminder', locals: { reminder: Reminder.new }  %>
  </div>
  <%= button_tag 'Set new reminder', class: 'button error-page-button w-button modal-loader', 'data-ix' => "schedule-notification" %>
</div>
</div>
