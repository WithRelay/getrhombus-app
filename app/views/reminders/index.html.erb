<%= render 'shared/flash_messages' %>
<table>
  <thead>
    <tr>
     <th>Id</th>
     <th>From</th>
     <th>Created</th>
     <th>Channel</th>
     <th>Recipients</th>
     <th>Action</th>
     <th>Edit</th>
    </tr>
  </thead>
  <tbody>
    <% @reminders.each do |reminder| %>
      <tr>
        <td>
          <%= reminder.id %>
        </td>
        <td>
          <%= reminder.from_user %>
        </td>
        <td>
          <%= present(reminder).format_created_at %>
        </td>
        <td>
          <%= "#{reminder.channel} (#{present(reminder).format_frequency_type}) " %>
        </td>
        <td>
          No
        </td>
        <td>
          <%= present(reminder).reminder_change_status_link %>
        </td>
        <td>
          <%= link_to 'Edit', edit_user_reminder_path(current_user, reminder) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
