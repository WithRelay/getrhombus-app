<div class="settings sub-nav-bar w-clearfix">
  <%= link_to user_path(current_user) , class: 'dashboard-return sub-nav-button w-button' do %>
   &nbsp;Return to dashboard
  <% end %>
</div>

<div class="dashboard-body settings">
  <div class="dash-content-container manage-plans settings">
    <h4 class="form-header">Manage Segments</h4>
    <div class="flex-underline form-header-underline"></div>
    <div class="manage-segments-row w-row">
      <div class="w-col w-col-4">
        <div class="editable-row-header header settings-row-text">Segment name</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Type</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Customers in segment</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Date created</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Actions</div>
      </div>
    </div>
    <% @segments.each do |segment| %>
      <div class="manage-segments-row w-row">
        <div class="w-clearfix w-col w-col-4" id='segment-name-edit-show'>
          <div class="editable-field-text settings-row-text shrink-text" id="segment-<%= segment.id %>"><%= segment.name %></div>
          <div class='w-hidden editable-field-icon'>
            <input class="editable open text-field w-input segment-name" name="segment-name" type="text" value="<%= segment.name %>" data-segment-id="<%= segment.id %>">
            <a class="cancel-edit save-editable-field" href="#"><strong></strong></a>
          </div>
          <a class="edit-field save-editable-field" href="#"></a>
        </div>
        <div class="w-col w-col-2">
          <div class="settings-row-text"><%= segment_created_as(segment) %></div>
        </div>
        <div class="w-col w-col-2">
          <div class="settings-row-text"><%= number_of_users(segment).count %></div>
        </div>
        <div class="w-col w-col-2">
          <div class="settings-row-text"><%= segment.created_at.strftime('%Y/%m/%d') %></div>
        </div>
        <div class="w-col w-col-2">
          <% unless segment.origin? %>
            <%= link_to '', delete_segment_user_path(current_user, list_id: segment.id), class: 'w-hidden delete-hidden-segment-link', method: :delete %>
            <%= link_to 'Delete', '#', class: 'button settings-table-row w-button delete-segment-link', style: 'pointer-events: none;' %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
