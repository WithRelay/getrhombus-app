<%= render 'sub_nav_bar' %>

<div class="dashboard-body">
  <div id="objlists" data-object-type='list'>
    <%= render @lists %>
  </div>
  <div id="with-button" class="hide">
    <%= will_paginate %>
  </div>

  <% if @lists.next_page %>
    <div id="load_more_lists" class="show_more load-more-wrapper" data-loading-text="Loding more lists" style="margin-top: 5%;" >
      <a class="load-more-rows-button w-button" href="#">&nbsp;&nbsp;&nbsp;Load more</a>
    </div>
  <% end %>
</div>
