<div class="settings sub-nav-bar w-clearfix">
  <%= link_to user_path(current_user) , class: 'dashboard-return sub-nav-button w-button' do %>
   &nbsp;Return to dashboard
  <% end %>
</div>

<div class="dashboard-body settings">
  <div class="dash-content-container manage-plans settings">
    <h4 class="form-header">Manage Segments</h4>
    <div class="flex-underline form-header-underline"></div>
    <div class="manage-segments-row w-row">
      <div class="w-col w-col-4">
        <div class="editable-row-header header settings-row-text">Segment name</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Type</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Customers in segment</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Date created</div>
      </div>
      <div class="w-col w-col-2">
        <div class="header settings-row-text">Actions</div>
      </div>
    </div>
    <div id="objlists">
      <%= render segments %>
    </div>
    <div id="with-button" class="hide">
      <%= will_paginate %>
    </div>

    <% if segments.next_page %>
      <div id="load_more_segments" class="show_more button w-button" data-loading-text="Loding more segments" title="Click here to load more segments">Show More</div>
    <% end %>
  </div>
</div>
