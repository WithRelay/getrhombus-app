<p id="notice"><%= notice %></p>
<div id="list_info">
<strong>List name:</strong> <%= @list.name %></br>
<strong>List owner:</strong> <%= User.find(@list.user_id).first_name  %> </br>
<strong>List created at:</strong> <%= @list.created_at %> </br>

</div>


<div id= "customers"> 
	<strong> Customers in list </strong>
<table style="width:50%">
<tr>
	<th>First name</th>
	<th>Last name</th>
	<th>Email </th>
	<th>Action </th>
</tr>

<% @users.each do |c| %>
<tr>
	<td><%= c[:user].first_name %> </td>
	<td><%= c[:user].last_name %> </td>
	<td><%= c[:user].email %> </td>
	<% customer_list = UserList.where(list_id:@list.id,user_id:c[:user].id) %>
	<td><%= link_to 'Remove user from list', controller:'user_lists', action: 'remove_user', user_id: c[:user].id, list_id:@list.id %>
	</td>
</tr>

<% end %>

</table>

<%= link_to 'Edit List', edit_list_path(@list) %>
<%= link_to 'Back', lists_path %> </br>
</div>

<style>
table, th, td {
    border: 1px solid black;
    border-collapse: collapse;
}
th, td {
    padding: 5px;
    text-align: left;
}
</style>