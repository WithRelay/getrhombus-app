<% list_members.each do |member| %>
  <div class="customer-dashboard-table-wrapper list-members row-wrapper">
    <div>
      <div class="new-table-row w-row">
        <div class="cn w-clearfix w-col w-col-3">
          <div class="name w-clearfix">
            <%= present(member[:user]).profile_image %>
            <div class="shrink-text table-text", style="margin-top: 3px;">
              <%= link_to present(member[:user]).format_customer_name, "/users/#{current_user.id}/customers/#{member[:user].id}" %>
            </div>
          </div>
          <div class="cb check-box-column">
            <div class="w-form">
              <form data-name="Email Form 2" id="email-form-2" name="email-form-2">
                <div class="select-all-check-box w-checkbox w-clearfix">
                  <input class="cb table-checkbox w-checkbox-input" id="node" type="checkbox">
                  <label class="checkbox-field-lable w-form-label" for="node">-</label>
                </div>
              </form>
            </div>
          </div>
        </div>
        <div class="fv w-clearfix w-col w-col-2">
          <div class="cn column column-2 w-clearfix">
            <div class="shrink-text table-text"><%= present(member[:user]).customer_first_visit_formatted %></div>
          </div>
        </div>
        <div class="lv w-clearfix w-col w-col-2">
          <div class="colum-3 column lv w-clearfix">
            <div class="shrink-text table-text"><%= present(member[:user]).customer_last_visit_formatted %></div>
          </div>
        </div>
        <div class="avs w-clearfix w-col w-col-1">
          <div class="avs column column-4 w-clearfix">
            <div class="table-text"><%= present(member[:user]).average_transaction %></div>
          </div>
        </div>
        <div class="ts w-clearfix w-col w-col-1">
          <div class="column column-5 ts w-clearfix">
            <div class="shrink-text table-text total-spend-text"><%= present(member[:user]).total_transaction %></div>
          </div>
        </div>
        <div class="table-actions w-clearfix w-col w-col-3">
          <div class="column column-6 left new-row w-clearfix">
            <div class="frequency shrink-text table-text">Washington</div>
          </div>
          <div class="column column-6 new-row">
            <%= link_to 'Remove', remove_customer_list_path(current_user, @list), id: "list-member-delete-#{member[:user].id}", class: 'w-hidden', method: :delete %>
            <%= link_to 'Remove', '#', class: "actions-button notification list-member-delete", data: { user_id: member[:user].id } %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
