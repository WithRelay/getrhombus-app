<div class="row-wrapper">
  <div class="alt-table-row w-row">
    <div class="alt-column w-clearfix w-col w-col-3">
      <div class="title-column-div w-clearfix">
        <div class="shrink-text table-text"><%= link_to list.name, user_list_path(current_user, list), class: "non-underline-link" %></div>
        <%= link_to '', user_list_path(current_user, list), id: "list-delete-#{list.id}", class: 'w-hidden', method: :delete %>
      </div>
      <div class="cb check-box-column">
        <div>
          <form id="email-form-2" name="email-form-2">
            <div class="select-all-check-box w-checkbox w-clearfix">
              <input class="cb table-checkbox w-checkbox-input obj-checkbox-selector" id="node" type="checkbox" data-obj-id="<%= list.id %>" data-list-name="<%= list.name %>">
              <label class="checkbox-field-lable w-form-label" for="node">-</label>
            </div>
          </form>
        </div>
      </div>
    </div>
    <div class="alt-column w-col w-col-2">
      <div class="alt-table-column-div w-clearfix">
        <div class="table-text"> &nbsp; &nbsp; &nbsp;<%= list.user_lists.size %></div>
      </div>
    </div>
    <div class="alt-column w-col w-col-2">
      <div class="alt-table-column-div w-clearfix">
        <div class="table-text"><%= time_in_relative_form(list.created_at, 'long_format') %></div>
      </div>
    </div>
    <div class="alt-column w-col w-col-2">
      <div class="alt-table-column-div w-clearfix">
        <div class="table-text"><%= list.list_type.try(:capitalize).try(:pluralize) %></div>
      </div>
    </div>
    <div class="alt-column w-col w-col-1">
      <div class="alt-table-column-div w-clearfix">
        <div class="table-text"> &nbsp; &nbsp;<%= list.campaign_lists.size %></div>
      </div>
    </div>
    <div class="alt-column w-col w-col-2">
      <div class="alt-table-column-div w-clearfix">
        <div class="table-text"><%= list_last_sent(list) %></div>
      </div>
    </div>
  </div>
</div>
