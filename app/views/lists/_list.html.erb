<div class="row-wrapper">
  <div class="alt-table-row w-row">
    <div class="alt-column w-clearfix w-col w-col-3">
      <div class="title-column-div w-clearfix">
        <div class="table-text"><%= link_to list.name, list_path(current_user, list) %></div>
      </div>
      <div class="cb check-box-column">
        <div class="w-form">
          <form id="email-form-2" name="email-form-2">
            <div class="select-all-check-box w-checkbox w-clearfix">
              <input class="cb table-checkbox w-checkbox-input merchant_customers" id="node" type="checkbox" data-users="<%= list.id %>" data-list-name="<%= list.name %>">
              <label class="checkbox-field-lable w-form-label" for="node">-</label>
            </div>
          </form>
        </div>
      </div>
    </div>
    <div class="alt-column w-col w-col-2">
      <div class="alt-table-column-div w-clearfix">
        <div class="table-text"> &nbsp; &nbsp; &nbsp;<%= list.user_lists.count %></div>
      </div>
    </div>
    <div class="alt-column w-col w-col-2">
      <div class="alt-table-column-div w-clearfix">
        <div class="table-text"><%= time_ago_in_words(list.created_at) %></div>
      </div>
    </div>
    <div class="alt-column w-col w-col-2">
      <div class="alt-table-column-div w-clearfix">
        <div class="table-text">---</div>
      </div>
    </div>
    <div class="alt-column w-col w-col-2">
      <div class="alt-table-column-div w-clearfix">
        <div class="table-text">---</div>
      </div>
    </div>
    <div class="alt-column w-col w-col-1">
      <div class="alt-table-column-div w-clearfix">
        <div class="table-text"> &nbsp; &nbsp;<%= list.campaign_lists.count %></div>
      </div>
    </div>
  </div>
</div>
