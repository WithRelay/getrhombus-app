<p id="notice"><%= notice %></p>

<h1>Listing Bank Accounts</h1>

<table>
  <thead>
    <tr>
      <th>Stripe bank account</th>
      <th>Country</th>
      <th>Bank name</th>
      <th>Routing number</th>
      <th>Last4</th>
      <th>Currency</th>
      <th>Status</th>
      <th>Default for currency</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @bank_accounts.each do |bank_account| %>
      <tr>
        <td><%= bank_account.stripe_bank_account_id %></td>
        <td><%= bank_account.country %></td>
        <td><%= bank_account.bank_name %></td>
        <td><%= bank_account.routing_number %></td>
        <td><%= bank_account.last4 %></td>
        <td><%= bank_account.currency %></td>
        <td><%= bank_account.status %></td>
        <td><%= bank_account.default_for_currency %></td>
        <td><%= link_to 'Show', bank_account %></td>
        <td><%= link_to 'Edit', edit_bank_account_path(bank_account) %></td>
        <td><%= link_to 'Destroy', bank_account, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Bank account', new_bank_account_path %>
