<!DOCTYPE html>
<html>
<head>
<meta http-equiv="content-type" content="text/html;charset=UTF-8" />
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
</head>
<body>
 <br>
              <a href="http://www.getrhombus.com"><strong>Rhombus</strong></a><br>
              
              <h2>receipt</h2>

                <h4>Payment to <%= @merchant_business_name %></h4>
 
                <p>Transaction # : <%= @transaction_number %><br>
                Transaction Date : <%= Time.now.strftime("%m/%d/%y") %></p><br>
            <table class="table">
              <thead>
                <tr>
                  <th style="text-align: left;">DESCRIPTION</th>
                  <th style="width:140px; text-align: left;">AMOUNT</th>
                  <th style="width:90px; text-align: left;">TOTAL</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><%= @message %></td>
                  <td class="text-right"><%= number_to_currency(@amount) %></td>
                  <td class="text-right"><%= number_to_currency(@amount_with_taxes) %></td>
                </tr>
              </tbody>
            </table>

            <br>

            <p>If you have questions about your payment please contact <%= @merchant_business_name %> at <%= @merchant_phone_number %> or email <%= @merchant_email %>. Please include your email address and transaction number in any communication to help them serve you more quickly.
            </p>

            <br>
    
            <p>Yours, <br>
              The Rhombus Team
            </p>
            <br>


</body>
</html>