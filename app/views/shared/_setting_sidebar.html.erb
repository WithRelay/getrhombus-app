<div class="side-bar w-clearfix overflow_hidden">
  <div class="dashboard-logo-wrapper">
    <%= link_to user_path(current_user) do %>
      <%= image_tag 'Relay-Transparent-500x300.png', class: 'dashboard-logo', width: '50' %>
    <% end %>
  </div>
  <h5 class="left-nav signup-box-subheading shrink-text"><%= sidebar_name "#{params[:controller]}-#{params[:action]}" %></h5>

  <% if current_user.is_merchant? %>

    <%= link_to user_account_settings_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab" data-ix="display-and-hide-customers">Account</div>
    <% end %>

    <%= link_to user_business_settings_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Business</div>
    <% end %>

    <%= link_to user_notifications_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Notifications</div>
    <% end %>

    <%= link_to user_plans_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Manage plans</div>
    <% end %>

    <%= link_to user_segments_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Manage segments</div>
    <% end %>

    <%= link_to user_integrations_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Integrations</div>
    <% end %>

    <%= link_to user_billing_information_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Billing Information</div>
    <% end %>

    <%= link_to user_managed_accounts_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Bank account</div>
    <% end %>

    <%= link_to user_sms_usage_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">SMS usage</div>
    <% end %>

    <%= link_to user_refer_business_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Refer Business</div>
    <% end %>

    <%= link_to user_away_message_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Away messages</div>
    <% end %>

    <% if current_user.is_platform? %>
      <%= link_to user_manage_coupons_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
        <div class="left-nav-tab">Manage Coupons</div>
      <% end %>
    <% end %>

    <h5 class="left-nav rhom-number signup-box-subheading">RELAY NUMBER</h5>
    <div class="left-nav-underline"></div>
    <a class="left-nav-tab-wrapper w-inline-block" href="#">
      <div class="left-nav-tab"><%= current_user.friendly_relay_number %></div>
    </a>

  <% elsif current_user.is_customer? %>

    <%= link_to user_account_settings_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab" data-ix="display-and-hide-customers">Account</div>
    <% end %>

    <%= link_to user_billing_information_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Billing Information</div>
    <% end %>

    <%= link_to user_refer_business_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Refer a Business</div>
    <% end %>

  <% end %>

  <h5 class="left-nav rhom-number signup-box-subheading">OTHER</h5>
  <div class="left-nav-underline"></div>
  <a class="left-nav-tab-wrapper w-inline-block" href="/relay-docs">
    <div class="left-nav-tab">Help</div>
  </a>
</div>
