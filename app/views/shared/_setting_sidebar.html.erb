<div class="side-bar w-clearfix" style="overflow:hidden">
  <div class="dashboard-logo-wrapper">
    <%= link_to user_path(current_user) do %>
      <%= image_tag 'Relay-Transparent-500x300.png', class: 'dashboard-logo', width: '50' %>
    <% end %>
  </div>
  <h5 class="left-nav signup-box-subheading"><%= sidebar_name "#{params[:controller]}-#{params[:action]}" %></h5>

  <% if current_user.is_customer? %>

    <%= link_to account_settings_user_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab" data-ix="display-and-hide-customers">Account</div>
    <% end %>

    <%= link_to billing_information_user_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Billing Information</div>
    <% end %>

  <% end %>

  <% if current_user.is_merchant? || current_user.is_platform? %>

    <%= link_to account_settings_user_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab" data-ix="display-and-hide-customers">Account</div>
    <% end %>

    <%= link_to business_settings_user_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Business</div>
    <% end %>

    <%= link_to notifications_user_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Notifications</div>
    <% end %>

    <%= link_to user_plans_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Manage plans</div>
    <% end %>

    <%= link_to segments_user_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Manage segments</div>
    <% end %>

    <%= link_to integrations_user_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Integrations</div>
    <% end %>

    <%= link_to billing_information_user_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Billing Information</div>
    <% end %>

    <%= link_to managed_accounts_user_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Bank account</div>
    <% end %>

    <%= link_to sms_usage_user_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">SMS usage</div>
    <% end %>

    <%= link_to refer_business_user_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Free subscriptions</div>
    <% end %>

    <%= link_to user_away_message_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">Away messages</div>
    <% end %>
  <% end %>

  <h5 class="left-nav rhom-number signup-box-subheading">RHOMBUS NUMBER</h5>
  <div class="left-nav-underline"></div>
  <a class="left-nav-tab-wrapper w-inline-block" href="#">
    <div class="left-nav-tab">+ <redacted_phone_number></div>
  </a>
  <h5 class="left-nav rhom-number signup-box-subheading">OTHER</h5>
  <div class="left-nav-underline"></div>
  <a class="left-nav-tab-wrapper w-inline-block" href="#">
    <div class="left-nav-tab">Help</div>
  </a>
</div>

