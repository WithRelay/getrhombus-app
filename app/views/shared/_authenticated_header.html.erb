<%= render 'shared/loading' %>

<div class="dashboard-nav w-clearfix">
  <div class="dashboard-nav-links-wrapper">
    <a class="w-clearfix w-inline-block" href="#">
      <% unless params[:controller] == 'users' %>
        <%= link_to user_path(current_user), class: 'dash-header-links' do %>
          <strong>Dashboard</strong>
        <% end %>
      <% end %>
      <%= render "shared/rhombus_number" %>
    </a>
  </div>
  <div class="dashboard-nav-links-wrapper new-tab right-nav settings-dropdown">
    <div class="dropdown-wrapper w-dropdown" data-delay="0">
      <%= render 'shared/settings_dropdown' %>
    </div>
  </div>
</div>
