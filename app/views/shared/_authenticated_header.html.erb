<div class="blank-page-content-wrapper loading w-hidden" >
  <div class="blank-page-container w-container">
    <%= image_tag('Relay-Transparent-500x300.png', class: 'blank-page-icon', width: 145) %>
    <h5 class="blank-page footer-cta-subheading signup-box-subheading">loading...</h5>
  </div>
</div>
<div class="dashboard-nav w-clearfix">
  <div class="dashboard-nav-links-wrapper">
    <a class="w-clearfix w-inline-block" href="#">
      <%= link_to user_path(current_user), class: 'dash-header-links' do %>
         &nbsp;<strong>Dashboard</strong>
      <% end %>
      <%= link_to customers_user_path(current_user), class: 'dash-header-links new-link' do %>
         &nbsp;<strong>All &nbsp;customers</strong>
      <% end %>
      <%= link_to customers_user_path(current_user), class: 'dash-header-links new-link' do %>
         &nbsp;<strong>New &nbsp;customers</strong>
      <% end %>
      <%= render "shared/rhombus_number" %>
    </a>
  </div>
  <div class="dashboard-nav-links-wrapper new-tab right-nav settings-dropdown">
    <div class="dropdown-wrapper w-dropdown" data-delay="0">
      <%= render 'shared/settings_dropdown' %>
    </div>
  </div>
</div>
