          <% end %>
        </div>
        <div class="dash-header-links new-link">
          <%= link_to customers_user_path(current_user), class: 'header-links-fix' do %>
             &nbsp;<strong>New &nbsp;customers</strong>
          <% end %>
        </div>
      <%= render "shared/rhombus_number" %>
