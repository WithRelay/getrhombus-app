<!-- Relay Pricing Packages/Plan -->
<div class="container">
  <h2>Select Subscription Plan</h2>
  <!-- we can pass user's subscribed plan amount in amountValue attribute -->
  <div id="pricing-range" style="height: 300px;" amountValue="120">
