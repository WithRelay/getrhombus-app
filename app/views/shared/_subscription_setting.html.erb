<%= form_for('subscription', :html=> { id: 'plan-update-form', class: 'form-horizontal' }) do |f| %>
  <!-- Relay Pricing Packages/Plan -->
  <div class="container">
    <h2 style="padding-left: 5%;">Select Subscription Plan</h2>
    <br>
    <div class="row" >
      <!-- we can pass user's subscribed plan amount in amountValue attribute -->
      <div class="col-xs-1"  style="height: 200px;padding-left: 5%;margin-top: 25px;">
      <!-- we have to set amountValue dynamically for selected subscription -->
        <!-- <input type="text" name="plan[amount]" id="pricing-range" amountValue="120"> -->
        <%= f.text_field :plan_name, id: 'pricing-range', amountValue: "120" %>
      </div>
      <br>
      <div class="col-xs-5">
        <span id="price-value"></span>
      </div>
    </div>
    <div class="row" style="padding-left: 15%;margin-top:-35px;">
      <!-- <a class="button pricing-button customer-text-me" href="users/<%= current_user.id%>/subscriptions" id="change_subscription_plan" >SUBSCRIPTION</a> -->
      <br>
      <%= f.submit 'Subscription', class: 'button pricing-button customer-text-me', id: 'change_subscription_plan', data: {disable_with: 'Please wait ...'} %>
    </div>
  </div>
<% end %>
