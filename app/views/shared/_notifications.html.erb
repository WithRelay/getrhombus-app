<div class="dashboard-nav-links-wrapper new-tab right-nav settings-dropdown">
  <div class="dropdown-wrapper w-dropdown" data-delay="0">
    <div class="notifications-navbar-dropdown w-dropdown-toggle">
      <div class="dropdown-wrapper-text"><strong> &nbsp;&nbsp;<span class="notification-counter"><%= total_transaction %></span></strong>
      </div>
    </div>
    <nav class="dropdown-content-wrapper notifications-dropdown-wrapper w-dropdown-list">
      <a class="dropdown-link header notifications-dropdown-header w-clearfix w-dropdown-link" href="#">Today <span class="unread-notification-count">Unread (<%= @todays_transaction.count %>)</span></a>
      <% @todays_transaction.each do |tr| %>

      <a class="dashboard-header-notification-wrapper w-inline-block" href="#">
          <div class="w-row">
            <div class="w-col w-col-2">
              <img class="notifier-picture" height="30" src="images/49-1.jpg" width="30">
            </div>
            <div class="w-col w-col-8">
              <div class="notification-text-block notifier"><strong class="notifier-name">James Gordon</strong> sent your a <strong class="notifier-action">message</strong> via messenger</div>
            </div>
            <div class="w-col w-col-2">
              <div class="notification-text-block notifier"><strong class="notifier-time">5m</strong>
              </div>
            </div>
          </div>

      </a>
      <% end %>
      <a class="dropdown-link header notifications-dropdown-header older w-clearfix w-dropdown-link" href="#">Yesterday <span class="unread-notification-count">Unread (<%= @yesterday_transactions.count %>)</span></a>
      <% @yesterday_transactions.each do |tr| %>

      <a class="dashboard-header-notification-wrapper w-inline-block" href="#">
          <div class="w-row">
            <div class="w-col w-col-2">
              <img class="notifier-picture" height="30" src="images/81.jpg" width="30">
            </div>
            <div class="w-col w-col-8">
              <div class="notification-text-block notifier"><strong class="notifier-name">Brendan Fraser</strong>&nbsp;sent your a <strong class="notifier-action">Payment</strong> via SMS</div>
            </div>
            <div class="w-col w-col-2">
              <div class="notification-text-block notifier"><strong class="notifier-time">1d</strong>
              </div>
            </div>
          </div>

      </a>
      <% end %>
      <a class="dropdown-link header notifications-dropdown-header w-clearfix w-dropdown-link" href="#">Earlier <span class="unread-notification-count">Unread (<%= @earlier_transactions.count %>)</span></a>
      <% @earlier_transactions.each do |tr| %>
        <a class="dashboard-header-notification-wrapper w-inline-block" href="#">
          <div class="w-row">
            <div class="w-col w-col-2"><img class="notifier-picture" height="30" src="images/49-2.jpg" width="30">
            </div>
            <div class="w-col w-col-8">
              <div class="notification-text-block notifier"><strong class="notifier-name">Jacqueline&nbsp;Krantz</strong>&nbsp;sent your a <strong class="notifier-action">message</strong> via SMS</div>
            </div>
            <div class="w-col w-col-2">
              <div class="notification-text-block notifier"><strong class="notifier-time">1w</strong>
              </div>
            </div>
          </div>
        </a>
      <% end %>
    </nav>
  </div>
</div>
