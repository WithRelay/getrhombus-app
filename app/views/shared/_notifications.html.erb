<div class="dashboard-nav-links-wrapper new-tab right-nav settings-dropdown">
  <div class="dropdown-wrapper w-dropdown" data-delay="0">
    <div class="notifications-navbar-dropdown w-dropdown-toggle">
      <div class="dropdown-wrapper-text"><strong> &nbsp;&nbsp;<span class="notification-counter"><%= total_alerts %></span></strong>
      </div>
    </div>
    <nav class="dropdown-content-wrapper notifications-dropdown-wrapper w-dropdown-list"><a class="dropdown-link header notifications-dropdown-header w-clearfix w-dropdown-link" href="#">Messages<span class="unread-notification-count">Unread (<%= @todays_unread_convs_count %>)</span></a>
      <% @todays_last_msgs_from_last5_convs.each do |m| %>
        <a class="dashboard-header-notification-wrapper w-inline-block" href="#">
          <div class="w-row">
            <div class="w-col w-col-2">
              <%= present(m).profile_image %>
            </div>
            <div class="w-col w-col-8">
              <div class="notification-text-block notifier"><strong class="notifier-name"><%= present(m).get_full_name %></strong> sent you a <strong class="notifier-action">message</strong> via <%= m.channel %></div>
            </div>
            <div class="w-col w-col-2">
              <div class="notification-text-block notifier"><strong class="notifier-time"><%= time_in_relative_form(m.created_at, 'short_format') %></strong>
              </div>
            </div>
          </div>
        </a>
      <% end %>
      <a class="dropdown-link header notifications-dropdown-header older w-clearfix w-dropdown-link" href="#">Transactions<span class="unread-notification-count">New (<%= @todays_txns_count %>)</span></a>
      <% @todays_last5_txns.each do |transaction| %>
        <a class="dashboard-header-notification-wrapper w-inline-block" href="#">
          <div class="w-row">
            <div class="w-col w-col-2">
              <%= present(transaction).profile_image %>
            </div>
            <div class="w-col w-col-8">
              <div class="notification-text-block notifier"><strong class="notifier-name"><%= transaction.user.full_name %></strong>&nbsp;sent you a <strong class="notifier-action">
                Payment</strong>&nbsp;of $<%= transaction.amount %></div>
            </div>
            <div class="w-col w-col-2">
              <div class="notification-text-block notifier"><strong class="notifier-time"><%= time_in_relative_form(transaction.created_at, 'short_format') %></strong>
              </div>
            </div>
          </div>
        </a>
        <% end %>
    </nav>
  </div>
</div>
