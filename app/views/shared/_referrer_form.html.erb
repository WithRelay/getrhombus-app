<div id= 'refer-a-business'>
  <%= form_for('referrer', :html => { :class => "w-clearfix", :id => "referrerForm" } ) do |f| %>

    <label class="form-label paragraph" for="Referrer-Email">Refer your favorite local businesses to Rhombus, and earn up to <strong>$25 per month</strong>&nbsp;for <strong>12 months</strong>, after they subscribe. The businesses your refer also receive a 50% discount on their subscription because you sent them our way. There are no limits to how many businesses you can refer</label>
    
    <label class="field-headers form-label settings" for="name">referrer details</label>
    <div class="form-group col-xs-6">
      <%= f.text_field 'referrer_name', placeholder: 'Your full name', class: 'form-control full-name settings text-field w-input', value: current_user.present? ? user_full_name : '' %>
    </div>

    <div class="form-group col-xs-6">
      <%= f.text_field 'referrer_email', placeholder: 'Your email address', class: 'form-control settings text-field w-input', value: current_user.present? ? current_user.email : '' %>
    </div>
    <div class="flex-underline form-section-divider"></div>

    <label class="field-headers form-label settings" for="Referee-Business-Name">i'm referring</label>

    <div class="form-group col-xs-6">
      <%= f.text_field 'org_name', placeholder: 'Name of the business you\'re referring', class: 'form-control full-name settings text-field w-input'%>
    </div>

    <div class="form-group col-xs-6">
      <%= f.text_field 'referee_email', placeholder: 'Contact person\'s email address', class: 'form-control settings text-field w-input' %>
    </div>

    <div class="form-group col-xs-6">
      <%= f.phone_field 'phone', placeholder: 'Phone Number (optional)', class: 'form-control settings text-field w-input', id: 'phone' %>
      <%= f.hidden_field :phone_number, :id => "phone_number" %>
    </div>

    <div class="form-group col-xs-6">
      <%= f.select :country, country_list, { prompt: 'Select your country' }, { class: 'form-control country_dropdown w-select', id:'user-country' } %>
    </div>

    <%= f.button "Invite business", id: 'referrer-submit', class: "button save-changes w-button" %>

  <% end %>
</div>
