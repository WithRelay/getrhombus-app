<footer class="footer">
  <div class="content-wrapper footer w-container">
    <div class="w-row">
      <div class="w-col w-col-2">
        <div class="footer-heading">product</div>
        <%= link_to 'Pricing', request_demo_url, class: 'footer-links links' %>
        <%= link_to 'Use Cases', request_demo_url, class: 'footer-links links' %>
        <%= link_to 'Request Demo', request_demo_url, class: 'footer-links links' %>
        <%= link_to 'Sign-up', request_demo_url, class: 'footer-links links' %>
        <%= link_to 'Dashboard', request_demo_url, class: 'footer-links links' %>
      </div>
      <div class="w-col w-col-2">
        <div class="footer-heading">features</div>
          <a class="footer-links links" href="#">SMS | MMS</a>
          <a class="footer-links links" href="#">Messenger</a>
          <a class="footer-links links" href="#">Payment Request</a>
          <a class="footer-links links" href="#">Charge</a>
          <a class="footer-links links" href="#">Pre-authorize</a>
          <a class="footer-links links" href="#">Hashtags</a>
      </div>
      <div class="w-col w-col-2">
        <div class="footer-heading">HELP &amp; SUPPORT</div>
        <a class="footer-links links" href="#">Help Center</a>
        <a class="footer-links links" href="#">Resources</a>
        <%= link_to 'Contact Us', contact_path, class: 'footer-links links' %>
      </div>
      <div class="w-col w-col-3">
        <div class="footer-heading">COMPANY</div>
        <%= link_to 'About Relay', about_url, class: 'footer-links links' %>
        <%= link_to 'Blog', '#', class: 'footer-links links' %>
        <%= link_to 'Jobs', '#', class: 'footer-links links' %>
        <%= link_to 'Privacy Policy', privacy_url , class: 'footer-links links' %>
        <%= link_to 'Terms of Use', terms_url, class: 'footer-links links' %>
      </div>
      <div class="blog-content-footer w-col w-col-3">
        <div class="blog-section footer-heading">RECENT POSTS</div>
        <div class="blog-date footer-heading">JULY 2016</div>
        <a class="blog-links footer-links links" href="#">The Future of Messaging Bots in the Enterprise</a>
        <a class="blog-links footer-links links" href="#">How to Provide Exceptional Customer Support</a>
        <div class="blog-date footer-heading">JUNE 2016</div>
        <a class="blog-links footer-links links" href="#">The Age&nbsp;Conversational Commerce</a>
        <a class="blog-links footer-links links" href="#">Why Instant&nbsp;Messaging is a Better Medium for Customer Interaction</a>
        <a class="blog-links footer-links links" href="#">Best Customer Communication Tools 2015</a>
      </div>
    </div>
    <%= image_tag('relay-4.png', class: 'footer-logo', width: 60) %>
    <div class="copyright">© 2016, Relay Software Inc. All Rights Reserved.</div>
  </div>
</div>



