<div class="default-content-section">
    <h1 class="first-content-section-sub-header footer-cta-header">Get started for free</h1>
    <h5 class="footer-cta-subheading signup-box-subheading">TRY IT FREE NO LONG-TERM <br>COMMITMENT</h5>
    <div class="footer-cta-forms w-form">
      <form class="w-clearfix" data-name="Email Form" id="email-form" name="email-form">
        <input class="footer-cta-field text-field w-input" data-name="Email" id="email" maxlength="256" name="email" placeholder="Email address" required="required" type="email">
        <input class="text-field w-input" data-name="Phone Number" id="Phone-Number" maxlength="256" name="Phone-Number" placeholder="Phone number" required="required" type="email">
        <div class="footer-cta form-check-box w-checkbox">
          <input class="w-checkbox-input" data-name="Checkbox" id="checkbox" name="checkbox" type="checkbox">
          <label class="w-form-label" for="checkbox">I agree to Relay <a class="terms-link" href="#">terms of use &amp; policy</a>
          </label>
        </div><a class="alt-hero-cta-button footer-cta-button home w-button" href="#">Create relay account</a>
      </form>
      <div class="w-form-done">
        <div>Thank you! Your submission has been received!</div>
      </div>
      <div class="w-form-fail">
        <div>Oops! Something went wrong while submitting the form</div>
      </div>
    </div>
  </div>
