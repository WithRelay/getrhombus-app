<% if flash[:notice].present? %>
  <script type="text/javascript">
    $(window).load(function(){
      flashSuccess( "<%= flash[:notice] %>")
    })
  </script>

<% elsif flash[:error].present? %>
  <script type="text/javascript">
    $(window).load(function(){
      flashSuccess( "<%= flash[:notice] %>")
    })
  </script>

<% elsif flash[:alert].present?  %>
  <script type="text/javascript">
    var notice = new PNotify({
      title: 'Alert!!',
      text: "<%= flash[:alert] %>",
      buttons: {
          closer: false,
          sticker: false
      }
    });
    notice.get().click(function() {
        notice.remove();
    });
  </script>
<% end %>
