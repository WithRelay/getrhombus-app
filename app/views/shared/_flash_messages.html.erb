<% if flash[:notice].present? %>
  <script type="text/javascript">
    $(window).load(function(){ 
      new PNotify({
          title: 'Success!!',
          text: "<%= flash[:notice] %>",
          type: 'success',
          hide: true
      });
    })
  </script>
<% elsif flash[:error].present? %>
  <script type="text/javascript">
    $(window).load(function(){
      new PNotify({
          title: 'Error!!',
          text: "<%= flash[:error] %>",
          type: 'error',
          hide: true
      });
    })
  </script>
<% end %>

