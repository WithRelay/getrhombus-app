<% if flash[:notice].present? %>
  <script type="text/javascript">
    $(window).load(function(){ 
      new PNotify({
          title: 'Success!!',
          text: "<%= flash[:notice] %>",
          type: 'success',
          hide: true
      });
    })
  </script>

<% elsif flash[:error].present? %>
  <script type="text/javascript">
    $(window).load(function(){
      new PNotify({
          title: 'Error!!',
          text: "<%= flash[:error] %>",
          type: 'error',
          hide: true
      });
    })
  </script>

<% elsif flash[:alert].present?  %>
  <script type="text/javascript">
    var notice = new PNotify({
      title: 'Alert!!',
      text: <%= flash[:alert] %>,
      buttons: {
          closer: false,
          sticker: false
      }
    });
    notice.get().click(function() {
        notice.remove();
    });
  </script>
<% end %>
