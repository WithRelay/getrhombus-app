<% if flash.present? %>
  <script type="text/javascript">
    $(document).on('ready page:load', function() {
      <% flash_key = flash.keys[0] %>
      var flashTitle= '<%= flash_key %>'
      // to set arrayMessage as flash error array as verbatism
      // .to_json is sometime flash message can contain string
      var arrayMessage = <%== flash[flash_key].to_json %>
      // flashMethod is a method availabel in flashes.js
      FlashHandler.setFlashMessage( arrayMessage, flashTitle )
      <% flash.delete(flash_key) %>
    });
  </script>
<% end %>
