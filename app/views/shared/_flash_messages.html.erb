<% if flash[:notice].present? %>
  <script type="text/javascript">
    $(window).load(function(){ 
      new PNotify({
          title: 'Success!!',
          text: "<%= flash[:notice] %>",
          type: 'success',
          hide: true
      });
    })
  </script>

<% elsif flash[:error].present? %>
  <script type="text/javascript">
    $(window).load(function(){
      new PNotify({
          title: 'Error!!',
          text: "<%= flash[:error] %>",
          type: 'error',
          hide: true
      });
    })
  </script>

<% elsif flash[:alert].present? || alert.present? %>
  <% message = flash[:alert].present? flash[:alert] : alert %>
  <script type="text/javascript">
    var message = "<%= message %>";

    var notice = new PNotify({
      title: 'Alert!!',
      text: message,
      buttons: {
          closer: false,
          sticker: false
      }
    });
    notice.get().click(function() {
        notice.remove();
    });
  </script>
<% end %>
