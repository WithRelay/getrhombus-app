<div class="alt help-center hero" data-ix="show-fixed-navbar">
  <div class="help-center hero-content w-container">
    <div class="categories relay-docs-logo-wrapper w-row">
      <div class="w-col w-col-6">
        <%= image_tag('Relay-Transparent-White.png', class: 'relay-logo-docs', width: 67) %>
        <div class="docs-page-title">
         <%if controller.action_name == "terms" %>
            Terms of Use
          <%elsif controller.action_name == 'privacy' %>
