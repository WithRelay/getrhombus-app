<div class="alt help-center hero" data-ix="show-fixed-navbar">
  <div class="help-center hero-content w-container">
    <div class="categories relay-docs-logo-wrapper w-row">
      <div class="w-col w-col-6">
        <%= image_tag('Relay-Transparent-White.png', class: 'relay-logo-docs', width: 67) %>
        <div class="docs-page-title">Help Center</div>
      </div>
      <div class="relay-docs-logo-wrapper-column-2 w-col w-col-6"><a class="sign-in-link" href="#">Sign in</a>
      </div>
    </div>
  </div>
</div>

<div class="alt faq static-page-def-section">
  <div class="w-form">
    <form data-name="Email Form" id="email-form" name="email-form">
      <input class="alt relay-docs-search w-input" data-name="Docs Search 2" id="Docs-Search-2" maxlength="256" name="Docs-Search-2" placeholder="Search the help center" type="text">
    </form>
    <div class="w-form-done">
      <div>Thank you! Your submission has been received!</div>
    </div>
    <div class="w-form-fail">
      <div>Oops! Something went wrong while submitting the form</div>
    </div>
  </div>
</div>
