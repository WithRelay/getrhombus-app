


<div class="row">
<% flash.each do |name, msg| %>
  <% if msg.is_a?(String) %>
    <div class="alert alert-<%= name %>">
      <button type="button" class="close" data-dismiss="alert" aria-hidden="true">x</button>
      <%= content_tag :div, msg, :id => "flash_#{name}" unless msg.blank? %>
    </div>
  <% end %>
<% end %>
</div>
