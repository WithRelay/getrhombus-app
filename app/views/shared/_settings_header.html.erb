<%= render 'shared/loading' %>

<div class="dashboard-nav w-clearfix">
  <div class="dashboard-nav-links-wrapper">

    <% if current_user.is_merchant? %>
      <%= link_to user_merchant_customers_path(current_user) do %>
        <div class="dash-header-links new-link">
          <strong class="important-text-41">
            All customers
          </strong>
        </div>
      <% end %>
    
      <% list = List.where("lower(name) = ? and user_id = ?", "new customers", current_user.id).first %>
      <% if list %>
        <%= link_to user_segment_path(current_user, list) do %>
          <div class="dash-header-links new-link">
            <strong class="important-text-41">
              New customers
            </strong>
          </div>
        <% end %>
      <% end %>
    
    <% else %>

      <%= link_to user_organizations_path(current_user) do %>
        <div class="dash-header-links new-link">
          <strong class="important-text-41">
            All Organizations
          </strong>
        </div>
      <% end %>

    <% end %>
    
  </div>

  <div class="dashboard-nav-links-wrapper new-tab right-nav settings-dropdown">
    <div class="dropdown-wrapper w-dropdown" data-delay="0">
      <%= render 'shared/settings_dropdown' %>
    </div>
  </div>

</div>
