<div class="dashboard-nav-links-wrapper new-tab right-nav settings-dropdown">
    <div class="dropdown-wrapper w-dropdown" data-delay="0">
      <div class="w-dropdown-toggle">
        <div class="dropdown-wrapper-text"><strong class="settings-header-tab-text">Settings &nbsp;&nbsp;</strong>
        </div>
      </div>
      <nav class="dropdown-content-wrapper w-dropdown-list">
        <a class="dropdown-link header w-dropdown-link" href="#"><%= current_user.full_name %></a>
        <a class="content-link dropdown-link w-dropdown-link" href="#"><span class="business-name-settings-dropdown"><%= current_user.org_name %></span><br>
          <span class="account-owner-email-settings-dropdown"><%= current_user.email %></span></a>
        <%= link_to 'Settings', account_settings_user_path(current_user), class: 'dropdown-link w-dropdown-link' %>
        <%= link_to 'Billing Information', billing_information_user_path(current_user), class: 'dropdown-link w-dropdown-link' %>
        <%= link_to 'Sign out', destroy_user_session_path, class: 'dropdown-link sign-out w-dropdown-link', method: :delete %>
      </nav>
    </div>
  </div>
    <%= render 'shared/notifications' %>