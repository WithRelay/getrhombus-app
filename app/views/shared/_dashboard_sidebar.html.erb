<div class="side-bar">
    <div class="dashboard-nav-links">All Customers</div>
    <h5 class="left-nav signup-box-subheading">CAMPAIGNS</h5>
    <a class="left-nav-tab-wrapper w-inline-block" href="#">
      <div class="left-nav-tab">&nbsp; &nbsp; Customers &nbsp; &nbsp;</div>
    </a>
    <div class="customers-hidden-menu">
      <div class="w-form">
        <form id="email-form-7" name="email-form-7">
          <select class="dropdown segments w-select" id="field-5" name="field-5">
            <option value="">Segments</option>
            <option value="">New customers</option>
            <option value="">Active customers</option>
            <option value="">Inactive customers</option>
            <option value="">Signed up 3 days ago</option>
          </select>
        </form>
      </div>
    </div>
    <%= link_to lists_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab" data-ix="display-and-hide-customers">&nbsp; &nbsp; Lists</div>
    <% end %>
    <a class="left-nav-tab-wrapper w-inline-block" href="#">
      <div class="left-nav-tab messaging">&nbsp; &nbsp;Messaging &nbsp; &nbsp; </div>
    </a>
    <div class="messaging-hidden-menu" data-ix="display-none-on-load">
      <%= link_to 'Conversations', user_conversations_path(current_user), class: 'dashboard-dropdown-link' %>
      <%= link_to 'Saved Replirs', user_saved_replies_path(current_user), class: 'dashboard-dropdown-link' %>
      <%= link_to 'Customer Reminders', user_reminders_path(current_user), class: 'dashboard-dropdown-link' %>
    </div>
    <%= link_to user_campaigns_path(current_user), class: 'left-nav-tab-wrapper w-inline-block' do %>
      <div class="left-nav-tab">&nbsp; &nbsp;Campaigns</div>
    <% end %>
    <a class="left-nav-tab-wrapper w-inline-block" data-ix="display-and-hide-transaction-tab" href="#">
      <div class="left-nav-tab transactions" data-ix="display-and-hide-transaction-tab"> &nbsp;Transactions &nbsp;</div>
    </a>
    <div class="transactions-hidden-nav">
      <a class="dashboard-dropdown-link" href="#">Charges</a>
      <!-- <a class="dashboard-dropdown-link" href="#">Pre-authorized</a> -->
      <%= link_to "Pre-authorized", user_transactions_path(captured: false, user_id: current_user.id ),class:"dashboard-dropdown-link" %>
      <a class="dashboard-dropdown-link" href="#">Subscriptions</a>
    </div>
    <%= link_to user_hashtags_path(current_user)  , class: "left-nav-tab-wrapper w-inline-block" do %>
      <div class="left-nav-tab">&nbsp; &nbsp;Hashtags</div>
    <%end%>
    <a class="left-nav-tab-wrapper w-inline-block" href="#">
      <div class="left-nav-tab">&nbsp; &nbsp;Leads</div>
    </a>
  </div>
