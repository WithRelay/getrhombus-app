<%= render 'shared/loading' %>
<div class="customer-profile dashboard-nav w-clearfix">
  <% if params[:controller] == 'merchant_customers' && params[:action] == 'show' %>
    <div class="dashboard-logo-wrapper">
      <%= link_to user_path(current_user) do %>
        <%= image_tag('Relay-Transparent.png', width: 50, class: 'dashboard-logo') %>
      <% end %>
    </div>
  <% end %>
  <div class="dashboard-nav w-clearfix">
    <div class="dashboard-nav-links-wrapper">
      <a class="w-clearfix w-inline-block" href="#">
        <% unless params[:controller] == 'users' %>
          <%= link_to user_path(current_user) do %>
            <div class="dash-header-links"><strong class="important-text-69">Dashboard</strong></div>
              <% end %>
            <% if params[:controller] == 'merchant_customers' && params[:action] == 'show' %>
              <%= link_to user_merchant_customers_path(current_user) do %>
                <div class="dash-header-links new-link"><strong class="important-text-70">All &nbsp;customers</strong></div>
              <% end %>
              <%= link_to user_transactions_path(current_user) do%>
                <div class="dash-header-links new-link"><strong class="important-text-71">Transactions</strong></div>
              <% end %>
              <%= link_to user_lists_path(current_user) do%>
                <div class="dash-header-links new-link"><strong class="important-text-72">List</strong></div>
              <% end %>
              <%= link_to user_conversations_path(current_user) do%>
                <div class="dash-header-links new-link"><strong class="important-text-73">Conversations</strong></div>
              <% end %>
            <% end %>
        <% end %>
        <%= render "shared/rhombus_number" %>
      </a>
    </div>
    <div class="dashboard-nav-links-wrapper new-tab right-nav settings-dropdown">
      <div class="dropdown-wrapper w-dropdown" data-delay="0">
        <%= render 'shared/settings_dropdown' %>
      </div>
    </div>
  </div>
</div>
<div class="customer-profile sub-nav-bar w-clearfix">
  <a class="add sub-nav-button w-button modal-loader" href="#" modal-target= "charge-customer-modal"><strong>Charge</strong></a>
  <div class='modal-background w-hidden modal-body charge-customer-modal'>
   <%= render 'shared/modals/charge_customer' %>
  </div>
  <a class="import sub-nav-button w-button modal-loader" href="#" modal-target= 'new-subscription-modal' ><strong>Create subscription</strong></a>
  <div class='modal-background w-hidden modal-body new-subscription-modal'>
   <%= render 'shared/modals/new_subscription' %>
  </div>
  <a class="sub-nav-button w-button modal-loader" href="#" modal-target="add-to-list-modal"><strong>Add to list</strong></a>
  <div class='modal-background w-hidden modal-body add-to-list-modal'>
   <%= render 'shared/modals/add_to_list' %>
  </div>
  <a class="sub-nav-button w-button modal-loader" href="#" modal-target="schedule-message-modal" ><strong>Schedule message</strong></a>
  <div class='modal-background w-hidden modal-body schedule-message-modal'>
    <%= render partial: 'shared/modals/new_reminder', locals: { reminder: Reminder.new }  %>
  </div>
</div>
<div class="customer-profile dashboard-body">
  <div class="customer-profile-section-header w-row">
    <div class="w-col w-col-3">
      <div class="customer-properties-div">
        <div class="right-nav-profile-content-wrapper">
          <% if user_snapshot[:profile_image][:type] == 'color' %>
            <div class= "rignt-sidebar-placeholder-container" style="background: <%= user_snapshot[:profile_image][:value] %>">
              <div class="side-bar-profile-image-placeholder-text"><%= user_snapshot[:full_name][0] %></div>
            </div>
          <% else %>
            <%= image_tag(user_snapshot[:profile_image][:value], class: 'profile-picture-right-nav', width: 60 )%>
          <% end %>

          <div class="dashboard-right-nav signup-box-subheading"><%= user_snapshot[:full_name] %> <span class="relay-id"><%= user_snapshot[:verified] %></span>
          </div>

          <% if user_snapshot[:phone_number].present? && user_snapshot[:phone_number] != "-" %>
            <div class="left-column-text number"><%= user_snapshot[:phone_number] %></div>
          <% end %>
          <% if user_snapshot[:email].present? && user_snapshot[:email] != "-" %>
            <div class="left-column-text"><%= user_snapshot[:email] %></div>
          <% end %>
          <% if user_snapshot[:location].present? && user_snapshot[:location] != "-" %>
            <div class="left-column-text"><%= user_snapshot[:location] %></div>
          <% end %>
          <% if user_snapshot[:twitter].present? && user_snapshot[:twitter] != "-" %>
            <div class="left-column-text"><%= user_snapshot[:twitter] %></div>
          <% end %>
          <div class="left-column-text"><%= contact_or_customer %> since: <%= user_snapshot[:since][:date] %></div>
        </div>
        <%= render partial: 'shared/profiles/recent_activity', locals: { recent_activity: recent_activity } %>
        <% if current_user.is_platform? %>
          <%= render partial: 'shared/profiles/plan_info', locals: { active_plan: @active_plan, current_subscription: @current_subscription } %>
        <% end %>
      </div>
    </div>
    <div class="w-col w-col-5">
      <div class="customer-profile-section-header-div">
        <h4 class="welcome-dash-content-container-header">Conversation History</h4>
      </div>

      <% if conversation_refs.empty? %>
        <div class="no-profile-data-text profile-conversations">
          You have no conversations with this <%= contact_or_customer.downcase %>.
        </div>
      <% else %>
        <% conversation_refs.each do |conversation_ref| %>
          <a class="conversation-history-link-wrapper w-block" href="#">
            <div class="customer-profile-conversation-history top w-container">
              <div class="conversation-content-wrapper w-row">
                <div class="w-col w-col-1">
                  <div class="icon-cell"></div>
                </div>
                <div class="w-clearfix w-col w-col-11">
                  <div class="customer-name-conversation-tab"><%= "#{user_snapshot[:full_name]}" %></div>
                  <div class="said-text">said:</div>
                  <p class="conversation-preview"><%= present(conversation_ref).format_textable_text %></p>
                  <div class="message-channel"> &nbsp; Sent from</div>
                  <div class="channel-name message-channel"><%= present(conversation_ref).channel %></div>
                  <div class="message-channel time-received"><%= present(conversation_ref).format_created_at %></div>
                  <div class="status"><%= present(conversation_ref).format_resolution %></div>
                </div>
              </div>
            </div>
          </a>
        <% end %>
      <% end %>

    </div>
    <div class="w-col w-col-4">
      <div class="customer-transactions-div overlow-div">
        <div class="customer-profile-section-header-div transaction-history-section">
          <h4 class="welcome-dash-content-container-header">Transaction History</h4>
        </div>
        <div class="transaction-summary-table w-row">
          <div class="w-col w-col-6">
            <div class="customer-profile-box total-spend">
              <div class="total-spend-text transaction-history-box-headers">
                <%= customer ? present(@merchant_customer).total_transaction : '-' %>
              </div>
              <div class="table-description">Total Spend</div>
            </div>
          </div>
          <div class="w-col w-col-6">
            <div class="average-spend customer-profile-box">
              <div class="average-spend-text transaction-history-box-headers">
                <%= customer ? present(@merchant_customer).average_transaction : '-' %>
              </div>
              <div class="table-description">Average Spend</div>
            </div>
          </div>
        </div>
        <%= render partial: 'shared/profiles/transactions_table', locals: { transactions: transactions } %>
      </div>
    </div>
  </div>
</div>
