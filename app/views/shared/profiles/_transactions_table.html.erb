<% if transactions.empty? %>
  <div class="no-profile-data-text profile-conversations">
    <%= contact_or_customer %> has no transactions to date.
  </div>
<% else %>
  <div class="customer-profile-transactions">
    <div class="customer-profile-trasaction-table w-row">
      <div class="w-col w-col-5">
        <div class="description header">
          <div class="headings transaction-description"> &nbsp; Description</div>
        </div>
      </div>
      <div class="w-col w-col-2">
        <div class="amount header">
          <div class="headings transaction-amount">Amount</div>
        </div>
      </div>
      <div class="w-col w-col-2">
        <div class="date header">
          <div class="headings transaction-time">Time</div>
        </div>
      </div>
      <div class="w-col w-col-3">
        <div class="action header">
          <div class="actions headings">Actions</div>
        </div>
      </div>
    </div>

    <div id='objlists' data-object-type='transaction'>
      <%= render transactions %>
    </div>
    <div id="with-button" class="hide">
      <%= will_paginate transactions %>
    </div>
    <% if transactions.next_page %>
      <div id="load_more_transactions" class="show_more load-more-wrapper" data-loading-text="Loding more transactions" >
        <a class="load-more-rows-button w-button" href="#">&nbsp;&nbsp;&nbsp;Load more</a>
      </div>
    <% end %>

    <div class='modal-background w-hidden modal-body refund_customer_modal'>
      <%= render 'shared/modals/refund_customer' %>
    </div>
  </div>
<% end %>
