<%# removed all webflow data attributes %>
<div class="cancel-subscription-form-wrapper w-clearfix modal-background" id="cancel-subscription-div">
  <div class="cancel-subscription-wrapper w-clearfix">
    <p class="cancel-subscription modal-content-description">Are you sure you'd like to unsubscriber <span class="text-highlight"><%= current_user.first_name  %> <%= current_user.last_name  %></span> from <span class="text-highlight"><%= saas_plan_name.humanize %></span> plan?</p>
    <div class="modal-underline underline-div"></div>
    <%= link_to 'Yes, unsubscribe customer', user_subscription_path(current_user, saas_sub), method: :delete, class: "button cancel-yes w-button subscription#{saas_sub.id}", id: 'cancel-subscription', data: { parent: "cancel-subscription-div",disable_with: "Please wait..." } %>
    <%# added update-close-modals and data %>
    <a class="button cancel-no w-button update-close-modals" data-parent='cancel-subscription-div'>Cancel</a>
  </div>
</div>
