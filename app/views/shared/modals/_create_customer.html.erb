<div class="modal-form-wrapper">
  <div class="content-sub-wrapper modal w-clearfix">
    <h4 class="modal-header welcome-dash-content-container-header">Create Customer</h4><a class="close-create-customer" data-ix="close-create-customer" href="#"></a>
  </div>
  <div class="get-started-2 log-in-form w-form">
    <form class="modal-form w-clearfix" data-name="Email Form" id="email-form" name="email-form">
      <label class="form-label modal" for="Full-name-2">Basic Information</label>
      <input class="modal-field text-field w-input" data-name="Full Name 2" id="Full-name-2" maxlength="256" name="Full-name-2" placeholder="Full name" required="required" type="text">
      <input class="modal-field text-field w-input" data-name="Email" id="Email-2" maxlength="256" name="Email" placeholder="Email" required="required" type="text">
      <input class="modal-field text-field w-input" data-name="Phone 2" id="Phone-2" maxlength="256" name="Phone-2" placeholder="Phone number" required="required" type="text">
      <select class="dropdown w-select" data-name="List Selection 2" id="List-Selection-2" name="List-Selection-2">
        <option value="">Add to List</option>
        <option value="">VIP</option>
        <option value="">First-time customers</option>
        <option value="">San Francisco</option>
      </select>
      <div class="form underline-div"></div>
      <label class="form-label modal" for="Street-Address-3">Address (optional)</label>
      <input class="modal-field text-field w-input" data-name="Street Address 3" id="Street-Address-3" maxlength="256" name="Street-Address-3" placeholder="Street address, APT" type="text">
      <input class="city modal-field text-field w-input" data-name="City 3" id="City-3" maxlength="256" name="City-3" placeholder="City" type="text">
      <input class="modal-field state-province text-field w-input" data-name="State 3" id="State-3" maxlength="256" name="State-3" placeholder="State: E.g. (MA)" type="text">
      <select class="dropdown w-select" data-name="Country 3" id="Country-3" name="Country-3">
        <option value="">Country</option>
        <option value="">United States</option>
        <option value="">Canada</option>
      </select>
      <div class="form underline-div"></div>
      <label class="form-label modal" for="Card-Number-3">Payment Information (optional)</label>
      <input class="card-number modal text-field w-input" data-name="Card Number 3" id="Card-Number-3" maxlength="256" name="Card-Number-3" placeholder="Card number" type="text">
      <input class="card-name modal text-field w-input" data-name="Name On Card 3" id="Name-on-Card-3" maxlength="256" name="Name-on-Card-3" placeholder="Name on card" type="text">
      <input class="month-year text-field w-input" data-name="Month Year 3" id="Month-Year-3" maxlength="256" name="Month-Year-3" placeholder="MM / YYYY" required="required" type="text">
      <input class="cvv modal text-field w-input" data-name="Cvv 3" id="CVV-3" maxlength="256" name="CVV-3" placeholder="CVV" type="text">
      <input class="button create-customer w-button" data-wait="Please wait..." type="submit" value="Create customer">
      <input class="button cancel log-in w-button" data-ix="close-modal" data-wait="Please wait..." type="submit" value="Cancel">
    </form>
    <div class="w-form-done">
      <div>Thank you! Your submission has been received!</div>
    </div>
    <div class="w-form-fail">
      <div>Oops! Something went wrong while submitting the form</div>
    </div>
  </div>
</div>
