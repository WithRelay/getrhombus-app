<%= render 'shared/flash_messages' %>
 <div class="create-customer-form-wrapper  w-clearfix modal-background" id="new-customer-div">
  <%# removed all webflow data attributes %>

  <div class="modal-form-wrapper">
    <div class="content-sub-wrapper modal w-clearfix">
      <h4 class="modal-header welcome-dash-content-container-header">Create Customer</h4>
      <%# added update-close-modals and data %>
      <a class="close-modal update-close-modals" data-parent='new-customer-div' href="#"></a>
    </div>
    <div class="get-started-2 log-in-form w-form">
        <%= form_for @new_customer, url: v1_merchant_customers_url, html: { class: "modal-form w-clearfix", id: "create-user-form" } do |f| %>
        <label class="form-label modal" for="Full-name-2">Basic Information</label>

        <%= f.fields_for @new_customer.people.build do |p|%>
          <div class="form-group col-xs-6">
            <%= p.text_field :full_name, class: "form-control modal-field text-field w-input", placeholder:"Full name" %>
          </div>
        <% end %>

        <div class="form-group col-xs-6">
          <%= f.text_field :email, class: "form-control modal-field text-field w-input", placeholder: "Email" %>
        </div>

        <div class="form-group col-xs-6">
          <%= f.text_field :phone, class: "form-control modal-field text-field w-input", placeholder: "Phone number", id: 'phone' %>
        </div>
        <%= f.hidden_field :phone_number, :id => "phone_number" %>

        <%= f.fields_for @new_customer.user_lists.build do |ul|%>
          <%= ul.select :list_id, [], { prompt: 'Add user to list' }, class: 'dropdown w-select' %>
        <% end %>

        <div class="form underline-div"></div>

        <%= f.fields_for @new_customer.build_address do |a| %>

          <label class="form-label modal" for="Street-Address-3">Address (optional)</label>

          <%= a.text_field :street_address, class: "modal-field text-field w-input", placeholder: "Street address, APT" %>

          <%= a.text_field :city, class: "city modal-field text-field w-input", placeholder: 'City' %>

          <%= a.text_field :state_province, class: "modal-field state-province text-field w-input", placeholder: "State: E.g. (MA)" %>
          
          <%= a.select :country, country_list, { prompt: 'Select your country' }, { class: 'dropdown w-select' } %>
          </div>

        <% end %>

        <div class="form underline-div"></div>

        <label class="form-label modal" for="Card-Number-3">Payment Information (optional)</label>
        <div class="form-group col-xs-6">

          <div class="form-group col-xs-6">
            <%= f.number_field :last4, id: "cc-number", type: "tel", class: "form-control card-number modal text-field w-input", placeholder: "Card number", "x-autocompletetype" => "cc-number", autocompletetype: "cc-number", autocorrect: 'off', spellcheck: 'off', autocapitalize: 'off' %>
          </div>

          <div class="form-group col-xs-6">
            <%= f.text_field :card_name, id: 'cc-name', type: "text", class: "form-control card-name modal text-field w-input", placeholder: "Name on Card", 'x-autocompletetype' => "off", autocompletetype: 'off', autocorrect: "off", spellcheck: 'off', autocapitalize: "off", autocomplete: "off" %>
          </div>

          <div class="form-group col-xs-6">
            <input id="cc-exp" type="text" class="form-control month-year text-field w-input" placeholder="MM / YYYY" value="" x-autocompletetype="off" autocompletetype="off" autocorrect="off" spellcheck="off" autocapitalize="off">
          </div>

          <div class="form-group col-xs-6">
            <input id="cc-csc" type="tel" class="form-control cvv modal text-field w-input" placeholder="CVV" value="" autocorrect="off" spellcheck="off" autocapitalize="off" autocomplete="off" maxlength="4">
          </div>

          <%= f.hidden_field :exp_month, id: "cc-ex-month" %>
          <%= f.hidden_field :exp_year, id: "cc-ex-year" %>
          <%= f.hidden_field :card_token, id: "cc-uri" %>
          <%= f.hidden_field :card_type, id: "cc-type" %>

        <%= f.submit "Create customer", class: "button create-customer w-button", id: 'create-user-submit' %>
        
        <%# added update-close-modals and data %>
        <input class="button cancel log-in w-button update-close-modals" data-parent='new-customer-div' type="submit" value="Cancel">

      <%end%>
    </div>
  </div>
</div>
