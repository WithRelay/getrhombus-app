<style type="text/css">
  .underline-div {
    width: 80%;
    height: 1px;
    margin-bottom: 50px;
    background-color: #dde5ed;
  }
</style>
<%= render 'shared/flash_messages' %>
 <div class="create-customer-form-wrapper  w-clearfix modal-background" id="new-customer-div">
  <%# removed all webflow data attributes %>

  <div class="modal-form-wrapper">
    <div class="content-sub-wrapper modal w-clearfix">
      <h4 class="modal-header welcome-dash-content-container-header">Create Customer</h4>
      <%# added update-close-modals and data %>
      <a class="close-modal update-close-modals" data-parent='new-customer-div' href="#"></a>
    </div>
    <div class="get-started-2 log-in-form w-form">
        <%= form_for @new_customer, url: add_customers_v1_users_url, html: {class: "modal-form w-clearfix", id: "create-user-form", name: "email-form"} do |f| %>
        <label class="form-label modal" for="Full-name-2">Basic Information</label>

        <input class="modal-field text-field w-input" id="user_full_name" maxlength="256" name="Full-name-2" placeholder="Full name" required="required" type="text">

        <%#= f.fields_for @new_customer.people.build do |ff|%>
          <%#= ff.text_field :full_name, class: "modal-field text-field w-input", id:"user_full_name", placeholder:"Full name", required: "required" %>
          <%#end%>

          <%= f.hidden_field :first_name , id: "firstName"%>
          <%= f.hidden_field :last_name, id: "lastName" %>
        <!-- <input class="modal-field text-field w-input" id="Email-2" maxlength="256" name="Email" placeholder="Email" required="required" type="text">
 -->
        <%= f.text_field :email, class: "modal-field text-field w-input", id: "Email-2" , placeholder: "Email" , required: "required" %>

        <%= f.text_field :phone_number, class:"modal-field text-field w-input", id: "Phone-2", placeholder: "Phone number", required: "required" %>

        <%= f.select :lists, ['VIP', 'First-time Customers', 'San Francisco'], {}, class: 'dropdown w-select', data: { name:'List-Selection-2'}, id: 'List-Selection-2' %>

        <div class="form underline-div"></div>
         <%#= f.fields_for @new_customer.build_address  do |ff| %>
        <label class="form-label modal" for="Street-Address-3">Address (optional)</label>

        <%= f.text_field :street_address, class: "modal-field text-field w-input", id: "Street-Address-3", placeholder: "Street address, APT" %>


       <%= f.text_field :city, class: "city modal-field text-field w-input", id: "City-3"%>

        <%= f.text_field :state_province, class: "modal-field state-province text-field w-input", id: "State-3", placeholder: "State: E.g. (MA)" %>


        <%= f.select :country, [['United State', 'US'], ['Canada', 'CA']], {}, class: 'dropdown w-select', id:'Country-3' %>

        <%#end%>

        <div class="form underline-div"></div>
        <label class="form-label modal" for="Card-Number-3">Payment Information (optional)</label>

        <!-- <input class="card-number modal text-field w-input" id="Card-Number-3" maxlength="256" name="Card-Number-3" placeholder="Card number" type="text">

        <input class="card-name modal text-field w-input" id="Name-on-Card-3" maxlength="256" name="Name-on-Card-3" placeholder="Name on card" type="text">
        <input class="month-year text-field w-input" id="Month-Year-3" maxlength="256" name="Month-Year-3" placeholder="MM / YYYY" required="required" type="text">
        <input class="cvv modal text-field w-input" id="CVV-3" maxlength="256" name="CVV-3" placeholder="CVV" type="text">
 -->
        <%= f.submit "Create customer", class: "button create-customer w-button"  %>
              <%# added update-close-modals and data %>
        <input class="button cancel log-in w-button update-close-modals" data-parent='new-customer-div' type="submit" value="Cancel">

      <%end%>
    </div>
  </div>
</div>
