<%# removed all webflow data attributes %>

<div class="saved-reply-selection-wrapper w-clearfix">
  <div class="content-sub-wrapper modal w-clearfix">
    <h4 class="modal-header welcome-dash-content-container-header">Select Saved Reply</h4>
  </div>
  <p class="modal-content-description">Saved replies help your team speed up response time to frequently asked questions. Select your saved replies from the drop-down, then personalize and hit send.</p>
  <div class="segment-modal underline-div"></div>
  <div class="saved-reply-select-form w-form">
    <form id="email-form-3" name="email-form-3">
      <select class="dropdown w-select" id="field-2" name="field-2">
        <option value="">Select saved reply</option>
        <option value="">Business Hours: Monday - Friday</option>
        <option value="">Order Cancellation</option>
        <option value="">Returns</option>
        <option value="">International Shipping</option>
      </select>
      <textarea class="text-area view-saved-reply w-input" id="Saved-Reply-Content-2" maxlength="5000" name="Saved-Reply-Content-2" placeholder="Edit saved reply"></textarea>
    </form>
  </div><a class="button send-saved-reply w-button">Send Reply</a>
  <%# added update-close-modals and data %>
  <a class="button cancel-saved-reply w-button update-close-modals" data-parent='saved-reply-selection-div'>Cancel</a>
</div>
