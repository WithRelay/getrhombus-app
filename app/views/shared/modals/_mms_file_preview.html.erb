<%# removed all webflow data attributes %>

<div class="mms-file-preview-wrapper">
  <div class="content-sub-wrapper modal w-clearfix">
    <h4 class="modal-header welcome-dash-content-container-header">Send file</h4>
  </div>
  <div class="file-name image-preview">Sample_File_Name.jpg</div>
  <div class="image-preview-wrapper"><img class="image-file-preview" src="images/Relay-Image-Placeholder.png" width="254">
  </div>
  <div class="w-form">
    <form class="w-clearfix" id="email-form-9" name="email-form-9">
      <textarea class="file-description text-area w-input" id="File-Description-2" maxlength="5000" name="File-Description-2" placeholder="Add description (optional)"></textarea>
      <div class="file-sender split-button-wrapper"><a class="message-window-tabs send-button split-button w-button">Send</a>
        <div class="w-dropdown">
          <div class="split-dropdown w-dropdown-toggle"><span class="font-icon-split"></span>
          </div>
          <nav class="dropdown-options-wrapper split-button w-dropdown-list"><a class="dropdown-link split-button w-dropdown-link"> &nbsp; &nbsp;Send via Messenger</a>
          </nav>
        </div>
      </div>
      <%# added update-close-modals and data %>
      <a class="button cancel-send w-button update-close-modals" data-parent='mms-file-preview-div'>Cancel</a>
    </form>
  </div>
</div>
