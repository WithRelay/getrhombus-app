<div class="mms-file-preview-wrapper">
  <div class="content-sub-wrapper modal w-clearfix">
    <h4 class="modal-header welcome-dash-content-container-header">Send file</h4>
  </div>
  <div class="file-name image-preview">Sample_File_Name.jpg</div>
  <div class="image-preview-wrapper"><img class="image-file-preview" src="images/Relay-Image-Placeholder.png" width="254">
  </div>
  <div class="w-form">
    <form class="w-clearfix" data-name="Email Form 9" id="email-form-9" name="email-form-9">
      <textarea class="file-description text-area w-input" data-name="File Description 2" id="File-Description-2" maxlength="5000" name="File-Description-2" placeholder="Add description (optional)"></textarea>
      <div class="file-sender split-button-wrapper"><a class="message-window-tabs send-button split-button w-button" href="#">Send</a>
        <div class="w-dropdown" data-delay="0">
          <div class="split-dropdown w-dropdown-toggle"><span class="font-icon-split"></span>
          </div>
          <nav class="dropdown-options-wrapper split-button w-dropdown-list"><a class="dropdown-link split-button w-dropdown-link" href="#"> &nbsp; &nbsp;Send via Messenger</a>
          </nav>
        </div>
      </div><a class="button cancel-send w-button" data-ix="cancel-send-file" href="#">Cancel</a>
    </form>
    <div class="w-form-done">
      <div>Thank you! Your submission has been received!</div>
    </div>
    <div class="w-form-fail">
      <div>Oops! Something went wrong while submitting the form</div>
    </div>
  </div>
</div>
