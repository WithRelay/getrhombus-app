<%# removed all webflow data attributes %>

<div class="mark-as-done-form-wrapper">
  <p class="modal-content-description">Label conversations before you close it, so your entire team can stay informed on why a customer or lead reached out.</p>
  <div class="segment-modal underline-div"></div>
  <div class="mark-as-done-form w-form">
    <form class="w-clearfix" id="email-form-6" name="email-form-6">
      <select class="dropdown message-reason w-select" id="Message-Reason-2" name="Message-Reason-2" required="required">
        <option value="">Select message reason</option>
        <option value="">Account reactivation</option>
        <option value="">Account deactivation</option>
        <option value="">Apply coupon/promo code</option>
        <option value="">Appointment scheduled</option>
        <option value="">Appointment cancelled </option>
        <option value="">Billing or payment question</option>
        <option value="">Complaint</option>
        <option value="">Change delivery address</option>
        <option value="">Delivery status</option>
        <option value="">Defective product</option>
        <option value="">Defective feature</option>
        <option value="">Late order arrival</option>
        <option value="">Missing item</option>
        <option value="">New order</option>
        <option value="">Order cancellation</option>
        <option value="">Order not delivered</option>
        <option value="">Product or service question</option>
        <option value="">Product or service feedback</option>
        <option value="">Refund request</option>
        <option value="">Refund status</option>
        <option value="">Resend receipt</option>
        <option value="">Returns</option>
        <option value="">Spam</option>
        <option value="">Subscription cancellation</option>
        <option value="">Subscription reactivation</option>
        <option value="">Update account information</option>
        <option value="">Update order</option>
        <option value="">Wrong item</option>
      </select>
      <textarea class="mark-done text-area w-input" id="field-4" maxlength="5000" name="field-4" placeholder="Add notes"></textarea><a class="button mark-as-done-modal-button w-button">Mark conversation as done</a>
      <%# added update-close-modals and data %>
      <a class="button cancel-mark-as-done w-button update-close-modals" data-parent='mark-as-done-div'>Cancel</a>
    </form>
  </div>
</div>
