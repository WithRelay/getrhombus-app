<%# removed all webflow data attributes %>

<div class="account-deactivation-form-wrapper w-clearfix">
    <div class="content-sub-wrapper modal w-clearfix">
      <h4 class="modal-header welcome-dash-content-container-header">Deactivate Account</h4>
    </div>
    <p class="cancel-subscription modal-content-description">We're sad to see you go. Please take a moment to tell us why, so we can improve the software to meet your future needs.</p>
    <div class="segment-modal underline-div"></div>
    <div>
      <form class="deactivation-form" id="email-form-2" name="email-form-2">
        <label class="form-label" for="field-7">What prompted you to deactivate your account?</label>
        <select class="dropdown w-select" id="field-7" name="field-7" required="required">
          <option value="">Select one...</option>
          <option value="">Pricing</option>
          <option value="">Inadequate Features</option>
          <option value="">Customer support</option>
          <option value="">Other</option>
        </select>
        <textarea class="deactivation-comments text-area w-input" id="Deactivation-Comments-2" maxlength="5000" name="Deactivation-Comments-2" placeholder="Please include some details or suggestions for improvement"></textarea>
        <input class="enter-cancel-field text-field w-input" id="Deactivate-2" maxlength="256" name="Deactivate-2" placeholder="Type the word &quot;DEACTIVATE&quot;" required="required" type="text">
      </form>
    </div><a class="button deactivate-account-button w-button" href="#">Deactivate/Pause account</a>
    <%# added update-close-modals and data %>
    <a class="button cancel deactivate-account-button w-button update-close-modals" data-parent='deactivate-account' href="#">Cancel</a>
  </div>
