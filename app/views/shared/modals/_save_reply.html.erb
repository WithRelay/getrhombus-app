<!-- added modal-background -->
<%# removed all webflow data attributes %>

<div class="create-saved-reply-form-wrapper w-clearfix modal-background">
  <div class="content-sub-wrapper modal w-clearfix">
    <h4 class="modal-header welcome-dash-content-container-header">Create Saved reply</h4>
    <%# added data and update-close-modals %>
    <a class="close-modal update-close-modals" data-parent="new-saved-reply-div" href="#"></a>
  </div>
  <p class="modal-content-description">Create saved replies to frequently asked questions so you can respond to you customers faster. Type '/' on your messaging dashboard to trigger a saved reply.</p>
  <div class="segment-modal underline-div"></div>
  <div class="saved-reply-form w-form">
    <form id="email-form-8" name="email-form-8">
      <input class="saved-reply text-field title-create w-input" id="Saved-Reply-Title-3" maxlength="256" name="Saved-Reply-Title-3" placeholder="Saved reply title" type="text">
      <textarea class="create saved-reply text-area w-input" id="Saved-Replies-Editor-3" maxlength="5000" name="Saved-Replies-Editor-3" placeholder="Start typing..."></textarea>
    </form>
  </div><a class="button send-saved-reply w-button" href="#">Save</a>
  <%# added update-close-modals and data %>
  <a class="button cancel-saved-reply w-button update-close-modals" data-parent='new-saved-reply-div' href="#">Cancel</a>
</div>
