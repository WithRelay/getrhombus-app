<div class="create-saved-reply-form-wrapper w-clearfix">
  <div class="content-sub-wrapper modal w-clearfix">
    <h4 class="modal-header welcome-dash-content-container-header">Create Saved reply</h4><a class="close-modal" data-ix="close-create-subscription" href="#"></a>
  </div>
  <p class="modal-content-description">Create saved replies to frequently asked questions so you can respond to you customers faster. Type '/' on your messaging dashboard to trigger a saved reply.</p>
  <div class="segment-modal underline-div"></div>
  <div class="saved-reply-form w-form">
    <form data-name="Email Form 8" id="email-form-8" name="email-form-8">
      <input class="saved-reply text-field title-create w-input" data-name="Saved Reply Title 3" id="Saved-Reply-Title-3" maxlength="256" name="Saved-Reply-Title-3" placeholder="Saved reply title" type="text">
      <textarea class="create saved-reply text-area w-input" data-name="Saved Replies Editor 3" id="Saved-Replies-Editor-3" maxlength="5000" name="Saved-Replies-Editor-3" placeholder="Start typing..."></textarea>
    </form>
    <div class="w-form-done">
      <div>Thank you! Your submission has been received!</div>
    </div>
    <div class="w-form-fail">
      <div>Oops! Something went wrong while submitting the form</div>
    </div>
  </div><a class="button send-saved-reply w-button" href="#">Save</a><a class="button cancel-saved-reply w-button" href="#">Cancel</a>
</div>
