<div class="charge-customer-form-wrapper">
  <div class="content-sub-wrapper modal w-clearfix">
    <h4 class="modal-header welcome-dash-content-container-header">Charge customer</h4><a class="close-modal" data-ix="close-charge-customer" href="#"></a>
  </div>
  <div class="charge-customer-form w-form">
    <form data-name="Email Form 4" id="email-form-4" name="email-form-4">
      <input class="customer-name-or-number text-field w-input" data-name="Name Or Number 2" id="Name-or-Number-2" maxlength="256" name="Name-or-Number-2" placeholder="Enter customer&#39;s name or phone number" type="text">
      <input class="item-name text-field w-input" data-name="Item Name 4" id="Item-name-4" maxlength="256" name="Item-name-4" placeholder="Item name" required="required" type="email">
      <input class="amount-field text-field w-input" data-name="Amount 4" id="Amount-4" maxlength="256" name="Amount-4" placeholder="Amount" required="required" type="email">
      <textarea class="item-description text-area w-input" data-name="Item Description 4" id="Item-Description-4" maxlength="5000" name="Item-Description-4" placeholder="Item Description"></textarea>
      <div class="form-check-box w-checkbox">
        <input class="w-checkbox-input" data-name="Checkbox 4" id="checkbox-4" name="checkbox-4" type="checkbox">
        <label class="w-form-label" for="checkbox-4">Authorize only</label>
      </div><a class="button charge-modal-button w-button" href="#">Charge Customer</a>
    </form>
    <div class="w-form-done">
      <div>Thank you! Your submission has been received!</div>
    </div>
    <div class="w-form-fail">
      <div>Oops! Something went wrong while submitting the form</div>
    </div>
  </div>
  <p class="charge-tips modal-paragraph tips"> &nbsp;TIP: You can use Hashtags to create an item list in Relay. Hashtags allow your customers text an item name to place an order</p>
</div>
