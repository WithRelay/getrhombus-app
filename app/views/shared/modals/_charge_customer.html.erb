
<%# removed all webflow data attributes %>
<div class="charge-customer-form-wrapper">
  <div class="content-sub-wrapper modal w-clearfix">
    <h4 class="modal-header welcome-dash-content-container-header">Charge customer</h4>
    <%# added update-close-modals and data %>
    <a class="close-modal update-close-modals" data-parent='charge-a-customer-div'></a>
  </div>
  <div class="charge-customer-form w-form">
       <label>
          <angucomplete-alt id="find-hashtag"
          placeholder="Hashtag or item name"
          pause="300"
          minlength="1"
          selected-object="hashtagSelected"
          remote-url="<%= (Rails.env == 'development' ? "http://localhost:3000" : "#{Rails.application.secrets.url["info"]}") + "/v1/hashtags?query=" %>"
          remote-url-data-field="hashtags"
          title-field="tag"
          text-no-results='false'
          match-class='highlight'
          input-name='hashtag'
          description-field='description'
          text-searching="Finding your tag/item..."
          <%#= add html notification during ui integration %>
          <%#= scroll bar added but test option during UI integration and testing %>
          remote-url-error-callback='hashtagsApiErrorHandler'
          />
        </label>

    <form id="chargeForm" name="email-form-4">
      <input class="customer-name-or-number text-field w-input" id="Name-or-Number-2" maxlength="256" name="Name-or-Number-2" placeholder="Enter customer&#39;s name or phone number" type="text">
      <input class="item-name text-field w-input" id="Item-name-4" maxlength="256" name="Item-name-4" placeholder="Item name" required="required" type="email">
      <input class="amount-field text-field w-input"  id="Amount-4" maxlength="256" name="Amount-4" placeholder="Amount" required="required" type="email">
      <textarea class="item-description text-area w-input" id="Item-Description-4" maxlength="5000" name="Item-Description-4" placeholder="Item Description"></textarea>
      <div class="form-check-box w-checkbox">
        <input class="w-checkbox-input" id="checkbox-4" name="checkbox-4" type="checkbox">
        <label class="w-form-label" for="checkbox-4">Authorize only</label>
      </div><a class="button charge-modal-button w-button">Charge Customer</a>
    </form>
  </div>
  <p class="charge-tips modal-paragraph tips"> &nbsp;TIP: You can use Hashtags to create an item list in Relay. Hashtags allow your customers text an item name to place an order</p>
</div>
