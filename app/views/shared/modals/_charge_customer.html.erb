<%# removed all webflow data attributes %>

<div class="charge-customer-form-wrapper" id="charge-a-customer-div">
  <div class="content-sub-wrapper modal w-clearfix">
    <h4 class="modal-header welcome-dash-content-container-header">Charge customer</h4>
    <%# added update-close-modals and data %>
    <a class="close-modal update-close-modals" data-parent='charge-a-customer-div'></a>
  </div>
  <div class="charge-customer-form">
    <%= form_for('transaction', html: { id: 'chargeForm', class: 'w-clearfix' }) do |f| %>
      <div class="form-group col-xs-6">
         <%= transaction_customer_field(f) %>
      </div>

      <div class="form-group col-xs-6">
        <%= f.text_field :hashtag_id, class: 'form-control item-name text-field w-input', id: 'search-hashtag', placeholder: "Item name" %>
      </div>

      <div class="form-group col-xs-6">
        <%= f.text_field :amount, class: 'form-control amount-field text-field w-input', id: 'charge-amount', placeholder: "Amount" %>
      </div>

      <div class="form-group col-xs-6">
        <%= f.text_area :description, class: 'form-control item-description text-area w-input', id: 'item-description', placeholder: "Item Discription" %>
      </div>

      <div class="form-check-box w-checkbox">
        <%= f.check_box :captured, class: 'w-checkbox-input' %>
        <label class="w-form-label" for="checkbox-4">Authorize only</label>
      </div>
      <%= f.submit 'Charge Customer', class: 'button charge-modal-button w-button', id: 'charge-customer' %>
    <% end %>
  </div>
  <p class="charge-tips modal-paragraph tips"> &nbsp;TIP: You can use Hashtags to create an item list in Relay. Hashtags allow your customers text an item name to place an order</p>
</div>
