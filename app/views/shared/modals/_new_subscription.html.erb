<%# removed all webflow data attributes %>

<div class="create-subscription-form-wrapper">
  <div class="content-sub-wrapper modal w-clearfix">
    <h4 class="modal-header welcome-dash-content-container-header">Create subscription</h4>
    <%# added data and update-close-modals %>
    <a class="close-modal update-close-modals" data-parent='new-subscription-div' href="#"></a>
  </div>
  <p class="create-plan modal-content-description">Subscribe customers to an existing plan to charge them on a recurring basis.</p>
  <div class="modal-underline underline-div"></div>
  <div class="create-subscription-form w-form">
    <form class="w-clearfix" id="email-form-9" name="email-form-9">
      <input class="subscriber-name text-field w-input" id="Subscriber-Name-2" maxlength="256" name="Subscriber-Name-2" placeholder="Enter customer&#39;s name or phone number" required="required" type="text">
      <select class="dropdown w-select" id="field-6" name="field-6">
        <option value="">Select a plan</option>
        <option value="">Weekly Veggie Bowl</option>
        <option value="">Monthly fruit basket</option>
      </select><a class="create-new-plan" href="#">Create a new plan</a>
      <label class="form-label" for="Number-of-subscriptions-2">Number of subscriptions</label>
      <input class="number-of-subscriptions text-field w-input" id="Number-of-subscriptions-2" maxlength="256" name="Number-of-subscriptions-2" placeholder="1" required="required" type="email"><a class="button subscription w-button" href="#">Subscribe customer</a>
    </form>
  </div>
</div>
