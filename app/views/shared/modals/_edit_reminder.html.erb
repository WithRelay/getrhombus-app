<style>
#submitReminderForm {
    margin-top: -2px;
}
</style>
<div class="schedule-notification-form-wrapper" id = "edit-reminder-div">
  <div class="content-sub-wrapper modal w-clearfix">
    <h4 class="modal-header welcome-dash-content-container-header">Schedule message</h4>
    <a class="close-modal update-close-modals" data-parent='edit-reminder-div' ></a>

  </div>

  <p class="modal-content-description">Set a reminder or notification that will go out to this customer at a future date. You can use this to automate appointment reminders, or bill payment reminders.</p>
  <div class="segment-modal underline-div"></div>

  <div class="scheduled-notification-form">
    <%= form_for reminder, url: user_reminder_path(current_user, 12), html: { class: "w-clearfix editReminderFrom reminderForm", id: "reminderFrom",  name: "email-form-7", method: :patch }  do |f| %>

      <div class="form-group col-xs-6">
        <%= f.select :channel, reminder_channel(reminder), {}, selected: get_channel_enum_value(reminder), class: 'form-control dropdown w-select', data: { name: 'Notification Channel', id: 'Notification-Channel' } %>
      </div>
      <div class="form-group col-xs-6">
        <%= f.text_field :customer_id, class: 'search-customers-and-contacts text-field w-input form-control', id: 'reminder-customer-list' %>
      </div>
      <div class="form-group col-xs-6">
        <%= f.text_area :text, class: 'form-control notification-message text-area w-input form-control', id: "Notification-Message" %>
      </div>
      <div class="char-count notications" id= "textBoxCounter1" ></div>
      <%= f.text_field :date_time, data: { name: "Delivery Date &amp; Time" }, class: 'daterange delivery-date-time-picker text-field w-input', id:'reminder-date-time' %>
      <div class="notification-frequency radio-button w-radio">
        <%= f.radio_button :frequency_type, 0, id: 'oneTimeFrequency', class: 'w-radio-input', data: { name: "Notification Frequency" }, checked: is_one_time_checked?(reminder) %>
        <label class="w-form-label" for="Notification Frequency">Send once</label>
      </div>

      <div class="notification-frequency radio-button repeat w-radio">
        <%= f.radio_button :frequency_type, 1, id: 'recurringFrequency', class: 'w-radio-input', data: { name: "Notification Frequency" }, checked: is_recurring_checked?(reminder) %>
        <label class="w-form-label" for="Notification Frequency-2">Repeat</label>
      </div>
      <%= f.select :repeat_days, repeat_days_options, {}, selected: reminder.repeat_days, id: 'campaign_repeat_days', class: "dropdown frequency-dropdown w-select" %>

      <!-- <a class="button schedule-notification w-button" href="#" id='submitEditReminderForm'>Schedule notification</a> -->
      <%= f.submit 'Schedule Notification', id: 'submitReminderForm', class: 'button schedule-notification w-button' %>
      <div id="new-reminder-div">
        <a class="button cancel-notification w-button update-close-modals" data-parent='edit-reminder-div'>Cancel</a>
      </div>
    <% end %>
  </div>
</div>
