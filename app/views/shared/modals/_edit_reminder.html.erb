<div class="schedule-notification-form-wrapper" id = "edit-reminder-div">

  <div class="content-sub-wrapper modal w-clearfix">
    <h4 class="modal-header welcome-dash-content-container-header">Schedule message</h4>
    <a class="close-modal update-close-modals" data-parent='edit-reminder-div' ></a>
  </div>

  <p class="modal-content-description">Edit a reminder or notification that will go out to this customer at a future date. You can use this to automate appointment reminders, or bill payment reminders.</p>
  <div class="segment-modal underline-div"></div>

  <div class="scheduled-notification-form">
    <%= form_for reminder, url: v1_reminders_url, html: { class: "w-clearfix reminderForm", id: "editReminderForm", method: :patch }  do |f| %>
      <div class="form-group col-xs-6">
        <%= f.text_field :mc_id, class: 'search-customers-and-contacts text-field w-input form-control', id: 'reminder-customer-list' %>
      </div>

      <div class="form-group col-xs-6">
        <%= f.select :channel, reminder_channels, {}, class: 'form-control dropdown w-select', id: 'Edit-Notification-Channel', disabled: true %>
      </div>

      <div class="form-group col-xs-6">
        <%= f.text_area :text, class: 'form-control notification-message text-area w-input', id: "Notification-Message" %>
      </div>

      <div class="char-count notications" id= "textBoxCounter1" ></div>
      <%= f.text_field :date_time, class: 'daterange delivery-date-time-picker text-field w-input', id:'reminder-date-time' %>

      <div class="flex">
        <div class="notification-frequency radio-button w-radio">
          <%= f.radio_button :frequency_type, 0, class: 'w-radio-input editReminderFrequency', id: 'edit_reminder_frequency_type_0' %>
          <label class="w-form-label" for="Notification Frequency">Send once</label>
        </div>

        <div class="notification-frequency radio-button repeat w-radio">
          <%= f.radio_button :frequency_type, 1, class: 'w-radio-input editReminderFrequency', id: 'edit_reminder_frequency_type_1' %>
          <label class="w-form-label" for="Notification Frequency-2">Repeat</label>
        </div>
      </div>

      <%= f.select :repeat_days, repeat_days_options, {}, selected: reminder.repeat_days, class: "dropdown frequency-dropdown w-select", id: 'editReminderRepeatDays' %>

      <!-- <a class="button schedule-notification w-button" href="#" id='submitEditReminderForm'>Schedule notification</a> -->
      <%= f.submit 'Schedule Notification', id: 'submitReminderForm', class: 'button schedule-notification w-button' %>

      <div id="new-reminder-div">
        <a class="button cancel-notification w-button update-close-modals" data-parent='edit-reminder-div'>Cancel</a>
      </div>
    <% end %>
  </div>
</div>
