<%# removed all webflow data attributes %>

<div class="create-list-form-wrapper modal-background" id="import-customers-div">
  <div class="content-sub-wrapper modal w-clearfix">
    <h4 class="modal-header welcome-dash-content-container-header">Create List</h4>
    <%# added data and update-close-modals %>
    <a class="close-modal update-close-modals" data-parent='import-customers-div' href="#"></a>
  </div>
  <div class="w-form">
    <%= form_for('lists', url: v1_lists_path, html: { id: "create_user_list", class: "edit_create_user_list" }) do |f| %>
      <%= f.label "List name", class: 'form-label list-name' %>
      <%= f.hidden_field :selected_users, id: 'selectedUsers' %>
      <%= f.hidden_field :list_category, placeholder: 'E.g. VIP customers', id: 'listCategory' %>
      <%= f.hidden_field :list_channel, placeholder: 'E.g. VIP customers', id: 'listChannel', value: get_list_channel %>
      <%= f.hidden_field :list_type, placeholder: 'E.g. VIP customers', id: 'listType' %>
      <div class='form-group col-xs-6'>
        <%= f.text_field :name, class: 'modal-field text-field w-input form-control' %>
        <div class="errorMessageContainer"></div>
      </div>
      <%= f.submit "Create List", class: 'button create-a-list w-button' %>
    <% end %>
  </div>
  <div class="modal-instruction-wrapper">
    <p class="modal-paragraph tips"> &nbsp;TIP: You can create a list based on "Custom segments". You can also send messaging campaigns to members of each list you create. Go to "List" tab on the left navigation to view and edit all your customer OR lead lists.</p>
  </div>
</div>
