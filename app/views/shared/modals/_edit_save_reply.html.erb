<div class="create-saved-reply-form-wrapper w-clearfix modal-background" id="new-saved-reply-div">
  <div class="content-sub-wrapper modal w-clearfix">
    <h4 class="modal-header welcome-dash-content-container-header">Edit Saved reply</h4>
    <%# added data and update-close-modals %>
    <a class="close-modal update-close-modals" data-parent ="edit-saved-reply-modal"></a>
  </div>
  <p class="modal-content-description">Edit saved replies to frequently asked questions so you can respond to you customers faster. Type '/' on your messaging dashboard to trigger a saved reply.</p>
  <div class="segment-modal underline-div"></div>
  <div class="saved-reply-form">
    <%= form_for(saved_reply,url: user_saved_replies_path(current_user, 12), :html => {class: 'save-reply-form', :id => "edit-save-reply-form", data: { name: 'email-form-8'}, method: :patch } ) do |f| %>
      <div class="form-group col-xs-6">
       <%= f.text_field :title, placeholder: 'Saved reply title', id: 'Edit-Saved-Reply-Title', class: 'form-control saved-reply text-field title-create w-input', data: { name: 'Saved Reply Title' } %>
     </div>

     <div class="form-group col-xs-6">
       <%= f.text_area :body, placeholder:'Start typing...', id: 'Edit-Saved-Replies-Editor',
       class: 'form-control create saved-reply text-area w-input', data: { name: 'Saved-Replies-Editor-3'} %>
     </div>

    <%= f.button "Save", class: 'button send-saved-reply w-button', id: 'send-saved-reply' %>

    <%= f.button "Cancel", id: 'saved-reply-cancel', class: "button cancel-saved-reply w-button update-close-modals", data: { parent: 'edit-saved-reply-modal'} %>

    <%end%>
  </div>
</div>
