<div class="container">
  <div class="row">
    <div class="col-sm-6 col-md-4 col-md-offset-4">
      <h1 class="text-center login-title">Sign in to Rhombus </h1>
      <div class="account-wall">
        <img class="profile-img" src="https://www.getrhombus.com/assets/imgo-252069578bf9441f8f0cf59bc8660170.jpg"
          alt="">
        <%= form_tag redirect_path(redirect_uri: @params['redirect_uri'], account_linking_token: @params['account_linking_token']), :method => :post, id: 'user_login_form', class: 'form-signin' do %>
        <p>
          <%= label_tag :email, 'Email' %><br />
          <%= text_field_tag :email, params[:email], type:'email', required: true, class: 'form-control' %>
        </p>
        <p>
          <%= label_tag :password %><br />
          <%= password_field_tag :password, params[:password], type: 'password', class: 'form-control', 
            required: true %>
        </p>
        <p><%= button_tag 'Log In', class: 'btn btn-primary btn-block', data: { disable_with: "<i class='fa fa-spinner fa-pulse fa-fw'></i>Logging In...".html_safe } %></p>
        <% end %>
      </div>
      <br>
      <div class="pull-right">
        <%= link_to signup_path, id: 'signup', target: '_blank', onClick: 'javascript:window.close()' do%>
        <i class='fa fa-sign-in' aria-hidden='true'>Sign Up</i>
      </div>
      <%end%>
    </div>
  </div>
</div>
