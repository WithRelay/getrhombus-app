<div class="container">

  <h1>Log In to Rhombus</h1>
  <%= form_tag redirect_path(redirect_uri: @params['redirect_uri'], account_linking_token: @params['account_linking_token']), :method => :post, 
      id: 'user_login_form' do %>
    <p>
      <%= label_tag :email, 'Email' %><br />
      <%= text_field_tag :email, params[:email], type:'email', required: true %>
    </p>
    <p>
      <%= label_tag :password %><br />
      <%= password_field_tag :password, params[:password], type: 'password', 
            required: true %>
    </p>
    <p><%= submit_tag 'Log In', class: 'btn btn-primary', data: { disable_with: "Please wait..." } %></p>
  <% end %>
  <br>
  <p> Sign up to Rhombus: </p>
  <%= link_to signup_path, id: 'signup', target: '_blank', onClick: 'javascript:window.close()' do%>
    <i class='fa fa-sign-in' aria-hidden='true'>Sign Up</i>
  <%end%>

</div>