<div class="blank-page-content-wrapper loading reset-password">
  <div class="onboarding-form-div sign-in">
    <a class="form-logo w-inline-block" href="#"><img src="assets/Relay-Transparent-500x300.png" width="50">
    </a>
    <div class="log-in-form w-form">
      <%= form_tag redirect_path(redirect_uri: @params['redirect_uri'], account_linking_token: @params['account_linking_token']), :method => :post, id: '', class: 'w-clearfix' do %>
        <%= email_field_tag :email, params[:email], type:'email', class: 'email-address text-field w-input', placeholder: 'Email address' %>
        <%= password_field_tag :password, params[:password], type: 'password', class: 'login password text-field w-input', placeholder: 'Password' %>
        <%= submit_tag 'Log In', class: 'button log-in w-button' %>
      <% end %>
    </div>
    <div class="login-form-row w-row">
      <div class="log-in-form-row-column-1 w-col w-col-6">
        <div class="w-form">
          <form data-name="Email Form 2" id="email-form-2" name="email-form-2">
            <div class="footer-cta form-check-box login-form w-checkbox">
              <input class="w-checkbox-input" data-name="Checkbox 4" id="checkbox-4" name="checkbox-4" type="checkbox">
              <label class="w-form-label" for="checkbox-4">Remember me</label>
            </div>
          </form>
        </div>
      </div>
      <div class="log-in-form-row-column-2 w-clearfix w-col w-col-6"><a class="links login-form-password-reset" href="#">Forgot your password?</a>
      </div>
    </div>
  </div>
  <div class="log-in-sign-up-cta">Don't have a Rhombus account?
    <%= link_to new_user_registration_path(referrer_uid: @referrer, value: @params), id: 'signup', class: 'links sign-up-cta-log-in-page', target: '_blank', onClick: 'javascript:window.close()' do%>
      Sign up
    <%end%>
  </div>
</div>
