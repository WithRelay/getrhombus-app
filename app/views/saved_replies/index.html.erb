<div class="dashboard-body">
  <div class="saved-replies-wrapper">
    <div class="content-sub-wrapper">
      <h4 class="welcome-dash-content-container-header">Saved Replies</h4>
    </div>
    <div class="saved-replies-table w-row">
      <div class="soved-reply-column w-col w-col-5">
        <% if @saved_replies.present? %>
          <% @saved_replies.each do |reply| %>
            <%= link_to class: 'saved-reply-row-wrapper w-inline-block' do %>
              <div class="saved-reply-row">
                <div class="saved-reply-title"><%= reply.title %></div>
              </div>
            <% end %>
          <% end %>
          <% else %>

           You don't have any saved replies

        <% end %>
      </div>
      <div class="saved-reply-editor w-clearfix w-col w-col-7">
        <%= render partial: 'form', locals: { saved_reply: @saved_replies.first } %>
      </div>
    </div>
  </div>
</div>
<%= link_to 'New Saved Reply', new_user_saved_reply_path %>
