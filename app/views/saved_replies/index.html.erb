
<div class="customer-dash sub-nav-bar">

  <div class='modal-background w-hidden modal-body new-saved-reply' id ='new-saved-reply' >
    <%= render partial: 'shared/modals/save_reply', locals: { saved_reply: SavedReply.new }  %>
  </div>

  <div class='modal-background w-hidden modal-body edit-saved-reply' id = 'edit-saved-reply-modal'>
    <%= render partial: 'shared/modals/edit_save_reply', locals: { saved_reply: SavedReply.new }  %>
  </div>

  <div class="sub-nav-options-wrapper w-clearfix">
      <a class="saved-replies sub-nav-button w-button modal-loader" href="#" modal-target= "new-saved-reply"><strong> &nbsp; Create new saved reply</strong></a>
      <a class="saved-replies sub-nav-button w-button" href="#" modal-target= "edit-saved-reply" id = "edit-saved-reply" > &nbsp;<strong>Edit</strong></a>
      <a class="sub-nav-button w-button" data-ix="create-list"  id= "delete-saved-reply" href="#"> &nbsp;<strong>Delete</strong></a>
  </div>
</div>
<div class="dashboard-body">
  <div class="saved-reply-table-wrapper">

    <div class="header new-table-row w-row">
      <div class="cn w-clearfix w-col w-col-4">
        <div class="header name w-clearfix">
          <div class="heading table-text">&nbsp;&nbsp;&nbsp;Created by</div>
        </div>

      </div>
      <div class="fv w-clearfix w-col w-col-4">
        <div class="cn column column-2 header w-clearfix">
          <div class="heading table-text">&nbsp;&nbsp;&nbsp;Title</div>
        </div>
      </div>
      <div class="lv w-clearfix w-col w-col-4">
        <div class="colum-3 column header lv w-clearfix">
          <div class="heading saved-reply-date-created-header table-text">&nbsp;&nbsp;&nbsp;Date created</div>
        </div>
      </div>
    </div>

    <% @saved_replies.each do |reply| %>
      <div class="new-table-row saved-replies w-row">
        <div class="cn w-clearfix w-col w-col-4">
          <div class="name saved-reply-author w-clearfix"><%= present(reply).profile_image %>
            <div class="shrink-text table-text"><%="#{current_user.full_name}"%></div>
          </div>
          <div class="cb check-box-column">
            <div class="w-form">
              <%= form_for(reply, url: user_saved_reply_path(current_user, reply), html: { method: :delete } ) do |f| %>
                <div class="select-all-check-box w-checkbox w-clearfix">
                  <%= f.hidden_field :id %>
                  <input class="cb table-checkbox checkboxes w-checkbox-input" id="node" type="checkbox">
                  <label class="checkbox-field-lable w-form-label" for="node">-</label>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <div class="fv w-clearfix w-col w-col-4">
          <div class="cn column column-2 w-clearfi">
            <div class="table-text shrink-text">
            <%= reply.title %></div>
          </div>
        </div>
        <div class="lv w-clearfix w-col w-col-4">
          <div class="colum-3 column lv">
            <div class="shrink-text table-text"><%= present(reply).date_in_word %></div>
          </div>
        </div>
      </div>
    <% end %>

  </div>
</div>
