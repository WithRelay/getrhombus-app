<div class = 'container' >
  <% if @saved_replies.present? %>
    <h1>Saved Replies</h1>

    <table class="table table-condensed table-hover table-bordered">
      <tr>
        <th>Title</th>    
      </tr>

      <% @saved_replies.each do |reply| %>
        <tr>
          <td id="saved-reply-title-<%= reply.id %>" class='saved-reply-title'><%= reply.title %></td>
          <div id="saved-reply-body-<%= reply.id %>" style='display: none;'><%= reply.body %></div>
        </tr>
      <% end %>
    </table>
    <br> 
    
    <%= render partial: 'form', locals: { saved_reply: @saved_replies.first } %>

  <% else %>
   
   You don't have any saved replies

  <% end %>
  <br>
  <%= link_to 'New Saved Reply', new_user_saved_reply_path %>
</div>
