<div class="customer-dash sub-nav-bar">
  <div class="sub-nav-options-wrapper w-clearfix">
    <a class="saved-replies sub-nav-button w-button" href="#"><strong> &nbsp; Create new saved replies</strong></a>
  </div>
</div>
<div class="dashboard-body">
    <div class="saved-replies-alt-wrapper w-row">
      <div class="w-col w-col-6">
        <div class="replies-list saved-replies-wrapper">
          <div class="content-sub-wrapper">
            <h4 class="welcome-dash-content-container-header">Saved Replies</h4>
          </div>
          <% @saved_replies.each do |reply| %>

            <div class="new-table-row saved-replies w-row">

              <div class="cn w-clearfix w-col w-col-4">
                <%= button_to reply.title, v1_saved_replies_edit_path, form: { id: 'saved-reply-form', class: 'w-hidden' } %>

                <div class="saved-reply-title" id="saved-reply-edit-<%= reply.id %>"><%= reply.title%></div>
            
                <div class="cb check-box-column"></div>
              </div>
              <div class="fv w-clearfix w-col w-col-4">
                <div class="cn column column-2 w-clearfix">
                  <div class="shrink-text table-text"><%= reply.body %></div>
                </div>
              </div>
              <div class="lv w-clearfix w-col w-col-4">
                <div class="colum-3 column lv">
                  <div class="table-text"><em>Created</em> <em>1 week ago</em>
                  </div>
                </div>
              </div>
            </div>
            <% end %>
        </div>
      </div>
      <div class="w-col w-col-6">
        <div class="reply-editor saved-replies-wrapper w-clearfix">
          <div class="content-sub-wrapper">
            <h4 class="welcome-dash-content-container-header">Edit</h4>
          </div>
          <div class="saved-reply-form w-form">
            <%= render partial: 'form', locals: { saved_reply: @saved_replies.first } %>
            <div class="w-form-done">
              <div>Thank you! Your submission has been received!</div>
            </div>
            <div class="w-form-fail">
              <div>Oops! Something went wrong while submitting the form</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
