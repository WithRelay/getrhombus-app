<div class="customer-dash sub-nav-bar w-clearfix">
  <a class="add sub-nav-button w-button modal-loader" href="#"> &nbsp;<strong>Set a new Reply</strong></a>
</div>
<div class="dashboard-body">
  <div class="blank-page-container w-container">
    <%= image_tag('020_200.png', class: 'blank-page-icon') %>
    <h1 class="empty-state-dash hero-h1 home-header">You have no records for <br>SavedReplies</h1>
    <div class='modal-background w-hidden modal-body new-saved-reply' id ='new-saved-reply' >
      <%= render partial: 'shared/modals/save_reply', locals: { saved_reply: SavedReply.new }  %>
    </div>
    <%= button_tag 'Set New SavedReply', class: 'button error-page-button w-button modal-loader', 'data-ix' => "schedule-notification" %>
  </div>
</div>
