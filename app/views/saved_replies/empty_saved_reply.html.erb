<div class="customer-dash sub-nav-bar w-clearfix">
  <%= link_to user_path(current_user) , class: 'dashboard-return sub-nav-button w-button' do %>
   &nbsp;Return to dashboard
  <% end %>
</div>
<div class="dashboard-body">
  <div class="blank-page-container w-container">
    <%= image_tag('019_066.png', class: 'blank-page-icon') %>
    <h1 class="empty-state-dash hero-h1 home-header">You have no saved replies</h1>
    <div class='modal-background w-hidden modal-body new-saved-reply' id ='new-saved-reply' >
      <%= render partial: 'shared/modals/save_reply', locals: { saved_reply: SavedReply.new }  %>
    </div>
    <%= button_tag 'Create saved reply', class: 'button error-page-button w-button modal-loader', 'data-ix' => "schedule-notification" %>
  </div>
</div>
