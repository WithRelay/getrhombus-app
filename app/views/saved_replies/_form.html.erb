  <%= form_for(saved_reply, url: v1_saved_replies_update_path, :html => { :id => "saved-reply-edit-new", data: { name: 'Email Form 8' } } ) do |f| %>
    <%= f.text_field :title, placeholder: 'Saved reply title', id: 'saved-reply-title-field', class: 'saved-reply text-field w-input', data: { name: 'Saved Reply Title' } %>
    <%= f.text_area :body, placeholder: 'Start typing...', id: 'saved-reply-body-field', class: 'saved-reply text-area w-input', data: {name: 'Saved Replies Editor'} %>

    <%= f.hidden_field :id, class: 'hidden-id-field' %>
    
    <%= f.button "Save", class: 'button save-reply-button w-button' , id: 'save-reply-button' %>
    <% if action_name == 'index' %>
      <%= link_to 'Delete', [current_user, saved_reply],  method: :delete, id: 'delete-saved-reply', class: "button cancel-save-reply w-button" %>
      <%= f.button "Cancel", id: 'saved-reply-cancel', class: "button delete-saved-reply w-button
        " %>
    <% end %>
  <% end %>
  <div class="w-form-done">
    <div>Thank you! Your submission has been received!</div>
  </div>
  <div class="w-form-fail">
    <div>Oops! Something went wrong while submitting the form</div>
  </div>
