
<%= form_for([current_user, saved_reply], :html => { :id => "saved-reply-form" } ) do |f| %>

  <%= f.text_field :title, placeholder: 'Saved reply title', id: 'saved-reply-title-field' %>

  <br>
  <br>

  <%= f.text_area :body, placeholder: 'Start typing...', id: 'saved-reply-body-field' %>
  <br>
  <% if action_name == 'index' %>
  	<%= link_to 'Delete', [current_user, saved_reply],  method: :delete, id: 'delete-saved-reply', class: "btn btn-danger", data: { disable_with: "Please wait..." } %>
    <%= f.button "Cancel", id: 'saved-reply-cancel', class: "btn btn-default " %>
  <% end %>

  <%= f.submit "Save", class: "btn btn-primary  pull-right", data: { disable_with: "Please wait..." } %>

<% end %>
