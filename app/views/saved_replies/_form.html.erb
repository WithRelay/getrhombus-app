<%= form_for([current_user, saved_reply], :html => { :id => "saved-reply-form" } ) do |f| %>

  <%= f.text_field :title, placeholder: 'Saved reply title', id: 'saved-reply-title-field', class: 'col-xs-12' %>

  <br>
  <br>

  <%= f.text_area :body, placeholder: 'Start typing...', id: 'saved-reply-body-field', class: 'col-xs-12' %>

  <% if action_name == 'index' %>
    <%= link_to 'Delete', [current_user, saved_reply],  method: :delete, id: 'delete-saved-reply', class: "btn btn-danger", data: { disable_with: "<i class='fa fa-spinner fa-spin'></i>Please wait...".html_safe } %>
    <%= f.button "Cancel", id: 'saved-reply-cancel', class: "btn btn-default " %>
  <% end %>

  <%= f.button "Save", class: "btn btn-primary  pull-right", data: { disable_with: "<i class='fa fa-spinner fa-spin'></i>Please wait...".html_safe } %>

<% end %>
