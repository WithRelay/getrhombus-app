
<%= form_for([current_user, saved_reply], :html => { :id => "saved-reply-form" } ) do |f| %>

  <%= f.text_field :title, placeholder: 'Saved reply title', id: 'saved-reply-title-field' %>
  
  <br>
  <br>

  <%= f.text_area :body, placeholder: 'Start typing...', id: 'saved-reply-body-field' %>

  <% if action_name == 'index' %>
  	<%= link_to 'Destroy', [current_user, saved_reply],  method: :delete, id: 'delete-saved-reply' %>
  <% end %>

  <%= f.button "Cancel", id: 'saved-reply-cancel' %>
  <%= f.submit "Save", class: "btn btn-warning btn-small" %>

<% end %>
