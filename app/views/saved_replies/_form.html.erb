  <%= form_for(saved_reply, url: v1_saved_replies_update_path, :html => { :id => "saved-reply-edit-new" } ) do |f| %>
    <%= f.text_field :title, placeholder: 'Saved reply title', id: 'saved-reply-title-field', class: 'saved-reply text-field w-input' %>
    <%= f.text_area :body, placeholder: 'Start typing...', id: 'saved-reply-body-field', class: 'saved-reply text-area w-input' %>

    <%= f.hidden_field :id, class: 'hidden-id-field' %>
    
    <%= f.button "Save", class: 'button save-reply-button w-button' , id: 'save-reply-button' %>
    <% if action_name == 'index' %>
      <%= link_to 'Delete', [current_user, saved_reply],  method: :delete, id: 'delete-saved-reply', class: "button cancel-save-reply w-button" %>
      <%= f.button "Cancel", id: 'saved-reply-cancel', class: "button delete-saved-reply w-button
        " %>
    <% end %>
  <% end %>
