<!DOCTYPE html>
<html data-wf-site='55398a823ca1c17b4205500b' data-wf-page='55398a823ca1c17b4205500d'>
  <head>
    <meta charset='UTF-8'>
    <title><%= content_for?(:title) ? yield(:title) : 'Relay Platform' %></title>

    <!-- Meta Tags -->
    <meta name='description' content='Exchange real-time text messages, and accept payments from your customers – all within the conversation.'>
    <meta name='keywords' content='sms, conversational commerce, payments, text message, pay, chat, Make payments via text messages'>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!--  favicon -->
    <%= favicon_link_tag 'favicon.ico' %>

    <!--  CSS files -->
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track' => true  %>

    <!--  Js files -->
    <%= javascript_include_tag 'https://ajax.googleapis.com/ajax/libs/webfont/1.4.7/webfont.js' %>
    <script>
      WebFont.load( { google: { families: ["Lato:100,100italic,300,300italic,400,400italic,700,700italic,900,900italic",
                                           "Open Sans:300,300italic,400,400italic,600,600italic,700,700italic,800,800italic",
                                           "Montserrat:400,700","Nunito:300,regular,700","Alegreya Sans:100,300,regular,500,700",
                                           "Fira Sans:300,regular,500,700","Roboto:100,300,regular,500,700",
                                           "Raleway:100,200,300,regular,500,700","Lobster:regular","Lobster Two:regular,700",
                                           "Fira Sans:300,regular,500","Montserrat Alternates:regular"]}
                                         });
   </script>

    <%= javascript_include_tag 'https://js.stripe.com/v2/' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track' => true  %>
    <%= javascript_include_tag 'https://cdnjs.cloudflare.com/ajax/libs/danialfarid-angular-file-upload/12.2.12/ng-file-upload-all.min.js', integrity: 'sha256-ktd4ChVnmURgRrtZc6nd5lxjjbclQIE29x5Ex4I/76g', crossorigin: 'anonymous' %>
    <%= javascript_include_tag 'https://cdnjs.cloudflare.com/ajax/libs/angucomplete-alt/2.5.0/angucomplete-alt.min.js', integrity: 'sha256-vmEdXKZ4fjH96do5nyrOOJhzKIAq+uCzuzdcq3q/TfE=', crossorigin: 'anonymous' %>

    <%= csrf_meta_tags %>

  </head>

  <body class="<%= add_body_class %>" > <!-- needed for conversations page body -->
    <%= render_header_partial %>
    <%= render_sidebar_partial %>
    <%= yield %>
    <%= render_footer_partial %>
    <%= render 'shared/smooch' %>
    <%= render 'shared/google_analytics' %>
    <%= render 'shared/flash_messages' %>
  </body>


</html>
