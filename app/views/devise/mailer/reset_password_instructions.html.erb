<div class="html-email-wrapper"><img class="html-email-logo" src="images/Relay-Transparent-500x300.png" width="62">
  <div class="html-email-body-div">
    <h3 class="html-email-heading" style='color:red'>Reset password</h3>
    <p class="html-email-content-paragraph">Hi <%= @resource.first_name || 'there' %>,
      <br>
      <br>Let's help you reset your password. If you did not request this password reset, ignore this email, and check your account for any unusual activity.</p><%= link_to 'Reset password', edit_password_url(@resource, :reset_password_token => @token) %>
    <p class="html-email-content-paragraph">We're happy to help if necessary. You can visit the <a href="#" class="links">help center</a> to get more information or <a href="#" class="links">email us.</a>
      <br>
      <br>Thanks,
      <br>
      <br>Relay Team</p>
  </div>
  <div class="html-email-footer-row w-row">
    <div class="w-col w-col-2"><a class="footer-links html-email links" href="#">Unsubscribe</a>
    </div>
    <div class="w-col w-col-4"><a class="alt footer-links html-email links" href="#">Help</a>
    </div>
    <div class="w-col w-col-2"><a class="alt footer-links html-email links" href="#">Facebook</a>
    </div>
    <div class="w-col w-col-2"><a class="alt footer-links html-email links" href="#">LinkedIn</a>
    </div>
    <div class="w-col w-col-2"><a class="alt footer-links html-email links" href="#">Twitter</a>
    </div>
  </div>
  <div class="email-company-info">WITHRELAY Inc.: 151 Charles St W. suite 199, Kitchener ON N2G 1H6</div>
</div>
