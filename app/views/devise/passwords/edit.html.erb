
  <% provide(:title, 'Relay - Change Password') %>

<% flash[:error] = devise_error_messages! unless resource.errors.blank?%>
  
  <div class="blank-page-content-wrapper reset-password">
    <div class="onboarding-form-div sign-in signup">
      <%= link_to root_url, class: 'form-logo w-inline-block' do %>
        <%= image_tag('Relay-Transparent-500x300.png', width: 50, class: 'password-reset-logo') %>
      <% end %>    
      <div class="flex-underline form-header-underline"></div>
      <div class="password-reset-instructions">Change your password</div>
      <div class="log-in-form w-form">
      
      <%= form_for(resource, :as => resource_name, :url => password_path(resource_name), :html => { :method => :put, :id => 'changePasswordForm'}) do |f| %>

          <%= f.hidden_field :reset_password_token %>

          <div class="form-group col-xs-5">
          <%= f.password_field :password, :autofocus => true, :type => 'password', :class => " form-control reset-password text-field w-input", placeholder: "New password" %>
          </div>
          <div class="form-group col-xs-5">
            <%= f.password_field :password_confirmation, type: "password", :class => "form-control reset-password text-field w-input", placeholder: "Confirm password" %>
          </div>
          <%= f.submit "Reset Password",  :class => "button log-in w-button" %>

      <% end %>
        &nbsp;
      </div>
      </div>
      <div class="log-in-sign-up-cta" style= "text-align: center">Return to <%= link_to 'Log In.', new_user_session_url, class: 'links sign-up-cta-log-in-page' %> 
    </div>
    </div>

<%#= render "devise/shared/links" %>
