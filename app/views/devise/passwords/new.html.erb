 <% provide(:title, 'Rhombus - Reset Password') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>
  <!-- ========== Css Files ========== -->
  
  <style type="text/css">
    body{background: #F5F5F5;}
  </style>
  <body>

  <%= devise_error_messages! %>
  <%= render 'shared/full_messages' %>

  <div class="login-form">
    <%= form_for(resource, :as => resource_name, :url => password_path(resource_name), :html => { :method => :post, :id => 'ForgotPassword' }) do |f| %>
        <div class="top">
        <img src="<%= asset_path 'logo_grey.jpg' %>" alt="icon" id="signup_logo" class="icon">
          <h4>You can reset your password</h4>
        </div>
        <div class="form-area">
          <div class="group">
          <%= f.email_field :email, :class => "form-control rhombusFocus", type: "email", placeholder: "Email", :autofocus => true %>
            <i class="fa fa-envelope-o"></i>
          </div>
          <%= f.submit "RESET PASSWORD",  :class => "btn btn-default btn-block btn-rhombus" %>
        </div>
      <% end %>
      <div class="footer-links row">
        <div class="col-xs-6"><a href="/signin"><i class="fa fa-sign-in"></i> Login</a></div>
        <div class="col-xs-6 text-right"><a href="/signup"><i class="fa fa-external-link"></i> Register Now</a></div>
      </div>
    </div>

</body>
</html>
 

<%#= render "devise/shared/links" %>

<%#= form_for(resource, :as => resource_name, :url => password_path(resource_name), :html => { :method => :post }) do |f| %>
  

  <%#= f.label :email %>
  <%#= f.email_field :email, :autofocus => true %>

  <%#= f.submit "Send me reset password instructions" %>
<%# end %>