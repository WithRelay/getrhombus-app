<% provide(:title, 'Rhombus - Reset password') %>




<%= content_for :head do %>
  <%#= stylesheet_link_tag "style.css", "data-turbolinks-track" => true %>
  <%#= stylesheet_link_tag "responsive.css", "data-turbolinks-track" => true %>
  <%#= stylesheet_link_tag "magic_space.css", "data-turbolinks-track" => true %>
  <%#= stylesheet_link_tag "custom-icon-set.css", "data-turbolinks-track" => true %>
  <%= stylesheet_link_tag "forms.css", "data-turbolinks-track" => true %>
<% end %>


<%= render 'shared/header' %>

<body class="error-body no-top lazy" style="background-image: url('/assets/bg.jpg')"> 
  

  <%= devise_error_messages! %>
<div class="container">
  <div class="row login-container animated fadeInUp">  
        <div class="col-md-7 col-md-offset-2 tiles white no-padding">
		 <div class="p-t-30 p-l-40 p-b-20 xs-p-t-10 xs-p-l-10 xs-p-b-10"> 
          <h3 class="normal">Reset Rhombus password</h3>	  
        </div>
		<div class="tiles grey p-t-20 p-b-20 text-black">
			<%# <form id="frm_login" class="animated fadeIn">  %>
	<%= form_for(resource, :as => resource_name, :url => password_path(resource_name), :html => { :method => :post }) do |f| %>
                    <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">

                      <div class="col-md-6 col-sm-6 ">                    
                        <%= f.email_field :email, :class => "form-control", placeholder: "Email", :autofocus => true %>
                      </div>

                         <div class="col-md-6 col-sm-6">
             <%# </form> %> <%= f.submit "Reset password",  :class => "btn btn-primary btn-cons btn-block"  %>

                    </div>
                    </div>
                 <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                        <div class="col-md-12">
                          <p><a href="/signin">Back to Sign in</a></p>
                      </div>
                    </div>  
                    
  			<% end %>
			
		</div>   
      </div>   
  </div>
</div>

</body>

 

<%#= render "devise/shared/links" %>

<%#= form_for(resource, :as => resource_name, :url => password_path(resource_name), :html => { :method => :post }) do |f| %>
  

  <%#= f.label :email %>
  <%#= f.email_field :email, :autofocus => true %>

  <%#= f.submit "Send me reset password instructions" %>
<%# end %>