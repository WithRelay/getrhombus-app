 <% provide(:title, 'Relay - Reset Password') %>

<% flash[:error] = devise_error_messages! unless resource.errors.blank? %>

  <div class="blank-page-content-wrapper reset-password">
    <div class="onboarding-form-div sign-in signup">
      <%= link_to root_url, class: 'form-logo w-inline-block' do %>
        <%= image_tag('Relay-Transparent-500x300.png', width: 50, class: 'password-reset-logo') %>
      <% end %>
      <div class="flex-underline form-header-underline"></div>
      <div class="password-reset-instructions">Enter your email address below and we'll send you a link to reset your password.</div>
      <div class="log-in-form">
        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, id: 'ForgotPassword', class: 'w-clearfix', data: { name: "Email Form" } }) do |f| %>
           <div class="form-group col-xs-6">
             <%= f.email_field :email, placeholder: "Email", autofocus: true, class: 'form-control email-address reset-password text-field w-input', data: { name: "Email" } %>
             <div class='messageContainer'></div>
          </div>
          <%= f.submit "RESET PASSWORD", class: "button log-in w-button", value: "Send reset password email", data: { wait: "Please wait..." } %>
        <% end %>
      </div>
    </div>
  </div>
