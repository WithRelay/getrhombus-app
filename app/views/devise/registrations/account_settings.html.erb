<!-- Title for header -->
<% provide(:title, 'Rhombus - Merchant Profile') %>
<!-- the css is page specific because some pages have different ui for phone number field -->
<div class="settings sub-nav-bar w-clearfix">
  <%= link_to user_path(current_user) , class: 'dashboard-return sub-nav-button w-button' do %>
   &nbsp;Return to dashboard
  <% end %>
</div>
<div class="dashboard-body settings w-clearfix">
  <div class="dash-content-container settings w-clearfix" id="account-settings">
    <h4 class="form-header">Account Information</h4>
    <div class="flex-underline form-header-underline"></div>
    <%= form_for(current_user, as: resource_name, url: registration_update_user_path(resource_name), html: { method: :patch, id: "account-settings-form", class: "form-horizontal rhombusFocus" }) do |f| %>
    <div class="account-settings-form-wrapper">

      <label class="field-headers form-label settings" for="name">Basic details</label>
      <div class="company-rep-div w-clearfix">
        <% if current_user.is_merchant? %>

          <%= f.fields_for :people do |f| %>
            <div class="form-group">
              <%= f.text_field :full_name, class: 'form-control full-name settings text-field w-input', placeholder: 'Full name' %>
            </div>
          <% end %>
          <%= f.hidden_field :org_phone, id: "phone_number" %>

        <% else %>

            <%= f.hidden_field :phone_number, id: "phone_number" %>

        <% end %>
        <div class="form-group">
          <%= f.phone_field :phone, id: "phone", class: "form-control password settings text-field w-input" %>
        </div>
        <input type="hidden" name="page_params" value="account_settings">
      </div>


      <div class="update-email-password-div w-clearfix">
        <div class="flex-underline form-section-divider"></div>
        <label class="field-headers form-label settings" for="email">update email/password</label>
        <div class="form-group">
          <%= f.email_field :email, type: "email", id: "email", placeholder: "Email", class: "form-control settings text-field w-input" %>
        </div>
        <div class="form-group">
          <%= f.password_field :current_password, type: 'password', class: 'form-control full-name settings text-field w-input', placeholder: "Current Password" %>
        </div>
        <div class="form-group">
          <%= f.password_field :password, type: "password", id: "newPassword", placeholder: "Enter new password", class: "form-control password settings text-field w-input" %>
        </div>
        <div class="form-group">
          <%= f.password_field :password_confirmation, id: "confirmNewPassword", type: "password", placeholder: "Confirm new password", class: "form-control confirm password settings text-field w-input" %>
        </div>
      </div>

  </div>
  <%= f.submit "Save changes", id: "ba-submit", class: "btn-rhombus button save-changes w-button" %>
  <a class="button deactivate w-button" href="#">Deactivate/Pause Account</a>
  <% end %>
</div>
</div>
