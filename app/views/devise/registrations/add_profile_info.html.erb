<div class="w-row">
  <div class="onboarding-table-column-1 w-col w-col-8">
    <div class="onboarding-form-section">
      <div class="get-started-2 onboarding-form-div sign-in signup">
        <h4 class="form-header">Business Information</h4>
        <div class="flex-underline form-header-underline"></div>
        <div class="get-started-2 log-in-form w-form">

          <%= form_for(@user, as: resource_name, url: registration_update_user_path(@user), html: { method: :patch, class: "w-clearfix rhombusFocus", id: 'add-profile-info' }) do |f| %>

            <%= f.fields_for :people do |f| %>
              <%= f.text_field :full_name, class: 'login text-field w-input', placeholder: 'Full name' %>
            <% end %>

            <%= f.text_field :org_name, class: 'login text-field w-input', placeholder: 'Business name' %>

            <label class="form-label" for="Company-Size-2">Team size</label>
            <%= f.select :team_size, select_team_size, {}, class: 'form-control dropdown w-select' %>

            <label class="form-label" for="Department-2">We'd like to use Rhombus for:</label>
            <%= f.select :use_rhombus_for, rhombus_for, {}, class: 'form-control dropdown w-select' %>

            <label class="form-label" for="Org-Type-2">Organization type</label>
            <%= f.select :org_type, business_type_list, {}, class: 'form-control dropdown w-select' %>

            <label class="form-label" for="Timezones-3">Set Timezone:</label>
            <%= f.select :time_zone, get_time_zone_lists, {}, class: 'form-control dropdown w-select' %>

            <input type="hidden" name="add_profile_info" value="true">
            <input class="button log-in w-button" type="submit" value="Continue">

          <% end %>

        </div>
      </div>
    </div>
  </div>
  <div class="onboarding-table-column-2 w-col w-col-4">
    <div class="onboarding-right-bar">
      <div class="w-container whats-new-container">
        <div class="whats-new-content-wrapper">
          <h4 class="onboarding-side-bar-h4">get started: step 2</h4>
          <h3 class="onboarding-side-bar-h3">Welcome to Relay</h3>
          <p class="onboarding-side-bar-paragraph">Thanks for choosing us to handle your customer communications via SMS and Messenger.</p>
          <p class="onboarding-side-bar-paragraph">To help setup your dashboard, tell us more about your business</p>
          <div class="left-arrow"></div>
        </div>
      </div>
    </div>
  </div>
</div>
