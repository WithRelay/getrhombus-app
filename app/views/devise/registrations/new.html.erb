<% provide(:title, 'Rhombus - Sign Up') %>

<div class="w-row">
  <div class="onboarding-table-column-1 w-col w-col-8">
    <div class="onboarding-form-section">
      <div class="onboarding-form-div sign-in signup">
        <%= link_to root_url, class: 'form-logo w-inline-block' do %>
          <%= image_tag('relay-4.png', width: 50) %>
        <% end %>
        <div class="log-in-form w-form">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name, params[:value]), html: { id: 'signupForm frm_register email-form', class: 'w-clearfix', data: { name: 'Email Form' }} ) do |f| %>
            <%= f.email_field :email, id: "email Email-2", class: "form-control rhombusFocus login text-field w-input", placeholder: "Email address", data: { name:'Email' }, max_length: 100 %>
            <%= f.password_field :password, class: "form-control rhombusFocus login text-field w-input", placeholder: "Password", id: 'Password-3' %>
            <%= f.select :user_level, "<option value='' disabled selected class='hide'>Account Type</option> <option value='0'>Business Account</option><option value='1'>Customer Account</option>".html_safe, {}, class: 'dropdown w-select', data: { name:'Field 2'}, id: 'field-2' %>
            <%= f.phone_field :phone, id: "phone", class: "login text-field w-input form-control rhombusFocus", placeholder: 'Mobile number', data: { name: 'Phone'} %>
            <%= f.submit "SIGN UP", class: "button log-in w-button", value: 'continue', data: { wait: 'Please wait...' } %>
          <% end %>
          <div class="w-form-done">
            <div>Thank you! Your submission has been received!</div>
          </div>
          <div class="w-form-fail">
            <div>Oops! Something went wrong while submitting the form</div>
          </div>
        </div>
        <div class="log-in-sign-up-cta">Already have a Rhombus account? <a class="links sign-up-cta-log-in-page" href="/users/sign_in">Sign in.</a>
        </div>
      </div>
      <div class="forgot-password links">By continuing, I agree to Rhombus' Terms and Privacy Policy</div>
    </div>
  </div>
  <div class="onboarding-table-column-2 w-col w-col-4">
    <div class="onboarding-right-bar">
      <div class="w-container whats-new-container">
        <div class="whats-new-content-wrapper">
          <h4 class="onboarding-side-bar-h4">get started: step 1</h4>
          <h3 class="onboarding-side-bar-h3">Let's create your account in 3 simple steps.</h3>
          <p class="onboarding-side-bar-paragraph">Relay business account is free for 14-days. Take it for a spin with no commitments or long-term contracts.</p>
          <p class="onboarding-side-bar-paragraph">Customer accounts are free forever.</p>
          <div class="left-arrow"></div>
        </div>
      </div>
    </div>
  </div>
</div>



