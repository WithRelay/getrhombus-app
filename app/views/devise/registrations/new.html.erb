    <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Sign Up') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>
<style type="text/css">
    body{background: #F5F5F5;}
  </style>

<body> 

    <%= devise_error_messages! %>
    <%= render 'shared/full_messages' %>
    
    <div class="login-form">
    <%= form_for(resource, :id => "frm_register", :as => resource_name, :url => registration_path(resource_name), :html=> {:id => 'signupForm'} ) do |f| %>
        <div class="top">
          <img src="<%= asset_path 'logo_grey.jpg' %>" alt="icon" id="signup_logo" class="icon">
          <h4>Create an account.</h4>
        </div>
        <div class="form-area">
          <div class="group">
          <%= f.email_field :email, id: "email", type: "email", :class => "form-control rhombusFocus", placeholder: "E-mail" %>
            <i class="fa fa-envelope-o"></i>
          </div>
          <div class="group phonegroup">
            <%= f.hidden_field :phone_number, :id => "phoneNumber" %>
            <%= f.phone_field :phone, :id => "phone", class: "form-control rhombusFocus" %>

            <%= f.hidden_field :referrer_num, :id => "referrer_num" %>
            <%= f.hidden_field :subscription_type, :id => "subscription_type" %>
            <%#<input type="tel" id="phone" name="phone" class="form-control rhombusFocus">%>
          </div>
          <div class="group">
           <%= f.password_field :password, type: "password", :class => "form-control rhombusFocus", placeholder: "Password" %>
            <i class="fa fa-key"></i>
          </div>
          <div class="group">
          <%= f.password_field :password_confirmation, type: "password", :class => "form-control rhombusFocus", placeholder: "Confirm Password" %>
            <i class="fa fa-key"></i>
          </div>
          <div class="form-group accountTypegroup"> 
            <%= f.select :user_level, "<option value='' disabled selected class='hide'>Please select account type</option> <option value='0'>I'm a customer</option><option value='1'>I'm a merchant</option><option value='1'>I'm a non-profit</option>".html_safe, {}, :class => 'selectpicker rhombusFocus' %>
          </div>  

          <%= f.submit "SIGN UP", :class => "btn btn-default btn-block btn-rhombus" %>
          <p id="termsNote">By signing up, I agree to Rhombus <a href="/terms">terms and conditions.</a></p>
        

        </div>
      <% end %>
      <div class="footer-links row">
        <div class="col-xs-6"><a href="/signin"><i class="fa fa-sign-in"></i> Login</a></div>
        <div class="col-xs-6 text-right"><a href="/users/password/new"><i class="fa fa-lock"></i> Forgot password</a></div>
        <div class="col-md-12 hide" id="rhombusPower"><img src="<%= asset_path 'poweredbyR.jpg' %>" style="width: 140px; margin: 20px auto;"></div>
      </div>
    </div>

</body>
</html>

<%#= form_for(resource, :as => resource_name, :url => registration_path(resource_name)) do |f| %>

  <%#= f.label :phone_number %>
  <%#= f.text_field :phone_number, :id => "num" %>

  <%#= f.label :email %>
  <%#= f.email_field :email, :autofocus => true %>

  <%#= f.label :password %>
  <%#= f.password_field :password %>

  <%#= f.label :password_confirmation %>
  <%#= f.password_field :password_confirmation %>

  <%#= f.submit "Sign up" %>
<%# end %>

<%#= render "devise/shared/links" %>