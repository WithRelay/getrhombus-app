<% provide(:title, 'Rhombus - Sign up') %>

<%= content_for :head do %>
  <%= stylesheet_link_tag "forms.css" %>
<% end %>  
<body class="error-body no-top lazy"> 

    <%= devise_error_messages! %>
    <%= render 'shared/full_messages' %>


<div class="container">
  <div class="row login-container animated fadeInUp">  
        <div class="col-md-7 col-md-offset-2 tiles white no-padding">
     <div class="p-t-30 p-l-40 p-b-20 xs-p-t-10 xs-p-l-10 xs-p-b-10"> 
          <h3 class="normal">Create your Rhombus account</h3>
        </div>
    <div class="tiles grey p-t-20 p-b-20 text-black">
        <%#<form id="frm_register">%>

        <%= form_for(resource, :id => "frm_register", :as => resource_name, :url => registration_path(resource_name)) do |f| %>

                    <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                      <div class="col-md-6 col-sm-6">   
                        
                        <%= f.email_field :email, id: "reg_email", type: "text", :class => "form-control", placeholder: "Email", :autofocus => true %>

                      </div>
                      <div class="col-md-6 col-sm-6">                       
                        
                          <%= f.text_field :phone_number, :id => "num", :class => "form-control", placeholder: "Ex. <redacted_phone_number>", type: "text" %>

                      </div>
                    </div>  
                    
                    <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">

                      <div class="col-md-6 col-sm-6">                        
                        <%= f.password_field :password, id: "reg_pass", type: "password", :class => "form-control", placeholder: "Password" %>
                      </div>

                      <div class="col-md-6 col-sm-6">

                      <%= f.password_field :password_confirmation, id: "reg_first_Name", type: "password", :class => "form-control", placeholder: "Confirm Password" %>
                      </div>
                    </div>  

                    <div class="row p-t-10 m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
          <div class="control-group  col-md-12">
                 <div class="radio radio-primary for_radio">
                        
                       <%= f.radio_button :user_level, '0', id: "radio1", type: "radio" %>
                        <label for="radio1">I want to send payments</label>
                        <br>
                        <%= f.radio_button :user_level, '1', id: "radio2", type: "radio" %>
                        <label for="radio2">I want to receive payments (merchants)</label>
                      </div>
          </div>
        </div>

  <div class="row">
                    <div class="col-md-12">
            
                    </div>
                  </div>


                    <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                        <div class="col-md-12" style="margin-top: 7px;">
                          <%= f.submit "Sign up", :class => "btn btn-primary btn-cons" %> <p></p> <p>By signing up I agree to Rhombus <a href="#">terms and conditions</a>.</p>
                      </div>
                    </div>  

      <%#</form>%><% end %>
    </div>   
      </div>   
  </div>
</div>


</body>

<%#= form_for(resource, :as => resource_name, :url => registration_path(resource_name)) do |f| %>

  <%#= f.label :phone_number %>
  <%#= f.text_field :phone_number, :id => "num" %>

  <%#= f.label :email %>
  <%#= f.email_field :email, :autofocus => true %>

  <%#= f.label :password %>
  <%#= f.password_field :password %>

  <%#= f.label :password_confirmation %>
  <%#= f.password_field :password_confirmation %>

  <%#= f.submit "Sign up" %>
<%# end %>

<%#= render "devise/shared/links" %>