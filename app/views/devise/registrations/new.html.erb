<% provide(:title, 'Relay - Sign Up') %>

<div class="w-row">
  <div class="onboarding-table-column-1 w-col w-col-8">
    <div class="onboarding-form-section">

      <div class="onboarding-form-div sign-in signup">
        <%= link_to root_url, class: 'form-logo w-inline-block', id: 'signup-logo' do %>
          <%= image_tag('Relay-Transparent-500x300.png', width: 50) %>
        <% end %>
        <div id="signup-referrer-name" class="hide">ssss</div>

        <div class="log-in-form">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name, params[:value]), html: { id: 'signupForm', class: 'w-clearfix' } ) do |f| %>

            <div class="form-group col-xs-5">
              <%= f.email_field :email, id: "email", class: "form-control email-address text-field w-input", placeholder: "Email address", autofocus: true %>
            </div>

            <div class="form-group col-xs-6">
              <%= f.phone_field :phone, id: "phone", class: "form-control login phone text-field w-input", placeholder: 'Mobile number' %>
              <%= f.hidden_field :phone_number, :id => "phone_number" %>
            </div>

            <%= f.hidden_field :referrer, id: "referrer", value: params[:user] ? params[:user][:referrer] : '' %>
            <%= f.hidden_field :captured_amt, id: "captured_amt", value: params[:user] ? params[:user][:captured_amt] : '' %>
            <%= f.hidden_field :referrer_uid, id: "referrer_uid", value: params[:user] ? params[:user][:referrer_uid] : '' %>            
            <%= f.hidden_field :page_specific_id, id: "page_specific_id", value: params[:user] ? params[:user][:page_specific_id] : '' %>
            <%= f.hidden_field :msg_id, id: "msg_id", value: params[:user] ? params[:user][:msg_id] : '' %>
            <%= f.hidden_field :channel, id: "channel", value: params[:user] ? params[:user][:channel] : '' %>

            <div class="form-group col-xs-5">
              <%= f.select :user_level, "<option value='' disabled selected class='hide'>Account Type</option> <option value='1'>Business Account</option><option value='0'>Customer Account</option>".html_safe, {}, class: 'form-control dropdown w-select margin-15', id: 'user-level' %>
            </div>

            <div class="form-group col-xs-5">
              <%= f.password_field :password, class: "form-control login password text-field w-input", placeholder: "Password", id: 'Password-3' %>
            </div>

            <%= f.submit "SIGN UP", class: "button log-in w-button", value: 'Continue' %>
        <% end %>
        </div>

        <div class="log-in-sign-up-cta">Already have a Relay account? <a class="links sign-up-cta-log-in-page" href="/users/sign_in">Sign in.</a>
        </div>

      </div>

      <div class="forgot-password links">By continuing, I agree to Relay' <span class="terms-link"><a href="/privacy" class="terms-link">Terms and Privacy Policy</a></span>
      </div>

    </div>
  </div>

  <div class="onboarding-table-column-2 w-col w-col-4">
    <div class="onboarding-right-bar">
      <div class="w-container whats-new-container">
        <div class="whats-new-content-wrapper">
          <h4 class="onboarding-side-bar-h4">get started: step 1</h4>
          <h3 class="onboarding-side-bar-h3">Let's create your account in 3 simple steps.</h3>
          <p class="onboarding-side-bar-paragraph">Relay business account is free for 14-days. Take it for a spin with no commitments or long-term contracts.</p>
          <p class="onboarding-side-bar-paragraph">Customer accounts are free forever.</p>
          <div class="left-arrow"></div>
        </div>
      </div>
    </div>
  </div>
</div>
