  

    <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Account Settings') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>


  <body>

 <%= render 'shared/header_new' %>
  <%= render 'shared/sidebar' %>


  <div class="content" id="userProfile1">


    <!-- Start Page Header -->
    <div class="page-header">
      <h1 class="title">Account Settings</h1>

      <%= render 'shared/dashboard_shortcut' %>
    </div>


   <div class="login-form">
   <%= render 'alerts' %>
    <%= form_for(resource, :as => resource_name, :url => registration_path(resource_name), :html => { :method => :put, :autocomplete => "off", id: "user-form", class: "userForm hide show" }) do |f| %>
        <div class="top">
          <h4>Enter Payment Info.</h4>
          <img src="<%= asset_path 'stripe.png' %>" alt="icon" id="stripe-logo">
        </div>
        
        <div class="form-area">

         <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10" id="response">
            <div class="panel-body" ></div>                
        </div>   
          
          
          <div class="group">
           <%= f.text_field :card_name, id: 'cc-name', type: "text", :class => "form-control rhombusFocus", placeholder: "Name on Card", 'x-autocompletetype' => "off", autocompletetype: 'off', :autocorrect => "off", spellcheck: 'off', autocapitalize: "off", autocomplete: "off" %>
            <i class="fa fa-user"></i>
          </div>          

          
          <div class="group ccn-group">
            <%= f.number_field :last4, id: "cc-number", type: "tel", class: "form-control cc-num rhombusFocus", placeholder: "Card number", "x-autocompletetype" => "cc-number", autocompletetype: "cc-number", autocorrect: 'off', spellcheck: 'off', autocapitalize: 'off' %>
            <span class="card" aria-hidden="true"></span>
          </div>

          
          <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
            <div class="col-md-6 col-sm-6" id="exp-div">

            <%= f.hidden_field :exp_month, id: "cc-ex-month" %>
            <%= f.hidden_field :exp_year, id: "cc-ex-year" %>

             <%= f.hidden_field :card_token, id: "cc-uri" %>
              <%= f.hidden_field :card_type, id: "cc-type" %>

              <input id="cc-exp" type="text" class="form-control rhombusFocus" placeholder="MM / YY" value="" x-autocompletetype="off" autocompletetype="off" autocorrect="off" spellcheck="off" autocapitalize="off">
                  <i class="fa fa-calendar" id="fa-Calendar"></i>
            </div>

            <div class="col-md-6 col-sm-6" id="csc-div">
                <input id="cc-csc" type="tel" class="form-control rhombusFocus" placeholder="CVC" value="" autocorrect="off" spellcheck="off" autocapitalize="off" autocomplete="off" maxlength="4">
                <i class="fa fa-lock"></i>
            </div>

          </div>

          
          
          <%#<div class="group">
             <%= f.password_field :current_password, type: "password", class: "form-control rhombusFocus", placeholder: "Re-enter current password" %>
            <%#<i class="fa fa-key"></i>
            <div id="pwdnote">For account protection, enter your password to save info.</div>
          </div>%>

          <%= f.submit "Save", id: "cc-submit", :class => "btn btn-default btn-block btn-rhombus" %>  
          <div href="#" id="next" class="btn btn-default btn-block btn-info btn-rhombus-2">or update login info</div>
        </div>
      <% end %>

       <%= form_for(resource, :as => resource_name, :url => registration_path(resource_name), :html => { :method => :put, id: "user-profile-form", class: "userForm hide" }) do |f| %>  
        <div class="top">
          <h4>Update Login Info.</h4>
        </div>                  

        <div class="form-area">
            <div class="group">
            
            <!-- should now use person -->
            <%#= f.text_field :full_name, type: "text", :class => "form-control rhombusFocus", placeholder: "Full Name" %>
          
            <i class="fa fa-user"></i>
          </div> 

          <div class="group">
            <%= f.email_field :email, type: "email", placeholder: "Email", class: "form-control rhombusFocus", :autofocus => true %>
            <i class="fa fa-envelope-o"></i>
          </div>
          <div class="group phonegroup">
            <%= f.hidden_field :phone_number, :id => "phone_number" %>
            <%= f.phone_field :phone, :id => "phone", class: "form-control rhombusFocus" %>
          </div>
          <div class="group">
          <%= f.password_field :password, type: "password", :autocomplete => "off", placeholder: "New Password", class: "form-control rhombusFocus" %>
            <i class="fa fa-key"></i>
          </div>
          <div class="group">
           <%= f.password_field :password_confirmation, type: "password", placeholder: "Confirm new password", class: "form-control rhombusFocus", :autocomplete => "off" %>
            <i class="fa fa-key"></i>
          </div>
          <%#<div class="group">
          <%= f.password_field :current_password, type: "password", class: "form-control rhombusFocus", placeholder: "Enter current password" %>
            <%#<i class="fa fa-key"></i>
            <div id="pwdnote">For account protection, enter your password to save info.</div>
          </div>%>
          <%= f.submit "Save", :class => "btn btn-default btn-block btn-rhombus" %>  
          <div id="Prev" class="btn btn-default btn-block btn-info btn-rhombus-2">or edit card info</div>
        </div>      
      <% end %>


      
      <div class="footer-links row">
        <div class="col-xs-6"><a href="#"></a></div>
        <div class="col-xs-6 text-right"><a href="#"></a></div>
      </div>
    </div>

       <br><br><br><br><br>
    <br><br><br><br><br>

 </div>

</body>
</html>