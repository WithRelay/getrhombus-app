<div class="w-row">
  <div class="onboarding-table-column-1 w-col w-col-8">
    <div class="onboarding-form-section">
      <div class="choose-plan onboarding-form-div sign-in signup w-clearfix">
        <div class="choose-plan def-row-content-wrapper">
          <img src="http://uploads.webflow.com/5767087cbd63608e7eb4abdc/587e5fef406151a55b9105b0_Relay%20Transparent%20500x300.png" width="50">
          <h1 class="first-content-section-sub-header pricing-header">Select a plan to get started</h1>
          <div class="flex-underline form-header-underline"></div>
          <p class="def-content-section-paragraph pricing-paragraph">How many customers do you have?</p>
          <div class="slider-wrapper">
            <input type="text" name="plan[name]" id="pricing-range" amountValue="0">
            <span id="price-value"></span>
          </div>
          
          <!--<a class="button choose-plan pricing-table-button w-button" href="#" id='subscription_get_started'>Get Started</a>-->

          <div class="display-credit-card-wrapper display-credit-card-wrapper-fix">
            <div class="get-started-2 log-in-form w-form">
              
              <%= form_for(current_user, as: resource_name, url: current_user, html: { method: :patch, class: "w-clearfix", id: "cc-form" }) do |f| %>
                
                <div id='cc-fields'>

                  <%= f.number_field :last4, id: "cc-number", type: "tel", class: "card-number text-field w-input", placeholder: "Card number", "x-autocompletetype" => "cc-number", autocompletetype: "cc-number", autocorrect: 'off', spellcheck: 'off', autocapitalize: 'off' %> 

                  <%= f.hidden_field :exp_month, id: "cc-ex-month" %>
                  <%= f.hidden_field :exp_year, id: "cc-ex-year" %>
                  <%= f.hidden_field :card_token, id: "cc-uri" %>
                  <%= f.hidden_field :card_type, id: "cc-type" %>

                  <%= f.text_field :card_name, id: 'cc-name', type: "text", :class => "name-on-card text-field w-input", placeholder: "Name on Card", 'x-autocompletetype' => "off", autocompletetype: 'off', :autocorrect => "off", spellcheck: 'off', autocapitalize: "off", autocomplete: "off" %>

                   <input id="cc-exp" type="text" class="month-year text-field w-input" placeholder="MM / YYYY" value="" x-autocompletetype="off" autocompletetype="off" autocorrect="off" spellcheck="off" autocapitalize="off">

                  <input id="cc-csc" type="tel" class="cvv text-field w-input" placeholder="CVV" value="" autocorrect="off" spellcheck="off" autocapitalize="off" autocomplete="off" maxlength="4">

                  <label class="form-label paragraph select-plan" for="Card-Number-3">Don't worry, we'll notify you when your trial is about to expire</label>

                  <input type="hidden" id='add_subscription' name="add_subscription" value="true">
                  <input type="hidden" id='plan_name' name="plan_name">

                </div>

                <%= f.submit "Start 14-day Trial", class: "button log-in w-button", id: 'add_subscription_btn' %>

              <% end %>

            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
  <div class="onboarding-table-column-2 w-col w-col-4">
    <div class="onboarding-right-bar">
      <div class="w-container whats-new-container">
        <div class="whats-new-content-wrapper">
          <h4 class="onboarding-side-bar-h4">get started: step 3</h4>
          <h3 class="onboarding-side-bar-h3">You're almost done.</h3>
          <p class="onboarding-side-bar-paragraph">You're moments away from delighting your customers with personalized messages on the messaging apps they love; including Facebook Messenger, and SMS.</p>
          <p class="onboarding-side-bar-paragraph">Create and send amazing marketing campaigns, respond to support questions or new customer inquiries, and best of all, make it easy for your customers to pay you using SMS and Messenger.</p>
          <p class="credit onboarding-side-bar-paragraph">Enjoy $5 SMS credit during your trial period.</p>
          <div class="left-arrow"></div>
        </div>
      </div>
    </div>
  </div>
</div>