
<div class="container">
  <div class="row login-container animated fadeInUp" >  
        <div class="col-md-7 col-md-offset-2 tiles white no-padding">
     <div class="p-t-30 p-l-40 p-b-20 xs-p-t-10 xs-p-l-10 xs-p-b-10"> 
          <h3 class="normal">Business & Account Information</h3>
          <p class="normal">Tell us about your business or organization.</p>
        </div>
    <div class="tiles grey p-t-20 p-b-20 text-black">

      <%= form_for(resource, :as => resource_name, class: "animated fadeIn", :url => registration_path(resource_name), :html => { :method => :put }) do |f| %> 


        <div class="biz_form show">
            <%= render :partial => "business_information", :locals=>{:f=>f} %>

                <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10" style="margin-bottom: 20px;">
                  <div class="col-md-6 col-sm-6 ">
                      <a id="next" class="btn btn-default btn-block">Next</a> 
                    </div>
                 </div>
        </div>
      

        <div class="biz_form">
            <%= render :partial => "bank_information", :locals=>{:f=>f} %>

            <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10" style="margin-bottom: 20px; margin-top: 20px;">
                  <div class="col-md-6 col-sm-6 ">
                      <a id="Prev" class="btn btn-default btn-block">Previous</a> 
                    </div>
                     <div class="col-md-6 col-sm-6 ">
                       <img src="/assets/balanced.png" align="middle" />   
                    </div>
                 </div> 


        </div>        
                 
        <% end %>
      
    </div>   
      </div>   
  </div>
</div>






