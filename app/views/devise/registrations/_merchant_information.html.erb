  

    <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Merchant Profile') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>
  

  <body>
 
  <style type="text/css">
    body{background: #F5F5F5;}
  </style>

  <div class="completeAccount">

    <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTAINER -->
<div class="container-padding">  

  <!-- Start Row -->
  <div class="row">
      <div id="profileLogo"><img src="<%= asset_path 'logo.jpg' %>" alt="icon" id="signup_logo" class="icon"></div>

      <div class="panel panel-default" id="merchantprofilepage">
            
            <div class="panel-body">
            <%= form_for(resource, :as => resource_name, :url => registration_path(resource_name), :html => { :method => :put, id: "merchantProfile", class: "form-horizontal rhombusFocus" }) do |f| %> 

              <div class="merchant-form-line" style="margin-top: 10px;">Where are you based?</div>

                <div class="form-group" >
                  <label class="col-sm-2 control-label form-label">Country</label>
                  <div class="col-sm-10 countrygroup">   
                      <%= f.select :country, "<option value='' disabled selected class='hide'>Select country</option><option value='AU'>Australia</option><option value='AU'>Austria</option><option value='BE'>Belgium</option><option value='CA'>Canada</option><option value='DK'>Denmark</option><option value='FI'>Finland</option><option value='FR'>France</option><option value='DE'>Germany</option><option value='IE'>Ireland</option><option value='IT'>Italy</option><option value='LU'>Luxembourg</option><option value='NL'>Netherlands</option><option value='NO'>Norway</option><option value='ES'>Spain</option><option value='SE'>Sweden</option><option value='GB'>United Kingdom</option><option value='US'>United States</option>".html_safe, {}, :class => 'selectpicker rhombusFocus', id: 'country' %> 
                    </div>
                </div>

                <div class="merchant-form-line">Tell us about your business</div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Name</label>
                  <div class="col-sm-10">
                  <%= f.text_field :business_name, type: "text", class: "form-control rhombusFocus", placeholder: "Business Name" %>
                  </div>
                </div>
           
                
                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Type</label>
                  <div class="col-sm-10">
                    <%= f.select :business_type, "<option value='' disabled selected class='hide'>Select business type</option><option value='Beauty Professional'>Beauty Professional</option><option value='Cleaning Services'>Cleaning Services</option><option value='Coffee Shop'>Coffee Shop</option><option value='Concierge Services'>Concierge Services</option><option value='Home and Repair Services'>Home and Repair Services</option><option value='Health and Fitness'>Health and Fitness</option><option value='Individual'>Individual</option><option value='On-Demand Delivery'>On-Demand Delivery</option><option value='Orgs and Non-Profits'>Orgs and Non-Profits</option><option value='Professional Services'>Professional Services</option><option value='Restaurant'>Restaurant</option><option value='Retail'>Retail</option><option value='Taxi'>Taxi</option><option value='Others'>Others</option>".html_safe, {}, :class => 'selectpicker rhombusFocus' %>
                  </div>
                </div>

                <%# <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Phone</label>
                  <div class="col-sm-10">
                    <input type="tel" class="form-control rhombusFocus" id="phone" name="phone">
                  </div>
                </div>%>


                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Address</label>
                  <div class="col-sm-10">
                  <%= f.text_field :street_address, type: "text", :class => "form-control rhombusFocus", placeholder: "123 Main St, Ste 3", id: "address" %>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">City</label>
                  <div class="col-sm-10">
                  <%= f.text_field :city, type: "text", class: "form-control rhombusFocus", placeholder: "City" %>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">State or Province</label>
                  <div class="col-sm-10">
                  <%= f.text_field :state_province, type: "text", class: "form-control rhombusFocus", placeholder: "State" %>
                  </div>
                </div>

                 <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Postal Code</label>
                  <div class="col-sm-10">
                  <%= f.text_field :business_zip_code, type: "text", class: "form-control rhombusFocus", placeholder: "Zip", id: 'zip' %>
                  </div>
                </div>

                <input type="hidden" class="form-control" id="city" name="city" >
                <input type="hidden" class="form-control" id="state" name="state">

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Website</label>
                  <div class="col-sm-10">
                  <%#= f.text_field :website, type: "text", class: "form-control rhombusFocus", placeholder: "Your website or social profile link" %>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Tax rate</label>
                  <div class="col-sm-10">
                  <%= f.text_field :tax_rate, type: "text", class: "form-control rhombusFocus", placeholder: "5", id: "taxrate" %>
                      <span>Default is 0. To be applied to transactions</span>
                  </div>
                </div>


                <div class="merchant-form-line">Tell us about you</div>


                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Name</label>
                  <div class="col-sm-10">
                  <%= f.text_field :first_name, type: "text", class: "form-control rhombusFocus", placeholder: "First", id: "firstName" %>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label"></label>
                  <div class="col-sm-10">
                  <%= f.text_field :last_name, type: "text", class: "form-control rhombusFocus", placeholder: "Last", id: "lastName" %>
                  </div>
                </div>

              <div class="merchant-form-line">Set an optional welcome SMS message for customers that sign up with your number</div>


                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Welcome Message</label>
                  <div class="col-sm-10"> 
                  <%#= f.text_area :welcome_message, type: "text", class: "form-control rhombusFocus", id: "count_me", rows: 4 %>
                  </div>
                </div>


                <div class="merchant-form-line">You're almost set</div>


                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Password</label>
                  <div class="col-sm-10">
                  <%= f.password_field :current_password, type: "password", class: "form-control rhombusFocus", placeholder: "Re-enter current password", id: "reenterPassword" %>
                  </div>
                </div>
                
                <div class="form-group">
                  <div class="col-sm-offset-2 col-sm-10">
                  <%= f.submit "Submit", id: "ba-submit", :class => "btn btn-default btn-rhombus" %> 
                  </div>
                </div>

              <% end %>

            </div>

      </div>
      <div id="signout1"><%= link_to "LOG OUT", destroy_user_session_path, method: :delete %></div>
  </div>
  <!-- End Row -->


</div>
<!-- END CONTAINER -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 

 </div>

</body>
</html>