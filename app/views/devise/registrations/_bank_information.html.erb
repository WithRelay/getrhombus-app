



	    <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                      <div class="col-md-6 col-sm-6 ">

                        <%= f.text_field :account_name, type: "text", class: "form-control", placeholder: "Account Name" %>

                      </div>
                      <div class="col-md-6 col-sm-6">
            
                        <%= f.text_field :account_number, type: "text", class: "form-control", placeholder: "Account Number" %>
                      </div>
                    </div>

           <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                      <div class="col-md-6 col-sm-6 ">

                        <%= f.text_field :routing_number, type: "text", class: "form-control", placeholder: "Routing Number" %>

                      </div>
                      <div class="col-md-6 col-sm-6">
            
                           <select id="" name="" class="form-control">
                        <option value="Checking">Checking</option>
                        <option value="Savings">Savings</option>
                    </select>

                      </div>
                    </div>

       <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10" style="margin-top: 25px;">
                      <div class="col-md-6 col-sm-6 ">

                        <%= f.password_field :current_password, type: "Password", class: "form-control", placeholder: "Enter password" %>
                         <p>For account protection, your password is required to save changes to your settings.</p>

                      </div>
                      <div class="col-md-6 col-sm-6">
            
                         <%= f.submit "Save", :class => "btn btn-primary btn-cons btn-block" %>  

                      </div>
                    </div>

                     




