<%= render "balanced_error" %>

	    <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                      <div class="col-md-6 col-sm-6 ">

                        <%= f.text_field :account_name, type: "text", class: "form-control", placeholder: "Account Name", id: "ba-name" %>

                      </div>
                      <div class="col-md-6 col-sm-6">
            
                        <%= f.text_field :account_number, type: "text", class: "form-control", placeholder: "Account Number", id: "ba-number" %>
                      </div>
                    </div>

           <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                      <div class="col-md-6 col-sm-6 ">

                        <%= f.text_field :routing_number, type: "text", class: "form-control", placeholder: "Routing Number", id: "ba-routing" %>

                      </div>
                      <div class="col-md-6 col-sm-6">
            
                    
          <%= f.select(:account_type, [['Checking', "checking"], ['Savings', "savings"]], {}, :class => "form-control", id: "ba-type") %>

                    
                       <%= f.hidden_field :instrument_uri, id: "ba-uri" %>
                            
                      </div>
                    </div>

       <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10" style="margin-top: 25px;">
                      <div class="col-md-6 col-sm-6 ">

                        <%= f.password_field :current_password, type: "Password", class: "form-control", placeholder: "Enter password" %>
                         <p>For account protection, your password is required to save changes to your settings.</p>

                      </div>
                      <div class="col-md-6 col-sm-6">
            
                         <%= f.submit "Save", id: "ba-submit", :class => "btn btn-primary btn-cons btn-block" %>  

                      </div>
                    </div>

                     




