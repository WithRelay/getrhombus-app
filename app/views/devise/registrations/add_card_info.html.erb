<div class="w-row">
    <div class="onboarding-table-column-1 w-col w-col-8">
      <div class="onboarding-form-section">
        <div class="choose-plan onboarding-form-div sign-in signup">
          <%= link_to root_url do %>
            <%= image_tag('Relay-Transparent-500x300.png', class: 'slider-placeholder', width: 50) %>
          <% end %>
          <h4 class="card-info form-header">Payment Information</h4>
          <div class="flex-underline form-header-underline"></div>
          <div class="customer-card-info display-credit-card-wrapper">
            <div class="get-started-2 log-in-form">
              <%= form_for(current_user, as: resource_name, url: registration_update_user_path(resource_name), html: { method: :patch, id: "cc-form", autocomplete: "off", class: 'w-clearfix' }) do |f| %>

                <label class="form-label paragraph" for="Card-Number-5">Messaging businesses with Relay is free. Add your debit/credit card information to your profile to allow send payments to via text</label>

                <div class="form-group col-xs-6">
                  <%= f.number_field :last4, id: "cc-number", type: "tel", class: "form-control card-number text-field w-input", placeholder: "Card number", "x-autocompletetype" => "cc-number", autocompletetype: "cc-number", autocorrect: 'off', spellcheck: 'off', autocapitalize: 'off' %>
                </div>

                <%= f.hidden_field :exp_month, id: "cc-ex-month" %>
                <%= f.hidden_field :exp_year, id: "cc-ex-year" %>
                <%= f.hidden_field :card_token, id: "cc-uri" %>
                <%= f.hidden_field :card_id, id: "cc-id" %>
                <%= f.hidden_field :livemode, id: "cc-livemode" %>
                <%= f.hidden_field :card_type, id: "cc-type" %>

                <%= f.hidden_field :captured_amt, id: "captured_amt" %>
                <%= f.hidden_field :msg_id, id: "msg_id" %>
                <%= f.hidden_field :tag_id, id: "tag_id" %>
                <%= f.hidden_field :referrer_uid, id: "referrer_uid" %>

                <input type="hidden" name="page_params" value="add_card_info">

                <div class="form-group col-xs-6">
                  <%= f.text_field :card_name, id: 'cc-name', type: "text", class: "form-control name-on-card text-field w-input", placeholder: "Name on Card", 'x-autocompletetype' => "off", autocompletetype: 'off', :autocorrect => "off", spellcheck: 'off', autocapitalize: "off", autocomplete: "off" %>
                </div>

                <div class="form-group col-xs-6">
                  <input id="cc-exp" type="text" class="form-control month-year text-field w-input" placeholder="MM / YYYY" value="" x-autocompletetype="off" autocompletetype="off" autocorrect="off" spellcheck="off" autocapitalize="off">
                </div>

                <div class="form-group col-xs-6">
                  <input id="cc-csc" type="tel" class="form-control cvv text-field w-input" placeholder="CVV" value="" autocorrect="off" spellcheck="off" autocapitalize="off" autocomplete="off" maxlength="4">
                </div>

                <%= f.submit "Submit", class: "button log-in w-button", id: 'cc-submit' %>

              <% end %>


            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="onboarding-table-column-2 w-col w-col-4">
      <div class="onboarding-right-bar">
        <div class="w-container whats-new-container">
          <div class="whats-new-content-wrapper">
            <h4 class="onboarding-side-bar-h4">get started: step 2</h4>
            <h3 class="onboarding-side-bar-h3">You're almost done.</h3>
            <p class="onboarding-side-bar-paragraph">Add your payment information to your profile to allow you make purchases or pay bills using simple text messages on Facebook Messenger, or SMS.</p>
            <p class="onboarding-side-bar-paragraph">For example, you can text "$10 Cheese Pizza" to the Relay phone number of your favorite pizzeria to order lunch.
              <br>
              <br>Remember to ask your favorite local businesses for their Relay phone numbers so you can start messaging them when you need help, or to complete your purchase via text.</p>
            <p class="credit onboarding-side-bar-paragraph">Your Relay account is free forever.</p>
            <div class="left-arrow"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
