
<%= form_for(resource, :as => resource_name, :url => registration_path(resource_name), :html => { :method => :put }) do |f| %>

<div class="container">
  <div class="row login-container animated fadeInUp">  
        <div class="col-md-7 col-md-offset-2 tiles white no-padding">
     <div class="p-t-30 p-l-40 p-b-20 xs-p-t-10 xs-p-l-10 xs-p-b-10"> 
          <h3 class="normal">Payment Information</h3>
          <p class="normal">We only need to collect this information once.</p>
        </div>
    <div class="tiles grey p-t-20 p-b-20 text-black">
      <form id="frm_login" class="animated fadeIn">    
                    <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                      <div class="col-md-6 col-sm-6 ">

                        <%= f.text_field :card_name, id: 'cc-name', type: "text", :class => "form-control", placeholder: "Name on Card" %>

                      </div>
                      <div class="col-md-6 col-sm-6">
            
                        <%= f.number_field :last_four, id: "cc-number", type: "text", class: "form-control", placeholder: "Card Number" %>
                      </div>
                    </div>

                  <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                      <div class="col-md-6 col-sm-6 ">

                          <select id="cc-ex-month" name="" class="form-control">
                        <option value="01"> 01 - Jan</option>
                        <option value="02"> 02 - Feb</option>
                        <option value="03"> 03 - Mar</option>
                        <option value="04"> 04 - Apr</option>
                        <option value="05"> 05 - May</option>
                        <option value="06"> 06 - Jun</option>
                        <option value="07"> 07 - Jul</option>
                        <option value="08"> 08 - Aug</option>
                        <option value="09"> 09 - Sep</option>
                        <option value="10"> 10 - Oct</option>
                        <option value="11"> 11 - Nov</option>
                        <option value="12"> 12 - Dec</option>
                    </select>



                      </div>
                      <div class="col-md-6 col-sm-6">
                <select name="" id="cc-ex-year" class="form-control">                
                    <option value="2014">2013</option> 
                    <option value="2014">2014</option>                
                    <option value="2015">2015</option>                
                    <option value="2016">2016</option>                
                    <option value="2017">2017</option>                
                    <option value="2018">2018</option>                
                    <option value="2019">2019</option>                
                    <option value="2020">2020</option>                
                    <option value="2021">2021</option>                
                    <option value="2022">2022</option>                
                    <option value="2023">2023</option>                
                </select>
                      </div>
                    </div>

                    <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                      <div class="col-md-6 col-sm-6 ">

                        <input name="" type="text"  id="ex-csc" class="form-control" placeholder="Security Code">

                      </div>
                      <div class="col-md-6 col-sm-6">
            
                       <input name="" id="" type="text"  class="form-control" placeholder="Zip Code">
                      </div>
                    </div>

                    <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10" style="margin-top: 25px;">
                      <div class="col-md-6 col-sm-6 ">

                        <%= f.password_field :current_password, type: "Password", class: "form-control", placeholder: "Password required", id: "current_password" %>
                        <p>For account protection, your password is required to save changes to your settings.</p>

                      </div>
                      <div class="col-md-6 col-sm-6">
            
                       <%#= f.submit "Save", id: "cc-submit", :class => "btn btn-primary btn-cons btn-block" %>   
                       <a id="cc-submit" class="btn btn-primary btn-cons btn-block">Save</a>
                      </div>
                    </div>
    
    <div class="row">
            <div id="response" class="col-lg-12" style="display: none;">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title">Response</h3>
                    </div>
                    <div class="panel-body">
                        <pre></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>

                     <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10" style="margin-top: 15px;">
                        <div class="col-md-12" style="margin-bottom:15px; margin-top: 10px;">
                          <img src="/assets/balanced.png" align="middle" />   
                          </div>
                    </div>  


        </form>
      
    </div>   
      </div>   
  </div>
</div>
<% end %>

