<% provide(:title, 'Rhombus - Merchant Profile') %>
<div class="settings sub-nav-bar w-clearfix"><a class="dashboard-return sub-nav-button w-button" href="#"> &nbsp;<strong>Return to dashboard</strong></a>
</div>
<div class="dashboard-body settings">
  <div class="dash-content-container settings">
    <h4 class="form-header">Business Information</h4>
    <div class="flex-underline form-header-underline"></div>
    <div class="account-settings-form-wrapper w-form">
      <%= form_for(current_user, as: resource_name, url: registration_update_user_path(resource_name), html: { method: :patch, id: "businessSetting", class: "w-clearfix" }) do |f| %>

        <label class="field-headers form-label settings" for="Business-Name">Basic details</label>
          <div class="form-group col-xs-6">
            <%= f.text_field :org_name, class: "form-control full-name settings text-field w-input", placeholder: "Business legal name" %>
          </div>
        <label class="form-label paragraph" for="Organization-Type">Your business name will appear on both your customer’s card statement &amp; receipts. If your business doesn't have a name, enter your product or services and your city, e.g. “Bakery - New York”</label>

        <div class="form-group col-xs-6 inline-display">
          <%= f.select :org_type, options_for_select([['Business', 'Business'], ['Nonprofit', 'Nonprofit'], ['Education (K-12)', 'Education (K-12)'], ['Education (Universities &amp; Colleges)'.html_safe, 'Education (Universities &amp; Colleges)']]), { prompt: 'Organization Type' }, class: 'form-control organization-type w-select', id: '' %>
        </div>

        <select class="form-control business-category organization-type w-select" name="user[org_category]">
          <option value="" class='hide'>Business category (optional)</option>
          <option value="Beauty &amp; Spas">Beauty &amp; Spas</option>
          <option value="Charity">Charity</option>
          <option value="Cleaning Service">Cleaning Service</option>
          <option value="Coffee Shop">Coffee Shop</option>
          <option value="Concierge Services">Concierge Services</option>
          <option value="Ecommerce">Ecommerce</option>
          <option value="Financial Services">Financial Services</option>
          <option value="Home &amp; Repair Services">Home &amp; Repair Services</option>
          <option value="Hotel &amp; Travel">Hotel &amp; Travel</option>
          <option value="Health &amp; Fitness">Health &amp; Fitness</option>
          <option value="Individual">Individual</option>
          <option value="Local Services">Local Services</option>
          <option value="On-demand Delivery">On-demand Delivery</option>
          <option value="Pets">Pets</option>
          <option value="Professional Services">Professional Services</option>
          <option value="Religious Organization">Religious Organization</option>
          <option value="Restaurant">Restaurant</option>
          <option value="Retail">Retail</option>
          <option value="Taxi &amp; Limousine">Taxi &amp; Limousine</option>
          <option value="Other">Other</option>
        </select>

        <div class="flex-underline form-section-divider"></div>

        <label class="field-headers form-label settings" for="Street-Address">ADDRESS INFORMATION</label>
        <div class="form-group col-xs-6">
          <%= f.text_field :street_address, type: "text", class: "form-control settings street-name text-field w-input", placeholder: "Street Address" %>
        </div>

        <div class="form-group col-xs-6">
          <%= f.text_field :suite, type: "text", class: "form-control apt_suite settings text-field w-input", placeholder: "Suite" %>
        </div>

        <div class="form-group col-xs-6">
          <%= f.text_field :city, class: "form-control city settings text-field w-input", placeholder: "City" %>
        </div>
        <div class="form-group col-xs-6">
          <%= f.text_field :state_province, class: "form-control settings state text-field w-input", placeholder: "State/Province" %>
        </div>
        <div class="form-group col-xs-6">
          <%= f.text_field :zip_code, class: "form-control settings text-field w-input zip", placeholder: "Zip/Postal code" %>
        </div>
        <div class="form-group col-xs-6">
          <select class="form-control country_dropdown w-select" name="user[country]">
              <option value="" class='hide'>Select a country</option>
              <% CountriesList::COUNTRIES_LIST.each do |c| %>
                <option value="<%= c[:code] %>"><%= c[:name] %></option>
              <% end %>
            </select>
        </div>

        <div class="flex-underline form-section-divider"></div>
        <label class="field-headers form-label settings" for="Website">other INFORMATION</label>
        <div class="form-group col-xs-6">
          <%= f.url_field :url, class: "form-control settings short-field text-field w-input", placeholder: "Website" %>
        </div>
        <div class="form-group col-xs-6">
          <%= f.number_field :tax_percent, step: 0.1, min: 0, class: "form-control settings tax text-field w-input", id: 'user_tax_percent', placeholder: "Tax" %>
        </div>
        <label class="form-label other-info paragraph" for="Re-enter-Password">Set the tax rate that will be applied to every transaction made by your customers via Rhombus. The default rate is set at zero.</label>

        <%= f.submit "Save changes", id: "ba-submit", class: "button save-changes w-button" %>
        <input type="hidden" name="page_params" value="business_settings">

      <% end %>
    </div>
  </div>
</div>
