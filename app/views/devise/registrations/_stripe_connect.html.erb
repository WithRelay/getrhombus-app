
  

    <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Connect to Stripe') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>

  <style type="text/css">
    body{background: #F5F5F5;}
  </style>

  <body>
  
 <!-- //////////////////////////////////////////////////////////////////////////// --> 
 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTENT -->
<div class="">

 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTAINER -->
  <div class="container-default">

    <!-- Start Panel -->
    
      <div class="panel panel-default" id="connectStripe">

        <div class="panel-title">
          Account Information
        </div>
        <div class="panel-heading" style="font-size: 12px">To receive payments, please create and/or connect a <a href="https://stripe.com" target="_blank">Stripe Payments</a> account. This generally needs to be done once.</div>

        <div class="panel-body">
        <%= link_to "Connect with Stripe", user_omniauth_authorize_path(:stripe_connect, "stripe_user[country]" => current_user.country, "stripe_user[email]" => current_user.email, "stripe_user[phone_number]" => current_user.org_phone, "stripe_user[org_name]" => current_user.org_name, "stripe_user[first_name]" => current_user.first_name, "stripe_user[last_name]" => current_user.last_name, "stripe_user[street_address]" => current_user.street_address, "stripe_user[city]" => current_user.city, "stripe_user[zip]" => current_user.zip_code, "stripe_user[url]" => current_user.url ), class: "btn btn-primary btn-rhombus" %>
        </div>

      </div>
    <!-- End Panel -->

    <div id="signout2"><%= link_to "LOG OUT", destroy_user_session_path, method: :delete %></div>
<br><br><br><br><br><br><br><br><br><br><!--<br><br><br><br><br><br><br><br><br><br><br> -->
<br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br>



</div>
<!-- END CONTAINER -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 


</div>
<!-- End Content -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 




</body>
</html>