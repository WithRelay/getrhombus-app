
<% provide(:title, 'Rhombus - Profile') %>
<%= content_for :head do %>
  <%= stylesheet_link_tag "forms.css" %>
<% end %>

<%= content_for :head_script do %>
  <script type="text/javascript" src="https://js.balancedpayments.com/v1/balanced.js"></script>
  <%= javascript_include_tag "tokenize.js" %>
<% end %>
  
<body class="error-body no-top lazy" style="background-color: gray"> 


<%= render 'shared/header' %>


  <%= devise_error_messages! %>
  <%= render 'shared/full_messages' %>

  <%#<button type="button" id="populate" class="btn btn-default pull-right" style="margin-bottom: 20px;">Populate Test Data</button>%>
  
  <% if current_user.user_level == 0 and current_user.customer_uri.blank? %>
        <%= render "user_information" %>
  <% elsif current_user.user_level == 1 and current_user.customer_uri.blank? %>
        <%= render "merchant_information" %>
  <% else %>
        <%= render "entire_profile" %>
  <% end %>


</body>



