  

    <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Merchant Profile') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>
  

  <body>

 <%= render 'shared/header_new' %>
  <%= render 'shared/sidebar' %>

  <div class="content">
    <!-- Start Page Header -->
    <div class="page-header">
      <h1 class="title">Account Settings</h1>



    </div>
    <!-- End Page Header -->

    <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTAINER -->
<div class="container-padding" id="merchantProfile">


  
  <!-- Start Row -->
  <div class="row">
    
    <div class="">
      <div class="panel panel-default" id="merchantprofilepage">

            <div class="panel-body">
            <%= render 'alerts' %>
               <%= form_for(resource, :as => resource_name, :url => registration_path(resource_name), :html => { :method => :put, id: "merchantProfile", class: "form-horizontal rhombusFocus" }) do |f| %> 

               <div class="merchant-form-line">Email and Password</div>
                 <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Email</label>
                  <div class="col-sm-10">
                  <%= f.email_field :email, type: "email", id: "email", placeholder: "Email", class: "form-control rhombusFocus", :autofocus => true %>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">New Password</label>
                  <div class="col-sm-10">
                  <%= f.password_field :password, type: "password", id: "newpassword", :autocomplete => "off", placeholder: "Enter new password", class: "form-control rhombusFocus" %>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Confirm Password</label>
                  <div class="col-sm-10">
                  <%= f.password_field :password_confirmation, id: "confirmNewPassword", type: "password", placeholder: "Confirm new password", class: "form-control rhombusFocus" %>
                  </div>
                </div>

              <div class="merchant-form-line">Where are you based?</div>

                <div class="form-group" >
                  <label class="col-sm-2 control-label form-label">Country</label>
                  <div class="col-sm-10 countrygroup">
                      <%= f.select :country, options_for_select({ "Australia" => "AU", "Austria" => 'AT', "Belgium" => "BE", "Canada" => "CA", "Denmark" => "DK", "Finland" => "FI", "France" => "FR", "Germany" => "DE", "Ireland" => "IE", "Italy" => "IT", "Luxembourg" => "LU", "Netherlands" => "NL", "Norway" => "NO", "Spain" => "ES", "Sweden" => "SE", "United Kingdom" => "GB", "United States" => "US" }, selected: current_user.country), {}, :class => 'selectpicker rhombusFocus', id: 'country' %>
                    </div>
                </div>

                <div class="form-group" >
                  <label class="col-sm-2 control-label form-label">Time Zone</label>
                  <div class="col-sm-10 countrygroup">
                    <%= time_zone_select(:user, :time_zone) %>
                  </div>
                </div>

                <div class="form-group" >
                  <label class="col-sm-2 control-label form-label">Currency</label>
                  <div class="col-sm-10">   
                      <%= f.select :currency, options_for_select({ "AUD" => "aud", "CAD" => 'cad', "CRC" => "crc", "DKK" => "dkk", "EUR" => "eur", "GBP" => "gbp", "NOK" => "nok", "SEK" => "sek", "USD" => "usd" }, selected: current_user.currency), {}, :class => 'selectpicker rhombusFocus', id: 'currency' %>
                    </div>
                </div>

                <div class="merchant-form-line">Tell us about your business</div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Name</label>
                  <div class="col-sm-10">
                  <%= f.text_field :org_name, type: "text", class: "form-control rhombusFocus", placeholder: "Business Name" %>
                  </div>
                </div>
           
                
                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Type</label>
                  <div class="col-sm-10">
                    <%= f.select :org_category, options_for_select({ "Beauty Professional" => "Beauty Professional", "Cleaning Services" => 'Cleaning Services', "Coffee Shop" => "Coffee Shop", "Concierge Services" => "Concierge Services", "Home and Repair Services" => "Home and Repair Services", "Health and Fitness" => "Health and Fitness", "Individual" => "Individual", "On-Demand Delivery" => "On-Demand Delivery", "Orgs and Non-Profits" => "Orgs and Non-Profits", "Professional Services" => "Professional Services", "Restaurant" => "Restaurant", "Retail" => "Retail", "Taxi" => "Taxi", "Others" => "Others" }, selected: current_user.org_category), {}, :class => 'selectpicker rhombusFocus' %>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Business Phone</label>
                  <div class="col-sm-10">
                      <%= f.hidden_field :org_phone, :id => "phone_number", class: "form-control rhombusFocus" %>
                      <%= f.phone_field :phone, :id => "phone", class: "form-control rhombusFocus" %>
                      
                      <%# <input type="tel" class="form-control rhombusFocus" id="phone" name="phone"> %>
                      <%#= f.hidden_field :phone_number, :id => "phone_number" %>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Address</label>
                  <div class="col-sm-10">
                  <%= f.text_field :street_address, type: "text", :class => "form-control rhombusFocus", placeholder: "123 Main St, Ste 3", id: "address" %>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">City</label>
                  <div class="col-sm-10">
                  <%= f.text_field :city, type: "text", class: "form-control rhombusFocus", placeholder: "City", id: "city" %>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">State or Province</label>
                  <div class="col-sm-10">
                  <%= f.text_field :state_province, type: "text", class: "form-control rhombusFocus", placeholder: "State", id: "state" %>
                  </div>
                </div>

                                <!-- Addresses now has it own model      -->


                 <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Postal Code</label>
                  <div class="col-sm-10">
                  <%= f.text_field :zip_code, type: "text", class: "form-control rhombusFocus", placeholder: "Zip", id: 'zip' %>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Website</label>
                  <div class="col-sm-10">
                  <%= f.text_field :url, type: "text", class: "form-control rhombusFocus", placeholder: "Your website or social profile link" %>
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Tax rate</label>
                  <div class="col-sm-10">
                  <%= f.text_field :tax_percent, type: "text", class: "form-control rhombusFocus", placeholder: "5", id: "taxrate" %>
                      <span>Default is 0. To be applied to transactions</span>
                  </div>
                </div>


                <div class="merchant-form-line">Tell us about yourself</div>


                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Name</label>
                  <div class="col-sm-10">
                  <!-- now thru person -->
                  <%#= f.text_field :full_name, type: "text", class: "form-control rhombusFocus", placeholder: "First", id: "fullName" %>
                  </div>
                </div>

                

              <div class="merchant-form-line">Optional SMS message sent to customers the first time they text you</div>

                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Message</label>
                  <div class="col-sm-10"> 
                  <%= f.text_area :custom_welcome, type: "text", class: "form-control rhombusFocus", id: "count_me", rows: 4 %>
                  </div>
                </div>


                <div class="merchant-form-line">You're almost set</div>

                <%# if you need merchant's to confirm password %>
                <%#<div class="form-group">
                  <label class="col-sm-2 control-label form-label">Password</label>
                  <div class="col-sm-10">
                  <%= f.password_field :current_password, type: "password", class: "form-control rhombusFocus", placeholder: "Re-enter current password", id: "reenterPassword" %>
                  <%#</div>
                </div>%>
                
                <div class="form-group">
                  <div class="col-sm-offset-2 col-sm-10">
                  <%= f.submit "Save", id: "ba-submit", :class => "btn btn-default btn-rhombus" %> 
                  </div>
                </div>

              <% end %>

            </div>

      </div>
    </div>

  </div>
  <!-- End Row -->


</div>
<!-- END CONTAINER -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 


 </div>


</body>
</html>