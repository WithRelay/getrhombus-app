<div class="w-row">
  <div class="onboarding-table-column-1 w-col w-col-8">
    <div class="onboarding-form-section">
      <div class="choose-plan onboarding-form-div sign-in signup w-clearfix">
        <div class="choose-plan def-row-content-wrapper">
          <%= image_tag('Relay-Transparent-500x300.png', class: 'slider-placeholder', width: 50) %>
          <h1 class="first-content-section-sub-header pricing-header">Select a plan to get started</h1>
          <div class="flex-underline form-header-underline"></div>
          <p class="def-content-section-paragraph pricing-paragraph">How many customers do you have?</p>
          <div class="slider-wrapper">
            <%= image_tag('Slider-Placeholder-2.png', class: 'slider-placeholder') %>
          </div>
          <h1 class="plan-amount">$0</h1>
          <h5 class="signup-box-subheading starter-table">BILLED MONTHLY</h5><a class="button choose-plan pricing-table-button w-button" href="#">Get Started</a>
          <div class="display-credit-card-wrapper">
            <div class="get-started-2 log-in-form w-form">
              <%= form_for(resource, as: resource_name, data: { name: "Email Form" }, url: registration_path(resource_name), html: { method: :put, id: "merchantProfile", class: "w-clearfix rhombusFocus" }) do |f| %>
                <input class="card-number text-field w-input" data-name="Card Number 4" id="Card-Number-4" maxlength="256" name="Card-Number-4" placeholder="Card number" required="required" type="text">
                <input class="name-on-card text-field w-input" data-name="Name On Card 4" id="Name-on-Card-4" maxlength="256" name="Name-on-Card-4" placeholder="Name on card" required="required" type="text">
                <input class="month-year text-field w-input" data-name="Month Year 3" id="Month-Year-3" maxlength="256" name="Month-Year-3" placeholder="MM / YYYY" required="required" type="text">
                <input class="cvv text-field w-input" data-name="Cvv 5" id="CVV-5" maxlength="256" name="CVV-5" placeholder="CVV" required="required" type="text">
                <input class="button log-in w-button" data-wait="Please wait..." type="submit" value="Start 14-day Trial">
                <label class="form-label paragraph select-plan" for="Card-Number-3">Don't worry, we'll notify you when your trial is about to expire</label>
              <% end %>
              <div class="w-form-done">
                <div>Thank you! Your submission has been received!</div>
              </div>
              <div class="w-form-fail">
                <div>Oops! Something went wrong while submitting the form</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="onboarding-table-column-2 w-col w-col-4">
    <div class="onboarding-right-bar">
      <div class="w-container whats-new-container">
        <div class="whats-new-content-wrapper">
          <h4 class="onboarding-side-bar-h4">get started: step 3</h4>
          <h3 class="onboarding-side-bar-h3">You're almost done.</h3>
          <p class="onboarding-side-bar-paragraph">You're moments away from delighting your customers with personalized messages on the messaging apps they love; including Facebook Messenger, and SMS.</p>
          <p class="onboarding-side-bar-paragraph">Create and send amazing marketing campaigns, respond to support questions or new customer inquiries, and best of all, make it easy for your customers to pay you using SMS and Messenger.</p>
          <p class="credit onboarding-side-bar-paragraph">Enjoy $5 SMS credit during your trial period.</p>
          <div class="left-arrow"></div>
        </div>
      </div>
    </div>
  </div>
</div>
