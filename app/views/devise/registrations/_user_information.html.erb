  

    <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Payment Info') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>
<style type="text/css">
    body{background: #F5F5F5;}
  </style>
  <body>

  <div class="" id="userProfile1">

   <div class="login-form">
    <div id="profileLogo"><img src="<%= asset_path 'logo.jpg' %>" alt="icon" id="signup_logo" class="icon"></div>

<%= form_for(resource, :as => resource_name, :url => registration_path(resource_name), :html => { :method => :put, id: "user-form", :autocomplete => "off" }) do |f| %>
        <div class="top">
          <h4>Enter Payment Info.</h4>
          <img src="<%= asset_path 'stripe.png' %>" alt="icon" id="stripe-logo">
        </div>
        
        <div class="form-area">

        
         <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10" id="response">
            <div class="panel-body" ></div>                
        </div>   ==>   <%#= render "error" %>


          
          <div class="group">
          <%#= f.text_field :fullname, type: "text", :class => "form-control rhombusFocus", placeholder: "Full Name" %>
            <input type="text" class="form-control rhombusFocus" placeholder="Full Name" name="fullname" >
            <i class="fa fa-user"></i>
          </div>          

          
          <div class="group">
          <%= f.text_field :card_name, id: 'cc-name', type: "text", :class => "form-control rhombusFocus", placeholder: "Name on Card", 'x-autocompletetype' => "off", autocompletetype: 'off', :autocorrect => "off", spellcheck: 'off', autocapitalize: "off", autocomplete: "off" %>
            <i class="fa fa-user"></i>
          </div>          

          
          <div class="group ccn-group">
          <%= f.number_field :last_four, id: "cc-number", type: "tel", class: "form-control rhombusFocus", placeholder: "Card number", "x-autocompletetype" => "cc-number", autocompletetype: "cc-number", autocorrect: 'off', spellcheck: 'off', autocapitalize: 'off' %>
            <i class="fa fa-credit-card"></i>
          </div>

          
          <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10 exp-row">
            <div class="col-md-6 col-sm-6 padding-fix1" id="exp-div">

            <%= f.hidden_field :expiration_month, id: "cc-ex-month" %>
            <%= f.hidden_field :expiration_year, id: "cc-ex-year" %>

             <%= f.hidden_field :instrument_uri, id: "cc-uri" %>
              <%= f.hidden_field :card_type, id: "cc-type" %>

              <input id="cc-exp" type="text" class="form-control rhombusFocus" placeholder="MM / YY" value="">
                  <i class="fa fa-calendar" id="fa-Calendar" x-autocompletetype="off" autocompletetype="off" autocorrect="off" spellcheck="off" autocapitalize="off"></i>

            </div>

            <div class="col-md-6 col-sm-6 padding-fix2" id="csc-div">
                <input id="cc-csc" type="tel" class="form-control rhombusFocus" placeholder="CVC" value="" 
                  autocorrect="off" spellcheck="off" autocapitalize="off" autocomplete="off" maxlength="4"> <i class="fa fa-lock"></i>
            </div>

          </div>

          
          
          <div class="group">
           <%= f.password_field :current_password, type: "password", class: "form-control rhombusFocus", placeholder: "Re-enter current password" %>
            <i class="fa fa-key"></i>
            <div id="pwdnote">For account protection, enter your password to save info.</div>
          </div>

           <%= f.submit "Save", id: "cc-submit", :class => "btn btn-default btn-block btn-rhombus" %>  
        </div>
      <% end %>


      
      <div class="footer-links row">
        <div class="col-xs-6"><a href="#"></a></div>
        <div class="col-xs-6 text-right"><a href="#"></a></div>
      </div>
    </div>

    <div id="signout1"><%= link_to "LOG OUT", destroy_user_session_path, method: :delete %></div>

    <br><br><br><br><br>
    <br><br><br><br><br>
 </div>

</body>
</html>