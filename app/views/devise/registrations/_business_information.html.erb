
               <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                      <div class="col-md-6 col-sm-6 ">

                        <%= f.text_field :first_name, type: "text", class: "form-control", placeholder: "First Name" %>

                      </div>
                      <div class="col-md-6 col-sm-6">
            
                        <%= f.text_field :last_name, type: "text", class: "form-control", placeholder: "Last Name" %>
                      </div>
                    </div>

               <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                      <div class="col-md-6 col-sm-6 ">

                        <%= f.text_field :business_name, type: "text", class: "form-control", placeholder: "Business Name" %>

                      </div>
                      <div class="col-md-6 col-sm-6">
            
                        <%= f.text_field :business_type, type: "text", class: "form-control", placeholder: "Ex. Individual, Food, Non-Profit" %>
                      </div>
                    </div>

                  <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                      <div class="col-md-12">
                    <%= f.text_field :street_address, type: "text", :class => "form-control", placeholder: "Street Address, Suite or Apartment #" %>
                      </div>
                    </div>


                  <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                      <div class="col-md-6 col-sm-6 ">

                        <%= f.text_field :city, type: "text", class: "form-control", placeholder: "City" %>

                      </div>
                      <div class="col-md-6 col-sm-6">
            
                        <%= f.text_field :state_province, type: "text", class: "form-control", placeholder: "State or Province Ex. NY or AB", :maxlength => 2 %>
                      </div>
                    </div>

                    <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                      <div class="col-md-6 col-sm-6 ">

                        <%= f.text_field :country, type: "text", class: "form-control", placeholder: "Country Ex. US or CA", :maxlength => 2 %>

                      </div>
                      <div class="col-md-6 col-sm-6">
            
                        <%= f.text_field :business_zip_code, type: "text", class: "form-control", placeholder: "Zip/Postal Code" %>
                      </div>
                    </div>

                    
                     <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
                      <div class="col-md-6 col-sm-6 ">
                          <p>Tax rate to be applied to customer debits</p>
                        <%= f.text_field :tax_rate, type: "text", class: "form-control", placeholder: "Without %. Default is 0" %>

                      </div>
                      <div class="col-md-6 col-sm-6">                    
          <%#= f.select(:account_type, [['Checking', "checking"], ['Savings', "savings"]], {}, :class => "form-control") %>        
                      </div>
                    </div>


       <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10" style="margin-top: 25px;">
                      <div class="col-md-6 col-sm-6 ">

                        <%= f.password_field :current_password, type: "Password", class: "form-control", placeholder: "Enter password" %>
                         <p>For account protection, your password is required to save changes to your settings.</p>

                      </div>
                      <div class="col-md-6 col-sm-6">
            
                         <%= f.submit "Save", id: "ba-submit", :class => "btn btn-primary btn-cons btn-block" %>  

                      </div>
                    </div>


       <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10" style="margin-top: 25px;">
                      <div class="col-md-6 col-sm-6 ">
                        <p>Click below to update Stripe Connect details.</p>
                      <%= link_to "Connect with Stripe", "https://manage.stripe.com/account", class: "btn btn-primary btn-block" %>

                      </div>
                      
                    </div>