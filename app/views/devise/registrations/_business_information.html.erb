<div class="w-row">
  <div class="onboarding-table-column-1 w-col w-col-8">
    <div class="onboarding-form-section">
      <div class="get-started-2 onboarding-form-div sign-in signup">
        <h4 class="form-header">Business Information</h4>
        <div class="flex-underline form-header-underline"></div>
        <div class="get-started-2 log-in-form w-form">
          <%= form_for(resource, as: resource_name, data: { name: "Email Form" }, url: registration_path(resource_name), html: { method: :put, id: "merchantProfile", class: "w-clearfix rhombusFocus" }) do |f| %>
            <input class="login text-field w-input" data-name="Name" id="Name" maxlength="256" name="Name" placeholder="Full name" required="required" type="text">
            <input class="login text-field w-input" data-name="Business Name" id="Business-Name-5" maxlength="256" name="Business-Name" placeholder="Business name" required="required" type="text">
            <label class="form-label" for="Company-Size-2">Team size</label>
            <select class="dropdown w-select" data-name="Company Size 2" id="Company-Size-2" name="Company-Size-2" required="required">
              <option value="">1 - 5 employees</option>
              <option value="First">6 - 20 employees</option>
              <option value="Second">21 - 50 employees</option>
              <option value="">51 - 100 employees</option>
              <option value="">101 - 200 employees</option>
              <option value="">201 - 500 employees</option>
              <option value="">501 - 1000 employees</option>
              <option value="">1001 - 3000 employees</option>
              <option value="">3001 - 5000 employees</option>
              <option value="">5000+ employees</option>
            </select>
            <label class="form-label" for="Department-2">We'd like to use Rhombus for:</label>
            <select class="dropdown w-select" data-name="Department 2" id="Department-2" multiple="multiple" name="Department-2" required="required">
              <option value="First">Customer Support</option>
              <option value="Second">Sales</option>
              <option value="Third">Marketing</option>
              <option value="Fourth">Payments</option>
            </select>
            <label class="form-label" for="Org-Type-2">Organization type</label>
            <select class="dropdown w-select" data-name="Org Type 2" id="Org-Type-2" name="Org-Type-2" required="required">
              <option value="">Business</option>
              <option value="">Nonprofit</option>
              <option value="">Education [K12]</option>
              <option value="">Education [University &amp; Colleges]</option>
              <option value="">Individual</option>
            </select>
            <label class="form-label" for="Timezones-3">Set Timezone:</label>
            <select class="dropdown w-select" data-name="Timezones 3" id="Timezones-3" name="Timezones-3" required="required">
              <option value="">EST - Eastern Standard Time [North America] - UTC--05</option>
            </select>
            <input class="button log-in w-button" data-wait="Please wait..." type="submit" value="Continue">
          <% end %>
          <div class="w-form-done">
            <div>Thank you! Your submission has been received!</div>
          </div>
          <div class="w-form-fail">
            <div>Oops! Something went wrong while submitting the form</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="onboarding-table-column-2 w-col w-col-4">
    <div class="onboarding-right-bar">
      <div class="w-container whats-new-container">
        <div class="whats-new-content-wrapper">
          <h4 class="onboarding-side-bar-h4">get started: step 2</h4>
          <h3 class="onboarding-side-bar-h3">Welcome to Relay</h3>
          <p class="onboarding-side-bar-paragraph">Thanks for choosing us to handle your customer communications via SMS and Messenger.</p>
          <p class="onboarding-side-bar-paragraph">To help setup your dashboard, tell us more about your business</p>
          <div class="left-arrow"></div>
        </div>
      </div>
    </div>
  </div>
</div>
