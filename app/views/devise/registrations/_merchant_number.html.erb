

    <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Merchant Profile') %>

  <body>

  <style type="text/css">
    body{background: #F5F5F5;}
  </style>

  <div class="completeAccount">

    <!-- //////////////////////////////////////////////////////////////////////////// -->
<!-- START CONTAINER -->
<div class="container-padding">

  <!-- Start Row -->
 <div class="row">
      <div id="profileLogo"><img src="<%= asset_path 'logo.jpg' %>" alt="icon" id="signup_logo" class="icon"></div>

      <div class="panel panel-default" id="merchantprofilepage">

            <div class="panel-body">

            <% countries = TextingService.twilio_list %>
            <select id="searchNumberCountry">
              <% countries.keys.each do |k| %>
                <option value="<%= k %>" <%= "selected" if k.to_s == "US" %> ><%= TextingService.twilio_list[k][:name] %></option>
              <% end %>
            </select>

            <select id="searchNumberType">
              <option value="local">Local</option>
              <option value="toll_free">Toll Free</option>
            </select>

            <br> <br>

            <input id="searchNumberField" placeholder='Enter area code' type="text" />
            <button id="searchNumberBtn">Search</button>


<style type="text/css">

#search_number_form label {
   display: block;
   width: 40%;
   text-align: center;
}
</style>

            <%= form_for(resource, :as => resource_name, :url => registration_path(resource_name), :html => { :method => :put, class: "form-horizontal rhombusFocus", id: "search_number_form" }) do |f| %>

              <div class="form-group">
                <div class="col-sm-10">
                  <%#= f.text_field :rhombus_number, type: "text", class: "form-control rhombusFocus", placeholder: "Rhombus Number", id: "rhombus_number", readonly: "true" %>
              </div>
              </div>
<%
=begin %>
                <div class="form-group">
                  <label class="col-sm-2 control-label form-label">Password</label>
                  <div class="col-sm-10">
                  <%= f.password_field :current_password, type: "password", class: "form-control rhombusFocus", placeholder: "Re-enter current password", id: "reenterPassword" %>
                  </div>
                </div>
<%
=end %>
                <div class="form-group">
                  <div class="col-sm-offset-2 col-sm-10">
                  <%= f.submit "Submit", id: "ba-submit", :class => "btn btn-default btn-rhombus" %>
                  </div>
                </div>

              <% end %>

            </div>

      </div>
      <div id="signout1"><%= link_to "LOG OUT", destroy_user_session_path, method: :delete %></div>
  </div>

  <!-- End Row -->


</div>
<!-- END CONTAINER -->
 <!-- //////////////////////////////////////////////////////////////////////////// -->

 </div>

</body>
</html>
