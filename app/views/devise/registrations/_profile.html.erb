<div class="w-row">
  <div class="onboarding-table-column-1 w-col w-col-8">
    <div class="onboarding-form-section">
      <div class="onboarding-form-div sign-in signup">
        <h4 class="form-header">Choose Area Code</h4>
        <div class="flex-underline form-header-underline"></div>
        <div class="get-started-2 log-in-form w-form">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, id: "merchantProfile", class: "w-clearfix rhombusFocus", data: { name: 'Email Form' } }) do |f| %>
            <label class="form-label" for="Country-3">In what country would you like your number?</label>
            <select class="dropdown w-select" data-name="Country 3" id="Country-3" name="Country-3" required="required">
              <option value="">Select Country</option>
              <option value="First">United States</option>
              <option value="Second">Canada</option>
              <option value="">Australia</option>
              <option value="">Austria</option>
              <option value="">Belgium</option>
              <option value="">Chile</option>
              <option value="">Czech Republic</option>
              <option value="">Estonia</option>
              <option value="">Finland</option>
              <option value="">France</option>
              <option value="">Germany</option>
              <option value="">Hungary</option>
              <option value="">Israel</option>
              <option value="">Lithuania</option>
              <option value="">Norway</option>
              <option value="">Poland</option>
              <option value="">Spain</option>
              <option value="">Sweden</option>
              <option value="">Switzerland</option>
              <option value="">United Kingdom</option>
              <option value="">Puerto Rico</option>
            </select>
            <label class="form-label" for="Area-Code-2">Enter preferred area code:</label>
            <input class="login text-field w-input" data-name="Area Code 2" id="Area-Code-2" maxlength="256" name="Area-Code-2" placeholder="E.g. 415" required="required" type="text">
            <div class="area-code-availability flex-underline form-header-underline"></div>
            <label class="form-label paragraph" for="Area-Code-Unavailable-CTA-2">Area code availability depends on the telecom network providers. What would you like to do if your preferred area code is unavailable?</label>
            <select class="dropdown w-select" data-name="Area Code Unavailable Cta 2" id="Area-Code-Unavailable-CTA-2" name="Area-Code-Unavailable-CTA-2" required="required">
              <option value="First">Give me any area code</option>
              <option value="Second">Let me try another area code</option>
            </select>
            <input class="button log-in w-button" data-wait="Please wait..." type="submit" value="Continue">
          <% end %>
          <div class="w-form-done">
            <div>Thank you! Your submission has been received!</div>
          </div>
          <div class="w-form-fail">
            <div>Oops! Something went wrong while submitting the form</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="onboarding-table-column-2 w-col w-col-4">
    <div class="onboarding-right-bar">
      <div class="w-container whats-new-container">
        <div class="whats-new-content-wrapper">
          <h4 class="onboarding-side-bar-h4">get started: step 2</h4>
          <h3 class="onboarding-side-bar-h3">Let's setup your phone number</h3>
          <p class="onboarding-side-bar-paragraph">You can exchange SMS and MMS messages with customers using your Relay assigned phone number.</p>
          <p class="onboarding-side-bar-paragraph">To ditch those long phone calls faster, display your Relay number on your web site, Yelp or Angie's List profile, including fliers and signs.</p>
          <div class="left-arrow"></div>
        </div>
      </div>
    </div>
  </div>
</div>
