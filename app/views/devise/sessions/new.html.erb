 <!-- ========== Css Files ========== -->
  <% provide(:title, 'Rhombus - Sign In') %>
  <%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <% end %>
  
  <style type="text/css">
    body{background: #F5F5F5;}
  </style>

  <body>
      <%= render 'shared/full_messages' %>

    <div class="login-form">
      <%= form_for(resource, :as => resource_name, :html=> {:id => 'signinForm'} , :url => session_path(resource_name)) do |f| %> 
        <div class="top">
          <img src="<%= asset_path 'logo_grey.jpg' %>" alt="icon" class="icon" id="signup_logo">
          <h4>Welcome Back!</h4>
        </div>
        <div class="form-area">
          <div class="group">
            <%= f.email_field :email, type: "email", :class => "form-control rhombusFocus", placeholder: "Email" %>
            <i class="fa fa-envelope-o"></i>
          </div>
          <div class="group">
            <%= f.password_field :password, type: "password", :class => "form-control rhombusFocus", placeholder: "Password" %>

            <i class="fa fa-key"></i>

          </div>
          <div class="checkbox checkbox-primary">
            <input id="checkbox101" type="checkbox" checked>
            <%#<label for="checkbox101"> Remember Me</label>%>
            <% if devise_mapping.rememberable? -%>
                <%= f.check_box :remember_me, id: "checkbox1", checked: "checked" %> <label for="checkbox1"> Remember Me</label>
              <% end -%>
          </div>
          <%= f.submit "LOGIN", :class => "btn btn-default btn-block btn-rhombus" %>
        </div>
      <% end %>
      <div class="footer-links row">
        <div class="col-xs-6"><a href="/signup"><i class="fa fa-external-link"></i> Sign Up</a></div>
        <%- if devise_mapping.recoverable? && controller_name != 'passwords' %>
          <div class="col-xs-6 text-right">
              <%= link_to new_password_path(resource_name) do %>            
                <i class="fa fa-lock"></i> Forgot password
              <% end %>
          </div>
        <% end -%>
      </div>
    </div>

</body>
</html>

</body>







