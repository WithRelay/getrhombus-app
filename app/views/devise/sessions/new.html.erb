<% provide(:title, 'Rhombus - Sign In') %>
<%= render 'shared/full_messages' %>

<div class="w-row">
  <div class="onboarding-table-column-1 w-col w-col-8">
    <div class="onboarding-form-section">
      <div class="onboarding-form-div sign-in">
        <%= link_to root_url, class: 'form-logo w-inline-block' do %>
          <%= image_tag('relay-4.png', width: 50) %>
        <% end %>
        <div class="log-in-form w-form">
          <%= form_for(resource, as: resource_name, html: { id: 'email-form signinForm', class: 'w-clearfix', data: { name: 'Email Form' } }, url: session_path(resource_name)) do |f| %>
            <%= f.email_field :email, id: 'Email-2', class: "form-control rhombusFocus login text-field w-input", placeholder: "Email", data: { name: 'Email' }, max_length: 100 %>
            <%= f.password_field :password, class: "form-control rhombusFocus login text-field w-input", placeholder: "Password", max_length: 100, id: 'Password-2', data: { name:'Password 2' } %>
            <%= f.hidden_field :captured_amt, id: "captured_amt", value: params[:user] ? params[:user][:captured_amt] : '' %>
            <%= f.hidden_field :referrer_id, id: "referrer_id", value: params[:user] ? params[:user][:referrer_id] : '' %>
            <%= f.hidden_field :referrer_uid, id: "referrer_uid", value: params[:user] ? params[:user][:referrer_uid] : '' %>
            <%= f.hidden_field :msg_id, id: "msg_id", value: params[:user] ? params[:user][:msg_id] : '' %>
            <%= f.hidden_field :tag_id, id: "tag_id", value: params[:user] ? params[:user][:tag_id] : '' %>
            <%= f.submit 'Sign in', class: 'button log-in w-button', data: { wait: 'Please wait...' } %>
            <%= f.label :remember_me %>
            <%= f.check_box :remember_me, id: "checkbox1", checked: devise_mapping.rememberable? %>
          <div class="w-form-done">
            <div>Thank you! Your submission has been received!</div>
          </div>
          <div class="w-form-fail">
            <div>Oops! Something went wrong while submitting the form</div>
          </div>
      <% end %>
    </div>
        <div class="log-in-sign-up-cta">Don't have a Rhombus account? <%= link_to 'Sign up', new_user_registration_path, class:'links sign-up-cta-log-in-page' %>
        </div>
      </div>
      <div class="forgot-password links">Forgot your password?&nbsp;
        <%- if devise_mapping.recoverable? && controller_name != 'passwords' %>
          <%= link_to new_password_path(resource_name) do %>
            <i class="fa fa-lock"></i> Forgot password
          <% end %>
        <% end -%>
      </div>
    </div>
  </div>
  <div class="onboarding-table-column-2 w-col w-col-4">
    <div class="onboarding-right-bar">
      <div class="w-container whats-new-container">
        <div class="whats-new-content-wrapper">
          <h4 class="onboarding-side-bar-h4">WHAT'S NEW</h4>
          <h3 class="onboarding-side-bar-h3">Check out our new Shopify Integration.</h3>
          <p class="onboarding-side-bar-paragraph">Rejoice eCommerce businesses! We've integrated Shopify. This integration allows you to track your customer metrics from inside Rhombus and set automatic mobile messaage based on what they do in your online store.</p>
          <div class="sign-in-right-bar-cta">Learn More &nbsp; </div>
        </div>
      </div>
    </div>
  </div>
</div>
