
<% provide(:title, 'Rhombus - Sign In') %>
<div class="w-row">
  <div class="onboarding-table-column-1 w-col w-col-8">
    <div class="onboarding-form-section">
      <div class="onboarding-form-div sign-in">
        <%= link_to root_url, class: 'form-logo w-inline-block' do %>
          <%= image_tag('Relay-Transparent-500x300.png', width: 50) %>
        <% end %>


        <div class="log-in-form w-form">
          <%= form_for(resource, as: resource_name, html: { id: 'signinForm', class: 'w-clearfix' }, url: session_path(resource_name)) do |f| %>
            <div class= "form-group col-xs-5">
              <%= f.email_field :email, id: 'Email-2', class: "form-control rhombusFocus login text-field w-input", placeholder: "Email" %>
            </div>
    
            <div class="form-group col-xs-5">
              <%= f.password_field :password, class: "form-control rhombusFocus login text-field w-input", placeholder: "Password", id: 'Password-2' %>
            </div>
            
            <%= f.hidden_field :captured_amt, id: "captured_amt", value: params[:user] ? params[:user][:captured_amt] : '' %>
            <%= f.hidden_field :referrer_uid, id: "referrer_uid", value: params[:user] ? params[:user][:referrer_uid] : '' %>
            <%= f.hidden_field :msg_id, id: "msg_id", value: params[:user] ? params[:user][:msg_id] : '' %>
            <%= f.hidden_field :tag_id, id: "tag_id", value: params[:user] ? params[:user][:tag_id] : '' %>
            
            <%= f.submit 'Sign in', class: 'button log-in w-button' %>
            
            <%#= f.label :remember_me %>
            <%#= f.check_box :remember_me, id: "checkbox1", checked: devise_mapping.rememberable? %>
        </div>

            <div class="def login-form-row w-row">
              <div class="log-in-form-row-column-1 w-col w-col-6">
                <div class="w-form">
                    <div class="footer-cta form-check-box login-form w-checkbox">
                      <%= f.check_box :remember_me, id: "checkbox1", checked: devise_mapping.rememberable?, class: "w-checkbox-input" %>
                      <%= f.label :remember_me, class: "w-form-label", for: "checkbox-3" %>
                    </div>
                </div>
              </div>
            <% end %>
            <div class="log-in-form-row-column-2 w-clearfix w-col w-col-6">
                <%- if devise_mapping.recoverable? && controller_name != 'passwords' %>
                  <%= link_to new_password_path(resource_name) do %>
                    <div class="links login-form-password-reset">Forgot your password?</div>
                  <% end %>
                <% end -%>
              </div>
            </div>
     </div>
        <div class="log-in-sign-up-cta">Don't have a Rhombus account?
         <%= link_to 'Sign up', new_user_registration_path ,class: "links sign-up-cta-log-in-page" %>
        <!-- <a href="#" class="links sign-up-cta-log-in-page">Sign up.</a> -->
        </div>
    </div>
  </div>
    <div class="onboarding-table-column-2 w-col w-col-4">
      <div class="onboarding-right-bar">
        <div class="w-container whats-new-container">
          <div class="whats-new-content-wrapper">
            <h4 class="onboarding-side-bar-h4">WHAT'S NEW</h4>
            <h3 class="onboarding-side-bar-h3">Rhombus is now Relay.</h3>
            <p class="onboarding-side-bar-paragraph">We've re-imagined the entire platform to make it easier for you to reach your customers and get paid faster using mobile messages. Go ahead and explore all the exciting features in this update, and of course we'd love to hear from you; let us know what you think.</p>
            <div class="sign-in-right-bar-cta"><a href="#" class="onboarding-learn-more-link">Learn more &nbsp; </a>
            </div>
          </div>
        </div>
      </div>
    </div>
</div>
