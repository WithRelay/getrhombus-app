<div class="settings sub-nav-bar w-clearfix">
  <%= link_to user_path(current_user) , class: 'dashboard-return sub-nav-button w-button' do %>
   &nbsp;Return to dashboard
  <% end %>
</div>
<div class="dashboard-body settings">
  <div class="dash-content-container integrations settings w-clearfix">
    <h4 class="form-header">Integrations</h4>
    <div class="flex-underline form-header-underline"></div>
    <div class="integrations-row w-row">
      <div class="w-clearfix w-col w-col-9">
        <%= image_tag 'messenger-logo.png', class: 'integration-partner-icon', width: 50 %>
        <h4 class="integration-partner-name">Facebook Messenger</h4>
        <p class="integration-description-paragraph">Facebook Messenger connects people with friends and businesses across platforms and devices.This integration allows your customers to chat with your team from Facebook and the Messenger app.</p>
      </div>
    </div>
    <div class="integration-settings-div">
      <div class="w-row">
        <div class="w-col w-col-6">
          <h4 class="authentication-column-header">Authentication</h4>
        </div>
        <div class="w-col w-col-6">
          <div class="authentication-column-text name-tag">Connected to Facebook as <%= @fb_cred.name %></div>
        </div>
      </div>
      <% if present(current_user).page_count %>
      <div class="w-row">
        <div class="w-col w-col-6">
          <p class="authentication-column-paragraph">Choose the Facebook page that you will use to receive messages</p>
        </div>
        <div class="w-col w-col-6">
          <div class="w-form">
            <%= form_for :fb_page, url: user_update_fb_page_path(current_user), html: { class: 'w-clearfix' }, method: :patch do |f| %>
              <%= select_tag 'Select Facebook page', options_for_select(@user_fb_pages.map{|p| ["#{p.page_name}", "#{p.id} #{p.subscription_status}"] }), class: "dropdown select-facebook-page w-select", id: "Select-Facebook-Page", prompt: 'Select a Facebook Page' %>

              <p>Subscribed Page:
                <% if subscribed_page.present? %>
                  <span> <%= subscribed_page %> </span>
                <% else %>
                  <b class='authentication-column-text name-tag '>No page is subscribed yet</b>
                <% end %>
              </p>
              <div class="w-col w-col6 pull-right">
               <%= f.submit '' , class: 'submit_page hide', id: 'select_page', param: "#{current_user.fb_creds.first.name}", subscribed_page: "#{subscribed_page}" %>
              </div>

            <% end %>
          </div>
        </div>
      </div>
      <% else %>
        <p>Please make a facebook page to proceed.</p>
      <%end%>

      <%= link_to fb_pages_remove_integration_path, id: 'delete_integration', class: 'pull-right button integrate-button w-button remove_fb_integration' do%>
        Remove Integration
      <%end%>

    </div>
</div>
