<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="content-type" content="text/html;charset=UTF-8" />
  <meta charset="utf-8" />
  <title><%= content_for?(:title) ? yield(:title) : "Rhombus" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta content='Make payments via text messages' name="description" />
  <%= favicon_link_tag "favicon.ico" %>
  <link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/font-awesome/4.3.0/css/font-awesome.min.css">
  <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
  <%= yield :head %>
  <%= javascript_include_tag "application_dashboard_messaging" %>
  <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/danialfarid-angular-file-upload/12.2.5/ng-file-upload-all.min.js" integrity="sha256-B9ZVWi/bArdi6DbU13iqW3h9Ry/4ppA8190Sx/j4G10=" crossorigin="anonymous"></script>
  <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/angucomplete-alt/2.4.2/angucomplete-alt.min.js" integrity="sha256-kqrOgJ8akBtAzdlPGWemWNHttiYHTvWZn/pksZGikZU=" crossorigin="anonymous"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.4/js/bootstrap.min.js"></script>

  <!-- <script src="https://cdnjs.cloudflare.com/ajax/libs/clipboard.js/1.5.1/clipboard.min.js"></script> -->
  
  <%= javascript_include_tag "plugins" %>
  <%= yield :head_script %>
  <%= csrf_meta_tags %>

</head>
<body style = "background: #f4f4f4">
   <!-- Start Page Loading -->
  <div class="loading"><img src="<%= asset_path 'loading.gif' %>" alt="loading-img"></div>

  <div class="content">
    <div class="page-header">
      <p>Connected to Facebook as
        <span style="color: blue"> 
          <i class="fa fa-user"></i> <%= current_user.fb_cred.name %>
        </span>
      </p>
      
      <h1>Facebook Messenger</h1>
      <% if present(current_user).page_count %>
        <p> Choose the Facebook page that you will use to receive messages </p>
        <h3>Facebook Page</h3>
        <%= form_for :fb_page, url: user_update_fb_page_path(current_user), method: :patch do |f| %>
          <div class="dropdown">
            <%= select_tag 'select_page', options_for_select(@user_fb_pages.map{|p| ["#{p.page_name}", "#{p.id} #{p.subscription_status}"] }), class: "btn dropdown-toggle", prompt: 'Select a Facebook Page' %>
            <%= f.submit '' , class: 'submit_page', param: "#{current_user.fb_cred.name}", data: { disable_with: "Please wait..." }, subscribed_page: "#{subscribed_page}" %>
          </div>

          <br>
          <p>Subscribed Page:
          <% if subscribed_page.present? %>
            <span style="color: green">
              <i class="fa fa-file" aria-hidden="true"></i> <%= subscribed_page %>
            </span>
          <% else %>
            <b>No page is subscribed yet</b>
          <% end %>
          </p>

        <%end%>
      <% else %>
        <p> Please make some facebook page before proceed</p>
      <%end%>

      <br/>
      <%= link_to fb_pages_remove_integration_path, id: 'delete_integration', class: 'pull-right' do%>
        <i class="fa fa-trash" aria-hidden="true"> Remove Integration </i>
      <%end%>
    </div>
    </div>

  </div>
  <!-- End Page Loading -->
  <%= render 'shared/header_new' %>
  <%= render 'shared/sidebar' %>

  <%= yield %>

  <%= render 'shared/smooch' %>
  <%= render 'shared/google_analytics' %>
</body>
</html>

    