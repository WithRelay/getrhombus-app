<%= form_for @user, url: { action: "create_managed_acct" } do |f| %>
  
  <%# https://hackhands.com/building-has_many-model-relationship-form-cocoon/ %>
 
  <% if @user.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h2>

      <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <%= notice %>

  <%= f.fields_for :address do |a| %>
    <div>
      <%= a.label :country %>
      <%= a.text_field :country %>
    </div>
  <% end %>

  <%= f.select :org_type, options_for_select({ "Individual" => "Individual", "Business" => 'Business' }, selected: @user.org_type), include_blank: 'Select business type' %><br>
  Legal Name <%= f.text_field :org_name %><br>

  URL <%= f.text_field :url %><br>
  EIN <%= f.text_field :org_tax_id %><br>
  tell us about your organization <%= f.text_area :description %><br>

  <%= f.fields_for :address do |a| %>
    <div>
      <label>Street Addres</label>
      <%= a.text_field :street_address %>
    </div>
    <div>
      <%= a.label :city %>
      <%= a.text_field :city %>
    </div>
    <div>
      <label>State/Province</label>
      <%= a.text_field :state_province %>
    </div>
    <div>
      <%= a.label :postal_code %>
      <%= a.text_field :postal_code %>
    </div>
  <% end %>

  <br><br><br>
  <%= f.fields_for :bank_accounts do |b| %>
    <div>
      <label>Account Number</label>
      <%= b.text_field :account_number %>
      <%= b.hidden_field :last4 %>
    </div>
    <div>
      <%= b.label :routing_number %>
      <%= b.text_field :routing_number %>
    </div>
    <div>
      <label>Country</label>
      <%= b.text_field :country %>
    </div>
    <div>
      <%= b.label :currency %>
      <%= b.text_field :currency %>
    </div>
  <% end %>

  <br><br>

  <fieldset id="user-people">
    <ol>
      COMPANY REP
      <%= f.fields_for :people do |p| %>
        <%= render "person_fields", f: p %> 
      <% end %>
      <br><br>
      OWNERS IF ANY <br>
    </ol>
    <%= link_to_add_association 'add people', f, :people, 'data-association-insertion-node' => "#user-people ol", 'data-association-insertion-method' => "append", :wrap_object => Proc.new { |p| p.build_address; p } %>
  </fieldset>

  <br><br>
  <%= f.fields_for :stripe_cred do |c| %>
    <div>
      <%= c.hidden_field :uid_type, value: 'managed' %>
      <%= c.hidden_field :ip %>

      <!--<script type="text/javascript">$('#UserAgent').val(navigator.userAgent);
      </script>-->
      <%= c.hidden_field :user_agent %>
    </div>
    
    <% if c.object.persisted? %>
      <%= c.check_box :charges_enabled, disabled: true %> 
      <%= c.check_box :transfers_enabled, disabled: true %>
      <div><%= c.object.disabled_reason %>ssss</div>
      <div><%= c.object.due_by %></div>
      <div><%= c.object.fields_needed %></div>
    <% end %>  
  <% end %>

  <br><br>



  <div class="actions">
    <%= f.submit 'Create Account', data: { disable_with: "Please wait..." } %>
  </div>


<% end %>
