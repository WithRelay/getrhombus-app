<% provide(:title, 'Rhombus - Merchant Profile') %>
<div class="settings sub-nav-bar w-clearfix">
  <%= link_to user_path(current_user) , class: 'dashboard-return sub-nav-button w-button' do %>
    Return to dashboard
  <% end %>
</div>
<div class="dashboard-body settings">
  <div class="dash-content-container settings">
    <h4 class="form-header">Business Information</h4>
    <div class="flex-underline form-header-underline"></div>
    <div class="account-settings-form-wrapper">
      <%= form_for(current_user, url: user_registration_update_path(current_user), html: { method: :patch, id: "businessSetting", class: "w-clearfix" }) do |f| %>

        <label class="field-headers form-label settings" for="Business-Name">Basic details</label>
          <div class="form-group col-xs-6">
            <%= f.text_field :org_name, class: "form-control full-name settings text-field w-input", placeholder: "Business legal name" %>
          </div>
        <label class="form-label paragraph" for="Organization-Type">Your business name will appear on both your customer’s card statement &amp; receipts. If your business doesn't have a name, enter your product or services and your city, e.g. “Bakery - New York”</label>

        <div class="form-group col-xs-6 inline-display">
          <%= f.select :org_type, options_for_select(business_type_list, f.object.org_type), { prompt: 'Organization Type' }, class: 'form-control organization-type w-select' %>
        </div>

        <%= f.select :org_category, options_for_select(business_categories, f.object.org_category), { prompt: 'Business category (optional)' }, class: 'form-control business-category organization-type w-select' %>

        <div class="flex-underline form-section-divider"></div>

        <label class="field-headers form-label settings" for="Street-Address">ADDRESS INFORMATION</label>
        <%= f.fields_for :address do |a| %>
          <div class="form-group col-xs-6">
            <%= a.text_field :street_address, type: "text", class: "form-control settings street-name text-field w-input", placeholder: "Street Address" %>
          </div>

          <div class="form-group col-xs-6">
            <%= a.text_field :suite, type: "text", class: "form-control apt_suite settings text-field w-input", placeholder: "Suite" %>
          </div>

          <div class="form-group col-xs-6">
            <%= a.text_field :city, class: "form-control city settings text-field w-input", placeholder: "City" %>
          </div>

          <div class="form-group col-xs-6">
            <%= a.text_field :state_province, class: "form-control settings state text-field w-input", placeholder: "State/Province" %>
          </div>

          <div class="form-group col-xs-6">
            <%= a.text_field :postal_code, class: "form-control settings text-field w-input zip", placeholder: "Zip/Postal code" %>
          </div>

          <div class="form-group col-xs-6">
            <%= a.select :country, country_list, { prompt: 'Select your country' }, { class: 'form-control country_dropdown w-select' } %>
          </div>
        <% end %>
        <div class="flex-underline form-section-divider"></div>
        <label class="field-headers form-label settings" for="Website">other INFORMATION</label>

        <div class="form-group col-xs-6">
          <%= f.url_field :url, class: "form-control settings short-field text-field w-input", placeholder: "Website" %>
        </div>

        <div class="form-group col-xs-6">
          <%= f.number_field :tax_percent, step: 0.1, min: 0, class: "form-control settings tax text-field w-input", id: 'user_tax_percent', placeholder: "Tax" %>
        </div>

        <label class="form-label other-info paragraph" for="Re-enter-Password">Set the tax rate that will be applied to every transaction made by your customers via Rhombus. The default rate is set at zero.</label>

        <%= f.submit "Save changes", id: "ba-submit", class: "button save-changes w-button" %>
        <input type="hidden" name="page_params" value="business_settings">

      <% end %>
    </div>
  </div>
</div>
