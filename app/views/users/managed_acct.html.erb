<div class="panel panel-info">

  <div class="panel-heading">
    <div class="panel-title text-center">Stripe Managed Account</div>
  </div>

  <%= form_for @user, url: { action: url_for_create_update }, html: { id: 'managed-account-form' } do |f| %>

    <ul id="progressbar">
      <li class="active">Account Setup</li>
      <li>Social Profiles</li>
      <li>Personal Details</li>
      <li>Personal Details</li>
    </ul>

    <fieldset id='step_one_business_details'>
      <h2 class="fs-title">Create your account</h2>
		  <h3 class="fs-subtitle">This is step 1</h3>

      <%= f.fields_for :address do |a| %>
        <div class="col-xs-5">
          <%= a.label :country %>
          <%= a.select :country, options_for_select(connect_country(a.object), selected: a.object.country), {}, class: 'rhombusFocus', id: 'managed-acct-country' %>
        </div>
      <% end %>

      <%= f.label :business_type %>
      <%= f.select :org_type, options_for_select(connect_org_type(f.object), selected: present(current_user).org_type_on_managed_acct_page) %>

      <br>
      <br>
      <div id='org-name-div'>
        <label>Publicly Sharable Name</label>
        <%= f.text_field :org_name, id: 'org-name' %>
      </div>

      <div class="col-xs-10">
        <%= f.label :url %>
        <%= f.text_field :url %><br>
      </div>

      <div class="col-xs-10">
        <label id='org-tax-id-label'>EIN</label>
        <%= f.text_field :org_tax_id, id: 'org-tax-id' %>
        <span id='org-tax-id-req'>(optional)</span>
      </div>

      <div class="col-xs-10">
        <label> tell us about your organization </label>
        <%= f.text_area :description %>
      </div>
      <%= f.submit 'Next', class: "next action-button" %>
    </fieldset>

    <fieldset id='step_two_address'>
      <h2 class="fs-title">Social Profiles</h2>
      <h3 class="fs-subtitle">Your presence on the social network</h3>
      <%= f.fields_for :address do |a| %>

        <div class="col-xs-5">
          <label>Street Addres</label>
          <%= a.text_field :street_address, id: 'company-street' %>
        </div>

        <div class="col-xs-5">
          <%= a.label :city %>
          <%= a.text_field :city, id: 'company-city' %>
        </div>

        <div id='company-state-div'>
          <div class="col-xs-5">
            <label>State/Province</label>
            <%= a.text_field :state_province, id: 'company-state' %>
          </div>
        </div>

        <div id='company-postal-code-div'>
          <div class="col-xs-5">
            <%= a.label :postal_code %>
            <%= a.text_field :postal_code, id: 'company-postal-code' %>
          </div>
        </div>

      <% end %>

      <input type="button" name="previous" class="previous action-button" value="Previous" />
      <%= f.submit 'Next', class: "next action-button" %>
    </fieldset>

    <fieldset id='step_3_bank_account' >
      <h2 class="fs-title">Social Profiles 2</h2>
      <h3 class="fs-subtitle">Your presence on the social network</h3>
      <%= f.fields_for :bank_accounts do |b| %>

        <div class="col-xs-5">
          <label id='account-number-label' >Account Number</label>
          <%= b.text_field :account_number, id: 'account-number' %>
        </div>

        <div class="col-xs-5">
          <div id='routing-number-div'>
            <%= b.label :routing_number, id: 'routing-number-label' %>
            <%= b.text_field :routing_number, id: 'routing-number' %>
          </div>
        </div>

        <div id='institution-number-div'>
          <div class="col-xs-5">
          <%= b.label :institution_number, id: 'institution-number-label' %>
          <%= b.text_field :institution_number, id: 'institution-number', placeholder: '000' %>
          </div>
        </div>

        <div id='account-country-div'>
          <div class="col-xs-5">
            <%= b.label :country %>
            <%= b.text_field :country, id: 'account-country', value: b.object.country %>
            <select id="account-country-select"></select>
          </div>
        </div>

        <div id='bank-currency-div'>
          <div class="col-xs-5">
            <%= b.label :currency %>
            <%= b.text_field :currency, id: 'bank-currency', value: b.object.currency %>
            <select id="bank-currency-select"></select>
          </div>
        </div>

      <% end %>

      <div id='ddr-div'>DDR message for australia only i think</div>

      <input type="button" name="previous" class="previous action-button" value="Previous" />
      <%= f.submit 'Next', class: "next action-button" %>
    </fieldset>

    <fieldset id="user-people">
      <h2 class="fs-title">Social Profiles 3</h2>
      <h3 class="fs-subtitle">Your presence on the social network</h3>

      <%= f.fields_for :people do |p| %>
        <%= render "person_fields", f: p %>
      <% end %>
      <div id='owners-title'>OWNERS IF ANY <br></div>

      <div id='add-owner-link'><%= link_to_add_association 'add people', f, :people,
              'data-association-insertion-node' => "#user-people ol", 'data-association-insertion-method' => "append",
              :wrap_object => Proc.new { |p| p.build_address; p } %>
      </div>
      <input type="button" name="previous" class="previous action-button" value="Previous" />
      <input type="button" name="next" class="next action-button" value="Next" />
    </fieldset>

    <fieldset>
      <h2 class="fs-title">Social Profiles 4</h2>
      <h3 class="fs-subtitle">Your presence on the social network</h3>
      <%= f.fields_for :stripe_creds do |c| %>
        <% if c.object.persisted? %>
          <%= c.check_box :charges_enabled, disabled: true %>
          <%= c.check_box :transfers_enabled, disabled: true %>
          <div><%= c.object.disabled_reason %>ssss</div>
          <div><%= c.object.due_by %></div>
          <div><%= c.object.fields_needed %></div>
        <% end %>
        <%= c.hidden_field :ip %>
      <% end %>
      <%= f.label 'Accept Terms and Service' %>
      <%= f.check_box :tos_acceptance %>
      <input type="button" name="previous" class="previous action-button" value="Previous" />
		  <input type="submit" name="submit" class="submit action-button" value="Submit" />
    </fieldset>
  <% end %>
</div>
