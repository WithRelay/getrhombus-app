<%= provide(:title, "Rhombus - Businesses") %>

<!-- ========== Css Files ========== -->
  
<%= content_for :head do %>
  <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
<% end %>

<body>
  <!-- Start Page Loading -->
  <div class="loading"><img src="<%= asset_path 'loading.gif' %>" alt="loading-img"></div>
  <!-- End Page Loading -->

 <%= render 'shared/header_new' %>
  <%= render 'shared/sidebar' %>



 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTENT -->
<div class="content">

  <!-- Start Page Header -->
  <div class="page-header" style="background: transparent; margin-bottom: 0px;">
    <div class="title" style="font-weight: normal;">Businesses</div>

    <%= render 'shared/dashboard_shortcut' %>
  </div>

 <!-- //////////////////////////////////////////////////////////////////////////// --> 
    <!-- START CONTAINER -->
    <div class="" id="transactions-column">

     <!-- Start Row -->
      <div class="row">

        <!-- Start Panel -->
        <div class="col-md-12">
          <% unless @businesses.blank? %>
              <div class="panel panel-default">
                <div class="panel-title">
                  <ul class="panel-tools">
                    <li><a class="icon expand-tool"><i class="fa fa-expand"></i></a></li>
                  </ul>
                </div>

                <div class="panel-body table-responsive">
                  <table id="transactions-table" class="table table-striped dataTable">
                    <thead>
                      <tr role="row">
                        <td class="text-center"><i class="fa fa-trash" style="visibility: hidden;"></i></td>
                        <th>Name</th>
                        <th>First Visit (ET)</th>
                        <th>Last Visit</th>
                        <th>Avg Spend</th>
                        <th>Total Spend</th>
                        <th>Visits in last 30 days</th>
                      </tr>
                    </thead>
                    <tbody>
                    <% @businesses.each do |b| %>
                      <tr role="row">
                        <td class="details-control" data-page="users" data-email="<%= b.email %>"
                          data-phone="<%= b.business_phone %>"

                          <%# if current_user.user_level == 0 %>
                             <%# data-rhombus-number= <%= b.rhombus_number %>
                          <%# end %>

                        ></td>
                        <td><%= b.business_name %></td>
                        <td><%= (b.first_visit) ? b.first_visit.strftime("%m/%d/%Y") : '--' %></td>
                        <td><%= (b.last_visit) ? b.last_visit.strftime("%m/%d/%Y") : "--" %></td>
                        <td><%= number_to_currency(b.avg_spend) %></td>
                        <td><%= number_to_currency(b.total_spend) %></td>
                        <td><%= b.last_30 %></td>
                      </tr>
                    <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            <% else %>
            <div class="center">
                <img src="<%= asset_path 'no-user.png' %>" alt="no user">
                <div class="no-user">You have no businesses :(</div>
            </div>
          <% end %>
        </div>
        <!-- End Panel -->
          <div style="text-align: center; margin-bottom: 40px;"><%= will_paginate @businesses, :page_links => false %></div>
      </div>
      <!-- End Row -->
    </div>
    <!-- END CONTAINER -->
     <!-- //////////////////////////////////////////////////////////////////////////// --> 

     <br><br><br><br><br><br><br><br><br><br><br><br>
     <br><br><br><br><br><br>

<%= render 'shared/dashboard_footer' %>


</div>
<!-- End Content -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 


</body>
</html>