<%= provide(:title, "Rhombus - Transactions") %>

<!-- ========== Css Files ========== -->
  
<%= content_for :head do %>
  <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
<% end %>

  <body>
  <!-- Start Page Loading -->
  <div class="loading"><img src="<%= asset_path 'loading.gif' %>" alt="loading-img"></div>
  <!-- End Page Loading -->

 <%= render 'shared/header_new' %>
  <%= render 'shared/sidebar' %>

 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTENT -->
<div class="content">

  <!-- Start Page Header -->
  <div class="page-header" style="background: transparent; margin-bottom: 0px;">
    <div class="title" style="font-weight: normal;">Transactions</div>

    <!-- Start Page Header Right Div -->
    <div class="right">
      <div class="btn-group" role="group" aria-label="...">
        <a href="index.html" class="btn btn-light">Dashboard</a>
        <a href="" id="refresh" class="btn btn-light"><i class="fa fa-refresh"></i></a>
      </div>
    </div>
    <!-- End Page Header Right Div -->

  </div>
  <!-- End Page Header -->

 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTAINER -->
<div class="" id="transactions-column">

 <!-- Start Row -->
  <div class="row">

    <!-- Start Panel -->
    <div class="col-md-12">
      <div class="panel panel-default">

        <div class="panel-title">
          <ul class="panel-tools">
            <li><a class="icon expand-tool"><i class="fa fa-expand"></i></a></li>
          </ul>
        </div>

        <div class="panel-body table-responsive">
          <table id="transactions-table" class="table table-striped dataTable">
            <thead>
              <tr role="row">
                <td class="text-center"><i class="fa fa-trash" style="visibility: hidden;"></i></td>
                <th>Date</th>
                <th>Card Name</th>
                <th>Description</th>
                <th>Phone #</th>
                <th>Amt. Paid</th>
                <th>Last Four</th>
              </tr>
            </thead>
            <tbody>
            	<% @transactions.each do |t| %>
	        	  <tr role="row">
	                <td class="details-control"></td>
	                <td><%= t.created_at.strftime("%m/%d/%Y") %></td>
	                <td><%= t.card_name %></td>
	                <td><%= t.notes %></td>
	                <td><%= t.phone_number %></td>
	                <td><%= t.amount_less_fees %></td>
	                <td><%= t.last_four %></td>
	              </tr>
	            <% end %>
            </tbody>
          </table>
        </div>

      </div>
    </div>
    <!-- End Panel -->
    	<div style="text-align: center; margin-bottom: 40px;"><%= will_paginate @transactions, :page_links => false %></div>
  </div>
  <!-- End Row -->

         

</div>
<!-- END CONTAINER -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 


<!-- Start Footer -->
<div class="row footer">
  <div class="col-md-6 text-left">
  Copyright © 2015 <a href="http://themeforest.net/user/egemem/portfolio" target="_blank">Egemem</a> All rights reserved.
  </div>
  <div class="col-md-6 text-right">
    Design and Developed by <a href="http://themeforest.net/user/egemem/portfolio" target="_blank">Egemem</a>
  </div> 
</div>
<!-- End Footer -->


</div>
<!-- End Content -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 


</body>
</html>