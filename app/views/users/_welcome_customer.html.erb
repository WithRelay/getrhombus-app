        <input class="card-number modal text-field w-input" data-name="Card Number 2" id="Card-Number-2" maxlength="256" name="Card-Number-2" placeholder="Card number" type="text">
        <input class="card-name modal text-field w-input" data-name="Name On Card 2" id="Name-on-Card-2" maxlength="256" name="Name-on-Card-2" placeholder="Name on card" type="text">
        <input class="month-year text-field w-input" data-name="Month Year 2" id="Month-Year-2" maxlength="256" name="Month-Year-2" placeholder="MM / YYYY" required="required" type="text">
