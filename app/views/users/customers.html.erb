<%= provide(:title, "Rhombus - Customers") %>

<!-- ========== Css Files ========== -->
  
<%= content_for :head do %>
  <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
<% end %>

<body>
  <!-- Start Page Loading -->
  <div class="loading"><img src="<%= asset_path 'loading.gif' %>" alt="loading-img"></div>
  <!-- End Page Loading -->

 <%= render 'shared/header_new' %>
  <%= render 'shared/sidebar' %>



 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTENT -->
<div class="content">

  <!-- Start Page Header -->
  <div class="page-header" style="background: transparent; margin-bottom: 0px;">
    <div class="title" style="font-weight: normal;">Customers</div>
        <%= submit_tag 'Create List', :id=>'create_list_button', :name => 'create_list', :type => 'button', disabled: true %>
    <%= render 'shared/dashboard_shortcut' %>
  </div>

 <!-- //////////////////////////////////////////////////////////////////////////// --> 
    <!-- START CONTAINER -->
    <div class="" id="transactions-column">

     <!-- Start Row -->
      <div class="row">

        <!-- Start Panel -->
        <div class="col-md-12">
          <% unless @customers.blank? %>
              <div class="panel panel-default">
                <div class="panel-title">
                  <ul class="panel-tools">
                    <li><a class="icon expand-tool"><i class="fa fa-expand"></i></a></li>
                  </ul>
                </div>

                <div class="panel-body table-responsive">
                  <form id="all_customers">
                    <table id="transactions-table" class="table table-striped dataTable">
                    <thead>
                      <tr role="row">
                        <td class="text-center"><i class="fa fa-trash" style="visibility: hidden;"></i></td>
                        <th></th>
                        <th>Name</th>
                        <th>First Visit (ET)</th>
                        <th>Last Visit</th>
                        <th>Avg Spend</th>
                        <th>Total Spend</th>
                        <th>Visits in last 30 days</th>
                      </tr>
                    </thead>
                    <tbody>
                    <% @customers.each do |c| %>
                      <tr role="row">
                        <td class="details-control" data-page="users" data-email="<%= c.email %>"
                          data-phone="<%= c.phone_number %>"></td>
                        <td><input type="checkbox" value="<%=c.user_id %>"  class="customer_checkboxes"></input></td>
                        <td><%= c.card_name %></td>
                        <td><%= (c.first_visit) ? c.first_visit.strftime("%m/%d/%Y") : '--' %></td>
                        <td><%= (c.last_visit) ? c.last_visit.strftime("%m/%d/%Y") : "--" %></td>
                        <td><%= number_to_currency(c.avg_spend) %></td>
                        <td><%= number_to_currency(c.total_spend) %></td>
                        <td><%= c.last_30 %></td>
                      </tr>
                    <% end %>
                    </tbody>
                    </table>
                  </form>
                </div>
              </div>
            <% else %>
            <div class="center">
                <img src="<%= asset_path 'no-user.png' %>" alt="no user">
                <div class="no-user">You have no customers :(</div>
            </div>
          <% end %>
        </div>
        <!-- End Panel -->
          <div style="text-align: center; margin-bottom: 40px;"><%= will_paginate @customers, :page_links => false %></div>
      </div>
      <!-- End Row -->
    </div>
    <!-- END CONTAINER -->
     <!-- //////////////////////////////////////////////////////////////////////////// --> 

     <br><br><br><br><br><br><br><br><br><br><br><br>
     <br><br><br><br><br><br>

<%= render 'shared/dashboard_footer' %>


</div>
<!-- End Content -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 

<!-- Create List form -->
<div id="list_create_modal">
    <span>Create your list of customers</span>
    <div id="create_list_form">
        <div id="list_form_errors"> </div>
        <div id="list_form_items">
          <%= form_tag("/lists/create_new_list", method: "post", remote: true) do %>
            <%= label_tag(:list_name, "List name") %>
            <%= hidden_field_tag(:selected_users) %>
            <%= text_field_tag(:list_name) %>
            <%= submit_tag("Submit list") %>
          </div>
            <%= button_tag("cancel") %>
          <% end %>
    </div>
  </div>
<!-- -->
</body>


<!--
Temporary script for enabling the create list button based on whether a customer is selected or not
-->
<script>
  var selected_users = [] 
  $("#create_list_button").click(function(e){
    $("#list_create_modal").lightbox_me({
      closeClick: true,
      closeEsc: true,
      centered: true,
      onLoad: function() {
        $("#list_create_modal").find('input:first')
        $("#selected_users").val(selected_users)
      }
      });
     e.preventDefault();
  });
  num_checkboxes_selected = 0;
  $(".customer_checkboxes" ).change(function() {
    var input = $(this);
    var state = (input.prop("checked"))
    if (state == true){
      num_checkboxes_selected +=1;
      selected_users.push(input.val());
      console.log("Input checked is : ", input.val());
  
    } else{
      num_checkboxes_selected -=1;
      element_index = selected_users.indexOf(input.val())
      selected_users.splice(element_index, 1);
    }
    
  if (selected_users.length > 0){
    console.log("There is a selected checkbox.", selected_users);
    $("#create_list_button").prop('disabled', false);
  }else{
    console.log("No selected checkboxes");
    $("#create_list_button").prop('disabled', true);
  }
})
</script>