<%= provide(:title, "Rhombus - Customers") %>

<!-- ========== Css Files ========== -->
  
<%= content_for :head do %>
  <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
<% end %>

<body>
  <!-- Start Page Loading -->
  <div class="loading"><img src="<%= asset_path 'loading.gif' %>" alt="loading-img"></div>
  <!-- End Page Loading -->

 <%= render 'shared/header_new' %>
  <%= render 'shared/sidebar' %>



 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTENT -->
<div class="content">

  <!-- Start Page Header -->
  <div class="page-header" style="background: transparent; margin-bottom: 0px;">
    <div class="title" style="font-weight: normal;">Customers</div>
        <%= submit_tag 'Create List', :id=>'create_list_button', :name => 'create_list', :type => 'button', disabled: true %>
    <%= render 'shared/dashboard_shortcut' %>
  </div>

 <!-- //////////////////////////////////////////////////////////////////////////// --> 
    <!-- START CONTAINER -->
    <div class="" id="transactions-column">

     <!-- Start Row -->
      <div class="row">

        <!-- Start Panel -->
        <div class="col-md-12">
          <% unless @customers.blank? %>
              <div class="panel panel-default">
                <div class="panel-title">
                  <ul class="panel-tools">
                    <li><a class="icon expand-tool"><i class="fa fa-expand"></i></a></li>
                  </ul>
                </div>


                <div class="panel-body table-responsive">
                    <form id="all_customers">
                    <table id="merchant_customers" class="table table-striped dataTable">
                    <thead>
                      <tr role="row">
                        <td class="text-center">
                          <i class="fa fa-trash" style="visibility: hidden;"></i>
                        </td>
                        <th>
                         <input type="checkbox" id="check_or_uncheck_all">
                        </input>
                        </th>
                        <th>Name</th>
                        <th>First Visit (ET)</th>
                        <th>Last Visit</th>
                        <th>Avg Spend</th>
                        <th>Total Spend</th>
                        <th>Visits in last 30 days</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @customers.each do |c| %>
                        <tr role="row">
                          <td class="details-control" data-page="users" data-email="<%= c.email %>"
                            data-phone="<%= c.phone_number %>"></td>
                          <td><input type="checkbox" value="<%=c.user_id %>"  class="customer_checkboxes"></input></td>
                          <td><%= c.card_name %></td>
                          <td><%= (c.first_visit) ? c.first_visit.strftime("%m/%d/%Y") : '--' %></td>
                          <td><%= (c.last_visit) ? c.last_visit.strftime("%m/%d/%Y") : "--" %></td>
                          <td><%= number_to_currency(c.avg_spend) %></td>
                          <td><%= number_to_currency(c.total_spend) %></td>
                          <td><%= c.last_30 %></td>
                        </tr>
                    <% end %>
                    </tbody>
                    </table>
                  </form>
                </div>
              </div>
            <% else %>
            <div class="center">
                <img src="<%= asset_path 'no-user.png' %>" alt="no user">
                <div class="no-user">You have no customers :(</div>
            </div>
          <% end %>
        </div>
        <div id="segments_test">
          This is for testing the segments functionality
          <p>
          <form id="create_segment" action="/v1/lists/create", method="post">
            <input type="hidden" id="list_type" value="segment"></input>
            <select id="segment_option">
              <option value ="all_customers">All Customers</option>
              <option value ="new_customers">New customers</option>
              <option value ="active_customers" selected>Active customers
              </option>
              <option value ="inactive_customers">Inactive customers
              </option>
            </select>
          within the last 
            <input type="text" id="num_days" placeholder="Enter number of days" size="5"> days</input>
            <input type ="submit" id="create_segment">Create segment</input>
            </form>
        </p>
        </div>
        <!-- End Panel -->
          <div style="text-align: center; margin-bottom: 40px;"><%= will_paginate @customers, :page_links => false %></div>
      </div>
      <!-- End Row -->
    </div>
    <!-- END CONTAINER -->
     <!-- //////////////////////////////////////////////////////////////////////////// --> 

     <br><br><br><br><br><br><br><br><br><br><br><br>
     <br><br><br><br><br><br>

<%= render 'shared/dashboard_footer' %>


</div>
<!-- End Content -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 

<!-- Create List form -->
<div id="list_create_modal">
    <span>Create your list of customers</span>
    <div id="create_list_form">
        <div id="list_form_errors"> </div>
        <div id="list_form_items">
          <%= form_tag("/v1/lists/create", id: "create_user_list", method: "post") do %>
            <%= label_tag(:list_name, "List name") %>
            <%= hidden_field_tag(:selected_users) %>
            <%= hidden_field_tag(:list_type, 'list') %>
            <%= text_field_tag(:list_name) %>
            <%= submit_tag("Submit list") %>
          </div>
            <%= button_tag("cancel") %>
          <% end %>
    </div>
  </div>
<!-- -->
</body>
