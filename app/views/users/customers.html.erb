<%= provide(:title, "Rhombus - Customers") %>
<div class="customer-dashboard-header sub-nav-bar table-header">
  <div class="table-header">
    <div class="table-header">
      <div class="header new-table-row w-row">
        <div class="cn w-clearfix w-col w-col-3">
          <div class="header name w-clearfix">
            <div class="headings name"> &nbsp; Name</div>
          </div>
          <div class="cb check-box-column header">
            <div class="w-form">
              <form data-name="Email Form 2" id="email-form-2" name="email-form-2">
                <div class="select-all-check-box w-checkbox w-clearfix">
                  <input class="cb table-checkbox w-checkbox-input" id="node" type="checkbox">
                  <label class="checkbox-field-lable w-form-label" for="node">-</label>
                </div>
              </form>
            </div>
          </div>
        </div>
        <div class="fv w-clearfix w-col w-col-2">
          <div class="cn column column-2 header">
            <div class="first-visit headings"> &nbsp; First visit</div>
          </div>
        </div>
        <div class="lv w-clearfix w-col w-col-2">
          <div class="colum-3 column header lv">
            <div class="headings last-visit"> &nbsp;Last visit</div>
          </div>
        </div>
        <div class="avs w-clearfix w-col w-col-1">
          <div class="avs column column-4 header">
            <div class="avs headings last-visit"> &nbsp;Average</div>
          </div>
        </div>
        <div class="ts w-clearfix w-col w-col-1">
          <div class="column column-5 header ts">
            <div class="headings total-spend-header">&nbsp; Total Spend</div>
          </div>
        </div>
        <div class="table-actions w-clearfix w-col w-col-3">
          <div class="column column-6 header new-row w-clearfix">
            <div class="headings message-customer name">&nbsp; &nbsp;Actions</div>
          </div>
          <div class="column column-6 header id new-row">
            <div class="headings id">&nbsp; &nbsp;Relay ID</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="dashboard-body">
  <div class="customer-dashboard-table-wrapper row-wrapper">
    <div>
      <div class="new-table-row w-row">
        <div class="cn w-clearfix w-col w-col-3">
          <div class="name w-clearfix">
            <%= image_tag 'Customer-2.jpg', class: 'table-profile-picture', height: 30, width: 30%>
            <div class="shrink-text table-text">Sandra Fried</div>
          </div>
          <div class="cb check-box-column">
            <div class="w-form">
              <form data-name="Email Form 2" id="email-form-2" name="email-form-2">
                <div class="select-all-check-box w-checkbox w-clearfix">
                  <input class="cb table-checkbox w-checkbox-input" id="node" type="checkbox">
                  <label class="checkbox-field-lable w-form-label" for="node">-</label>
                </div>
              </form>
            </div>
          </div>
        </div>
        <div class="fv w-clearfix w-col w-col-2">
          <div class="cn column column-2 w-clearfix">
            <div class="shrink-text table-text">6 months ago</div>
          </div>
        </div>
        <div class="lv w-clearfix w-col w-col-2">
          <div class="colum-3 column lv w-clearfix">
            <div class="shrink-text table-text">1 week ago</div>
          </div>
        </div>
        <div class="avs w-clearfix w-col w-col-1">
          <div class="avs column column-4 w-clearfix">
            <div class="shrink-text table-text">$23,04</div>
          </div>
        </div>
        <div class="ts w-clearfix w-col w-col-1">
          <div class="column column-5 ts w-clearfix">
            <div class="table-text total-spend-text">$400</div>
          </div>
        </div>
        <div class="table-actions w-clearfix w-col w-col-3">
          <div class="column column-6 left new-row w-clearfix">
            <div class="dashboard-right-nav id signup-box-subheading"><span class="relay-id leads unverified customer-dash">UNVERIFIED</span>
            </div>
          </div>
          <div class="column column-6 new-row"><a class="actions-button notification" href="#">Message &nbsp; </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="customer-dash sub-nav-bar">
  <div class="sub-nav-bar-row w-row">
    <div class="sub-nav-bar-row-column-1 w-clearfix w-col w-col-2">
      <div class="customer-count shrink-text">389 of/<span class="sub-nav-sub-text">1379 customers</span>
      </div>
    </div>
    <div class="sub-nav-bar-row-column-2 w-col w-col-6">
      <div class="modal-background w-hidden modal-body import-customers-modal">
        <%= render partial: 'shared/modals/import_customers' %>
      </div>
      <div class="customer-dashoard sub-nav-options-wrapper w-clearfix">
        <a class="w-button sub-nav-button modal-loader"  href="#" modal-target= 'new-customer-modal'>&nbsp;<strong>Create customer</strong></a>
        <a class="import sub-nav-button w-button modal-loader" modal-target="import-customers-modal" href="#">&nbsp; <strong>Import customers</strong></a>
        <a class="sub-nav-button w-button modal-loader" modal-target='new-list-modal' href="#"> &nbsp;<strong>Create&nbsp;list</strong></a>
        <div class='modal-background w-hidden modal-body new-customer-modal'>
          <%= render 'shared/modals/create_customer' %>
        </div>
        <div class='modal-background w-hidden modal-body new-list-modal'>
          <%= render 'shared/modals/new_list' %>
        </div>
      </div>
    </div>
    <div class="sub-nav-bar-search-row w-col w-col-4">
      <div class="customer-dash search-bar-form-wrapper w-form">
        <form class="w-clearfix" data-name="Email Form" id="email-form" name="email-form">
          <input class="search-field w-input" data-name="Search 6" id="Search-6" maxlength="256" name="Search-6" placeholder="Search" type="text">
        </form>
      </div>
    </div>
  </div>
</div>

 <!-- //////////////////////////////////////////////////////////////////////////// -->
<!-- START CONTENT -->
<div class="content">

  <!-- Start Page Header -->
  <div class="page-header" style="background: transparent; margin-bottom: 0px;">
    <div class="title" style="font-weight: normal;">Customers</div>
        <%= submit_tag 'Create List', :id=>'create_list_button', :name => 'create_list', :type => 'button', disabled: true %>
    <%= render 'shared/dashboard_shortcut' %>
  </div>

 <!-- //////////////////////////////////////////////////////////////////////////// -->
    <!-- START CONTAINER -->
    <div class="" id="transactions-column">

     <!-- Start Row -->
      <div class="row">

        <!-- Start Panel -->
        <div class="col-md-12">
          <% unless @customers.blank? %>
              <div class="panel panel-default">
                <div class="panel-title">
                  <ul class="panel-tools">
                    <li><a class="icon expand-tool"><i class="fa fa-expand"></i></a></li>
                  </ul>
                </div>


                <div class="panel-body table-responsive">
                    <form id="all_customers">
                    <table id="merchant_customers" class="table table-striped dataTable">
                    <thead>
                      <tr role="row">
                        <td class="text-center">
                          <i class="fa fa-trash" style="visibility: hidden;"></i>
                        </td>
                        <th>
                         <input type="checkbox" id="check_or_uncheck_all">
                        </input>
                        </th>
                        <th>Name</th>
                        <th>First Visit (ET)</th>
                        <th>Last Visit</th>
                        <th>Avg Spend</th>
                        <th>Total Spend</th>
                        <th>Visits in last 30 days</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @customers.each do |c| %>
                        <tr role="row">
                          <td class="details-control" data-page="users" data-email="<%= c.email %>"
                            data-phone="<%= c.phone_number %>"></td>
                          <td><input type="checkbox" value="<%=c.user_id %>"  class="customer_checkboxes"></input></td>
                          <td><%= c.card_name %></td>
                          <td><%= (c.first_visit) ? c.first_visit.strftime("%m/%d/%Y") : '--' %></td>
                          <td><%= (c.last_visit) ? c.last_visit.strftime("%m/%d/%Y") : "--" %></td>
                          <td><%= number_to_currency(c.avg_spend) %></td>
                          <td><%= number_to_currency(c.total_spend) %></td>
                          <td><%= c.last_30 %></td>
                        </tr>
                    <% end %>
                    </tbody>
                    </table>
                  </form>
                </div>
              </div>
            <% else %>
            <div class="center">
                <img src="<%= asset_path 'no-user.png' %>" alt="no user">
                <div class="no-user">You have no customers :(</div>
            </div>
          <% end %>
        </div>
        <div id="segments_test">
          <p>
            <select id="segment_option">
              <option value ="all_customers">All Customers</option>
              <option value ="new_customers">Customer created</option>
              <option value="last_purchase"> Last purchase made
              </option>
              <option value ="active_customers" selected>
                Active customers
              </option>
              <option value ="inactive_customers">Inactive customers
              </option>
              <option value ="all_contacts">All Contacts</option>
              <option value ="contacts_with_account">
                Contacts with accounts
              </option>
              <option value="contacts_without_account">
                Contacts without accounts
              </option>
              <option value ="last_msg_received">Last message received
              </option>
              <option value ="last_msg_sent">Last message sent</option>
              <option value ="contacts_with_accounts">
                Contacts with accounts
              </option>
            </select>
          <p></p>
            <select id="range">
              <option value="less_than">Less than</option>
              <option value="more_than">More than</option>
              <option value="exactly">Exactly</option>
              <option value="between">Between</option>
            </select>
          <p></p>
           <input type="text" id="num_days" style="width: 10%"
             size="5" placeholder="Days ago"> </input>
            <p></p>
            Filter segment by
            <p></p>
            <select id="amount_filter">
              <option value="customer_spend">Customer spend</option>
              <option value="less_than">Less than</option>
              <option value="more_than">More than</option>
              <option value="exactly">Exactly</option>
              <option value="between">Between</option>
            </select>
          </p>
           <input type="text" id="amount_1" style="width: 10%"
             size="5" placeholder="Amount">
           </input>
           <input type="text" id="amount_2" style="width: 10%"
             size="5" placeholder="Amount">
           </input>
          <p></p>
            <input id="name_segment" type ="button" value="Create segment"></input>
        </p>
        </div>
        <!-- End Panel -->
          <div style="text-align: center; margin-bottom: 40px;"><%= will_paginate @customers, :page_links => false %></div>
      </div>
      <!-- End Row -->
    </div>
    <!-- END CONTAINER -->
     <!-- //////////////////////////////////////////////////////////////////////////// -->

     <br><br><br><br><br><br><br><br><br><br><br><br>
     <br><br><br><br><br><br>

<%= render 'shared/dashboard_footer' %>


</div>
<!-- End Content -->
 <!-- //////////////////////////////////////////////////////////////////////////// -->

<!-- Create List form -->
<div id="list_create_modal" class="list_modal">
    <span>Create your list of customers</span>
    <div id="create_list_form">
        <div id="list_form_errors"> </div>
        <div id="list_form_items">
          <%= form_tag("/v1/lists.json", id: "create_user_list", method: "post") do %>
            <%= label_tag(:list_name, "List name") %>
            <%= hidden_field_tag(:selected_users) %>
            <%= hidden_field_tag(:list_type, 'list') %>
            <%= text_field_tag(:list_name) %>
            <%= submit_tag("Submit list") %>
           <%= button_tag(type: 'button', class: 'cancel') do
                content_tag(:strong, "Cancel")
              end
          %>
          <% end %>
        </div>
    </div>
  </div>


  <div id="segment_create_modal" class="list_modal">
    <span>Create segment</span>
    <div id="create_segment_form">
        <span id="segment_create_msg"> </span>
        <div id="segment_form_items">
          <%= form_tag("/v1/lists.json", id: "create_segment", method: "post") do %>
            <%= label_tag(:segment_name, "Segment name") %>
            <%= hidden_field_tag(:list_type, 'segment') %>
            <%= hidden_field_tag(:segment_type) %>
            <%= hidden_field_tag(:segment_num_days) %>
            <%= hidden_field_tag(:segment_filter) %>
            <%= hidden_field_tag(:amt_filter) %>
            <%= hidden_field_tag(:amt_1) %>
            <%= hidden_field_tag(:amt_2) %>
            <%= text_field_tag(:segment_name) %>
            <%= submit_tag("Create segment") %>
            <%= button_tag(type: 'button', class: 'cancel') do
                content_tag(:strong, "Cancel")
              end
            %>
          <% end %>
      </div>
    </div>
  </div>
<!-- -->
</body>
