 <% provide(:title, 'Relay - Verify Hosted Sms Order') %>

<div class="blank-page-content-wrapper">
  <div class="onboarding-form-div sign-in signup hosted-sms">
    <%= link_to root_url, class: 'form-logo w-inline-block' do %>
      <%= image_tag('Relay-Transparent-500x300.png', width: 50, class: 'password-reset-logo') %>
    <% end %>
    <div class="flex-underline form-header-underline"></div>
    <div class="password-reset-instructions">Enter your phone number verification code</div>
    <div class="log-in-form">
      <%= form_tag user_verify_hosted_sms_path(current_user), id: "verify-hosted-sms-order" do %>
        <div class="form-group">
          <input type="text" name="VerificationCode" placeholder="Verification code" autofocus="true" class="form-control text-field w-input">
        </div>
        <input type="submit" name="Verify" class="button log-in w-button" value="Verify & Continue" id="submit-verification-code" >
      <% end %>
    </div>
  </div>
</div>
