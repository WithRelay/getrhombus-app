      <div class = "w-col-12">
        <div class="form-group col-xs-6">
          <%= a.text_field :street_address, id: 'company-street', placeholder: 'Street Address', class: 'form-control settings street-name text-field w-input' %>
          <!-- <div class="messageContainer w-col-4"></div> -->
        </div>
        <div class="form-group col-xs-6">
          <%= a.text_field :city, id: 'company-city', class: 'apt_suite settings text-field w-input form-control', placeholder: 'City' %>
          <!-- <div class="messageContainer w-col-4"></div> -->
        </div>
      </div>

      <div id='company-state-div'>
        <div class="form-group col-xs-6">
          <%= a.select :state_province, options_for_select(states_list(a.object.country), selected: a.object.state_province), {}, class: 'rhombusFocus dropdown w-select settings street-name text-field w-input form-control', id: 'company-state' %>
          <!-- <div class="messageContainer street-name"></div> -->
        </div>
      </div>
      <div class="form-group col-xs-6">
        <%= a.text_field :postal_code, id: 'company-postal-code', class: 'apt_suite settings text-field w-input form-control', placeholder: 'Zip/Postal code' %>
        <!-- <div class="messageContainer w-col-6"></div> -->
      </div>
