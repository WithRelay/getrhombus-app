	
<%# if current_user.user_level == 1 %>
<%= provide(:title, "Rhombus - Dashboard") %>

<%#= content_for :head do %>
	<%= stylesheet_link_tag "forms.css" %>
<%# end %>

<%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
<% end %>

<body class="error-body no-top lazy"> 

	<%= render 'shared/header' %>
<%= render 'shared/full_messages' %>	

	<div class="container"> 

                        <div class="row">
                            <div class="col-md-12">                                
                                    
                                           <h3>Dashboard</h3>
                            </div>
                        </div>

			<div class="row spacing-bottom 2col">	
			<%# if current_user.user_level == 1 %>
				<%#= render "rhombus_number" %>
			<%# end %>
	

                                                <% @todays_stuff.each do |t| %>

                                                    <%= t.notes %> <br>

                                                    <% end %>
                                                    <br>
                                                    <%= will_paginate @todays_stuff, :page_links => false %>


                                                      <nav>
                                                        <ul class="pager">
                                                          <li><a href="#"><span aria-hidden="true">&larr;</span> Previous</a></li>
                                                          <li><a href="#">Next <span aria-hidden="true">&rarr;</span></a></li>
                                                        </ul>
                                                      </nav>
            <div>	
        </div>

	</body>

<%# end %>