<%= provide(:title, "Rhombus - Dashboard") %>

<!-- ========== Css Files ========== -->
  
<%= content_for :head do %>
    <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
<% end %>

<body>
<!-- Start Page Loading -->
  <div class="loading"><img src="<%= asset_path 'loading.gif' %>" alt="loading-img"></div>
  <!-- End Page Loading -->
  
<%= render 'shared/header_new' %>
<%= render 'shared/sidebar' %>

 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTENT -->
<div class="content">

  <!-- Start Page Header -->
  <div class="page-header" style="background: transparent; margin: -20px -24px 78px -32px; margin-bottom: 0px;">
    <h1 class="title">Dashboard</h1>

    <!-- Start Page Header Right Div -->
    <div class="right">
      <div class="btn-group" role="group" aria-label="...">
        <a href="index.html" class="btn btn-light">Dashboard</a>
        <a href="" id="refresh" class="btn btn-light"><i class="fa fa-refresh"></i></a>
      </div>
    </div>
    <!-- End Page Header Right Div -->

  </div>
  <!-- End Page Header -->


 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTAINER -->
<div class="container-widget">

  <!-- End Top Stats -->
  <!-- Start Row -->
  <div class="row">

    <!-- Start Panel -->
    <div class="col-md-3 col-lg-3">
      <div class="panel panel-default center">

        <div class="panel-title" id="isDashboard" data-dashboard="true">
          Sales
        </div>

        <div class="panel-body panel-font-size">
          <%= number_to_currency(@dashboard_stuff.first.todays_sales) %>
        </div>

        <div class="panel-footer nephritis white">Today</div>

      </div>
    </div>
    <!-- End Panel -->

    <!-- Start Panel -->
    <div class="col-md-3 col-lg-3">
      <div class="panel panel-default center">

        <div class="panel-title">
          Transactions
        </div>

        <div class="panel-body panel-font-size">
        <%= @dashboard_stuff.first.todays_txn %>
        </div>

        <div class="panel-footer peterriver white">Today (GMT)</div>

      </div>
    </div>
    <!-- End Panel -->

    <!-- Start Panel -->
    <div class="col-md-3 col-lg-3">
      <div class="panel panel-default center">

        <div class="panel-title">
        <%= (current_user.user_level == 0) ? "Businesses" : "Customers" %>
        </div>

        <div class="panel-body panel-font-size">
        <%= @dashboard_stuff.first.count %>
        </div>

        <div class="panel-footer amethyst white">Till Date</div>

      </div>
    </div>
    <!-- End Panel -->

    <!-- Start Panel -->
    <div class="col-md-3 col-lg-3">
      <div class="panel panel-default center">

        <div class="panel-title">
          Messages
        </div>

        <div class="panel-body panel-font-size">
          <%= (@total_msgs.present?) ? @total_msgs : "0" %>
        </div>

        <div class="panel-footer wetashphalt white">Count this month</div>

      </div>
    </div>
    <!-- End Panel -->


  </div>
  <!-- End Row -->

  <!-- Start Row -->
  <div class="row">

   <!-- Start Chart -->
    <div class="col-lg-4 col-md-6">
      <div class="panel panel-default">
        <div class="panel-title">
          Last 7 Days
          <ul class="panel-tools">
            <li><a class="icon expand-tool"><i class="fa fa-expand"></i></a></li>
          </ul>
        </div>
        <div class="panel-body">
          <div id="chartist-line" class="ct-chart ct-perfect-fourth"></div>
        </div>
        <div>legend</div>
      </div>
    </div>
    <!-- End Chart -->

     <!-- Start Orders -->
    <div class="col-md-6 col-lg-8">
      <div class="panel panel-widget">
        <div class="panel-title">
          RECENT TRANSACTIONS <span class="label label-warning"></span>
          <ul class="panel-tools">
            <li><a class="icon expand-tool"><i class="fa fa-expand"></i></a></li>
          </ul>
        </div>



        <div class="panel-body table-responsive">

          <table class="table table-hover table-striped">
            <thead>
              <tr>
                <th class="text-center"><i class="fa fa-trash" style="visibility: hidden;"></i></th>
                <th>Date (GMT)</th>
                <th><%= (current_user.user_level == 0) ? "Description" : "Card Name" %></th>
                <th>Message</th>
                <% if current_user.user_level == 1 %> 
                   <th>Phone #</th>
                <% end %>              
              </tr>
            </thead>
            <tbody>
                <% @last4_transactions.each do |t| %>
                  <tr>
                    <td class="text-center"><i class="fa fa-credit-card"></i></td>
                    <td><b><%= t.created_at.strftime("%m/%d/%Y") %></b></td>
                    <td><%= (current_user.user_level == 0) ? t.description : t.card_name %></td>
                    <td><%= t.notes %></td>
                    <% if current_user.user_level == 1 %> 
                       <td><%= t.from %></td>
                    <% end %> 
                  </tr>
                <% end %>
            </tbody>
          </table>

        </div>
      </div>
    </div>
    <!-- End Orders -->




   

  </div>
  <!-- End Row -->




  <div class="row">
        <!-- Start Panel -->
    <div class="col-md-4">
      <div class="col-md-12 col-lg-12">
        <div class="panel panel-default center">

          <div class="panel-title">
            SALES
          </div>

          <div class="panel-body panel-font-size">
            <%= number_to_currency(@dashboard_stuff.first.sales_till_date) %>
          </div>

          <div class="panel-footer alizarin white">Till Date</div>

        </div>
      </div>

      <!-- End Panel -->


      <!-- Start Panel -->
      <div class="col-md-12 col-lg-12 center">
        <div class="panel panel-default">

          <div class="panel-title">
            Transactions
          </div>

          <div class="panel-body panel-font-size">
          <%= @dashboard_stuff.first.txn_last_30days %>
          </div>

          <div class="panel-footer concrete white">Last 30 Days</div>

        </div>
      </div>
  </div>
    <!-- End Panel -->

    <div class="col-md-8">
      <!-- Start Chart -->
      <div class="col-lg-8 col-md-8">
        <div class="panel panel-default">
          <div class="panel-title">
            Last 30 Days
            <ul class="panel-tools">
              <li><a class="icon expand-tool"><i class="fa fa-expand"></i></a></li>
            </ul>
          </div>
              <div class="panel-body">
                <div id="chartist-line-area" class="ct-chart ct-perfect-fourth"></div>
              </div>
        </div>
      </div>
    </div>
    <!-- End Chart -->
  </div>
  <!-- End Chartist -->



</div>
<!-- END CONTAINER -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 

<!-- Start Footer -->
<div class="row footer">
  <div class="col-md-6 text-left">
  Copyright © 2015 <a href="http://themeforest.net/user/egemem/portfolio" target="_blank">Egemem</a> All rights reserved.
  </div>
  <div class="col-md-6 text-right">
    Design and Developed by <a href="http://themeforest.net/user/egemem/portfolio" target="_blank">Egemem</a>
  </div> 
</div>
<!-- End Footer -->


</div>
<!-- End Content -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 



</body>
</html>