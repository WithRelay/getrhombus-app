
<div class='nested-fields'>     
  <div>
    <label>Full name</label>
    <%= f.text_field :full_name %>
  </div>
  <div>
    <!-- use input masking here -->
    <label>DOB</label>
    <%= f.text_field :dob %>
  </div>
  <div>
    <label>SSN</label>
    <%= f.text_field :last4 %>
  </div>
  
  <%= f.hidden_field :role, value: f.index == 0 ? 'representative' : 'owner' %>

  <%= f.fields_for :address do |a| %>
    <div>
      <%= a.label :street_address %>
      <%= a.text_field :street_address %>
    </div>
    <div>
      <%= a.label :city %>
      <%= a.text_field :city %>
    </div>
    <div>
      <%= a.label :state_province %>
      <%= a.text_field :state_province %>
    </div>
    <div>
      <%= a.label :postal_code %>
      <%= a.text_field :postal_code %>
    </div>
    <div>
      <%= a.label :country %>
      <%= a.text_field :country %>
    </div>
  <% end %>

  <%# review this %>
  <% if f.object.persisted? %>
    <% if f.index != 0 %>
      <%= link_to_remove_association "remove", f %>  
    <% end %>  
  <% else %>
    <%= link_to_remove_association "remove", f %>   
  <% end %>  
</div>

