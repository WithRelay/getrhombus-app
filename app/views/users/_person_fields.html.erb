<div class='nested-fields'>
    <%= f.text_field :business_name, class: 'full-name settings text-field w-input' %>
    <%= f.text_field :full_name, readonly: (f.object.first_name.present? || f.object.last_name.present?), data: { name: 'Name 2'}, id: 'name-2', placeholder: 'Full name', class: 'full-name settings text-field w-input' %>
    <%= f.text_field :dob, id: 'Date-of-birth', placeholder: 'Date of birth', class: 'userDateOfBirth settings short-field text-field w-input', data: { name: "Date of birth" }, readonly: f.object.dob.present? %>
    <%# if f.index == 0 %>
    <%= f.text_field :last4, placeholder: "City", id: 'City-2', class: 'rep-pii settings short-field ssn text-field w-input', data: { name: "SSN" }, id: "SSN" %>

    <%# end %>
</div>

  <div class="col-md-10">
    <div class='col-md-5'>
      <%= f.label :gender, 'Male', value: 'male' %>
      <%= f.radio_button :gender, 'male'  %>
    </div>
    <div class='col-md-5'>
      <%= f.label :gender, 'Female', value: 'female' %>
      <%= f.radio_button :gender, 'female'  %>
    </div>
  </div>



  <%= f.hidden_field :role, value: f.index == 0 ? '0' : '1' %>

  <%= f.fields_for :address do |a| %>
    <div class="col-xs-5">
      <div class='person-street-div'>
        <%= a.text_field :street_address, placeholder: 'Street Address', id: "Street-Address-2", class: 'person-street settings street-name text-field w-input', data: { name: "Street Address 2" } %>
      </div>
    </div>

    <div class="col-xs-5">
      <div class='person-city-div'>
        <%= a.text_field :city, class: 'apt_suite settings text-field w-input', data: { name: "City 2" } %>
      </div>
    </div>

    <div class="col-xs-5">
      <div class='person-state-div'>
        <%= a.text_field :state_province, placeholder: "State/Province", id: "State-2", class: 'person-street settings street-name text-field w-input',  data: { name: "State 2" } %>
      </div>
    </div>

    <div class="col-xs-5">
      <div class='person-postal-div'>
        <%= a.text_field :postal_code, placeholder: "Zip/Postal code", data: { name: "Zip 2" },  id: "Zip-2", class: 'person-postal company-rep settings text-field w-input zip' %>
      </div>
    </div>

    <div class="col-xs-5">
      <select class="person-country-select bank-country dropdown w-select"></select>
    </div>

    <div class="col-xs-10">
      <div class="person-country-div">
        <%= a.hidden_field :country, class: 'person-country' %>
      </div>
    </div>

    <div class="col-xs-5">
      <% if f.object.persisted? %>
        <% if f.index != 0 %>
          <%= link_to_remove_association "remove", f %>
        <% end %>
      <% else %>
        <%= link_to_remove_association "remove", f %>
      <% end %>
    </div>
  <% end %>
