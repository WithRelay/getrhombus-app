<div class='nested-fields'>

  <div class="form-group col-xs-6">
    <label class="form-label label-margin">Full Name</label>
    <%= f.text_field :full_name, id: 'name-2', placeholder: 'Full name', class: 'settings short-field text-field w-input form-control' %>
    <div class="messageContainer w-col-12"></div>
  </div>

  <div class="form-group col-xs-6">
    <label class="form-label label-margin">Date of Birth</label>
    <%= f.text_field :dob, id: 'Date-of-birth', placeholder: 'Date of birth', class: 'userDateOfBirth settings short-field text-field w-input form-control' %>
    <div class="messageContainer w-col-12"></div>
  </div>

  <% if f.index == 0 %>
    <div class="form-group col-xs-6">
      <label class="form-label label-margin rep-pii-label">SSN</label>
      <%= f.text_field :last4, placeholder: "SSN", class: 'settings short-field ssn text-field w-input rep-pii form-control', id: "SSN" %>
      <div class="messageContainer w-col-12"></div>
    </div>
  <% end %>

  <%= f.hidden_field :role, value: f.index == 0 ? '0' : '1' %>

<%
=begin %>
  <fieldset class='gender-fieldset'>
    <div class="managed-account-gender">
      <%= f.label :gender, 'Male', value: 'male', class: 'gender-label' %>
      <%= f.radio_button :gender, 'male', class: 'gender-input'  %>
      <%= f.label :gender, 'Female', value: 'female', class: 'gender-label' %>
      <%= f.radio_button :gender, 'female', class: 'gender-input'  %>
    </div>
  </fieldset>

  <%= f.fields_for :address do |a| %>
    <div class="col-xs-5">
      <div class='person-street-div'>
        <%= a.text_field :street_address, placeholder: 'Street Address', id: "Street-Address-2", class: 'person-street settings street-name text-field w-input' %>
      </div>
    </div>

    <div class="col-xs-5">
      <div class='person-suite-div'>
        <%= a.text_field :suite, placeholder: 'Suite', class: 'person-country-select apt_suite settings text-field w-input' %>
      </div>
     </div>

    <div class="col-xs-10">
      <div class="person-country-div">
        <%= a.hidden_field :country, class: 'person-country' %>
      </div>
    </div>

    <div class="col-xs-5">
      <div class='person-city-div'>
        <%= a.text_field :city, class: 'city settings text-field w-input' %>
      </div>
    </div>

    <div class="col-xs-5">
      <div class='person-state-div'>
        <%= a.text_field :state_province, placeholder: "State/Province", id: "State-2", class: 'person-street settings state text-field w-input' %>
      </div>
    </div>

    <div class="col-xs-5">
      <div class='person-postal-div'>
        <%= a.text_field :postal_code, placeholder: "Zip/Postal code",  id: "Zip-2", class: 'person-postal company-rep settings text-field w-input zip' %>
      </div>
    </div>
  <% end %>

<%
=end %>

  <div class="flex-underline form-section-divider"></div>
  <label class="field-headers form-label settings" for="name-2">Upload Profile Picture (you)</label>

  <div id="managed-acct-picture-div">
    <%#<a class="attach-image" href="#" id='select-images-button'></a>%>
    <button type="button" id='select-images-button' class="dash-header-links new-link">Attach ID</button>
    <span class="profile-pic-or">OR</span>
    <button type="button" class="dash-header-links new-link modal-loader" id='webcam-capture' modal-target='new-webcam-modal'>Take picture of ID</button>
    <%#<a class="button w-button modal-loader" href="#" ><i class="material-icons webcam-icon">photo_camera</i></a>%>
  </div>

  <%= f.file_field :avatar, type: :file, id: "select-images", class: 'w-hidden', accept: "image/*" %>

  <div class='modal-background w-hidden modal-body new-webcam-modal'>
    <%= render 'shared/modals/webcam_modal' %>
  </div>

  <!-- for new images -->
  <div id='new-image-previews'>
  </div>

  <!-- for already attached images -->
  <% if @image %>
    <div>
      <%= div_for @image do |image| %>
        <%= present(image).image_url %>
        <%= present(image).image_name %>
      <% end %>
    </div>
  <% end %>


<%
=begin %>
  <div class="col-xs-5">
    <% if f.object.persisted? %>
      <% if f.index != 0 %>
        <%= link_to_remove_association "remove", f %>
      <% end %>
    <% else %>
      <%= link_to_remove_association "remove", f %>
    <% end %>
  </div>
<%
=end %>
</div>
