
<div class='nested-fields'>
  <div>
    <label>Full name</label>
    <%= f.text_field :full_name %>
  </div>
  <div>
    <%= f.label :gender, 'Male', value: 'male' %>
    <%= f.radio_button :gender, 'male'  %>
    <%= f.label :gender, 'Female', value: 'female' %>
    <%= f.radio_button :gender, 'female'  %>
  </div>
  <div>
    <!-- use input masking here -->
    <label>DOB</label>
    <%= f.text_field :dob, class: 'userDateOfBirth' %>
  </div>

  <% if f.index == 0 %>
    <div class='rep-pii-div'>
      <label class='rep-pii-label'>SSN</label>
      <%= f.text_field :last4, class: 'rep-pii' %>
    </div>
  <% end %>


  <%= f.hidden_field :role, value: f.index == 0 ? '0' : '1' %>

  <%= f.fields_for :address do |a| %>
    <div class='person-street-div'>
      <%= a.label :street_address %>
      <%= a.text_field :street_address, class: 'person-street' %>
    </div>
    <div class='person-city-div'>
      <%= a.label :city %>
      <%= a.text_field :city, class: 'person-city' %>
    </div>
    <div class='person-state-div'>
      <%= a.label :state_province %>
      <%= a.text_field :state_province, class: 'person-state' %>
    </div>
    <div class='person-postal-div'>
      <%= a.label :postal_code %>
      <%= a.text_field :postal_code, class: 'person-postal' %>
    </div>
    <div class="person-country-div">
      <%= a.label :country %>
      <%= a.text_field :country, class: 'person-country' %>
      <select class="person-country-select"></select>
    </div>
  <% end %>


  <%# review this %>
  <% if f.object.persisted? %>
    <% if f.index != 0 %>
      <%= link_to_remove_association "remove", f %>
    <% end %>
  <% else %>
    <%= link_to_remove_association "remove", f %>
  <% end %>
</div>
