<div class="customer-dashboard-header sub-nav-bar table-header">
  <div class="table-header">
    <div class="table-header">
      <div class="header new-table-row w-row">
        <div class="cn w-clearfix w-col w-col-3">
          <div class="header name w-clearfix">
            <div class="headings name"> &nbsp; Name</div>
          </div>
          <div class="cb check-box-column header">
            <div class="w-form">
              <form data-name="Email Form 2" id="email-form-2" name="email-form-2">
                <div class="select-all-check-box w-checkbox w-clearfix">
                  <input class="cb table-checkbox w-checkbox-input" id="node" type="checkbox">
                  <label class="checkbox-field-lable w-form-label" for="node">-</label>
                </div>
              </form>
            </div>
          </div>
        </div>
        <div class="fv w-clearfix w-col w-col-2">
          <div class="cn column column-2 header">
            <div class="first-visit headings"> &nbsp; Phone</div>
          </div>
        </div>
        <div class="lv w-clearfix w-col w-col-2">
          <div class="colum-3 column header lv">
            <div class="headings last-visit"> &nbsp;First contact</div>
          </div>
        </div>
        <div class="avs w-clearfix w-col w-col-1">
          <div class="avs column column-4 header">
            <div class="avs headings last-visit"> &nbsp;Channel</div>
          </div>
        </div>
        <div class="ts w-clearfix w-col w-col-1">
          <div class="column column-5 header ts">
            <div class="headings leads total-spend-header"> &nbsp; Relay ID</div>
          </div>
        </div>
        <div class="table-actions w-clearfix w-col w-col-3">
          <div class="column column-6 header new-row w-clearfix">
            <div class="headings message-customer name">&nbsp; &nbsp;Actions</div>
          </div>
          <div class="column column-6 header new-row">
            <div class="headings location name">&nbsp; &nbsp;Location</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="customer-dash sub-nav-bar">
  <div class="sub-nav-bar-row w-row">
    <div class="sub-nav-bar-row-column-1 w-clearfix w-col w-col-2">
      <div class="customer-count shrink-text"><%= @leads_contacts.count %> of<span class="sub-nav-sub-text">/<%= @leads_contacts.count %> leads</span>
      </div>
    </div>
    <div class="w-col w-col-6">
      <div class="customer-dashoard sub-nav-options-wrapper w-clearfix">
        <%= link_to ' &nbsp;<strong>SMS Channel</strong>'.html_safe, leads_and_contacts_user_path(current_user, uid_type: 'phone_number'), class: 'sub-nav-button w-button'%>
        <%= link_to ' &nbsp;<strong>Messenger Channel</strong>'.html_safe, leads_and_contacts_user_path(current_user, uid_type: 'messenger'), class: 'import sub-nav-button w-button'%>
        <a class="sub-nav-button w-button" data-ix="create-list" href="#"> &nbsp;<strong>Create&nbsp;list</strong></a>
      </div>
    </div>
    <div class="sub-nav-bar-search-row w-col w-col-4">
<!--       <div class="customer-dash search-bar-form-wrapper w-form">
        <form data-name="Email Form" id="email-form" name="email-form">
          <input class="search-field w-input" data-name="Search 7" id="Search-7" maxlength="256" name="Search-7" placeholder="Search" type="text">
        </form>
      </div> -->
    </div>
  </div>
</div>
<div class="dashboard-body">
  <div class="customer-dashboard-table-wrapper row-wrapper">
    <% @leads_contacts.each do |leads| %>
      <div>
        <div class="new-table-row w-row">
          <div class="cn w-clearfix w-col w-col-3">
            <div class="name w-clearfix">
              <%= present(leads.contacts).profile_image %>
              <div class="shrink-text table-text"><%= leads.contacts.first_name %></div>
            </div>
            <div class="cb check-box-column">
              <div class="w-form">
                <form data-name="Email Form 2" id="email-form-2" name="email-form-2">
                  <div class="select-all-check-box w-checkbox w-clearfix">
                    <input class="cb table-checkbox w-checkbox-input" id="node" type="checkbox">
                    <label class="checkbox-field-lable w-form-label" for="node">-</label>
                  </div>
                </form>
              </div>
            </div>
          </div>
          <div class="fv w-clearfix w-col w-col-2">
            <div class="cn column column-2 w-clearfix">
              <div class="shrink-text table-text"><%= leads.contacts.phone_number %></div>
            </div>
          </div>
          <div class="lv w-clearfix w-col w-col-2">
            <div class="colum-3 column lv w-clearfix">
              <div class="shrink-text table-text"><%= time_ago_in_words(leads.created_at) %></div>
            </div>
          </div>
          <div class="avs w-clearfix w-col w-col-1">
            <div class="avs column column-4">
              <div class="table-text"><%= leads.uid_type %></div>
            </div>
          </div>
          <div class="ts w-clearfix w-col w-col-1">
            <div class="column column-5 ts">
              <div class="dashboard-right-nav id signup-box-subheading"><span class="relay-id leads unverified">UNVERIFIED</span>
              </div>
            </div>
          </div>
          <div class="table-actions w-clearfix w-col w-col-3">
            <div class="column column-6 new-row"><a class="actions-button notification" href="#">Message &nbsp; </a>
            </div>
            <div class="column column-6 left new-row w-clearfix">
              <div class="frequency shrink-text table-text"><%= leads.contacts.address %></div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
