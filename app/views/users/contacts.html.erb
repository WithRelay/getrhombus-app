<%= provide(:title, "Rhombus - Contacts") %>

<!-- ========== Css Files ========== -->
  
<%= content_for :head do %>
  <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
<% end %>

<body>
  <!-- Start Page Loading -->
  <div class="loading"><img src="<%= asset_path 'loading.gif' %>" alt="loading-img"></div>
  <!-- End Page Loading -->

 <%= render 'shared/header_new' %>
  <%= render 'shared/sidebar' %>

 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTENT -->
<div class="content">

  <!-- Start Page Header -->
  <div class="page-header" style="background: transparent; margin-bottom: 0px;">
    <div class="title" style="font-weight: normal;">Contacts</div>

    <%= render 'shared/dashboard_shortcut' %>

  </div>
  <!-- End Page Header -->

 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTAINER -->
<div class="" id="transactions-column">

 <!-- Start Row -->
  <div class="row">

    <!-- Start Panel -->
    <div class="col-md-12">
      <% unless @contacts.blank? %>
        <div class="panel panel-default">

          <div class="panel-title">
            <ul class="panel-tools">
              <li><a class="icon expand-tool"><i class="fa fa-expand"></i></a></li>
            </ul>
          </div>

          <div class="panel-body table-responsive">
            <table id="transactions-table" class="table table-striped dataTable">
              <thead>
                <tr role="row">
                  <th>Name</th>
                  <th>Phone #</th>
                  <th>Email</th>
                  <th>First Conversation (ET)</th>
                  <th>Last Conversation</th>   
                  <th># Messages</th>    
                </tr>
              </thead>
              <tbody>
              <% @contacts.each do |c| %>
                <tr role="row">
                  <td><%= (current_user.user_level == 0) ? c.business_name : c.card_name %></td>
                  <td><%= (current_user.user_level == 0) ? c.business_phone : c.phone_number %></td>
                  <td><%= c.email %></td>
                  <td><%= c.first_conversation.strftime("%m/%d/%Y %I:%M %p") %></td>
                  <td><%= c.last_conversation.strftime("%m/%d/%Y %I:%M %p") %></td>
                  <td><%= c.total %></td>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>

        </div>
      <% else %>
        <div class="center">
          <img src="<%= asset_path 'no-contacts.png' %>" alt="no contacts">
          <div class="no-user">You have no contacts :(</div>
        </div>
      <% end %>
    </div>
    <!-- End Panel -->
      <div style="text-align: center; margin-bottom: 40px;"><%= will_paginate @contacts, :page_links => false %></div>
  </div>
  <!-- End Row -->
</div>
<!-- END CONTAINER -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 

          <br><br><br><br><br><br><br><br><br><br><br><br>
     <br><br><br><br><br><br>

<%= render 'shared/dashboard_footer' %>


</div>
<!-- End Content -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 


</body>
</html>