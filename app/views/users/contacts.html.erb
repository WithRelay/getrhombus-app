<%= provide(:title, "Rhombus - Contacts") %>

<!-- ========== Css Files ========== -->
  
<%= content_for :head do %>
  <%= stylesheet_link_tag "application_dashboard_messaging", media: "all" %>
<% end %>

<body>
  <!-- Start Page Loading -->
  <div class="loading"><img src="<%= asset_path 'loading.gif' %>" alt="loading-img"></div>
  <!-- End Page Loading -->

 <%= render 'shared/header_new' %>
  <%= render 'shared/sidebar' %>



  


 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTENT -->
<div class="content">

  <!-- Start Page Header -->
  <div class="page-header" style="background: transparent; margin-bottom: 0px;">
    <div class="title" style="font-weight: normal;">Contacts</div>

    <%= render 'shared/dashboard_shortcut' %>

  </div>
  <!-- End Page Header -->

 <!-- //////////////////////////////////////////////////////////////////////////// --> 
<!-- START CONTAINER -->
<div class="" id="transactions-column">

 <!-- Start Row -->
  <div class="row">

  <style type="text/css"> #top { position: relative; }</style>

    <form id="create-user-form" name="create-user-form"    style="width: 255px";>          
            <input type="text" class="form-control rhombusFocus" placeholder="Full Name" id='user_full_name'>
            <input type="text" class="form-control rhombusFocus" name="user[email]" placeholder="Email">

            <input type="hidden" class="form-control rhombusFocus" name="user[first_name]" id="firstName">
            <input type="hidden" class="form-control rhombusFocus" name="user[last_name]" id="lastName">

            <input type="phone" id="phone" class="form-control rhombusFocus">
            <input type="hidden" class="form-control rhombusFocus" name="user[phone_number]" id='phone_number'>

           <!-- <input type="text" class="form-control rhombusFocus" name="user[lists]" placeholder="Add to Lists">-->

            <input type="text" id='cc-name' class="form-control rhombusFocus" name="user[card_name]" placeholder="Name on Card" x-autocompletetype="off" autocompletetype='off' autocorrect="off" spellcheck='off' autocapitalize="off" autocomplete="off">       

             <input type="tel" id='cc-number' class="form-control cc-num rhombusFocus" name="user[last4]" placeholder="Card Number" x-autocompletetype="cc-number" autocompletetype='cc-number' autocorrect="off" spellcheck='off' autocapitalize="off" autocomplete="off"> 

          
            <div class="row form-row m-l-20 m-r-20 xs-m-l-10 xs-m-r-10">
              <div class="col-md-6 col-sm-6" id="exp-div">
                
                <input type="hidden" name="user[expiration_month]" id="cc-ex-month">
                <input type="hidden" name="user[expiration_year]" id="cc-ex-year">

                <input type="hidden" name="user[card_token]" id="cc-uri">
                <input type="hidden" name="user[card_type]" id="cc-type">

                <input id="cc-exp" type="text" class="form-control rhombusFocus" placeholder="MM / YY" value="" x-autocompletetype="off" autocompletetype="off" autocorrect="off" spellcheck="off" autocapitalize="off">
              </div>

              <div class="col-md-6 col-sm-6" id="csc-div">
                  <input id="cc-csc" type="tel" class="form-control rhombusFocus" placeholder="CVC" value="" autocorrect="off" spellcheck="off" autocapitalize="off" autocomplete="off" maxlength="4">
              </div>
            </div>

            <input type="text" class="form-control rhombusFocus" name="user[street_address]" placeholder="Street Address">
            <input type="text" class="form-control rhombusFocus" name="user[city]" placeholder="City">
            <input type="text" class="form-control rhombusFocus" name="user[state_province]" placeholder="State or Province">
            <input type="text" class="form-control rhombusFocus" name="user[country]" placeholder="Country">

          <footer>
            <input type="submit" name="commit" value="Submit" id="create-user-submit" class="btn btn-default btn-rhombus">
          </footer>
      </form>



    <!-- Start Panel -->
    <div class="col-md-12">
      <% unless @contacts.blank? %>
        <div class="panel panel-default">

          <div class="panel-title">
            <ul class="panel-tools">
              <li><a class="icon expand-tool"><i class="fa fa-expand"></i></a></li>
            </ul>
          </div>

          <div class="panel-body table-responsive">
            <table id="transactions-table" class="table table-striped dataTable">
              <thead>
                <tr role="row">
                  <th>Name</th>
                  <th>Phone #</th>
                  <th>Email</th>
                  <th>First Conversation (ET)</th>
                  <th>Last Conversation</th>   
                  <th># Messages</th>    
                </tr>
              </thead>
              <tbody>
              <% @contacts.each do |c| %>
                <tr role="row">
                  <td><%= (current_user.user_level == 0) ? c.org_name : c.card_name %></td>
                  <td><%= (current_user.user_level == 0) ? c.org_phone : c.phone_number %></td>
                  <td><%= c.email %></td>
                  <td><%= c.first_conversation.strftime("%m/%d/%Y %I:%M %p") %></td>
                  <td><%= c.last_conversation.strftime("%m/%d/%Y %I:%M %p") %></td>
                  <td><%= c.total %></td>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>

        </div>
      <% else %>
        <div class="center">
          <img src="<%= asset_path 'no-contacts.png' %>" alt="no contacts">
          <div class="no-user">You have no contacts :(</div>
        </div>
      <% end %>
    </div>
    <!-- End Panel -->
      <div style="text-align: center; margin-bottom: 40px;"><%= will_paginate @contacts, :page_links => false %></div>
  </div>
  <!-- End Row -->
</div>
<!-- END CONTAINER -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 

          <br><br><br><br><br><br><br><br><br><br><br><br>
     <br><br><br><br><br><br>

<%= render 'shared/dashboard_footer' %>


</div>
<!-- End Content -->
 <!-- //////////////////////////////////////////////////////////////////////////// --> 


</body>
</html>