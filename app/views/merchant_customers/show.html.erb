                <div class="said-text">said:</div>
                <p class="conversation-preview"><%= conversation.notes %></p>
                <div class="message-channel"> &nbsp; Sent from</div>
                <div class="channel-name message-channel">Messenger</div>
                <div class="message-channel time-received"><%= present(conversation).format_created_at %></div>
                <div class="status">Marked as done.</div>
              </div>
            </div>
          </div>
        </a>
        <% end %>
      </div>
      <div class="w-col w-col-4">
