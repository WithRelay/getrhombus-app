<div class='modal-background w-hidden modal-body new-reminder-modal'>
  <%= render partial: 'shared/modals/new_reminder', locals: { reminder: Reminder.new }  %>
</div>

 <div class="customer-profile sub-nav-bar w-clearfix">
   <a class="add sub-nav-button w-button modal-loader" href="#" modal-target= "charge-customer-modal">&nbsp; <strong>Charge</strong></a>
   <div class='modal-background w-hidden modal-body charge-customer-modal'>
     <%= render 'shared/modals/charge_customer' %>
   </div>
   <a class="import sub-nav-button w-button modal-loader" href="#" modal-target= 'new-subscription-modal' >&nbsp; <strong>Create subscription</strong></a>
   <div class='modal-background w-hidden modal-body new-subscription-modal'>
     <%= render 'shared/modals/new_subscription' %>
   </div>
   <a class="sub-nav-button w-button modal-loader" href="#" modal-target="add-to-list-modal"> &nbsp;<strong>Add to&nbsp;list</strong></a>
   <div class='modal-background w-hidden modal-body add-to-list-modal'>
     <%= render 'shared/modals/add_to_list' %>
   </div>
   <a class="sub-nav-button w-button modal-loader" href="#" modal-target="schedule-message-modal" > &nbsp;<strong>Schedule message</strong></a>
   <div class='modal-background w-hidden modal-body schedule-message-modal'>
     <%= render 'shared/modals/schedule_message' %>
   </div>
 </div>
  <div class="customer-profile dashboard-body">
    <div class="customer-profile-section-header w-row">
      <div class="w-col w-col-3">
        <div class="customer-properties-div">
          <div class="right-nav-profile-content-wrapper"><%#= present(@customer).profile_image %>
            <div class="dashboard-right-nav signup-box-subheading"><%#= "#{@customer.full_name}"%> <span class="relay-id">RELAY ID</span>
            </div>
            <div class="left-column-text number"> &nbsp; &nbsp;<%#= @customer.phone_number %></div>
            <div class="left-column-text"> &nbsp; &nbsp; <%#= @customer.email %></div>
            <div class="left-column-text"> &nbsp; &nbsp; &nbsp; <%#= @customer.state_province %></div>
            <div class="left-column-text"> &nbsp; &nbsp; <%#= present(@customer).twitter_uid %></div>
            <div class="left-column-text"> &nbsp; &nbsp; Customer since: adasdasdas</div>
            <div class="right-nav-underline"></div>
          </div>
          <div class="customer-profile profile-info-wrapper">
            <h1 class="dashboard-right-nav recent-activity signup-box-subheading">RECENT ACTIVITY</h1>
            <div class="recent-activity right-nav-row w-row">
              <div class="left-column w-col w-col-6">
                <div class="left-column-text recent-activity">Last &nbsp;Contact</div>
              </div>
              <div class="right-column w-col w-col-6">
                <div class="recent-activity-description"><%= @last_conv_ref ? time_in_relative_form(@last_conv_ref.created_at, 'long_format') : "-" %></div>
              </div>
            </div>
            <div class="recent-activity right-nav-row w-row">
              <div class="left-column w-col w-col-5">
                <div class="left-column-text recent-activity">Reason</div>
              </div>
              <div class="right-column w-col w-col-7">
                <div class="recent-activity-description"><%= @last_message_resolution %></div>
              </div>
            </div>
            <div class="payment recent-activity right-nav-row w-row">
              <div class="left-column w-col w-col-5">
                <div class="left-column-text recent-activity">Last &nbsp;Transaction</div>
              </div>
              <div class="right-column w-col w-col-7">
                <div class="recent-activity-description"><%= present(@merchant_customer).last_visit_format_created_at %></div>
              </div>
            </div>
            <div class="recent-activity right-nav-row w-row">
              <div class="left-column w-col w-col-6">
                <div class="left-column-text recent-activity">Amount</div>
              </div>
              <div class="right-column w-col w-col-6">
                <div class="recent-activity-description"><%= present(@customer).total_transaction %></div>
              </div>
            </div>
            <div class="recent-activity right-nav-row w-row">
              <div class="left-column w-col w-col-6">
                <div class="left-column-text recent-activity">Average Spend</div>
              </div>
              <div class="right-column w-col w-col-6">
                <div class="recent-activity-description"><%= present(@customer).average_transaction %></div>
              </div>
            </div>
            <div class="right-nav-underline"></div>
          </div>
        </div>
      </div>
      <div class="w-col w-col-5">
        <div class="customer-profile-section-header-div">
          <h4 class="welcome-dash-content-container-header">Conversation History</h4>
        </div>
        <% @conversation_refs.each do |conversation_ref| %>
          <a class="conversation-history-link-wrapper w-inline-block" href="#">
            <div class="customer-profile-conversation-history top w-container">
              <div class="conversation-content-wrapper w-row">
                <div class="w-col w-col-1">
                  <div class="icon-cell"></div>
                </div>
                <div class="w-clearfix w-col w-col-11">
                  <div class="customer-name-conversation-tab"><%= present(@customer).format_customer_name %></div>
                  <div class="said-text">said:</div>
                  <p class="conversation-preview"><%= present(conversation_ref).format_textable_text %></p>
                  <div class="message-channel"> &nbsp; Sent from</div>
                  <div class="channel-name message-channel"><%= conversation_ref.channel %></div>
                  <div class="message-channel time-received"><%= present(conversation_ref).format_created_at %></div>
                  <div class="status"><%= present(conversation_ref).format_resolution %></div>
                </div>
              </div>
            </div>
          </a>
        <% end %>
      </div>
      <div class="w-col w-col-4">
        <div class="customer-transactions-div overlow-div">
          <div class="customer-profile-section-header-div transaction-history-section">
            <h4 class="welcome-dash-content-container-header">Transaction History</h4>
          </div>
          <div class="transaction-summary-table w-row">
            <div class="w-col w-col-6">
              <div class="customer-profile-box total-spend">
                <div class="total-spend-text transaction-history-box-headers">
                  <%= present(@customer).total_transaction %>
                </div>
                <div class="table-description">Total Spend</div>
              </div>
            </div>
            <div class="w-col w-col-6">
              <div class="average-spend customer-profile-box">
                <div class="average-spend-text transaction-history-box-headers">
                  <%= present(@customer).average_transaction %>
                </div>
                <div class="table-description">Average Spend</div>
              </div>
            </div>
          </div>
          <div class="customer-profile-transactions">
            <div class="customer-profile-trasaction-table w-row">
              <div class="w-col w-col-5">
                <div class="description header">
                  <div class="headings transaction-description"> &nbsp; Description</div>
                </div>
              </div>
              <div class="w-col w-col-2">
                <div class="amount header">
                  <div class="headings transaction-amount">Amount</div>
                </div>
              </div>
              <div class="w-col w-col-2">
                <div class="date header">
                  <div class="headings transaction-time">Time</div>
                </div>
              </div>
              <div class="w-col w-col-3">
                <div class="action header">
                  <div class="actions headings">Actions</div>
                </div>
              </div>
            </div>
            <% @transactions.each do |transaction| %>
              <div class="customer-profile-trasaction-table w-row">
                <div class="w-col w-col-5">
                  <div class="description w-clearfix">
                    <div class="shrink-text table-text unread-table"><%= transaction.description %></div>
                  </div>
                </div>
                <div class="w-col w-col-2">
                  <div class="amount w-clearfix">
                    <div class="shrink-text table-text unread-table">$<%= transaction.amount || 0 %></div>
                  </div>
                </div>
                <div class="w-col w-col-2">
                  <div class="date w-clearfix">
                    <div class="table-text unread-table shrink-text"><%= time_in_relative_form(transaction.created_at, 'short_ago_format') %></div>
                  </div>
                </div>
                <div class="w-col w-col-3">
                  <div class="action w-clearfix">
                    <div class="actions status">Refund</div>
                  </div>
                </div>
              </div>
             <%end%>
          </div>
        </div>
      </div>
    </div>
  </div>
