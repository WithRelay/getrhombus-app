  <%= provide(:title, "Relay - Customers") %>
  <div class="customer-dashboard-header sub-nav-bar table-header">
    <div class="table-header">
      <div class="table-header">
        <div class="header new-table-row w-row">
          <div class="cn w-clearfix w-col w-col-3">
            <div class="header name w-clearfix">
              <div class="headings name"> &nbsp; Name</div>
            </div>
            <div class="cb check-box-column header">
              <div class="w-form">
                <div class="select-all-check-box w-checkbox w-clearfix">
                  <input class="cb table-checkbox w-checkbox-input" id="check_or_uncheck_all" type="checkbox">
                  <label class="checkbox-field-lable w-form-label" for="check_or_uncheck_all">-</label>
                </div>
              </div>
            </div>
          </div>
          <div class="fv w-clearfix w-col w-col-2">
            <div class="cn column column-2 header">
              <div class="first-visit headings"> &nbsp; First visit</div>
            </div>
          </div>
          <div class="lv w-clearfix w-col w-col-2">
            <div class="colum-3 column header lv">
              <div class="headings last-visit"> &nbsp;Last visit</div>
            </div>
          </div>
          <div class="avs w-clearfix w-col w-col-1">
            <div class="avs column column-4 header">
              <div class="avs headings last-visit"> &nbsp;Average</div>
            </div>
          </div>
          <div class="ts w-clearfix w-col w-col-1">
            <div class="column column-5 header ts">
              <div class="headings total-spend-header">&nbsp; Total Spend</div>
            </div>
          </div>
          <div class="table-actions w-clearfix w-col w-col-3">
            <div class="column column-6 header new-row w-clearfix">
              <div class="headings message-customer name">&nbsp; &nbsp;Actions</div>
            </div>
            <div class="column column-6 header id new-row">
              <div class="headings id">&nbsp; &nbsp;Relay ID</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="customer-dash sub-nav-bar">
    <div class="sub-nav-bar-row w-row">
      <div class="sub-nav-bar-row-column-1 w-clearfix w-col w-col-2">
        <div class="customer-count shrink-text">389 of/<span class="sub-nav-sub-text">1379 customers</span>
        </div>
      </div>
      <div class="sub-nav-bar-row-column-2 w-col w-col-6">
        <div class="customer-dashoard sub-nav-options-wrapper w-clearfix">
       <a class="w-button sub-nav-button modal-loader"  href="#" modal-target= 'new-customer-modal'>&nbsp;<strong>Create customer</strong></a>
        <a class="import sub-nav-button w-button modal-loader" modal-target="import-customers-modal" href="#">&nbsp; <strong>Import customers</strong></a>
        <button class="sub-nav-button w-button" modal-target='new-list-modal' disabled id='create_list_button'> &nbsp;<strong>Create&nbsp;list</strong></button>
        <div class='modal-background w-hidden modal-body new-customer-modal'>
          <%= render 'shared/modals/create_customer' %>
        </div>
        <div class='modal-background w-hidden modal-body new-list-modal'>
          <%= render 'shared/modals/new_list' %>
        </div>
        </div>
      </div>
    <!--   <div class="sub-nav-bar-search-row w-col w-col-4">
        <div class="customer-dash search-bar-form-wrapper w-form">
          <form class="w-clearfix" data-name="Email Form" id="email-form" name="email-form">
            <input class="search-field w-input" data-name="Search 6" id="Search-6" maxlength="256" name="Search-6" placeholder="Search" type="text">
          </form>
        </div>
      </div> -->
    </div>
  </div>


  <div class="dashboard-body">

    <div class="customer-dashboard-table-wrapper row-wrapper">
      <div>
      <% @customers.each do |c| %>
        <div class="new-table-row w-row">
          <div class="cn w-clearfix w-col w-col-3">
            <div class="name w-clearfix"><%= present(c).profile_image %>
              <div class="shrink-text table-text"><%= link_to "#{current_user.first_name} #{current_user.last_name}", action: "show" , customer_id: c.customer_id %></div>
            </div>
            <div class="cb check-box-column">
              <div class="w-form">
                <form data-name="Email Form 2" id="email-form-2" name="email-form-2">
                  <div class="select-all-check-box w-checkbox w-clearfix">
                    <input class="cb table-checkbox w-checkbox-input merchant_customers" id="node" type="checkbox" data-users="<%= c.id %>">
                    <label class="checkbox-field-lable w-form-label" for="node">-</label>
                  </div>
                </form>
                <div class="w-form-done">
                  <div>Thank you! Your submission has been received!</div>
                </div>
                <div class="w-form-fail">
                  <div>Oops! Something went wrong while submitting the form</div>
                </div>
              </div>
            </div>
          </div>
          <div class="fv w-clearfix w-col w-col-2">
            <div class="cn column column-2 w-clearfix">
              <div class="shrink-text table-text"><%= present(c).first_visit_format_created_at %></div>
            </div>
          </div>
          <div class="lv w-clearfix w-col w-col-2">
            <div class="colum-3 column lv w-clearfix">
              <div class="shrink-text table-text"><%= present(c).last_visit_format_created_at %></div>
            </div>
          </div>
          <div class="avs w-clearfix w-col w-col-1">
            <div class="avs column column-4 w-clearfix">
              <div class="shrink-text table-text"><%= present(c).average %></div>
            </div>
          </div>
          <div class="ts w-clearfix w-col w-col-1">
            <div class="column column-5 ts w-clearfix">
              <div class="table-text total-spend-text"><%= present(c).total %></div>
            </div>
          </div>
          <div class="table-actions w-clearfix w-col w-col-3">
            <div class="column column-6 left new-row w-clearfix">
              <div class="dashboard-right-nav id signup-box-subheading"><span class="relay-id leads unverified customer-dash">UNVERIFIED</span>
              </div>
            </div>
            <div class="column column-6 new-row">
            <!-- <a class="actions-button notification" href="#">Message &nbsp; </a> -->
            <%= link_to "Message ", user_conversations_path(current_user, uid: c.customer_id, type:'start_conversation', uid_type: 'user'), class: "actions-button notification"%>
            </div>
          </div>
        </div>
       <% end%>
      </div>
    </div>
  </div>
